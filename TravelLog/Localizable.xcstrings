        }
      }
    },
    "collections.flight-detail.speed.fast" : {
      "comment" : "Flight detail verdict when the trip was faster than any car, but a fast train could have made it.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtigere end en bil eller færge i gennemsnit. Kun et fly eller et hurtigtog kommer tæt på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller, als ein Auto oder eine Fähre im Schnitt fährt. Nur ein Flugzeug oder ein Schnellzug kommt heran."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πιο γρήγορα από τον μέσο όρο αυτοκινήτου ή φέρι. Μόνο αεροπλάνο ή τρένο υψηλής ταχύτητας πλησιάζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faster than a car or ferry averages. Only a plane or a fast train comes close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más rápido que la media de un coche o un ferri. Solo un avión o un tren rápido se acerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rapide que la moyenne d’une voiture ou d’un ferry. Seuls un avion ou un train rapide s’en approchent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più veloce della media di un’auto o di un traghetto. Solo un aereo o un treno veloce si avvicinano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車やフェリーの平均より速い速度です。近いのは飛行機か高速鉄道だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동차나 페리의 평균보다 빨라요. 비행기나 고속열차만 이에 가까워요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raskere enn en bil eller ferje i snitt. Bare et fly eller et lyntog kommer i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneller dan een auto of veerboot gemiddeld haalt. Alleen een vliegtuig of snelle trein komt in de buurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais rápido que a média de um carro ou balsa. Só um avião ou um trem rápido chega perto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais rápido do que a média de um carro ou ferry. Só um avião ou um comboio rápido se aproxima."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbare än en bil eller färja i snitt. Bara ett flyg eller ett snabbtåg kommer nära."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arabanın ya da feribotun ortalamasından hızlı. Yalnızca uçak ya da hızlı tren buna yaklaşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhanh hơn tốc độ trung bình của ô tô hay phà. Chỉ máy bay hoặc tàu cao tốc mới gần bằng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比汽车或渡轮的平均速度更快。只有飞机或高速列车能接近。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比汽車或渡輪的平均速度更快。只有飛機或高速列車能接近。"
          }
        }
      }
    },
    "collections.flight-detail.speed.ground" : {
      "comment" : "Flight detail verdict when the trip took about as long as a car or train would.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bil eller et tog kunne også holde det gennemsnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Auto oder ein Zug könnte diesen Schnitt auch schaffen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα αυτοκίνητο ή ένα τρένο θα μπορούσε επίσης να έχει αυτόν τον μέσο όρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A car or a train could average this too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coche o un tren también podría alcanzar esta media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une voiture ou un train pourrait aussi atteindre cette moyenne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche un’auto o un treno potrebbero tenere questa media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車や列車でもこの平均速度は出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동차나 기차로도 낼 수 있는 평균 속도예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bil eller et tog kunne også holdt dette snittet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een auto of trein kan dit gemiddelde ook halen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um carro ou um trem também conseguiria essa média."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um carro ou um comboio também conseguiria esta média."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bil eller ett tåg skulle också klara det snittet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir araba ya da tren de bu ortalamayı tutturabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ô tô hoặc tàu hỏa cũng có thể đạt tốc độ trung bình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽车或火车也能达到这个平均速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汽車或火車也能達到這個平均速度。"
          }
        }
      }
    },
    "collections.flight-detail.speed.inconclusive" : {
      "comment" : "Flight detail verdict when the time with no location is over a day, so the average speed proves nothing.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over så langt et hul kan gennemsnitsfarten ikke skelne en flyrejse fra en køretur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer so langen Lücke unterscheidet die Durchschnittsgeschwindigkeit einen Flug nicht von einer Autofahrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε τόσο μεγάλο κενό, η μέση ταχύτητα δεν ξεχωρίζει μια πτήση από μια διαδρομή με αυτοκίνητο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over a gap this long, the average speed can't tell a flight from a drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un intervalo tan largo, la velocidad media no distingue un vuelo de un trayecto en coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un intervalle aussi long, la vitesse moyenne ne distingue pas un vol d’un trajet en voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un intervallo così lungo, la velocità media non distingue un volo da un viaggio in auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これほど長い空白では、平均速度から飛行機と車を見分けられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 긴 공백에서는 평균 속도로 항공편과 자동차 이동을 구분할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over et så langt opphold kan ikke snittfarten skille en flyreise fra en kjøretur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij zo’n lange onderbreking kan de gemiddelde snelheid een vlucht niet van een autorit onderscheiden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em um intervalo tão longo, a velocidade média não distingue um voo de uma viagem de carro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num intervalo tão longo, a velocidade média não distingue um voo de uma viagem de carro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Över ett så långt uppehåll kan medelhastigheten inte skilja en flygning från en bilresa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadar uzun bir boşlukta ortalama hız, uçuşu araba yolculuğundan ayırt edemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với khoảng trống dài như vậy, tốc độ trung bình không phân biệt được chuyến bay với chuyến đi ô tô."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "间隔这么长，平均速度无法区分飞行和驾车。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間隔這麼長，平均速度無法區分飛行和開車。"
          }
        }
      }
    },
