    "collections.places.empty.description" : {
      "comment" : "Places collection empty-state description; the list holds trip destinations only.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byer og øer fra dine rejser vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Städte, Ortschaften und Inseln Ihrer Reisen erscheinen hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πόλεις, οι κωμοπόλεις και τα νησιά των ταξιδιών σου εμφανίζονται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cities, towns, and islands from your trips appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las ciudades, localidades e islas de sus viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les villes, communes et îles de vos voyages apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Città, località e isole dei tuoi viaggi appaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行で訪れた都市、町、島がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행에서 들른 도시, 마을, 섬이 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byer, tettsteder og øyer fra reisene dine vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steden, plaatsen en eilanden van je reizen verschijnen hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cidades, vilas e ilhas das suas viagens aparecem aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cidades, localidades e ilhas das suas viagens aparecem aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Städer, orter och öar från dina resor visas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahatlerinizdeki şehirler, kasabalar ve adalar burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thành phố, thị trấn và hòn đảo trong chuyến đi của bạn xuất hiện tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您旅行中到过的城市、小镇和岛屿会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您旅行中到過的城市、小鎮和島嶼會顯示在這裡。"
          }
        }
      }
