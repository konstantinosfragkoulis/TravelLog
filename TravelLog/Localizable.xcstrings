    "app-intent.travel-stats.description" : {
      "comment" : "Siri travel statistics description. Days away includes domestic and international trip dates.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsummerer dine rejser (lande, rejser, dage hjemmefra og flyrejser) for hele perioden eller et enkelt år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst Ihre Reisen für den gesamten Zeitraum oder ein einzelnes Jahr zusammen: Länder, Reisen, Tage unterwegs und Flüge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνοψίζει τα ταξίδια σου (χώρες, ταξίδια, ημέρες μακριά από το σπίτι και πτήσεις) για όλα τα έτη ή για ένα συγκεκριμένο έτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Summarizes your travel (countries, trips, days away, and flights) for your lifetime or a single year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume sus viajes (países, viajes, días fuera de casa y vuelos) desde siempre o para un solo año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résume vos voyages (pays, voyages, jours en voyage et vols) sur toute la période ou pour une seule année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riepiloga i viaggi, i paesi, i giorni in viaggio e i voli dell’intero periodo o di un singolo anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全期間または特定の1年間について、旅行（国、旅行、旅行日数、フライト）を要約します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평생 또는 특정 연도의 여행(국가, 여행, 여행 일수, 항공편)을 요약해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppsummerer reisene dine (land, reiser, dager hjemmefra og flyreiser) for hele perioden eller ett enkelt år."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft een samenvatting van je reizen (landen, reizen, dagen van huis en vluchten) over je hele leven of één jaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume suas viagens (países, viagens, dias fora de casa e voos) de toda a vida ou de um único ano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume as suas viagens (países, viagens, dias fora de casa e voos) de toda a vida ou de um único ano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammanfattar dina resor (länder, resor, dagar hemifrån och flygningar) för hela perioden eller ett enskilt år."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülkeler, seyahatler, evden uzakta geçen günler ve uçuşlar dâhil seyahatlerinizi ömür boyu veya tek bir yıl için özetler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tóm tắt hành trình của bạn (quốc gia, chuyến đi, ngày xa nhà và chuyến bay) cho toàn bộ thời gian hoặc một năm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇总终身或某一年的旅行数据（国家/地区、旅程、旅行天数和航班）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯總終身或某一年的旅行資料（國家或地區、旅程、旅行天數和航班）。"
          }
        }
      }
    },
