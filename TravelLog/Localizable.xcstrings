          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fototoegang is vereist. Geef toegang via iOS-instellingen → Privacy en beveiliging → Foto’s → TravelLog."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotos é necessário. Conceda-o em Ajustes do iOS → Privacidade → Fotos → TravelLog."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotografias é necessário. Conceda-o em Definições do iOS → Privacidade → Fotografias → TravelLog."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
