        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις επισκεφθεί %1$@ χώρα σε %2$@ ταξίδι, με %3$@ ημέρες μακριά από το σπίτι και %4$@ πτήση."
