    "settings.photo-import.error.checkpoint-unverified" : {
      "comment" : "Settings, photo import alert: the local checkpoint journal does not match the import row; only a fresh import is offered.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den gemte fremdrift kunne ikke bekræftes. Start en ny import. Eksisterende steder bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gespeicherte Fortschritt konnte nicht geprüft werden. Starten Sie einen neuen Import. Vorhandene Orte bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η επαλήθευση της αποθηκευμένης προόδου. Ξεκίνα νέα εισαγωγή. Οι υπάρχουσες τοποθεσίες διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved progress could not be verified. Start a fresh import. Existing locations are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar el progreso guardado. Inicie una nueva importación. Se conservan las ubicaciones existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression enregistrée n’a pas pu être vérifiée. Lancez une nouvelle importation. Les lieux existants sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile verificare i progressi salvati. Avvia una nuova importazione. Le posizioni esistenti vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された進行状況を確認できませんでした。新しく読み込みを開始してください。既存の位置情報は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 진행 상황을 확인할 수 없어요. 새로 가져오기를 시작하세요. 기존 위치는 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lagrede fremdriften kunne ikke bekreftes. Start en ny import. Eksisterende steder beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opgeslagen voortgang kon niet worden gecontroleerd. Start een nieuwe import. Bestaande locaties blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o progresso salvo. Inicie uma nova importação. As localizações existentes são mantidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar o progresso guardado. Inicie uma nova importação. As localizações existentes são mantidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sparade förloppet kunde inte verifieras. Starta en ny import. Befintliga platser behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmiş ilerleme doğrulanamadı. Yeni bir içe aktarma başlatın. Mevcut konumlar korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh tiến độ đã lưu. Hãy bắt đầu nhập mới. Các vị trí hiện có được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证已保存的进度。请重新开始导入。现有位置将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法驗證已儲存的進度。請重新開始匯入。現有位置將保留。"
