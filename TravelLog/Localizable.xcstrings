            "value" : "Χρησιμοποιεί τα ημερολόγιά σου για να επιβεβαιώνει πτήσεις σε παλαιότερα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Uses your calendars to confirm flights on older trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa sus calendarios para confirmar vuelos en viajes anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise vos calendriers pour confirmer les vols des anciens voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i tuoi calendari per confermare i voli dei viaggi precedenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーを使って、過去の旅行のフライトを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더를 사용해 이전 여행의 항공편을 확인해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker kalenderne dine til å bekrefte flyreiser på eldre reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt je agenda’s om vluchten van oudere reizen te bevestigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa seus calendários para confirmar voos em viagens antigas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa os seus calendários para confirmar voos em viagens antigas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder dina kalendrar för att bekräfta flygningar på äldre resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski seyahatlerdeki uçuşları doğrulamak için takvimlerinizi kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng lịch của bạn để xác nhận chuyến bay trong các chuyến đi cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您的日历确认较早旅程中的航班。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您的行事曆確認較早旅程中的航班。"
          }
        }
      }
    },
    "settings.calendar.privacy-footer" : {
      "comment" : "Footer of the Settings Calendar screen: what Travel Log reads, that it never changes events, why iOS asks for full access, where event details are stored and synced, and that notes are never stored.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log læser begivenheder for at finde kommende rejser og bekræfte tidligere flyrejser. Appen ændrer aldrig din kalender, men iOS tilbyder ikke adgang kun til læsning. De anvendte begivenhedsoplysninger gemmes på denne enhed og synkroniseres via din private iCloud, når synkronisering er slået til. Noter gemmes aldrig, og begivenheder vises aldrig i rejsetitler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log liest Ereignisse, um bevorstehende Reisen zu finden und vergangene Flüge zu bestätigen. Ihr Kalender wird nie verändert, aber iOS bietet keinen reinen Lesezugriff. Verwendete Ereignisdetails bleiben auf diesem Gerät und werden bei aktivierter Synchronisierung über Ihre private iCloud synchronisiert. Notizen werden nie gespeichert und Ereignisse erscheinen nie in Reisetiteln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log διαβάζει γεγονότα για να εντοπίζει επερχόμενα ταξίδια και να επιβεβαιώνει παλαιότερες πτήσεις. Δεν αλλάζει ποτέ το ημερολόγιό σου, αλλά το iOS δεν προσφέρει πρόσβαση μόνο για ανάγνωση. Τα στοιχεία γεγονότων που χρησιμοποιεί παραμένουν σε αυτήν τη συσκευή και συγχρονίζονται μέσω του ιδιωτικού σου iCloud, όταν ο συγχρονισμός είναι ενεργός. Οι σημειώσεις δεν αποθηκεύονται ποτέ και τα γεγονότα δεν εμφανίζονται ποτέ στους τίτλους ταξιδιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log reads events to find upcoming trips and confirm past flights. It never changes your calendar, but iOS has no read-only option. Event details it uses stay on this device and sync through your private iCloud when sync is on. Notes are never stored, and events never appear in trip titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log lee eventos para encontrar próximos viajes y confirmar vuelos pasados. Nunca modifica su calendario, pero iOS no ofrece acceso de solo lectura. Los detalles de eventos que utiliza se guardan en este dispositivo y se sincronizan mediante su iCloud privado cuando la sincronización está activada. Las notas nunca se guardan y los eventos nunca aparecen en los títulos de los viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log lit les événements pour trouver les voyages à venir et confirmer les vols passés. L’app ne modifie jamais votre calendrier, mais iOS ne propose pas d’accès en lecture seule. Les détails d’événements utilisés restent sur cet appareil et sont synchronisés via votre iCloud privé lorsque la synchronisation est activée. Les notes ne sont jamais enregistrées et les événements n’apparaissent jamais dans les titres des voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log legge gli eventi per trovare i viaggi in programma e confermare i voli passati. Non modifica mai il calendario, ma iOS non offre un accesso di sola lettura. I dettagli degli eventi utilizzati restano su questo dispositivo e si sincronizzano tramite il tuo iCloud privato quando la sincronizzazione è attiva. Le note non vengono mai salvate e gli eventi non compaiono mai nei titoli dei viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logはイベントを読み取り、今後の旅行を見つけたり、過去のフライトを確認したりします。カレンダーを変更することはありませんが、iOSには読み取り専用のアクセス権がありません。使用するイベントの詳細はこのデバイスに保存され、同期がオンの場合は個人用のiCloud経由で同期されます。メモは保存されず、イベントが旅行のタイトルに表示されることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log는 이벤트를 읽어 예정된 여행을 찾고 과거 항공편을 확인해요. 캘린더를 변경하지는 않지만, iOS에는 읽기 전용 접근 옵션이 없어요. 사용하는 이벤트 세부사항은 이 기기에 저장되며, 동기화가 켜져 있으면 비공개 iCloud를 통해 동기화돼요. 메모는 저장되지 않으며 이벤트가 여행 제목에 표시되는 일도 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log leser hendelser for å finne kommende reiser og bekrefte tidligere flyreiser. Appen endrer aldri kalenderen din, men iOS tilbyr ikke skrivebeskyttet tilgang. Hendelsesdetaljene som brukes, lagres på denne enheten og synkroniseres via din private iCloud når synkronisering er slått på. Notater lagres aldri, og hendelser vises aldri i reisetitler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log leest activiteiten om komende reizen te vinden en eerdere vluchten te bevestigen. De app verandert je agenda nooit, maar iOS biedt geen toegang voor alleen lezen. Gebruikte details van activiteiten blijven op dit apparaat en worden via je privé-iCloud gesynchroniseerd als synchronisatie aanstaat. Notities worden nooit opgeslagen en activiteiten verschijnen nooit in reistitels."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log lê eventos para encontrar próximas viagens e confirmar voos passados. Ele nunca altera seu calendário, mas o iOS não oferece uma opção de acesso somente para leitura. Os detalhes de eventos usados ficam neste dispositivo e são sincronizados pelo seu iCloud privado quando a sincronização está ativada. As notas nunca são armazenadas e os eventos nunca aparecem nos títulos das viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log lê eventos para encontrar próximas viagens e confirmar voos passados. Nunca altera o seu calendário, mas o iOS não oferece uma opção de acesso só de leitura. Os detalhes dos eventos utilizados ficam neste dispositivo e são sincronizados através do seu iCloud privado quando a sincronização está ativa. As notas nunca são guardadas e os eventos nunca aparecem nos títulos das viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log läser händelser för att hitta kommande resor och bekräfta tidigare flygningar. Appen ändrar aldrig din kalender, men iOS erbjuder inte enbart läsåtkomst. Händelseuppgifterna som används finns kvar på den här enheten och synkroniseras via din privata iCloud när synkronisering är på. Anteckningar sparas aldrig, och händelser visas aldrig i resetitlar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log, yaklaşan seyahatleri bulmak ve geçmiş uçuşları doğrulamak için etkinlikleri okur. Takviminizi hiçbir zaman değiştirmez, ancak iOS salt okunur erişim seçeneği sunmaz. Kullanılan etkinlik ayrıntıları bu aygıtta kalır ve eşzamanlama açıkken özel iCloud alanınız üzerinden eşzamanlanır. Notlar hiçbir zaman saklanmaz ve etkinlikler seyahat başlıklarında asla görünmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log đọc sự kiện để tìm chuyến đi sắp tới và xác nhận chuyến bay trước đây. Ứng dụng không bao giờ thay đổi lịch, nhưng iOS không có tùy chọn chỉ đọc. Chi tiết sự kiện được sử dụng vẫn lưu trên thiết bị này và đồng bộ qua iCloud riêng tư của bạn khi bật đồng bộ. Ghi chú không bao giờ được lưu và sự kiện không bao giờ xuất hiện trong tiêu đề chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 会读取日程来查找即将开始的旅程并确认过去的航班。它从不更改您的日历，但 iOS 没有只读访问选项。使用的日程详情保存在此设备上，开启同步后会通过您的私人 iCloud 同步。备注从不保存，日程也不会出现在旅程标题中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 會讀取行程來尋找即將開始的旅程，並確認過去的航班。它絕不會更改您的行事曆，但 iOS 沒有唯讀存取選項。使用的行程詳細資訊會保存在此裝置上，開啟同步後會透過您的私人 iCloud 同步。備註絕不會儲存，行程也不會出現在旅程標題中。"
          }
        }
      }
    },
