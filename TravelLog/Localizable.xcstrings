    "Stays from \"%@\" will be merged into \"%@\"." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ophold fra \"%1$@\" bliver flettet ind i \"%2$@\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufenthalte aus „%1$@“ werden mit „%2$@“ zusammengeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραμονές από το «%1$@» θα συγχωνευτούν στο «%2$@»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stays from \"%1$@\" will be merged into \"%2$@\"."
          }
