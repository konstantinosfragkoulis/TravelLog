      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filerne kunne ikke klargøres. Kontrollér din ledige plads, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien konnten nicht vorbereitet werden. Prüfen Sie Ihren freien Speicher und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η προετοιμασία των αρχείων. Ελέγξτε τον ελεύθερο χώρο σας και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The files couldn't be prepared. Check your free space and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido preparar los archivos. Comprueba tu espacio libre e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers n’ont pas pu être préparés. Vérifiez votre espace libre et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile preparare i file. Controlla lo spazio libero e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを準備できませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 준비할 수 없습니다. 여유 공간을 확인한 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filene kunne ikke klargjøres. Sjekk ledig plass og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestanden konden niet worden voorbereid. Controleer je vrije ruimte en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar os arquivos. Verifique seu espaço livre e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar os ficheiros. Verifique o espaço livre e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filerna kunde inte förberedas. Kontrollera ditt lediga utrymme och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyalar hazırlanamadı. Boş alanınızı denetleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể chuẩn bị các tệp. Hãy kiểm tra dung lượng trống và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备文件。请检查可用空间后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法準備檔案。請檢查可用空間後再試。"
          }
        }
      }
    },
