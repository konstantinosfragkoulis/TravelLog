    "onboarding.photo-scan.error.incomplete-local-data" : {
      "comment" : "Onboarding photo-scan error when required iCloud data is still syncing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
