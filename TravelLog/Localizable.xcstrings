    "“%@” is no longer a trip. Future visits there will count as home. Manage this under Settings › Home Area Places." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” er ikke længere en rejse. Fremtidige besøg dér tæller som hjem. Administrer dette under Indstillinger › Steder i hjemmeområdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine Reise mehr. Künftige Besuche dort zählen als Heimat. Verwalten Sie dies unter Einstellungen › Orte der Heimatregion."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» δεν είναι πλέον ταξίδι. Οι μελλοντικές επισκέψεις εκεί θα υπολογίζονται ως χρόνος στην περιοχή κατοικίας. Μπορείς να το διαχειριστείς στις Ρυθμίσεις › Μέρη περιοχής κατοικίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” is no longer a trip. Future visits there will count as home. Manage this under Settings › Home Area Places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no es un viaje. Las próximas visitas allí contarán como estancia en casa. Gestione este lugar en Ajustes › Lugares de la zona de residencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est plus un voyage. Vos prochaines visites à cet endroit seront considérées comme du temps au domicile. Gérez ce réglage dans Réglages › Lieux de la zone de domicile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è più un viaggio. Le visite future conteranno come permanenza a casa. Gestisci il luogo in Impostazioni › Luoghi della zona di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は旅行ではなくなりました。今後ここを訪れた場合は自宅として扱われます。設定 › 自宅エリアの場所で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 여행이 아니에요: “%@”. 앞으로 이곳 방문은 집으로 계산돼요. 설정 › 생활권 장소에서 관리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» er ikke lenger en reise. Fremtidige besøk der regnes som hjemme. Administrer dette under Innstillinger › Steder i hjemmeområdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is geen reis meer. Toekomstige bezoeken daar tellen als thuis. Beheer dit via Instellingen › Plekken in thuisgebied."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é mais uma viagem. Visitas futuras ao local contarão como casa. Gerencie isso em Ajustes › Locais da área de residência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já não é uma viagem. As visitas futuras a esse local contarão como casa. Faça a gestão deste local em Definições › Locais da área de residência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” är inte längre en resa. Framtida besök där räknas som hemma. Hantera detta under Inställningar › Platser i hemområdet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” artık seyahat değil. Gelecekteki ziyaretler ev bölgesi sayılacak. Ayarlar › Ev Bölgesi Yerleri bölümünden yönetin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” không còn là chuyến đi. Các lần ghé sau này sẽ được tính là ở nhà. Quản lý trong Cài đặt › Địa điểm thuộc khu vực sinh sống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不再属于旅程。今后到访该地点将视为回家。可在“设置”›“常住区域地点”中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不再屬於旅程。今後造訪該地點將視為回家。可在「設定」›「居住區域地點」中管理。"
          }
        }
      }
    },
    "data-import.error.protected-damaged" : {
      "comment" : "Error shown when a password-protected backup fails its integrity check or is cut off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne beskyttede sikkerhedskopi er beskadiget eller blev ændret, efter den blev lavet, så den kan ikke åbnes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses geschützte Backup ist beschädigt oder wurde nach dem Erstellen verändert, daher kann es nicht geöffnet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προστατευμένο αντίγραφο ασφαλείας είναι κατεστραμμένο ή άλλαξε μετά τη δημιουργία του, οπότε δεν μπορεί να ανοίξει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This protected backup is damaged or was changed after it was made, so it can't be opened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia protegida está dañada o se modificó después de crearse, así que no se puede abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde protégée est endommagée ou a été modifiée après sa création, elle ne peut donc pas être ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup protetto è danneggiato o è stato modificato dopo la creazione, quindi non può essere aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保護されたバックアップは破損しているか、作成後に変更されたため、開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보호된 백업은 손상되었거나 만들어진 후 변경되어 열 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne beskyttede sikkerhetskopien er skadet eller ble endret etter at den ble laget, så den kan ikke åpnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze beveiligde reservekopie is beschadigd of na het maken gewijzigd, dus hij kan niet worden geopend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup protegido está danificado ou foi alterado depois de criado, então não pode ser aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia de segurança protegida está danificada ou foi alterada depois de ser criada, por isso não pode ser aberta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den skyddade säkerhetskopian är skadad eller ändrades efter att den skapades, så den kan inte öppnas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu korumalı yedek bozuk veya oluşturulduktan sonra değiştirilmiş, bu yüzden açılamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu được bảo vệ này bị hỏng hoặc đã bị thay đổi sau khi tạo nên không thể mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此受保护的备份已损坏，或在创建后被更改，因此无法打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此受保護的備份已損壞，或在建立後遭到更改，因此無法打開。"
          }
        }
      }
    },
    "data-import.error.protected-newer" : {
      "comment" : "Error shown when a password-protected backup uses an encryption format newer than this app version reads.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne beskyttede sikkerhedskopi er lavet med en nyere version af Travel Log. Opdater appen for at åbne den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses geschützte Backup wurde mit einer neueren Version von Travel Log erstellt. Aktualisieren Sie die App, um es zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το προστατευμένο αντίγραφο ασφαλείας δημιουργήθηκε από νεότερη έκδοση του Travel Log. Ενημέρωσε την εφαρμογή για να το ανοίξεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This protected backup was made by a newer version of Travel Log. Update the app to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia protegida se creó con una versión más reciente de Travel Log. Actualice la app para abrirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde protégée a été créée par une version plus récente de Travel Log. Mettez à jour l’app pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup protetto è stato creato da una versione più recente di Travel Log. Aggiorna l’app per aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保護されたバックアップは新しいバージョンのTravel Logで作成されました。開くにはアプリをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보호된 백업은 더 새로운 버전의 Travel Log에서 만들어졌어요. 열려면 앱을 업데이트하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne beskyttede sikkerhetskopien ble laget med en nyere versjon av Travel Log. Oppdater appen for å åpne den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze beveiligde reservekopie is gemaakt met een nieuwere versie van Travel Log. Werk de app bij om hem te openen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup protegido foi criado por uma versão mais recente do Travel Log. Atualize o app para abri-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia de segurança protegida foi criada por uma versão mais recente do Travel Log. Atualize a app para a abrir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den skyddade säkerhetskopian skapades med en nyare version av Travel Log. Uppdatera appen för att öppna den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu korumalı yedek, Travel Log'un daha yeni bir sürümüyle oluşturulmuş. Açmak için uygulamayı güncelleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu được bảo vệ này được tạo bởi phiên bản Travel Log mới hơn. Hãy cập nhật ứng dụng để mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此受保护的备份由较新版本的 Travel Log 创建。请更新 App 后再打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此受保護的備份由較新版本的 Travel Log 建立。請更新 App 後再打開。"
          }
        }
      }
    },
    "data-import.error.too-large" : {
      "comment" : "Error shown when an imported backup expands to more data than a real backup holds, such as a damaged or altered file.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen er større, end en sikkerhedskopi fra Travel Log kan være, så den kan ikke importeres. Den er muligvis beskadiget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist größer, als ein Backup von Travel Log sein kann, daher kann sie nicht importiert werden. Sie ist möglicherweise beschädigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αρχείο είναι μεγαλύτερο από κάθε αντίγραφο ασφαλείας του Travel Log, οπότε δεν μπορεί να εισαχθεί. Μπορεί να είναι κατεστραμμένο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This file is larger than any Travel Log backup can be, so it can't be imported. It may be damaged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo es más grande de lo que puede ser una copia de Travel Log, así que no se puede importar. Puede que esté dañado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier est plus volumineux que ne peut l’être une sauvegarde Travel Log, il ne peut donc pas être importé. Il est peut-être endommagé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file è più grande di qualsiasi backup di Travel Log, quindi non può essere importato. Potrebbe essere danneggiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはTravel Logのバックアップとしては大きすぎるため、読み込めません。破損している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일은 Travel Log 백업이 가질 수 있는 크기보다 커서 가져올 수 없어요. 파일이 손상되었을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen er større enn en sikkerhetskopi fra Travel Log kan være, så den kan ikke importeres. Den kan være skadet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit bestand is groter dan een reservekopie van Travel Log kan zijn, dus het kan niet worden geïmporteerd. Het is mogelijk beschadigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo é maior do que um backup do Travel Log pode ser, então não pode ser importado. Ele pode estar danificado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ficheiro é maior do que uma cópia de segurança do Travel Log pode ser, por isso não pode ser importado. Pode estar danificado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen är större än en säkerhetskopia från Travel Log kan vara, så den kan inte importeras. Den kan vara skadad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosya bir Travel Log yedeğinin olabileceğinden daha büyük, bu yüzden içe aktarılamıyor. Dosya bozuk olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp này lớn hơn mọi bản sao lưu Travel Log nên không thể nhập. Tệp có thể đã bị hỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件超出了 Travel Log 备份可能的大小，因此无法导入。文件可能已损坏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案超出了 Travel Log 備份可能的大小，因此無法匯入。檔案可能已損壞。"
          }
        }
      }
    },
    "data-import.error.wrong-password" : {
