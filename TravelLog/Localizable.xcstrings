    "This device doesn't allow Travel Log to request location access, possibly due to parental controls or a management profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed tillader ikke, at Travel Log anmoder om adgang til lokalitet, muligvis på grund af børnesikring eller en administrationsprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät erlaubt Travel Log nicht, Standortzugriff anzufordern. Mögliche Gründe sind Kindersicherungen oder ein Verwaltungsprofil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν επιτρέπει στο Travel Log να ζητήσει πρόσβαση στην τοποθεσία, πιθανώς λόγω γονικού ελέγχου ή προφίλ διαχείρισης."
