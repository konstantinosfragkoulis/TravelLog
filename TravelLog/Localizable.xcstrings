    "stats.exploration.hex-explainer" : {
      "comment" : "Stats Exploration card line explaining what a hex is; the placeholder is the area of one hex, such as 36 km².",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver sekskant er et felt på kortet på ca. %@. Den tæller én gang, første gang du er der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Hexfeld ist eine Kartenzelle von etwa %@. Es zählt einmal, bei Ihrem ersten Besuch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε εξάγωνο είναι ένα κελί του χάρτη με έκταση περίπου %@. Μετράει μία φορά, την πρώτη φορά που βρίσκεσαι εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Each hex is a map cell of about %@. It counts once, the first time you are there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada hexágono es una celda del mapa de unos %@. Cuenta una sola vez, la primera vez que está allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque hexagone est une cellule de la carte d’environ %@. Il compte une seule fois, lors de votre première visite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esagono è una cella della mappa di circa %@. Conta una sola volta, la prima volta che ti trovi lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各六角形は、面積が約%@の地図上のマスです。初めて訪れたときに一度だけ数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 육각형은 면적이 약 %@인 지도 셀이에요. 처음 방문했을 때 한 번만 집계돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver sekskant er en kartrute på omtrent %@. Den telles én gang, første gang du er der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke zeshoek is een kaartvak van ongeveer %@. Het telt één keer mee, bij je eerste bezoek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada hexágono é uma célula do mapa de cerca de %@. Ele conta uma vez, na primeira vez que você está lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada hexágono é uma célula do mapa com cerca de %@. Conta uma vez, na primeira vez que lá está."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje hexagon är en kartruta på ungefär %@. Den räknas en gång, första gången du är där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her altıgen, yaklaşık %@ büyüklüğünde bir harita hücresidir. Oraya ilk gidişinizde bir kez sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ô lục giác là một ô trên bản đồ có diện tích khoảng %@. Ô chỉ được tính một lần, vào lần đầu bạn đến đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
