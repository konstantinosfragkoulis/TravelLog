        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você visitou %1$@ país em %2$@ viagem, com %3$@ dias fora de casa e %4$@ voo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
