    "tip.dismiss.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på denne rejse, og vælg “Dette var ikke en rejse” for at markere den som en del af din hverdag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese Reise gedrückt und wähle „Das war keine Reise“, um sie als Teil deines Alltags zu markieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα αυτό το ταξίδι και επίλεξε «Αυτό δεν ήταν ταξίδι» για να το σημειώσεις ως μέρος της καθημερινότητάς σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold this trip, then choose “This Wasn't a Trip” to mark it as part of everyday life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga pulsado este viaje y elija «Esto no era un viaje» para marcarlo como parte de su vida cotidiana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur ce voyage, puis choisissez « Ce n’était pas un voyage » pour le marquer comme faisant partie de votre quotidien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto questo viaggio, poi scegli “Questo non era un viaggio” per indicare che fa parte della vita quotidiana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行を長押しし、「これは旅行ではありませんでした」を選ぶと、日常生活の一部として登録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행을 길게 누른 다음 ‘여행이 아니었어요’를 선택해 일상생활의 일부로 표시하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på denne reisen, og velg «Dette var ikke en reise» for å markere den som en del av hverdagen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd deze reis ingedrukt en kies ‘Dit was geen reis’ om aan te geven dat deze bij je dagelijks leven hoort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure esta viagem e escolha “Isto não foi uma viagem” para marcá-la como parte do seu dia a dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque sem soltar nesta viagem e escolha «Isto não foi uma viagem» para a marcar como parte do seu dia a dia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på den här resan och välj ”Det här var ingen resa” för att markera den som en del av din vardag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahate dokunup basılı tutun, ardından günlük yaşamınızın bir parçası olarak işaretlemek için “Bu Bir Seyahat Değildi” seçeneğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ chuyến đi này, rồi chọn “Đây không phải chuyến đi” để đánh dấu đây là một phần của cuộc sống hằng ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按这次旅行，然后选择“这不是旅程”，将其标记为日常生活的一部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按這次旅行，然後選擇「這不是旅程」，將其標記為日常生活的一部分。"
          }
        }
      }
    },
    "tip.dismiss.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var det ikke en rejse?"
          }
        },
        "de" : {
