    "status-dashboard.recent-pings.footer.one" : {
      "comment" : "Status Dashboard footer when one recent location ping is shown.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser de %@ seneste positionsmålinger. Træk for at opdatere og prøve mislykket geokodning igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neueste %@ Ping wird angezeigt. Zum Aktualisieren nach unten ziehen und fehlgeschlagene Geocodierungen erneut versuchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται το %@ πιο πρόσφατο σήμα. Τράβηξε για ανανέωση και νέα προσπάθεια αποτυχημένης γεωκωδικοποίησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the %@ most recent pings. Pull to refresh and retry failed geocoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando el %@ registro más reciente. Deslice para actualizar y reintentar la geocodificación fallida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage du %@ relevé le plus récent. Tirez vers le bas pour actualiser et réessayer les géocodages en échec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene mostrato %@ rilevamento recente. Trascina per aggiornare e riprovare la geocodifica non riuscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近の%@件の位置情報を表示しています。プルして更新し、失敗したジオコーディングを再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 위치 신호 %@개를 표시해요. 아래로 당겨 새로 고치고 실패한 지오코딩을 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser den %@ nyeste posisjonen. Dra for å oppdatere og prøve mislykket geokoding på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %@ meest recente pings worden getoond. Trek om te vernieuwen en mislukte geocodering opnieuw te proberen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando o %@ sinal mais recente. Puxe para atualizar e tentar novamente geocodificações com falha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mostrar o %@ sinal mais recente. Puxe para atualizar e repetir geocodificações falhadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar den %@ senaste platspunkten. Dra för att uppdatera och försöka geokoda igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En son %@ konum sinyali gösteriliyor. Yenilemek ve başarısız coğrafi kodlamayı yeniden denemek için aşağı çekin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị %@ tín hiệu vị trí gần đây nhất. Kéo để làm mới và thử lại mã hóa địa lý không thành công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在显示最近的 %@ 个位置点。下拉刷新并重试失败的地理编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在顯示最近的 %@ 個位置點。下拉重新整理並重試失敗的地理編碼。"
          }
        }
      }
    },
