    "Your annual travel recap. %@'s edition unlocks automatically on December 1, or generate it now." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din årlige rejseoversigt. Udgaven for %@ låses automatisk op den 1. december, eller du kan oprette den nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr jährlicher Reiserückblick. Die Ausgabe für %@ wird am 1. Dezember automatisch freigeschaltet; Sie können sie auch jetzt erstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ετήσια ανασκόπηση των ταξιδιών σου. Η έκδοση του %@ ξεκλειδώνει αυτόματα την 1η Δεκεμβρίου ή μπορείς να τη δημιουργήσεις τώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your annual travel recap. %@'s edition unlocks automatically on December 1, or generate it now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su resumen anual de viajes. La edición de %@ se desbloquea automáticamente el 1 de diciembre, o puede generarla ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre rétrospective annuelle de voyages. L’édition %@ se débloque automatiquement le 1er décembre, mais vous pouvez la générer maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riepilogo annuale dei viaggi. L’edizione %@ si sblocca automaticamente il 1º dicembre, oppure puoi generarla ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎年の旅の振り返りです。%@年版は12月1日に自動で利用可能になりますが、今すぐ生成することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연간 여행 돌아보기예요. %@년 버전은 12월 1일에 자동으로 열리며 지금 생성할 수도 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din årlige reiseoppsummering. Utgaven for %@ låses opp automatisk 1. desember, eller du kan lage den nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je jaarlijkse reisoverzicht. De editie van %@ wordt op 1 december automatisch ontgrendeld, maar je kunt deze nu al genereren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua retrospectiva anual de viagens. A edição de %@ é liberada automaticamente em 1º de dezembro, ou você pode gerá-la agora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu resumo anual de viagens. A edição de %@ fica disponível automaticamente a 1 de dezembro, ou pode gerá-la agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din årliga resesammanfattning. Utgåvan för %@ låses upp automatiskt den 1 december, eller så kan du skapa den nu."
          }
        },
        "tr" : {
          "stringUnit" : {
