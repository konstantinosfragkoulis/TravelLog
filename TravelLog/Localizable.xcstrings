    "trips.search-empty.ai-empty-hint" : {
      "comment" : "Trip search empty-state hint when the AI fallback search also found nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet matchede, heller ikke med AI. Tjek stavningen, eller prøv et sted, et land eller et år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit KI wurde nichts gefunden. Prüfen Sie die Schreibweise, oder versuchen Sie einen Ort, ein Land oder ein Jahr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε τίποτα, ούτε με AI. Έλεγξε την ορθογραφία ή δοκίμασε ένα μέρος, μια χώρα ή ένα έτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing matched, even with AI. Check the spelling, or try a place, country, or year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró nada, ni siquiera con IA. Compruebe la ortografía o pruebe con un lugar, un país o un año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat, même avec l’IA. Vérifiez l’orthographe, ou essayez un lieu, un pays ou une année."
