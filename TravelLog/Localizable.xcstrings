    "Enable calendar access in Settings to detect upcoming trips." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå kalenderadgang til i Indstillinger for at registrere kommende rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Kalenderzugriff in den Einstellungen, um bevorstehende Reisen zu erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησε την πρόσβαση στο ημερολόγιο στις Ρυθμίσεις για να εντοπίζονται επερχόμενα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable calendar access in Settings to detect upcoming trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active el acceso al calendario en Ajustes para detectar próximos viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès au calendrier dans Réglages pour détecter les voyages à venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l’accesso al calendario in Impostazioni per rilevare i prossimi viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の旅行を検出するには、「設定」でカレンダーへのアクセスを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예정된 여행을 감지하려면 설정에서 캘린더 접근을 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på kalendertilgang i Innstillinger for å finne kommende reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel agendatoegang in via Instellingen om aankomende reizen te detecteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso ao calendário em Ajustes para detectar próximas viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso ao calendário em Definições para detetar próximas viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera kalenderåtkomst i Inställningar för att identifiera kommande resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşan seyahatleri algılamak için Ayarlar'dan takvim erişimini etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật quyền truy cập lịch trong Cài đặt để phát hiện các chuyến đi sắp tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许访问日历，以检测即将开始的旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許取用行事曆，以偵測即將開始的旅程。"
          }
        }
      }
    },
