    "settings.home-add.choice.message" : {
      "comment" : "Message of the add-home confirmation that offers keeping both homes or replacing the existing one.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold begge, hvis dette er et reelt ekstra hjem, f.eks. et sommer- eller vinterhus. Når du ankommer til et af dem, afsluttes en rejse. Erstat det, hvis du er flyttet. Det gamle hjem bliver i din historik for tidligere rejser. Gælder det et par måneders studie eller arbejde, skal du annullere og tilføje et midlertidigt hjem i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie beide, wenn dies wirklich ein zweites Zuhause ist, etwa ein Sommer- bzw. Winterhaus. Die Ankunft an einem der beiden Orte beendet eine Reise. Wenn Sie umgezogen sind, ersetzen Sie das bestehende Zuhause; für vergangene Reisen bleibt es im Verlauf erhalten. Für einige Monate Studium oder Arbeit brechen Sie ab und fügen stattdessen ein Zuhause auf Zeit hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτησε και τις δύο αν πρόκειται όντως για δεύτερη κατοικία, όπως ένα θερινό ή χειμερινό σπίτι. Η άφιξη σε οποιαδήποτε από τις δύο τερματίζει ένα ταξίδι. Αν μετακόμισες, αντικατάστησέ την· η παλιά κατοικία παραμένει στο ιστορικό σου για παλαιότερα ταξίδια. Για λίγους μήνες σπουδών ή εργασίας, ακύρωσε και πρόσθεσε καλύτερα ένα προσωρινό σπίτι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep both if this is a genuine second home, like a summer or winter house. Arriving at either one ends a trip. Replace if you moved; the old home stays in your history for past trips. For a few months of study or work, cancel and add a temporary home instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve ambas si se trata de una segunda residencia real, como una casa de verano o invierno. Llegar a cualquiera de ellas finaliza un viaje. Sustitúyala si se mudó; la anterior seguirá en el historial de viajes pasados. Para unos meses de estudio o trabajo, cancele y añada una residencia temporal en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez les deux s’il s’agit réellement d’un deuxième domicile, comme une maison d’été ou d’hiver. L’arrivée à l’un des deux met fin à un voyage. Remplacez l’ancien si vous avez déménagé ; il restera dans votre historique pour les voyages passés. Pour quelques mois d’études ou de travail, annulez et ajoutez plutôt un domicile temporaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva entrambe se si tratta davvero di una seconda casa, ad esempio una casa estiva o invernale. L’arrivo in una delle due conclude il viaggio. Sostituiscila in caso di trasloco: la vecchia casa resterà nella cronologia dei viaggi passati. Per qualche mese di studio o lavoro, annulla e aggiungi invece una casa temporanea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夏の家や冬の家など、実際に2つ目の自宅である場合は両方を保持します。どちらかに到着すると旅行が終了します。引っ越した場合は置き換えてください。以前の自宅は過去の旅行履歴に残ります。数か月間の留学や仕事の場合は、キャンセルして代わりに仮の自宅を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여름 별장이나 겨울 별장처럼 실제로 두 번째 집이라면 두 곳 모두 유지하세요. 어느 집에 도착하든 여행이 종료돼요. 이사했다면 교체하세요. 이전 집은 과거 여행 기록에 남아요. 몇 달간 공부하거나 일하는 곳이라면 취소하고 대신 임시 거주지를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold begge hvis dette faktisk er et hjem nummer to, for eksempel et sommer- eller vinterhus. Når du ankommer ett av dem, avsluttes reisen. Erstatt hvis du har flyttet. Det gamle hjemmet blir værende i historikken for tidligere reiser. Gjelder det noen måneder med studier eller jobb, avbryter du og legger til et midlertidig hjem i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoud beide als dit echt een tweede thuis is, zoals een zomer- of winterhuis. Aankomst bij een van beide beëindigt een reis. Vervang de locatie als je bent verhuisd; de oude thuislocatie blijft in je geschiedenis voor eerdere reizen. Annuleer voor een paar maanden studie of werk en voeg in plaats daarvan een tijdelijk thuis toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ambas se esta for realmente uma segunda casa, como uma casa de verão ou de inverno. Chegar a qualquer uma encerra uma viagem. Substitua se você se mudou; a casa antiga permanece no histórico das viagens anteriores. Para alguns meses de estudo ou trabalho, cancele e adicione uma casa temporária em vez disso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ambas se for realmente uma segunda residência, como uma casa de verão ou de inverno. Chegar a qualquer uma termina uma viagem. Substitua a residência se tiver mudado de casa; a anterior permanece no histórico das viagens passadas. Para alguns meses de estudo ou trabalho, cancele e adicione uma casa temporária em vez disso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåll båda om detta verkligen är ett andra hem, till exempel ett sommar- eller vinterhus. En resa avslutas när du anländer till något av dem. Ersätt om du har flyttat. Det gamla hemmet finns kvar i historiken för tidigare resor. Gäller det några månaders studier eller arbete avbryter du och lägger till ett tillfälligt hem i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burası yazlık veya kışlık ev gibi gerçekten ikinci ev bölgenizse ikisini de tutun. İkisinden birine varmak seyahati sonlandırır. Taşındıysanız değiştirin; eski ev bölgesi geçmiş seyahatleriniz için geçmişinizde kalır. Birkaç ay sürecek eğitim veya iş içinse vazgeçip bunun yerine geçici ev bölgesi ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ cả hai nếu đây thực sự là nhà thứ hai, chẳng hạn nhà mùa hè hoặc mùa đông. Đến một trong hai nhà sẽ kết thúc chuyến đi. Hãy thay thế nếu bạn đã chuyển nhà; nhà cũ vẫn được lưu trong lịch sử cho các chuyến đi trước. Nếu chỉ học tập hoặc làm việc vài tháng, hãy hủy và thêm nhà tạm thời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果这确实是第二常住地，例如避暑或避寒住所，请保留两者。抵达其中任一地点都会结束旅程。如果您已经搬家，请替换；旧常住地仍会保留在过往旅程的历史中。如果只是学习或工作几个月，请取消并改为添加暂住地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果這確實是第二居住地，例如避暑或避寒住所，請保留兩者。抵達其中任一地點都會結束旅程。如果您已經搬家，請取代；舊居住地仍會保留在過往旅程的歷史中。如果只是學習或工作幾個月，請取消並改為加入暫住地。"
          }
        }
      }
    },
