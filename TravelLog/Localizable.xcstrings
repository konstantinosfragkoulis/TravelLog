    "trip-share.error.changed" : {
      "comment" : "Share error when the chosen trips, the user's homes or their dates changed while the share sheet was open; nothing was shared and the preview now shows the current trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine rejser eller hjem blev ændret, mens dette var åbent. Se den opdaterede forhåndsvisning, og del igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Reisen oder Wohnorte haben sich geändert, während dies geöffnet war. Prüfen Sie die aktualisierte Vorschau und teilen Sie dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια ή τα σπίτια σας άλλαξαν όσο ήταν ανοιχτό αυτό. Ελέγξτε την ενημερωμένη προεπισκόπηση και κοινοποιήστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
