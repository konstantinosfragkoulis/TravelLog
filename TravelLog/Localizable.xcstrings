          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retome para continuar a analisar a sua fototeca ou descarte os resultados parciais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt för att skanna vidare i bildbiblioteket eller kasta delresultaten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf arşivinizi taramaya devam etmek için Sürdür'e, kısmi sonuçları atmak için At'a dokunun."
