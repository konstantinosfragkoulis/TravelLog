    "root.storage-error.detail" : {
      "comment" : "Full-screen explanation when the persistent store is preserved but unavailable for the current session.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine gemte rejsedata er sikre, men utilgængelige i denne session. Genstart Travel Log, eller frigør lagerplads, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre gespeicherten Reisedaten sind sicher, stehen in dieser Sitzung aber nicht zur Verfügung. Starten Sie Travel Log neu oder geben Sie Speicherplatz frei und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αποθηκευμένα δεδομένα των ταξιδιών σου είναι ασφαλή, αλλά δεν είναι διαθέσιμα για αυτήν τη συνεδρία. Κλείσε και άνοιξε ξανά το Travel Log ή ελευθέρωσε χώρο αποθήκευσης και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved travel data is safe but unavailable for this session. Restart Travel Log or free up storage, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de sus viajes guardados están seguros, pero no están disponibles en esta sesión. Reinicie Travel Log o libere espacio de almacenamiento e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de voyage que vous avez enregistrées sont en sécurité, mais indisponibles pour cette session. Redémarrez Travel Log ou libérez de l’espace de stockage, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati dei viaggi salvati sono al sicuro, ma non sono disponibili per questa sessione. Riavvia Travel Log o libera spazio di archiviazione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの旅行データは安全ですが、このセッションでは利用できません。Travel Logを再起動するか、ストレージの空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 여행 데이터는 안전하지만 이번 세션에서는 사용할 수 없어요. Travel Log를 다시 시작하거나 저장 공간을 확보한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lagrede reisedataene dine er trygge, men utilgjengelige i denne økten. Start Travel Log på nytt eller frigjør lagringsplass, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opgeslagen reisgegevens zijn veilig, maar niet beschikbaar in deze sessie. Start Travel Log opnieuw of maak opslagruimte vrij en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados das suas viagens salvos estão seguros, mas não estão disponíveis nesta sessão. Reinicie o Travel Log ou libere espaço de armazenamento e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados das suas viagens guardados estão seguros, mas não estão disponíveis nesta sessão. Reinicie o Travel Log ou liberte espaço de armazenamento e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina sparade resedata är säkra, men inte tillgängliga under den här sessionen. Starta om Travel Log eller frigör lagringsutrymme och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmiş seyahat verileriniz güvende ancak bu oturumda kullanılamıyor. Travel Log uygulamasını yeniden başlatın veya depolama alanında yer açın, ardından yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu chuyến đi đã lưu của bạn vẫn an toàn nhưng không khả dụng trong phiên này. Khởi động lại Travel Log hoặc giải phóng dung lượng lưu trữ, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您保存的旅行数据是安全的，但在本次会话中无法使用。请重新启动 Travel Log 或释放存储空间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您儲存的旅行資料是安全的，但在本次階段中無法使用。請重新啟動 Travel Log 或釋放儲存空間，然後再試一次。"
          }
        }
      }
    },
