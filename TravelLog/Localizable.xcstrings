    "temporary-home.form.changes.trips-split.favorite.one" : {
      "comment" : "Temporary home preview line right after the line about one favorited trip it will split: the trip leaves Favorites, and its favorite is kept with its copy in Removed Trips (a screen in Settings), not moved to the new trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens favoritmarkering bliver hos kopien i Fjernede rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Markierung als Favorit bleibt bei der Kopie unter „Entfernte Reisen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σήμανση ως αγαπημένο μένει στο αντίγραφο στα Αφαιρεμένα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Its favorite status stays with the copy in Removed Trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su marca de favorito se queda con la copia en Viajes eliminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son statut de favori reste avec la copie dans Voyages supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo stato di preferito resta con la copia in Viaggi rimossi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りは「削除された旅行」のコピーに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기는 삭제된 여행의 사본에 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorittmarkeringen blir værende på kopien i Fjernede reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De markering als favoriet blijft bij de kopie in Verwijderde reizen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A marcação de favorito fica com a cópia em Viagens removidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A marcação de favorito fica com a cópia em Viagens removidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritmarkeringen följer med kopian i Borttagna resor."
          }
        },
        "tr" : {
