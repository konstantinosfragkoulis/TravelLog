    "No pings recorded yet. Move around and pings will appear here as your phone detects cell tower changes." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er endnu ikke registreret nogen positionsmålinger. Bevæg dig rundt, så vises de her, når din telefon registrerer skift mellem mobilmaster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Pings aufgezeichnet. Wenn Sie sich bewegen, erscheinen hier Pings, sobald Ihr Telefon Funkzellenwechsel erkennt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχουν καταγραφεί σήματα ακόμα. Καθώς μετακινείσαι, θα εμφανίζονται εδώ όταν το τηλέφωνό σου εντοπίζει αλλαγές κεραιών κινητής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No pings recorded yet. Move around and pings will appear here as your phone detects cell tower changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay registros. Al desplazarse, aparecerán aquí cuando el teléfono detecte cambios de antena móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun relevé enregistré pour le moment. Déplacez-vous : les relevés apparaîtront ici à mesure que votre téléphone détectera les changements d’antenne-relais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun rilevamento. Muovendoti, i rilevamenti appariranno qui quando il telefono individua cambi di cella telefonica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報はまだ記録されていません。移動すると、携帯電話が基地局の切り替わりを検出してここに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 기록된 위치 신호가 없어요. 이동하면 휴대전화가 기지국 변경을 감지할 때마다 위치 신호가 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen posisjoner er registrert ennå. Beveg deg rundt, så vises de her når telefonen oppdager endringer i mobilmaster."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen pings vastgelegd. Verplaats je en hier verschijnen pings wanneer je telefoon veranderingen van zendmast detecteert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum sinal registrado ainda. Ao se deslocar, os sinais aparecerão aqui quando o telefone detectar mudanças de antena de celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há sinais registados. Desloque-se e os sinais aparecerão aqui quando o telemóvel detetar alterações das antenas da rede móvel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga platspunkter har registrerats än. När du rör dig visas punkter här när telefonen upptäcker byten av mobilmast."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz konum sinyali kaydedilmedi. Hareket ettikçe telefonunuz baz istasyonu değişikliklerini algılar ve sinyaller burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa ghi nhận tín hiệu vị trí nào. Hãy di chuyển và chúng sẽ xuất hiện tại đây khi điện thoại phát hiện thay đổi trạm phát sóng di động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未记录位置点。移动时，手机检测到基站变化后，位置点会显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未記錄位置點。移動時，手機偵測到基地台變化後，位置點會顯示在這裡。"
          }
        }
      }
    },
