    "home-area.removed-trips.forget.message.restore" : {
      "comment" : "Message of the confirmation before the device-local copy of a trip removed when its places became part of the home area is deleted from Removed Trips; Restore is the row's button.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke længere gendanne den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können sie dann nicht mehr wiederherstellen."
