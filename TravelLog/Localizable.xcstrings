    },
    "temporary-home.remove.confirmation.message" : {
      "comment" : "Message of the confirmation shown before a temporary home is removed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
