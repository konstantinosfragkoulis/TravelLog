    "temporary-home.form.changes.stays-joining.one" : {
      "comment" : "Temporary home preview line for one existing stay that will count as time at the temporary home.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ophold bliver til tid i dette midlertidige hjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Aufenthalt zählt künftig zu diesem Zuhause auf Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ παραμονή θα μετρά ως χρόνος σε αυτό το προσωρινό σπίτι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ stay becomes time at this temporary home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estancia pasa a contar como tiempo en esta residencia temporal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ séjour devient du temps passé à ce domicile temporaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ soggiorno diventa tempo trascorso in questa casa temporanea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@件の滞在が、この仮の自宅で過ごした時間になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체류 %@개가 이 임시 거주지에서 보낸 시간이 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ opphold blir tid i dette midlertidige hjemmet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verblijf wordt tijd in dit tijdelijke thuis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estadia passa a contar como tempo nesta casa temporária."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ estadia passa a contar como tempo nesta casa temporária."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vistelse blir tid i det här tillfälliga hemmet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konaklama bu geçici ev bölgesinde geçirilen süre sayılacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lần lưu trú sẽ được tính là thời gian ở nhà tạm thời này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个停留将计为在此暂住地的时间。"
          }
        },
