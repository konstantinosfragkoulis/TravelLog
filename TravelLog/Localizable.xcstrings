    "collections.flight-detail.evidence.across-water" : {
      "comment" : "Flight detail evidence: the ends are on different islands, or an island and the mainland, and the time between them is shorter than a ferry needs.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du krydsede mellem øer, eller en ø og fastlandet, hurtigere end en færge sejler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind zwischen Inseln oder einer Insel und dem Festland gereist, schneller als eine Fähre fährt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πέρασες από νησί σε νησί, ή από νησί στη στεριά, πιο γρήγορα απ’ ό,τι ταξιδεύει ένα φέρι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You crossed between islands, or an island and the mainland, faster than a ferry sails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzaste entre islas, o entre una isla y el continente, más rápido de lo que navega un ferri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez traversé entre des îles, ou entre une île et le continent, plus vite qu’un ferry."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai attraversato tra isole, o tra un’isola e la terraferma, più veloce di un traghetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "島と島、または島と本土の間を、フェリーより速く移動しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "섬과 섬, 또는 섬과 육지 사이를 페리보다 빠르게 건넜어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du krysset mellom øyer, eller en øy og fastlandet, raskere enn en ferje seiler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je stak over tussen eilanden, of een eiland en het vasteland, sneller dan een veerboot vaart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você atravessou entre ilhas, ou entre uma ilha e o continente, mais rápido do que uma balsa navega."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atravessou entre ilhas, ou entre uma ilha e o continente, mais rápido do que um ferry navega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du korsade mellan öar, eller en ö och fastlandet, snabbare än en färja seglar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adalar arasında ya da bir adayla anakara arasında, bir feribotun gidebileceğinden hızlı geçtiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đi giữa các đảo, hoặc giữa đảo và đất liền, nhanh hơn tốc độ của phà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你往返于岛屿之间，或岛屿与大陆之间，速度比渡轮还快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你往返於島嶼之間，或島嶼與大陸之間，速度比渡輪還快。"
          }
        }
      }
    },
    "collections.flight-detail.evidence.long-gap" : {
      "comment" : "Flight detail evidence: a long distance and a long time with no location between the two places, so a flight is likely but unproven.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lang vej, med lang tid og ingen placering imellem: du er måske fløjet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine weite Strecke, viel Zeit und kein Standort dazwischen: Vielleicht sind Sie geflogen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μεγάλη απόσταση, πολύς χρόνος και καμία τοποθεσία ενδιάμεσα: ίσως πέταξες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A long way, with a long time and no location in between: you may have flown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mucha distancia, mucho tiempo y ninguna ubicación entre medias: quizá volaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une longue distance, beaucoup de temps et aucune position entre les deux : vous avez peut-être pris l’avion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molta strada, molto tempo e nessuna posizione nel mezzo: forse hai volato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い距離と長い時間があり、その間の位置情報がありません。飛行機で移動した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼 거리와 긴 시간 동안 그 사이 위치가 없어요. 비행기를 탔을 수도 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lang vei, med lang tid og ingen posisjon imellom: du har kanskje fløyet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een lange afstand, veel tijd en geen locatie ertussen: misschien ben je gevlogen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma longa distância, muito tempo e nenhuma localização no meio: talvez você tenha voado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma longa distância, muito tempo e nenhuma localização pelo meio: talvez tenha voado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En lång väg, lång tid och ingen plats däremellan: du kanske flög."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun bir yol, uzun bir süre ve arada konum yok: uçmuş olabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quãng đường dài, thời gian dài và không có vị trí nào ở giữa: có thể bạn đã bay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距离很远，时间很长，中间没有任何位置记录：你可能乘坐了飞机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離很遠，時間很長，中間沒有任何位置記錄：你可能搭乘了飛機。"
          }
        }
      }
    },
    "collections.flight-detail.evidence.seen-in-air" : {
