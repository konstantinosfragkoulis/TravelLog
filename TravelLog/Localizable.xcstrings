        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスが必要です。「iOS設定」→「プライバシー」→「写真」→「TravelLog」でアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
