    "app-intent.where-was-i.description" : {
      "comment" : "Where Was I date-range action and result text.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæller dig ud fra din rejsedagbog, hvor du var på en bestemt dato eller i en periode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informiert Sie anhand Ihres Reisetagebuchs, wo Sie an einem Datum oder in einem Zeitraum waren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σου λέει πού βρισκόσουν σε μια ημερομηνία ή σε ένα χρονικό διάστημα, βάσει του ταξιδιωτικού σου ημερολογίου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you where you were on a date or during a date range, from your travel journal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica dónde estaba en una fecha o durante un intervalo de fechas, según su diario de viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique où vous étiez à une date ou pendant une période, d’après votre journal de voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica dove ti trovavi in una data o durante un intervallo di date, in base al tuo diario di viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行ジャーナルを基に、指定した日付や期間にいた場所を案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 일지를 바탕으로 특정 날짜나 기간에 있었던 곳을 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forteller deg hvor du var på en dato eller i en periode, basert på reisedagboken din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertelt je aan de hand van je reisdagboek waar je op een datum of in een periode was."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa onde você estava em uma data ou durante um intervalo de datas, com base no seu diário de viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica onde esteve numa data ou durante um intervalo de datas, com base no seu diário de viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berättar var du var ett visst datum eller under en period utifrån din resedagbok."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahat günlüğünüze göre bir tarihte veya tarih aralığında nerede olduğunuzu söyler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho bạn biết bạn đã ở đâu vào một ngày hoặc trong một khoảng ngày, dựa trên nhật ký du lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据旅行日志告知您在某个日期或日期范围内去过哪里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據旅行日誌告知您在某個日期或日期範圍內去過哪裡。"
          }
        }
      }
    },
