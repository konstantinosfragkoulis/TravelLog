    "Ongoing trips don't match any duration bucket. Clear the filter to see them." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igangværende rejser passer ikke i nogen varighedskategori. Ryd filteret for at se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende Reisen passen in keine Dauergruppe. Leeren Sie den Filter, um sie zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια σε εξέλιξη δεν αντιστοιχούν σε καμία κατηγορία διάρκειας. Κατάργησε το φίλτρο για να τα δεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ongoing trips don't match any duration bucket. Clear the filter to see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes en curso no pertenecen a ningún intervalo de duración. Borre el filtro para verlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voyages en cours ne correspondent à aucune catégorie de durée. Effacez le filtre pour les afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi in corso non rientrano in nessun intervallo di durata. Rimuovi il filtro per vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中の旅行はどの期間区分にも一致しません。表示するにはフィルタを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중인 여행은 기간 범주에 포함되지 않아요. 필터를 지우면 볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pågående reiser passer ikke i noen varighetskategori. Tøm filteret for å se dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopende reizen vallen niet in een duurcategorie. Wis het filter om ze te zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viagens em andamento não correspondem a nenhuma faixa de duração. Limpe o filtro para vê-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens em curso não correspondem a qualquer intervalo de duração. Limpe o filtro para as ver."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pågående resor matchar inget längdintervall. Rensa filtret för att se dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süren seyahatler hiçbir süre grubuyla eşleşmez. Görmek için filtreyi temizleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyến đi đang diễn ra không thuộc khoảng thời lượng nào. Xóa bộ lọc để xem chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进行中的旅程不符合任何时长类别。清除筛选即可查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中的旅程不符合任何時長類別。清除篩選即可查看。"
          }
        }
      }
    },
    "Only “While Using” granted" : {
      "localizations" : {
