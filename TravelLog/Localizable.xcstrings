    },
    "Tap to retry from the last checkpoint. Existing data is preserved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at prøve igen fra det seneste kontrolpunkt. Eksisterende data bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie, um es ab dem letzten Prüfpunkt erneut zu versuchen. Vorhandene Daten bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε για νέα προσπάθεια από το τελευταίο σημείο ελέγχου. Τα υπάρχοντα δεδομένα διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap to retry from the last checkpoint. Existing data is preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para reintentar desde el último punto de control. Los datos existentes se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour reprendre au dernier point de contrôle. Les données existantes sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per riprovare dall’ultimo punto di controllo. I dati esistenti verranno conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のチェックポイントから再試行するにはタップします。既存のデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하여 마지막 체크포인트부터 다시 시도하세요. 기존 데이터는 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å prøve igjen fra siste kontrollpunkt. Eksisterende data beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om opnieuw te proberen vanaf het laatste controlepunt. Bestaande gegevens blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para tentar novamente a partir do último ponto de controle. Os dados existentes serão preservados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para tentar novamente a partir do último ponto de controlo. Os dados existentes serão preservados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att försöka igen från den senaste kontrollpunkten. Befintliga data behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son kontrol noktasından yeniden denemek için dokunun. Mevcut veriler korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để thử lại từ điểm kiểm tra gần nhất. Dữ liệu hiện có được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
