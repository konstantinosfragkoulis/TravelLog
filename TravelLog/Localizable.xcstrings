          }
        }
      }
    },
    "temporary-home.remove.confirmation.message" : {
      "comment" : "Message of the confirmation shown before a temporary home is removed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log genopbygger denne periode som almindelige rejser. Rejser, du har redigeret, forbliver, som de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log erstellt diesen Zeitraum als gewöhnliche Reisen neu. Von Ihnen bearbeitete Reisen bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log θα ανακατασκευάσει αυτήν την περίοδο ως κανονικά ταξίδια. Τα ταξίδια που επεξεργάστηκες μένουν ως έχουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log will rebuild this period as ordinary trips. Trips you edited stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log reconstruirá este periodo como viajes normales. Los viajes que editó se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log reconstruira cette période sous forme de voyages ordinaires. Les voyages que vous avez modifiés restent tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log ricostruirà questo periodo come viaggi normali. I viaggi che hai modificato restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logはこの期間を通常の旅行として再構築します。編集した旅行はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log가 이 기간을 일반 여행으로 다시 구성해요. 편집한 여행은 그대로 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log bygger opp denne perioden på nytt som vanlige reiser. Reiser du har redigert, forblir som de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log bouwt deze periode opnieuw op als gewone reizen. Reizen die je hebt gewijzigd, blijven zoals ze zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log reconstruirá este período como viagens comuns. As viagens que você editou permanecem como estão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log irá reconstruir este período como viagens normais. As viagens que editou permanecem como estão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log återskapar den här perioden som vanliga resor. Resor du har redigerat förblir som de är."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log bu dönemi olağan seyahatler olarak yeniden oluşturur. Düzenlediğiniz seyahatler olduğu gibi kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log sẽ dựng lại giai đoạn này thành các chuyến đi thông thường. Những chuyến đi bạn đã sửa vẫn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 会将这段时间重建为普通旅程。您编辑过的旅程保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 會將這段時間重建為一般旅程。您編輯過的旅程維持不變。"
          }
        }
      }
    },
