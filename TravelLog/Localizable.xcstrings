    "A new title couldn't be generated right now. Try again in a moment." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kunne ikke oprettes en ny titel lige nu. Prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derzeit konnte kein neuer Titel erstellt werden. Versuchen Sie es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η δημιουργία νέου τίτλου αυτήν τη στιγμή. Δοκίμασε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A new title couldn't be generated right now. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo generar un título nuevo ahora. Inténtelo de nuevo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de générer un nouveau titre pour le moment. Réessayez dans quelques instants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile generare un nuovo titolo ora. Riprova tra un momento."
