    "This device doesn't allow Travel Log to request location access, possibly due to parental controls or a management profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed tillader ikke, at Travel Log anmoder om adgang til lokalitet, muligvis på grund af børnesikring eller en administrationsprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät erlaubt Travel Log nicht, Standortzugriff anzufordern. Mögliche Gründe sind Kindersicherungen oder ein Verwaltungsprofil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν επιτρέπει στο Travel Log να ζητήσει πρόσβαση στην τοποθεσία, πιθανώς λόγω γονικού ελέγχου ή προφίλ διαχείρισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This device doesn't allow Travel Log to request location access, possibly due to parental controls or a management profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no permite que Travel Log solicite acceso a la ubicación, posiblemente por controles parentales o un perfil de gestión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’autorise pas Travel Log à demander l’accès à la localisation, peut-être en raison du contrôle parental ou d’un profil de gestion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non consente a Travel Log di richiedere l’accesso alla posizione, forse a causa dei controlli parentali o di un profilo di gestione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロールまたは管理プロファイルにより、このデバイスではTravel Logが位置情報へのアクセスを要求できない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서는 Travel Log가 위치 접근을 요청할 수 없어요. 유해 콘텐츠 차단 또는 관리 프로파일 때문일 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten tillater ikke at Travel Log ber om stedstilgang, muligens på grunn av foreldrekontroll eller en administrasjonsprofil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat staat niet toe dat Travel Log om locatietoegang vraagt, mogelijk door ouderlijk toezicht of een beheerprofiel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não permite que o Travel Log solicite acesso à localização, possivelmente devido a controles parentais ou a um perfil de gerenciamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não permite que o Travel Log solicite acesso à localização, possivelmente devido a controlo parental ou a um perfil de gestão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten tillåter inte att Travel Log begär platsåtkomst, möjligen på grund av föräldrakontroller eller en hanteringsprofil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıt, muhtemelen ebeveyn denetimleri veya yönetim profili nedeniyle Travel Log'un konum erişimi istemesine izin vermiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này không cho phép Travel Log yêu cầu quyền truy cập vị trí, có thể do kiểm soát của phụ huynh hoặc hồ sơ quản lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备不允许 Travel Log 请求位置访问权限，可能是因为家长控制或管理描述文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置不允許 Travel Log 請求位置取用權限，可能是因為家長控制或管理描述檔。"
          }
        }
      }
    },
    "This photo isn't available right now. It may still be downloading from iCloud." : {
      "localizations" : {
        "da" : {
