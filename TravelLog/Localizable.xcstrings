          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下可從上一個檢查點重試。現有資料會保留。"
          }
        }
      }
    },
    "Tells you the next upcoming trip detected from your calendar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæller dig om den næste kommende rejse, der registreres i din kalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informiert Sie über die nächste bevorstehende Reise, die in Ihrem Kalender erkannt wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
