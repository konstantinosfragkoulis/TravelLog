    "shared-trip.result.partial" : {
      "comment" : "Shared trip result when a later batch failed to save.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun en del af denne rejse kunne gemmes. Det er sikkert at åbne filen igen, og så tilføjes resten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Teil dieser Reise konnte gesichert werden. Sie können die Datei gefahrlos erneut öffnen, um den Rest hinzuzufügen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο μέρος αυτού του ταξιδιού αποθηκεύτηκε. Μπορείτε με ασφάλεια να ανοίξετε ξανά το αρχείο για να προστεθεί το υπόλοιπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only part of this trip could be saved. Opening the file again is safe and adds the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se ha podido guardar parte de este viaje. Puedes volver a abrir el archivo sin problema para añadir el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule une partie de ce voyage a pu être enregistrée. Vous pouvez rouvrir le fichier sans risque pour ajouter le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È stato possibile salvare solo una parte di questo viaggio. Puoi riaprire il file in sicurezza per aggiungere il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行の一部しか保存できませんでした。ファイルをもう一度開いても問題なく、残りが追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행의 일부만 저장할 수 있었습니다. 파일을 다시 열어도 안전하며 나머지가 추가됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare en del av denne reisen kunne lagres. Det er trygt å åpne filen igjen, og da legges resten til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slechts een deel van deze reis kon worden bewaard. Je kunt het bestand veilig opnieuw openen om de rest toe te voegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só foi possível salvar parte desta viagem. Abrir o arquivo de novo é seguro e adiciona o restante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só foi possível guardar parte desta viagem. Abrir o ficheiro novamente é seguro e adiciona o resto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara en del av den här resan kunde sparas. Det är säkert att öppna filen igen, och då läggs resten till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahatin yalnızca bir kısmı kaydedilebildi. Dosyayı yeniden açmak güvenlidir ve kalanını ekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ lưu được một phần của chuyến đi này. Mở lại tệp là an toàn và sẽ thêm phần còn lại."
          }
        },
        "zh-Hans" : {
