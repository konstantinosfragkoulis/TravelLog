    "temporary-home.detail.split-trips.footer" : {
      "comment" : "Footer of the temporary home detail section listing the trips that setting it up, or a later change to it, split; explains its Keep as One Trip buttons and that the copies they restore from live on this device only.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse rejser blev delt af en ændring af dette midlertidige hjem. Behold som én rejse kan samle en rejse igen. Kopierne gemmes kun på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Reisen wurden durch eine Änderung an diesem Zuhause auf Zeit aufgeteilt. „Als eine Reise behalten“ kann eine Reise wieder zusammenfügen. Kopien werden nur auf diesem Gerät aufbewahrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα ταξίδια χωρίστηκαν από μια αλλαγή σε αυτό το προσωρινό σπίτι. Η Διατήρηση ως ένα ταξίδι μπορεί να ενώσει ξανά ένα ταξίδι. Τα αντίγραφα φυλάσσονται μόνο σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These trips were split by a change to this temporary home. Keep as One Trip can put a trip back together. Copies are kept on this device only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos viajes se dividieron por un cambio en esta residencia temporal. Mantener como un solo viaje puede volver a unir un viaje. Las copias se guardan solo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces voyages ont été séparés par une modification de ce domicile temporaire. Garder en un seul voyage peut réunir un voyage. Les copies sont conservées uniquement sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi viaggi sono stati divisi da una modifica a questa casa temporanea. Mantieni come un unico viaggio può riunire un viaggio. Le copie restano solo su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの旅行は、この仮の自宅の変更によって分割されました。「1つの旅行として残す」で元の1つの旅行に戻せる場合があります。コピーはこのデバイスにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행들은 이 임시 거주지의 변경으로 나뉘었어요. 하나의 여행으로 유지로 여행을 다시 합칠 수 있어요. 사본은 이 기기에만 보관돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse reisene ble delt av en endring i dette midlertidige hjemmet. Behold som én reise kan sette sammen en reise igjen. Kopiene lagres bare på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reizen zijn gesplitst door een wijziging aan dit tijdelijke thuis. Bewaar als één reis kan een reis weer samenvoegen. Kopieën worden alleen op dit apparaat bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens foram divididas por uma alteração nesta casa temporária. Manter como uma única viagem pode juntar a viagem de novo. As cópias ficam só neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens foram divididas por uma alteração nesta casa temporária. Manter como uma única viagem pode voltar a juntar a viagem. As cópias ficam apenas neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här resorna delades av en ändring av det här tillfälliga hemmet. Behåll som en resa kan sätta ihop en resa igen. Kopiorna sparas bara på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahatler, bu geçici ev bölgesinde yapılan bir değişiklikle bölündü. Tek Seyahat Olarak Koru, seyahati yeniden birleştirebilir. Kopyalar yalnızca bu aygıtta tutulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những chuyến đi này đã được tách do một thay đổi ở nhà tạm thời này. Giữ thành một chuyến đi có thể ghép chuyến đi lại. Bản sao chỉ được giữ trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
