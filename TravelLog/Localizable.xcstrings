          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện không thể truy cập ảnh này. Ảnh có thể vẫn đang được tải xuống từ iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
