      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din historik kunne ikke læses lige nu, så intet blev tilføjet. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Verlauf konnte gerade nicht gelesen werden, daher wurde nichts hinzugefügt. Versuchen Sie es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του ιστορικού σας αυτή τη στιγμή, οπότε δεν προστέθηκε τίποτα. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your history couldn't be read just now, so nothing was added. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer tu historial en este momento, así que no se ha añadido nada. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique n’a pas pu être lu pour le moment, rien n’a donc été ajouté. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è stato possibile leggere la cronologia, quindi non è stato aggiunto nulla. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在履歴を読み込めないため、何も追加されませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 기록을 읽을 수 없어 아무것도 추가되지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historikken din kunne ikke leses akkurat nå, så ingenting ble lagt til. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je geschiedenis kon nu niet worden gelezen, dus er is niets toegevoegd. Probeer het zo opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler seu histórico agora, então nada foi adicionado. Tente novamente em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o seu histórico neste momento, por isso nada foi adicionado. Tente novamente daqui a pouco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din historik kunde inte läsas just nu, så inget lades till. Försök igen om en stund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmişiniz şu anda okunamadı, bu yüzden hiçbir şey eklenmedi. Biraz sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc lịch sử của bạn lúc này nên không có gì được thêm. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法读取你的历史记录，因此未添加任何内容。请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫時無法讀取你的歷史記錄，因此未加入任何內容。請稍後再試。"
          }
        }
      }
    },
