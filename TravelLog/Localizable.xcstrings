    "Country Welcome notifies you when you arrive in a foreign country. Welcome Home notifies you when you return from a trip lasting at least one day." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkomst til land giver dig besked, når du ankommer til et andet land. Velkommen hjem giver dig besked, når du vender hjem fra en rejse, der varede mindst én dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Länderbegrüßung“ benachrichtigt Sie bei der Ankunft in einem anderen Land. „Willkommen zu Hause“ benachrichtigt Sie, wenn Sie von einer mindestens eintägigen Reise zurückkehren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Καλωσόρισμα σε χώρα σε ειδοποιεί όταν φτάνεις σε ξένη χώρα. Το Καλώς ήρθες σπίτι σε ειδοποιεί όταν επιστρέφεις από ταξίδι διάρκειας τουλάχιστον μίας ημέρας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Country Welcome notifies you when you arrive in a foreign country. Welcome Home notifies you when you return from a trip lasting at least one day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenida al país le avisa al llegar a otro país. Bienvenido a casa le avisa al regresar de un viaje de al menos un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Bienvenue dans le pays » vous avertit à votre arrivée à l’étranger. « Bon retour » vous avertit lorsque vous revenez d’un voyage d’au moins un jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benvenuto nel paese invia una notifica all’arrivo all’estero. Bentornato a casa invia una notifica al ritorno da un viaggio durato almeno un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「海外到着のお知らせ」は外国に到着したときに通知します。「おかえりなさい」は1日以上の旅行から戻ったときに通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가 도착 알림은 외국에 도착하면 알려 줘요. 귀가 알림은 하루 이상 여행한 뒤 집에 돌아오면 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen til landet varsler deg når du ankommer et annet land. Velkommen hjem varsler deg når du kommer tilbake fra en reise som varte i minst én dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welkom in land meldt het wanneer je in een ander land aankomt. Welkom thuis meldt het wanneer je terugkomt van een reis van minstens één dag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boas-vindas ao país avisa quando você chega a outro país. Boas-vindas de volta avisa quando você retorna de uma viagem de pelo menos um dia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boas-vindas ao país envia uma notificação quando chega a outro país. Boas-vindas de volta envia uma notificação quando regressa de uma viagem com pelo menos um dia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välkomsthälsning meddelar dig när du anländer till ett annat land. Välkommen hem meddelar dig när du återvänder från en resa som varat minst en dag."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ülkeye Hoş Geldiniz, yabancı bir ülkeye vardığınızda bildirim gönderir. Eve Hoş Geldiniz ise en az bir gün süren bir seyahatten döndüğünüzde bildirim gönderir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng Chào mừng đến quốc gia sẽ thông báo khi bạn đến một quốc gia khác. Chào mừng về nhà sẽ thông báo khi bạn trở về từ chuyến đi kéo dài ít nhất một ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“抵达国家/地区欢迎通知”会在您抵达外国时提醒您；“欢迎回家”会在您结束至少一天的旅程回家时提醒您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「抵達國家或地區歡迎通知」會在您抵達外國時提醒您；「歡迎回家」會在您結束至少一天的旅程回家時提醒您。"
          }
        }
      }
    },
