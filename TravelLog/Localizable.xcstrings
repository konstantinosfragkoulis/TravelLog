    "A specific year, like 2025. Leave empty for lifetime stats." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bestemt år, f.eks. 2025. Lad feltet stå tomt for statistik for hele perioden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein bestimmtes Jahr, z. B. 2025. Für Gesamtstatistiken leer lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα συγκεκριμένο έτος, όπως το 2025. Άφησέ το κενό για στατιστικά όλων των ετών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A specific year, like 2025. Leave empty for lifetime stats."
