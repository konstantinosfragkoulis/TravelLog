    "Travel Log can't read events with add-only access. Choose Full Access in Settings. It still never changes your calendar." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan ikke læse begivenheder med adgang kun til tilføjelse. Vælg Fuld adgang i Indstillinger. Appen ændrer dog aldrig din kalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kann Ereignisse mit der Berechtigung „Nur Hinzufügen“ nicht lesen. Wählen Sie in den Einstellungen „Vollzugriff“. Ihr Kalender wird weiterhin niemals verändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log δεν μπορεί να διαβάσει συμβάντα με πρόσβαση μόνο για προσθήκη. Επίλεξε Πλήρη πρόσβαση στις Ρυθμίσεις. Εξακολουθεί να μην αλλάζει ποτέ το ημερολόγιό σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log can't read events with add-only access. Choose Full Access in Settings. It still never changes your calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log no puede leer eventos con acceso solo para añadir. Elija Acceso total en Ajustes. Aun así, nunca modifica su calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log ne peut pas lire les événements avec l’accès en ajout uniquement. Choisissez Accès complet dans Réglages. L’app ne modifiera jamais votre calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log non può leggere gli eventi con l’accesso di sola aggiunta. Scegli Accesso completo in Impostazioni. L’app non modifica comunque mai il calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加のみのアクセスではTravel Logはイベントを読み取れません。「設定」でフルアクセスを選択してください。カレンダーが変更されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log는 추가만 허용된 상태에서 이벤트를 읽을 수 없어요. 설정에서 전체 접근을 선택하세요. 캘린더는 절대 변경하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan ikke lese hendelser med tilgang kun for å legge til. Velg Full tilgang i Innstillinger. Appen endrer fortsatt aldri kalenderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan activiteiten niet lezen met toegang voor alleen toevoegen. Kies Volledige toegang in Instellingen. Je agenda wordt nog steeds nooit gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não pode ler eventos com acesso somente para adicionar. Escolha Acesso total em Ajustes. Ainda assim, ele nunca altera seu calendário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não consegue ler eventos com acesso apenas para adicionar. Selecione Acesso total em Definições. Nunca altera o seu calendário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan inte läsa händelser med åtkomst endast för att lägga till. Välj Full åtkomst i Inställningar. Appen ändrar fortfarande aldrig din kalender."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log yalnızca ekleme erişimiyle etkinlikleri okuyamaz. Ayarlar'da Tam Erişim'i seçin. Takviminizi yine hiçbir zaman değiştirmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log không thể đọc sự kiện với quyền chỉ thêm. Chọn Quyền truy cập đầy đủ trong Cài đặt. Ứng dụng vẫn không bao giờ thay đổi lịch của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅有添加权限时，Travel Log 无法读取日程。请在“设置”中选择“完全访问权限”。Travel Log 仍绝不会更改您的日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅有加入權限時，Travel Log 無法讀取行程。請在「設定」中選擇「完整取用權限」。它仍絕不會更改您的行事曆。"
          }
        }
      }
    },
    "Travel Log Needs a Home" : {
