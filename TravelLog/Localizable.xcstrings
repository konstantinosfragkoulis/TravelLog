    "temporary-home.form.location.edit-footer" : {
      "comment" : "Footer of the location section when editing a temporary home: a new pin applies to the whole period, so a real move should end this temporary home and add another one starting on the move date.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du ændrer placeringen, rettes den for alle dens datoer. Hvis du er flyttet, så afslut dette midlertidige hjem, og tilføj et nyt fra flyttedatoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Änderung des Orts korrigiert ihn für alle seine Daten. Wenn Sie umgezogen sind, beenden Sie dieses Zuhause auf Zeit und fügen Sie ab dem Umzugsdatum ein neues hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αλλαγή τοποθεσίας τη διορθώνει για όλες τις ημερομηνίες του. Αν μετακόμισες, λήξε αυτό το προσωρινό σπίτι και πρόσθεσε ένα νέο από την ημερομηνία της μετακόμισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changing the location corrects it for all its dates. If you moved, end this temporary home and add a new one from the move date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar la ubicación, se corrige para todas sus fechas. Si se mudó, finalice esta residencia temporal y añada una nueva desde la fecha de la mudanza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le lieu le corrige pour toutes ses dates. Si vous avez déménagé, terminez ce domicile temporaire et ajoutez-en un nouveau à partir de la date du déménagement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare il luogo lo corregge per tutte le sue date. Se ti sei trasferito, termina questa casa temporanea e aggiungine una nuova dalla data del trasloco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所を変更すると、すべての期間の場所が修正されます。引っ越した場合は、この仮の自宅を終了し、引っ越した日から新しい仮の自宅を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 변경하면 모든 날짜에 대해 위치가 수정돼요. 이사했다면 이 임시 거주지를 종료하고 이사한 날부터 새 임시 거주지를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du endrer stedet, rettes det for alle datoene. Hvis du har flyttet, avslutter du dette midlertidige hjemmet og legger til et nytt fra flyttedatoen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de locatie wijzigt, geldt die wijziging voor de hele periode. Ben je verhuisd, beëindig dan dit tijdelijke thuis en voeg een nieuw thuis toe vanaf de verhuisdatum."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o local o corrige em todas as datas. Se você se mudou, encerre esta casa temporária e adicione uma nova a partir da data da mudança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o local corrige-o em todas as datas. Se se mudou, termine esta casa temporária e adicione uma nova a partir da data da mudança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du ändrar platsen rättas den för alla datum. Om du har flyttat avslutar du det här tillfälliga hemmet och lägger till ett nytt från flyttdatumet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumu değiştirmek, onu tüm tarihleri için düzeltir. Taşındıysanız bu geçici ev bölgesini sonlandırın ve taşınma tarihinden itibaren yeni bir tane ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi vị trí sẽ sửa vị trí cho tất cả các ngày của nhà tạm thời này. Nếu bạn đã chuyển đi, hãy kết thúc nhà tạm thời này và thêm một nhà mới từ ngày chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改位置会更正其所有日期的位置。如果您已搬家，请结束此暂住地，并从搬家日期起添加新的暂住地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改位置會更正其所有日期的位置。如果您已搬家，請結束此暫住地，並從搬家日期起新增新的暫住地。"
          }
        }
      }
    },
