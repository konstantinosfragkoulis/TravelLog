    "Photos you remove from this trip will appear here so you can restore them later." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billeder, du fjerner fra denne rejse, vises her, så du kan gendanne dem senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die Sie aus dieser Reise entfernen, erscheinen hier und können später wiederhergestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι φωτογραφίες που αφαιρείς από αυτό το ταξίδι θα εμφανίζονται εδώ, ώστε να μπορείς να τις επαναφέρεις αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photos you remove from this trip will appear here so you can restore them later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que quite de este viaje aparecerán aquí para que pueda restaurarlas más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos que vous retirez de ce voyage apparaîtront ici afin que vous puissiez les restaurer plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto rimosse dal viaggio appariranno qui e potranno essere ripristinate in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行で非表示にした写真がここに表示され、後で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행에서 숨긴 사진이 여기에 표시되며 나중에 복원할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder du fjerner fra denne reisen, vises her, slik at du kan gjenopprette dem senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto’s die je uit deze reis verwijdert, verschijnen hier zodat je ze later kunt herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos removidas desta viagem aparecerão aqui para que você possa restaurá-las depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotografias que remover desta viagem aparecerão aqui para poder restaurá-las mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder du tar bort från resan visas här så att du kan återställa dem senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahatten kaldırdığınız fotoğraflar, daha sonra geri yükleyebilmeniz için burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh bạn xóa khỏi chuyến đi này sẽ xuất hiện tại đây để bạn có thể khôi phục sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从这段旅程中移除的照片会显示在这里，以便日后恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這段旅程中移除的照片會顯示在這裡，以便日後恢復。"
          }
        }
      }
    },
    "photos.access-off.hint" : {
      "comment" : "Guidance shown on trip photo surfaces when Photos access is denied or restricted.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til billeder er slået fra. Slå den til i Indstillinger for at se rejsebilleder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fotozugriff ist deaktiviert. Aktivieren Sie ihn in den Einstellungen, um Reisefotos zu sehen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στις φωτογραφίες είναι απενεργοποιημένη. Ενεργοποίησέ την στις Ρυθμίσεις για να βλέπεις φωτογραφίες ταξιδιών"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access is off. Enable it in Settings to see trip photos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a las fotos está desactivado. Actívelo en Ajustes para ver las fotos de sus viajes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos est désactivé. Activez-le dans Réglages pour voir les photos de vos voyages"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alle foto è disattivato. Attivalo in Impostazioni per vedere le foto dei viaggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスがオフです。旅行の写真を見るには「設定」でオンにしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 접근이 꺼져 있어요. 여행 사진을 보려면 설정에서 켜세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildetilgang er slått av. Slå den på i Innstillinger for å se reisebilder"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fototoegang is uitgeschakeld. Schakel deze in via Instellingen om reisfoto’s te zien"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotos está desativado. Ative-o em Ajustes para ver as fotos das viagens"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotografias está desativado. Ative-o em Definições para ver as fotografias das viagens"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildåtkomst är avstängd. Aktivera den i Inställningar för att se resebilder"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf erişimi kapalı. Seyahat fotoğraflarını görmek için Ayarlar’dan etkinleştirin"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập ảnh đang tắt. Bật trong Cài đặt để xem ảnh chuyến đi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片访问权限已关闭。请在“设置”中开启，以查看旅程照片"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片取用權限已關閉。請在「設定」中開啟，以查看旅程照片"
          }
        }
      }
    },
