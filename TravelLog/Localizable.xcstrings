    "temporary-home.form.changes.failed" : {
      "comment" : "Row in the temporary home form when the preview of what a save, an end or a removal changes could not be read. Saving stays unavailable until a retry succeeds.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke tjekke, hvad der ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen konnten nicht geprüft werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατός ο έλεγχος των αλλαγών."
          }
        },
        "en" : {
