          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → Travel Log → Konum yoluna gidip Tam Konum’u açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vào Cài đặt → Travel Log → Vị trí và bật Vị trí chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
