    "settings.shared-trips.footer" : {
      "comment" : "Footer of the Settings shared trips section.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en rejse, som nogen har delt med dig som en Travel Log-fil. Dine egne placeringer kommer altid først, og du kan til enhver tid fjerne det, en delt rejse har tilføjet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie eine Reise hinzu, die jemand als Travel Log-Datei mit Ihnen geteilt hat. Ihre eigenen Standorte haben immer Vorrang, und Sie können jederzeit entfernen, was eine geteilte Reise hinzugefügt hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ένα ταξίδι που μοιράστηκε κάποιος μαζί σας ως αρχείο Travel Log. Οι δικές σας τοποθεσίες προηγούνται πάντα και μπορείτε να αφαιρέσετε ό,τι πρόσθεσε ένα κοινόχρηστο ταξίδι οποιαδήποτε στιγμή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add a trip someone shared with you as a Travel Log file. Your own locations always come first, and you can remove what a shared trip added at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un viaje que alguien compartió contigo como archivo de Travel Log. Tus propias ubicaciones siempre tienen prioridad y puedes eliminar lo que añadió un viaje compartido en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un voyage que quelqu’un vous a partagé sous forme de fichier Travel Log. Vos propres positions passent toujours en premier, et vous pouvez supprimer à tout moment ce qu’un voyage partagé a ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un viaggio che qualcuno ha condiviso con te come file di Travel Log. Le tue posizioni hanno sempre la precedenza e puoi rimuovere in qualsiasi momento ciò che un viaggio condiviso ha aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有されたTravel Logファイルから旅行を追加します。自分の位置情報が常に優先され、共有された旅行で追加された内容はいつでも削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 사람이 Travel Log 파일로 공유한 여행을 추가합니다. 내 위치가 항상 우선하며, 공유된 여행이 추가한 내용은 언제든지 삭제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en reise noen har delt med deg som en Travel Log-fil. Dine egne posisjoner kommer alltid først, og du kan når som helst fjerne det en delt reise la til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een reis toe die iemand als Travel Log-bestand met je heeft gedeeld. Je eigen locaties gaan altijd voor, en je kunt op elk moment verwijderen wat een gedeelde reis heeft toegevoegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma viagem que alguém compartilhou com você como arquivo do Travel Log. Suas próprias localizações sempre têm prioridade, e você pode remover a qualquer momento o que uma viagem compartilhada adicionou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma viagem que alguém partilhou consigo como ficheiro do Travel Log. As suas próprias localizações têm sempre prioridade e pode remover a qualquer momento o que uma viagem partilhada adicionou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en resa som någon har delat med dig som en Travel Log-fil. Dina egna platser går alltid först, och du kan när som helst ta bort det en delad resa har lagt till."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birinin sizinle Travel Log dosyası olarak paylaştığı bir seyahati ekleyin. Kendi konumlarınız her zaman önceliklidir ve paylaşılan bir seyahatin eklediklerini istediğiniz zaman kaldırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm chuyến đi mà ai đó đã chia sẻ với bạn dưới dạng tệp Travel Log. Vị trí của riêng bạn luôn được ưu tiên và bạn có thể xóa những gì chuyến đi được chia sẻ đã thêm bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加他人以 Travel Log 文件共享给你的旅程。你自己的位置始终优先，你可以随时移除共享旅程添加的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入他人以 Travel Log 檔案分享給你的旅程。你自己的位置永遠優先，你可以隨時移除分享旅程加入的內容。"
          }
        }
      }
    },
    "shared-trip.result.nothing-new" : {
      "comment" : "Shared trip result when every location was already known or covered by the user's own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet nyt at tilføje. Din historik dækker allerede denne rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts Neues hinzuzufügen. Ihr Verlauf deckt diese Reise bereits ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει τίποτα νέο για προσθήκη. Το ιστορικό σας καλύπτει ήδη αυτό το ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing new to add. Your history already covers this trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada nuevo que añadir. Tu historial ya cubre este viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de nouveau à ajouter. Votre historique couvre déjà ce voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente di nuovo da aggiungere. La tua cronologia copre già questo viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加する新しい内容はありません。この旅行はすでに履歴に含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가할 새로운 내용이 없습니다. 이 여행은 이미 기록에 포함되어 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting nytt å legge til. Historikken din dekker allerede denne reisen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets nieuws om toe te voegen. Je geschiedenis dekt deze reis al."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de novo para adicionar. Seu histórico já cobre esta viagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de novo para adicionar. O seu histórico já cobre esta viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget nytt att lägga till. Din historik täcker redan den här resan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklenecek yeni bir şey yok. Geçmişiniz bu seyahati zaten kapsıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì mới để thêm. Lịch sử của bạn đã bao gồm chuyến đi này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
