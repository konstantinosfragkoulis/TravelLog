    "tracking.issue.always-permission.description" : {
      "comment" : "Instructions for granting Always location permission to Travel Log.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan kun spore din lokalitet, mens appen er åben. Gå til Indstillinger → Travel Log → Lokalitet, og vælg \"Altid\" for sporing i baggrunden (også efter genstart)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kann Ihren Standort nur bei geöffneter App aufzeichnen. Für die Hintergrundaufzeichnung, auch nach Neustarts, öffnen Sie Einstellungen → Travel Log → Standort und wählen Sie „Immer“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log μπορεί να καταγράφει την τοποθεσία σου μόνο όταν η εφαρμογή είναι ανοιχτή. Για καταγραφή στο παρασκήνιο (και μετά από επανεκκινήσεις), πήγαινε στις Ρυθμίσεις → Travel Log → Τοποθεσία και επίλεξε \"Πάντα\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log can only track your location while the app is open. For background tracking (including after restarts), go to Settings → Travel Log → Location and select \"Always\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log solo puede acceder a su ubicación mientras la app está abierta. Para el seguimiento en segundo plano, incluso después de reiniciar, vaya a Ajustes → Travel Log → Ubicación y elija \"Siempre\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log ne peut suivre votre position que lorsque l’app est ouverte. Pour le suivi en arrière-plan, y compris après un redémarrage, accédez à Réglages → Travel Log → Localisation et sélectionnez « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log può accedere alla posizione solo mentre l’app è aperta. Per il monitoraggio in background, anche dopo un riavvio, vai in Impostazioni → Travel Log → Posizione e scegli “Sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel LogはAppを開いている間しか位置情報を記録できません。再起動後を含めバックグラウンドで記録するには、「設定」→「Travel Log」→「位置情報」で「常に」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log는 앱이 열려 있을 때만 위치를 추적할 수 있어요. 재시작 후를 포함한 백그라운드 추적을 위해 설정 → Travel Log → 위치에서 \"항상\"을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan bare spore posisjonen din mens appen er åpen. For sporing i bakgrunnen (også etter omstart) går du til Innstillinger → Travel Log → Sted og velger «Alltid»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan je locatie alleen volgen wanneer de app open is. Ga voor volgen op de achtergrond (ook na opnieuw starten) naar Instellingen → Travel Log → Locatie en kies \"Altijd\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log só pode rastrear sua localização enquanto o app está aberto. Para rastrear em segundo plano (inclusive após reinicializações), acesse Ajustes → Travel Log → Localização e selecione \"Sempre\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log só consegue acompanhar a sua localização enquanto a app está aberta. Para permitir o acompanhamento em segundo plano, incluindo após reinicializações, aceda a Definições → Travel Log → Localização e selecione “Sempre”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kan bara spåra din plats medan appen är öppen. För spårning i bakgrunden (även efter omstarter), gå till Inställningar → Travel Log → Plats och välj ”Alltid”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log konumunuzu yalnızca uygulama açıkken takip edebilir. Yeniden başlatmalardan sonra da arka planda takip için Ayarlar → Travel Log → Konum yoluna gidip “Her Zaman”ı seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log chỉ có thể theo dõi vị trí khi ứng dụng đang mở. Để theo dõi trong nền (kể cả sau khi khởi động lại), vào Cài đặt → Travel Log → Vị trí và chọn \"Luôn luôn\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 目前只能在 App 打开时记录您的位置。若要在后台记录（包括设备重启后），请前往“设置”→ Travel Log →“位置”并选择“始终”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 目前只能在 App 開啟時記錄您的位置。若要在背景記錄（包括裝置重啟後），請前往「設定」→ Travel Log →「位置」並選擇「永遠」。"
          }
        }
      }
    },
    "tracking.issue.always-permission.title" : {
      "comment" : "Tracking issue title.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
