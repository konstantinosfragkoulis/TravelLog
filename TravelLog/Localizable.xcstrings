    "stays-list.truncated.one" : {
      "comment" : "All Stays footer for a truncated list whose total is one stay.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser det %1$@ seneste af %2$@ ophold. Træk for at opdatere og gruppere nye positionsmålinger. Ophold grupperes ud fra fortløbende positionsmålinger, der ligger inden for 3 km og 4 timer af hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der neueste %1$@ von %2$@ Aufenthalt wird angezeigt. Zum Aktualisieren nach unten ziehen und neue Pings gruppieren. Aufenthalte werden aus aufeinanderfolgenden Standort-Pings gebildet, die höchstens 3 km und 4 Stunden auseinanderliegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζεται η %1$@ πιο πρόσφατη από %2$@ παραμονή. Τράβηξε για ανανέωση και ομαδοποίηση νέων σημάτων. Οι παραμονές ομαδοποιούνται από διαδοχικά σήματα τοποθεσίας που απέχουν έως 3 χλμ. και 4 ώρες μεταξύ τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Showing the %1$@ most recent of %2$@ stay. Pull to refresh and cluster new pings. Stays are grouped from consecutive location pings within 3km and 4 hours of each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando %1$@ estancia, la más reciente de %2$@. Deslice para actualizar y agrupar nuevos registros. Las estancias se forman con registros consecutivos separados por menos de 3 km y 4 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage du %1$@ séjour le plus récent sur %2$@. Tirez vers le bas pour actualiser et regrouper les nouveaux relevés. Les relevés de localisation consécutifs espacés de moins de 3 km et 4 heures sont regroupés en séjours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene mostrato %1$@ soggiorno su %2$@, il più recente. Trascina per aggiornare e raggruppare i nuovi rilevamenti. I soggiorni vengono formati da rilevamenti consecutivi entro 3 km e 4 ore l’uno dall’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@件の滞在のうち最近の%1$@件を表示しています。プルして更新し、新しい位置情報を滞在にまとめます。3 km以内かつ4時間以内に連続して記録された位置情報が、1回の滞在としてまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체류 %2$@개 중 최근 %1$@개를 표시해요. 아래로 당겨 새 위치 신호를 새로 고치고 묶으세요. 서로 3km 및 4시간 이내인 연속 위치 신호가 체류로 묶여요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser det %1$@ nyeste av %2$@ opphold. Dra for å oppdatere og gruppere nye posisjoner. Opphold grupperes fra påfølgende posisjoner innenfor 3 km og 4 timer fra hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %1$@ meest recente van %2$@ verblijf wordt getoond. Trek om te vernieuwen en nieuwe pings te groeperen. Verblijven worden gevormd uit opeenvolgende locatiepings die binnen 3 km en 4 uur van elkaar liggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando a %1$@ estadia mais recente de %2$@. Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos separados por até 3 km e 4 horas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mostrar a %1$@ estadia mais recente de %2$@. Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos a menos de 3 km e 4 horas entre si."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar den %1$@ senaste av %2$@ vistelse. Dra för att uppdatera och gruppera nya platspunkter. Vistelser skapas av efterföljande platspunkter inom 3 km och 4 timmar från varandra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ konaklamanın en son %1$@ tanesi gösteriliyor. Yenilemek ve yeni konum sinyallerini gruplamak için aşağı çekin. Birbirine 3 km ve 4 saat içinde olan ardışık konum sinyalleri konaklama olarak gruplanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị %1$@ lần lưu trú gần đây nhất trong tổng số %2$@. Kéo để làm mới và nhóm tín hiệu vị trí mới. Các lần lưu trú được nhóm từ những tín hiệu vị trí liên tiếp cách nhau trong phạm vi 3km và 4 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %2$@ 个停留，正在显示最近的 %1$@ 个。下拉刷新并聚类新的位置点。相距不超过 3 公里且时间间隔不超过 4 小时的连续位置点会归组为停留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %2$@ 個停留，正在顯示最近的 %1$@ 個。下拉重新整理並分群新的位置點。相距不超過 3 公里且時間間隔不超過 4 小時的連續位置點會歸類為停留。"
          }
        }
      }
    },
