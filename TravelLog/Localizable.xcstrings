    "Reconstructing trips from your photo library. Progress continues in the background; check the Dynamic Island or Lock Screen." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genskaber rejser fra dit fotobibliotek. Fortsætter i baggrunden. Se status på Dynamic Island eller låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen werden aus Ihrer Fotomediathek rekonstruiert. Der Vorgang läuft im Hintergrund weiter; prüfen Sie die Dynamic Island oder den Sperrbildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανακατασκευή ταξιδιών από τη βιβλιοθήκη φωτογραφιών σου. Η πρόοδος συνεχίζεται στο παρασκήνιο· έλεγξε το Dynamic Island ή την οθόνη κλειδώματος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reconstructing trips from your photo library. Progress continues in the background; check the Dynamic Island or Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruyendo viajes desde su fototeca. El proceso continúa en segundo plano; consulte la Dynamic Island o la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstitution des voyages à partir de votre photothèque. Le traitement se poursuit en arrière-plan ; consultez la Dynamic Island ou l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruzione dei viaggi dalla libreria foto. L’operazione continua in background; controlla la Dynamic Island o la schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真ライブラリから旅行を再構築中です。処理はバックグラウンドで続きます。Dynamic Islandまたはロック画面で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함에서 여행을 복원하고 있어요. 백그라운드에서 계속 진행되며 Dynamic Island 또는 잠금 화면에서 확인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenoppretter reiser fra bildebiblioteket ditt. Fremdriften fortsetter i bakgrunnen. Sjekk Dynamic Island eller låseskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizen uit je fotobibliotheek reconstrueren. Dit gaat door op de achtergrond; bekijk de voortgang op het Dynamic Island of toegangsscherm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruindo viagens a partir da sua fototeca. O progresso continua em segundo plano; confira a Dynamic Island ou a Tela Bloqueada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reconstruir viagens a partir da fototeca. O progresso continua em segundo plano; consulte a Dynamic Island ou o ecrã bloqueado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återskapar resor från ditt bildbibliotek. Bearbetningen fortsätter i bakgrunden. Kontrollera Dynamic Island eller låsskärmen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf arşivinizden seyahatler yeniden oluşturuluyor. İşlem arka planda sürer; Dynamic Island'ı veya Kilitli Ekran'ı kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang dựng lại chuyến đi từ thư viện ảnh. Tiến trình tiếp tục trong nền; hãy xem Dynamic Island hoặc Màn hình khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在根据照片图库重建旅程。此过程会在后台继续；可在灵动岛或锁定屏幕查看进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在根據照片圖庫重建旅程。此過程會在背景繼續；可在動態島或鎖定畫面查看進度。"
          }
        }
      }
    },
