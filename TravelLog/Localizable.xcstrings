    "tracking.issue.permission-denied.description" : {
      "comment" : "Instructions for granting location permission to Travel Log.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log har ikke tilladelse til at få adgang til din lokalitet. Gå til Indstillinger → Travel Log → Lokalitet, og vælg \"Altid\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log hat keine Berechtigung, auf Ihren Standort zuzugreifen. Öffnen Sie Einstellungen → Travel Log → Standort und wählen Sie „Immer“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log δεν έχει άδεια πρόσβασης στην τοποθεσία σου. Πήγαινε στις Ρυθμίσεις → Travel Log → Τοποθεσία και επίλεξε \"Πάντα\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log does not have permission to access your location. Go to Settings → Travel Log → Location and select \"Always\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log no tiene permiso para acceder a su ubicación. Vaya a Ajustes → Travel Log → Ubicación y elija \"Siempre\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log n’est pas autorisé à accéder à votre position. Accédez à Réglages → Travel Log → Localisation et sélectionnez « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log non ha l’autorizzazione ad accedere alla tua posizione. Vai in Impostazioni → Travel Log → Posizione e scegli “Sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logには位置情報へのアクセス権がありません。「設定」→「Travel Log」→「位置情報」で「常に」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log에 위치 접근 권한이 없어요. 설정 → Travel Log → 위치에서 \"항상\"을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log har ikke tillatelse til å bruke posisjonen din. Gå til Innstillinger → Travel Log → Sted og velg «Alltid»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log heeft geen toestemming om je locatie te gebruiken. Ga naar Instellingen → Travel Log → Locatie en kies \"Altijd\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não tem permissão para acessar sua localização. Acesse Ajustes → Travel Log → Localização e selecione \"Sempre\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não tem permissão para aceder à sua localização. Aceda a Definições → Travel Log → Localização e selecione “Sempre”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log har inte behörighet att komma åt din plats. Gå till Inställningar → Travel Log → Plats och välj ”Alltid”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log'un konumunuza erişim izni yok. Ayarlar → Travel Log → Konum yoluna gidip “Her Zaman”ı seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log không có quyền truy cập vị trí. Vào Cài đặt → Travel Log → Vị trí và chọn \"Luôn luôn\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 没有访问您位置的权限。请前往“设置”→ Travel Log →“位置”并选择“始终”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 沒有取用您的位置的權限。請前往「設定」→ Travel Log →「位置」並選擇「永遠」。"
          }
        }
      }
    },
