    "temporary-home.keep-as-one-trip.missing.message" : {
      "comment" : "Alert message when a trip a temporary home split cannot be put back together because some of its recorded stays are not on this device: they may still be syncing from iCloud, or may be gone for good. The placeholder is the trip's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget af lokalitetshistorikken for “%@” mangler på denne enhed. Hvis iCloud synkroniserer, så prøv igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil des Standortverlaufs von „%@“ fehlt auf diesem Gerät. Wenn iCloud gerade synchronisiert, versuchen Sie es später erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπει μέρος του ιστορικού τοποθεσίας του «%@» από αυτήν τη συσκευή. Αν το iCloud συγχρονίζει, δοκίμασε ξανά αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some location history for “%@” is missing on this device. If iCloud is syncing, try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta parte del historial de ubicaciones de “%@” en este dispositivo. Si iCloud se está sincronizando, inténtelo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie de l’historique de localisation de « %@ » manque sur cet appareil. Si iCloud est en cours de synchronisation, réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte della cronologia delle posizioni di “%@” manca su questo dispositivo. Se iCloud sta sincronizzando, riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の位置情報履歴の一部がこのデバイスにありません。iCloudで同期中の場合は、後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 위치 기록 일부가 이 기기에 없어요. iCloud가 동기화 중이라면 나중에 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe av posisjonsloggen for «%@» mangler på denne enheten. Hvis iCloud synkroniserer, prøv igjen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een deel van de locatiegeschiedenis van ‘%@’ ontbreekt op dit apparaat. Als iCloud aan het synchroniseren is, probeer het later opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte do histórico de localização de “%@” está faltando neste dispositivo. Se o iCloud estiver sincronizando, tente novamente mais tarde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta parte do histórico de localização de “%@” neste dispositivo. Se o iCloud estiver a sincronizar, tente novamente mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del av platshistoriken för ”%@” saknas på den här enheten. Om iCloud synkroniserar kan du försöka igen senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” konum geçmişinin bir kısmı bu aygıtta eksik. iCloud eşzamanlıyorsa daha sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phần lịch sử vị trí của “%@” bị thiếu trên thiết bị này. Nếu iCloud đang đồng bộ, hãy thử lại sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上缺少“%@”的部分位置历史。如果 iCloud 正在同步，请稍后再试。"
