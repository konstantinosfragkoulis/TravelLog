          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt från ”%@” och framåt blir en separat resa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve sonrasındaki her şey ayrı bir seyahat olur."
