      }
    },
    "This device doesn't allow photo access." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed tillader ikke adgang til billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät erlaubt keinen Fotozugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν επιτρέπει πρόσβαση στις φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This device doesn't allow photo access."
          }
        },
        "es" : {
