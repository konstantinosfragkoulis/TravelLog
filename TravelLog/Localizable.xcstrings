    "Airports appear here after a stay near one: a flight, a layover, or a pickup." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lufthavne vises her efter et ophold i nærheden: en flyrejse, en mellemlanding eller en afhentning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flughäfen erscheinen hier nach einem Aufenthalt in der Nähe: bei einem Flug, Zwischenstopp oder einer Abholung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αεροδρόμια εμφανίζονται εδώ μετά από παραμονή κοντά τους: πτήση, ανταπόκριση ή παραλαβή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Airports appear here after a stay near one: a flight, a layover, or a pickup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los aeropuertos aparecen aquí después de una estancia cercana: un vuelo, una escala o una recogida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les aéroports apparaissent ici après un séjour à proximité : vol, escale ou prise en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aeroporti appaiono qui dopo un soggiorno nelle vicinanze, ad esempio per un volo, uno scalo o un accompagnamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フライト、乗り継ぎ、送迎などで空港の近くに滞在すると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항공편 이용, 경유 또는 마중으로 공항 근처에 체류하면 여기에 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyplasser vises her etter et opphold i nærheten: ved en flyreise, mellomlanding eller henting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luchthavens verschijnen hier na een verblijf in de buurt: voor een vlucht, overstap of om iemand op te halen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aeroportos aparecem aqui após uma estadia próxima: um voo, uma conexão ou quando você busca alguém."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os aeroportos aparecem aqui após uma estadia nas proximidades: num voo, numa escala ou ao recolher alguém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flygplatser visas här efter en vistelse i närheten, till exempel för en flygresa, mellanlandning eller hämtning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir havalimanının yakınında uçuş, aktarma veya karşılama nedeniyle konakladığınızda havalimanı burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sân bay sẽ xuất hiện tại đây sau khi bạn lưu trú gần đó: để bay, quá cảnh hoặc đón người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在机场附近停留后，相关机场会显示在这里，例如乘机、转机或接人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在機場附近停留後，相關機場會顯示在這裡，例如乘機、轉機或接人。"
          }
        }
      }
    },
