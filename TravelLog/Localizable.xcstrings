    "wrapped.notification.ready.body" : {
      "comment" : "Notification body announcing that the year's Wrapped is ready.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dit rejseår: lande, byer, afstande og meget mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
