    "As you move around, hexes will light up on the map." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bevæger dig rundt, lyser sekskanter op på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während Sie unterwegs sind, leuchten Hexfelder auf der Karte auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθώς μετακινείσαι, τα εξάγωνα θα φωτίζονται στον χάρτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "As you move around, hexes will light up on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desplazarse, los hexágonos se iluminarán en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil de vos déplacements, les hexagones s’illumineront sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante gli spostamenti, gli esagoni si illumineranno sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動すると、地図上の六角形が点灯します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동할수록 지도에서 육각형이 밝아져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du beveger deg rundt, lyser sekskantene opp på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je je verplaatst, lichten zeshoeken op de kaart op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme você se desloca, os hexágonos se acendem no mapa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À medida que se deslocar, os hexágonos vão iluminar-se no mapa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du rör dig tänds hexagoner på kartan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket ettikçe haritadaki altıgenler aydınlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn di chuyển, các ô lục giác sẽ sáng lên trên bản đồ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着您的移动，地图上的六边形区域会逐一亮起。"
          }
        },
        "zh-Hant" : {
