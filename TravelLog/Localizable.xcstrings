        }
      }
    },
    "settings.wrapped.snapshot-footer" : {
      "comment" : "Settings, Wrapped section footer: saved recaps can change after a privacy deletion.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et år for at se tilbage. Sletning af private data kan ændre gemte årsoversigter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf ein Jahr, um zurückzublicken. Das Löschen privater Daten kann gespeicherte Rückblicke ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε μια χρονιά για να τη δεις ξανά. Οι διαγραφές για λόγους απορρήτου μπορεί να αλλάξουν τις αποθηκευμένες ανασκοπήσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any year to revisit. Privacy deletions can update saved recaps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque un año para recordarlo. Eliminar datos privados puede actualizar los resúmenes guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une année pour la revoir. La suppression de données privées peut modifier les récapitulatifs enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un anno per riviverlo. L’eliminazione dei dati privati può aggiornare i riepiloghi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年をタップして振り返れます。プライバシー保護のためにデータを削除すると、保存済みの振り返りが変更される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연도를 탭해 다시 보세요. 개인 데이터 삭제 시 저장된 한 해 돌아보기가 변경될 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på et år for å se tilbake. Sletting av private data kan endre lagrede årsoppsummeringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een jaar om terug te kijken. Het verwijderen van privégegevens kan opgeslagen overzichten wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um ano para revisitá-lo. A exclusão de dados privados pode atualizar as retrospectivas salvas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num ano para o revisitar. A eliminação de dados privados pode atualizar as retrospetivas guardadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ett år för att se tillbaka. Radering av privata data kan ändra sparade årssammanfattningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar görmek için bir yıla dokunun. Gizlilik için veri silmek, kaydedilmiş özetleri güncelleyebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào một năm để xem lại. Việc xóa dữ liệu riêng tư có thể thay đổi bản tổng kết đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点任意年份即可回顾。删除隐私数据可能会更新已保存的年度回顾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下任意年份即可回顧。刪除隱私資料可能會更新已儲存的年度回顧。"
          }
        }
      }
    },
