    "temporary-home.keep-as-one-trip.ambiguous.message" : {
      "comment" : "Alert message when a trip a temporary home split cannot be put back together because some of its recorded stays exist in more than one differing copy on this device. The placeholder is the trip's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalitetshistorikken for “%@” har modstridende kopier, så den kan ikke samles endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortverlauf von „%@“ hat widersprüchliche Kopien und kann deshalb noch nicht wieder zusammengefügt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ιστορικό τοποθεσίας του «%@» έχει αντικρουόμενα αντίγραφα, οπότε δεν μπορεί να ενωθεί ακόμη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The location history for “%@” has conflicting copies, so it can't be put back together yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de ubicaciones de “%@” tiene copias contradictorias, así que aún no se puede volver a unir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique de localisation de « %@ » comporte des copies contradictoires ; il ne peut donc pas encore être réuni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia delle posizioni di “%@” ha copie in conflitto, quindi non può ancora essere riunita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の位置情報履歴に矛盾するコピーがあるため、まだ元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”의 위치 기록에 서로 다른 사본이 있어서 아직 다시 합칠 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjonsloggen for «%@» har motstridende kopier, så den kan ikke settes sammen ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De locatiegeschiedenis van ‘%@’ heeft tegenstrijdige kopieën en kan dus nog niet worden samengevoegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de localização de “%@” tem cópias conflitantes, então ainda não pode ser reunido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico de localização de “%@” tem cópias em conflito, por isso ainda não pode ser reunido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platshistoriken för ”%@” har motstridiga kopior, så den kan inte sättas ihop än."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” konum geçmişinde birbiriyle çelişen kopyalar var, bu yüzden henüz yeniden birleştirilemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử vị trí của “%@” có các bản sao mâu thuẫn nên chưa thể ghép lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的位置历史存在相互冲突的副本，因此暂时无法重新合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」的位置歷史存在相互衝突的副本，因此暫時無法重新合併。"
          }
        }
      }
    },
    "temporary-home.keep-as-one-trip.blocked.message" : {
      "comment" : "Alert message when a trip a temporary home split cannot be put back together because its pieces or stays changed since the split, by the user or by sync; the placeholder lists the trips or places that changed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse rejser eller steder er ændret siden opdelingen, så rejsen kan ikke samles igen: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Reisen oder Orte haben sich seit der Aufteilung geändert, daher kann die Reise nicht wieder zusammengefügt werden: %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα ταξίδια ή μέρη άλλαξαν μετά τον διαχωρισμό, οπότε το ταξίδι δεν μπορεί να ενωθεί ξανά: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These trips or places changed since the split, so it can't be put back together: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos viajes o lugares cambiaron después de la división, así que el viaje no se puede volver a unir: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces voyages ou lieux ont changé depuis la séparation, le voyage ne peut donc pas être réuni : %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi viaggi o luoghi sono cambiati dopo la divisione, quindi il viaggio non può essere riunito: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割後に次の旅行または場所が変更されたため、元の1つの旅行に戻せません：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나뉜 뒤에 다음 여행이나 장소가 변경되어 여행을 다시 합칠 수 없어요: %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse reisene eller stedene er endret siden delingen, så reisen kan ikke settes sammen igjen: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reizen of plaatsen zijn sinds het splitsen gewijzigd, dus de reis kan niet weer worden samengevoegd: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens ou lugares mudaram depois da divisão, então a viagem não pode ser juntada de novo: %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens ou locais mudaram depois da divisão, por isso a viagem não pode voltar a ser juntada: %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
