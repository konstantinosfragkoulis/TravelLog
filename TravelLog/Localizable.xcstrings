            "value" : "¿Cuándo volaste?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand avez-vous volé ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando hai volato?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつ飛びましたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제 비행했나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når fløy du?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer vloog je?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você voou?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando voou?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När flög du?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne zaman uçtunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã bay khi nào?"
          }
        },
        "zh-Hans" : {
