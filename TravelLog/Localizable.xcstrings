          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ viagens serão divididas em tempo aqui e viagens fora: %2$@. As cópias ficam em Viagens removidas neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ resor delas upp i tid här och resor härifrån: %2$@. Kopior finns kvar i Borttagna resor på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ seyahat, buradaki süre ve buradan çıkılan seyahatler olarak bölünecek: %2$@. Kopyaları bu aygıtta Kaldırılan Seyahatler’de kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ chuyến đi sẽ được tách thành thời gian ở đây và các chuyến đi khỏi đây: %2$@. Các bản sao vẫn được giữ trong Chuyến đi đã xóa trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 段旅程将被拆分为在此的时间和离开这里的旅程：%2$@。副本会保留在此设备的“已移除的旅程”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 段旅程將被拆分為在此的時間和離開這裡的旅程：%2$@。副本會保留在此裝置的「已移除的旅程」中。"
          }
        }
      }
    },
    "temporary-home.form.dates.footer" : {
      "comment" : "Footer of the dates section in the temporary home form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad slutdatoen stå åben, hvis du ikke er sikker endnu. Du kan afslutte det senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lassen Sie das Ende offen, wenn Sie noch nicht sicher sind. Sie können es später beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν δεν ξέρεις ακόμα, άφησε τη λήξη ανοιχτή. Μπορείς να την ορίσεις αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Leave the end open if you're not sure yet. You can end it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje el final abierto si aún no lo sabe. Podrá finalizarla más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la fin ouverte si vous hésitez encore. Vous pourrez y mettre fin plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia aperta la fine se non la conosci ancora. Potrai terminarla in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ決まっていない場合は、終了日を未設定のままにしてください。あとから終了できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 확실하지 않다면 종료 날짜를 비워 두세요. 나중에 종료할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La slutten stå åpen hvis du ikke er sikker ennå. Du kan avslutte det senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat het einde open als je het nog niet zeker weet. Je kunt het later beëindigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o término em aberto se ainda não tiver certeza. Você pode encerrá-la depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o fim em aberto se ainda não tiver a certeza. Pode terminá-la mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna slutet öppet om du inte är säker än. Du kan avsluta det senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz emin değilseniz bitişi açık bırakın. Daha sonra sonlandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để trống ngày kết thúc nếu bạn chưa chắc chắn. Bạn có thể kết thúc sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果还不确定，可以先不设置结束日期，之后再结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果還不確定，可以先不設定結束日期，之後再結束。"
          }
        }
      }
    },
