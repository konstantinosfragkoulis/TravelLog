    "settings.flight-detection.none-confirmed" : {
      "comment" : "Flight detection result when no new flights were confirmed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen nye flyrejser fundet. Korte ture (under ~300 km) kan kun bekræftes af en matchende flyrejse i din kalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine neuen Flüge gefunden. Kurze Strecken unter etwa 300 km können nur durch ein passendes Flugereignis in Ihrem Kalender bestätigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκαν νέες πτήσεις. Οι σύντομες διαδρομές (κάτω από ~300 χλμ.) μπορούν να επιβεβαιωθούν μόνο από αντίστοιχο συμβάν πτήσης στο ημερολόγιό σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No new flights found. Short hops (under ~300 km) can only be confirmed by a matching flight event in your calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron vuelos nuevos. Los trayectos cortos (menos de ~300 km) solo se confirman si coinciden con un evento de vuelo del calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun nouveau vol trouvé. Les courts trajets (moins de ~300 km) ne peuvent être confirmés que par un événement de vol correspondant dans votre calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono stati trovati nuovi voli. Le tratte brevi, inferiori a circa 300 km, possono essere confermate solo da un evento di volo corrispondente nel calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいフライトは見つかりませんでした。約300 km未満の短距離移動は、カレンダー内に一致するフライトイベントがある場合のみ確定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 항공편을 찾지 못했어요. 약 300km 미만의 짧은 비행은 캘린더에 일치하는 항공편 이벤트가 있어야만 확인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fant ingen nye flyreiser. Korte hopp (under ca. 300 km) kan bare bekreftes av en samsvarende flyhendelse i kalenderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen nieuwe vluchten gevonden. Korte trajecten (minder dan ~300 km) kunnen alleen worden bevestigd door een overeenkomende vluchtactiviteit in je agenda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum voo novo encontrado. Trechos curtos (menos de ~300 km) só podem ser confirmados por um evento de voo correspondente no seu calendário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foram encontrados novos voos. Os segmentos curtos (menos de ~300 km) só podem ser confirmados por um evento de voo correspondente no seu calendário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga nya flygningar hittades. Korta sträckor (under ~300 km) kan bara bekräftas av en matchande flyghändelse i kalendern."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni uçuş bulunamadı. Kısa mesafeler (yaklaşık 300 km'den az) yalnızca takviminizdeki eşleşen bir uçuş etkinliğiyle onaylanabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy chuyến bay mới. Các chặng ngắn (dưới khoảng 300 km) chỉ có thể được xác nhận bằng sự kiện chuyến bay khớp trong lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未发现新航班。短途飞行（约 300 公里以内）只能通过日历中匹配的航班日程确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未發現新航班。短途飛行（約 300 公里以內）只能透過行事曆中相符的航班行程確認。"
          }
        }
      }
    },
    "settings.gpx-import.error.empty" : {
      "comment" : "GPX import error when the file has no timestamped track points.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blev ikke fundet nogen tidsstemplede sporpunkter i filen. GPX-filer med kun rutepunkter kan ikke importeres. Travel Log skal bruge tidspunkter for at genskabe din historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Datei wurden keine Trackpunkte mit Zeitstempel gefunden. Reine Wegpunkt-GPX-Dateien können nicht importiert werden. Travel Log benötigt Zeitangaben, um Ihren Verlauf zu rekonstruieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκαν σημεία διαδρομής με χρονική σήμανση σε αυτό το αρχείο. Δεν είναι δυνατή η εισαγωγή αρχείων GPX μόνο με σημεία αναφοράς. Το Travel Log χρειάζεται χρόνους για να ανακατασκευάσει το ιστορικό σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No timestamped track points were found in this file. Waypoint-only GPX files can't be imported. Travel Log needs times to reconstruct your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron puntos de ruta con fecha y hora. Los archivos GPX que solo contienen puntos de interés no se pueden importar. Travel Log necesita horas para reconstruir su historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun point de trace horodaté n’a été trouvé dans ce fichier. Les fichiers GPX ne contenant que des points de cheminement ne peuvent pas être importés. Travel Log a besoin des heures pour reconstituer votre historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questo file non sono stati trovati punti della traccia con data e ora. I file GPX contenenti solo punti di interesse non possono essere importati. Travel Log richiede gli orari per ricostruire la cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはタイムスタンプ付きのトラックポイントがありません。ウェイポイントのみのGPXファイルは読み込めません。Travel Logが履歴を再構築するには時刻が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일에서 타임스탬프가 있는 트랙 지점을 찾지 못했어요. 웨이포인트만 있는 GPX 파일은 가져올 수 없어요. Travel Log에서 기록을 복원하려면 시간이 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fant ingen tidsstemplede sporpunkter i denne filen. GPX-filer med bare veipunkter kan ikke importeres. Travel Log trenger tidspunkter for å gjenopprette historikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dit bestand zijn geen routepunten met tijdstippen gevonden. GPX-bestanden met alleen routepunten kunnen niet worden geïmporteerd. Travel Log heeft tijden nodig om je geschiedenis te reconstrueren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum ponto de trajeto com horário foi encontrado neste arquivo. Arquivos GPX contendo apenas pontos de referência não podem ser importados. O Travel Log precisa dos horários para reconstruir seu histórico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foram encontrados pontos de percurso com data e hora neste ficheiro. Os ficheiros GPX que contêm apenas pontos de passagem não podem ser importados. O Travel Log precisa das horas para reconstruir o seu histórico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga tidsstämplade spårpunkter hittades i filen. GPX-filer med enbart vägpunkter kan inte importeras. Travel Log behöver tider för att återskapa din historik."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosyada zaman damgalı rota noktası bulunamadı. Yalnızca ara nokta içeren GPX dosyaları içe aktarılamaz. Travel Log geçmişinizi yeniden oluşturmak için zaman bilgisine ihtiyaç duyar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy điểm lộ trình có dấu thời gian trong tệp này. Không thể nhập tệp GPX chỉ có điểm tham chiếu. Travel Log cần thời gian để dựng lại lịch sử."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件中没有带时间戳的轨迹点。无法导入仅含航点的 GPX 文件。Travel Log 需要时间信息来重建您的历史记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案中沒有帶時間戳記的軌跡點。無法匯入僅含航路點的 GPX 檔案。Travel Log 需要時間資訊來重建您的歷史記錄。"
          }
        }
      }
    },
    "settings.gpx-import.error.malformed" : {
      "comment" : "GPX import error when the file is malformed or truncated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-filen ser ud til at være afkortet eller beskadiget. Sporet stopper midt i filen. Eksporter eller hent den igen, og prøv derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese GPX-Datei scheint abgeschnitten oder beschädigt zu sein; der Track bricht mitten in der Datei ab. Exportieren oder laden Sie sie erneut und versuchen Sie es noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αρχείο GPX φαίνεται κομμένο ή κατεστραμμένο. Η διαδρομή διακόπτεται στη μέση του αρχείου. Εξήγαγέ το ή κατέβασέ το ξανά και μετά δοκίμασε πάλι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This GPX file appears truncated or corrupted. The track breaks off mid-file. Re-export or re-download it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo GPX parece incompleto o dañado. La ruta se interrumpe a mitad del archivo. Vuelva a exportarlo o descargarlo e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier GPX semble tronqué ou endommagé. La trace s’interrompt au milieu du fichier. Exportez-le ou téléchargez-le à nouveau, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file GPX sembra troncato o danneggiato. La traccia si interrompe a metà del file. Esportalo o scaricalo di nuovo, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このGPXファイルは途中で切れているか破損しているようです。トラックがファイルの途中で途切れています。再度書き出すかダウンロードしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 GPX 파일은 잘렸거나 손상된 것 같아요. 파일 중간에서 트랙이 끊겨요. 다시 내보내거나 다운로드한 후 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne GPX-filen ser avkortet eller skadet ut. Sporet brytes midt i filen. Eksporter eller last den ned på nytt, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit GPX-bestand lijkt afgekapt of beschadigd. De route stopt halverwege het bestand. Exporteer of download het opnieuw en probeer het nogmaals."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo GPX parece truncado ou corrompido. O trajeto é interrompido no meio do arquivo. Exporte ou baixe-o novamente e tente outra vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ficheiro GPX parece estar truncado ou danificado. O percurso termina a meio do ficheiro. Volte a exportá-lo ou a descarregá-lo e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-filen verkar vara avkortad eller skadad. Spåret bryts mitt i filen. Exportera eller hämta den igen och försök på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu GPX dosyası eksik veya bozuk görünüyor. Rota dosyanın ortasında kesiliyor. Yeniden dışa aktarın ya da indirin ve tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp GPX này có vẻ bị cắt ngắn hoặc hỏng. Lộ trình dừng giữa tệp. Hãy xuất hoặc tải xuống lại rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 GPX 文件似乎被截断或已损坏，轨迹在文件中途断开。请重新导出或下载后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 GPX 檔案似乎被截斷或已損壞，軌跡在檔案中途斷開。請重新匯出或下載後再試。"
          }
        }
      }
    },
    "settings.gpx-import.error.not-gpx" : {
      "comment" : "GPX import error when the selected file is not a GPX track.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filen ligner ikke et GPX-spor."
