    "temporary-home.form.changes.trips-split.one" : {
      "comment" : "Temporary home preview line for one trip the user renamed, edited or favorited that the temporary home covers. Its stays here count as time at the temporary home from now on and each outing becomes a separate trip; the trip as it was is kept, on this device only, in Removed Trips (a screen in Settings), from where the user can keep it as one trip. The placeholder is the trip's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bliver delt i tid her og rejser væk herfra. En kopi bliver i Fjernede rejser på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird in Zeit hier und Reisen von hier aufgeteilt. Eine Kopie bleibt auf diesem Gerät unter „Entfernte Reisen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» θα χωριστεί σε χρόνο εδώ και ταξίδια από εδώ. Ένα αντίγραφο μένει στα Αφαιρεμένα ταξίδια σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” will be split into time here and trips away. A copy stays in Removed Trips on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se dividirá en tiempo aquí y viajes fuera. Se conserva una copia en Viajes eliminados en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera divisé en temps passé ici et en voyages au départ d’ici. Une copie reste dans Voyages supprimés sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà diviso in tempo trascorso qui e viaggi fuori. Una copia resta in Viaggi rimossi su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は、ここで過ごした時間とここから出かけた旅行に分割されます。コピーはこのデバイスの「削除された旅行」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 여행이 이곳에서 보낸 시간과 다른 곳으로 떠난 여행으로 나뉘어요. 사본은 이 기기의 삭제된 여행에 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» blir delt i tid her og reiser herfra. En kopi blir liggende i Fjernede reiser på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ wordt gesplitst in tijd hier en reizen weg van hier. Er blijft een kopie in Verwijderde reizen op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será dividida em tempo aqui e viagens fora. Uma cópia fica em Viagens removidas neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será dividida em tempo aqui e viagens fora. Fica uma cópia em Viagens removidas neste dispositivo."
          }
