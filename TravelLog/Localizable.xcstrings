    "temporary-home.form.changes.no-city-boundary" : {
      "comment" : "Temporary home preview line shown when the chosen location lies in no measured city boundary. This Wasn't a Trip is the name of a trip action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ingen bygrænse her, så området starter som 1 km omkring nålen. Hvis hverdagssteder i nærheden vises som rejser, kan du bruge “Dette var ikke en rejse” på en af dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es keine Stadtgrenze, daher umfasst das Gebiet zunächst 1 km um die Markierung. Wenn alltägliche Orte in der Nähe als Reisen erscheinen, wählen Sie bei einer davon „Das war keine Reise“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει όριο πόλης εδώ, οπότε η περιοχή ξεκινά με ακτίνα 1 χλμ. γύρω από την πινέζα. Αν κοντινά καθημερινά μέρη εμφανίζονται ως ταξίδια, χρησιμοποίησε το «Αυτό δεν ήταν ταξίδι» σε ένα από αυτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No city boundary here, so the area starts as 1 km around the pin. If everyday places nearby show up as trips, use This Wasn't a Trip on one of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hay un límite urbano, así que la zona empieza con 1 km alrededor del marcador. Si lugares cotidianos cercanos aparecen como viajes, use “Esto no era un viaje” en uno de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune limite de ville ici : la zone commence à 1 km autour du repère. Si des lieux du quotidien à proximité apparaissent comme des voyages, utilisez « Ce n’était pas un voyage » sur l’un d’eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui non c’è un confine urbano, quindi la zona parte da 1 km intorno al segnaposto. Se i luoghi abituali nelle vicinanze compaiono come viaggi, usa “Questo non era un viaggio” su uno di essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここには市の境界がないため、エリアはピンの周囲1 kmから始まります。近くの日常の場所が旅行として表示される場合は、そのいずれかで「これは旅行ではありませんでした」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 도시 경계가 없어 영역이 핀 주변 1km에서 시작해요. 근처의 일상 장소가 여행으로 표시되면 그중 하나에서 ‘여행이 아니었어요’를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes ingen bygrense her, så området starter som 1 km rundt nålen. Hvis hverdagssteder i nærheten vises som reiser, bruker du «Dette var ikke en reise» på en av dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier is geen stadsgrens, dus het gebied begint als 1 km rond de speld. Als alledaagse plekken in de buurt als reizen verschijnen, gebruik dan ‘Dit was geen reis’ bij een daarvan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há limites de cidade aqui, então a área começa com 1 km ao redor do alfinete. Se locais do dia a dia nas proximidades aparecerem como viagens, use “Isto não foi uma viagem” em uma delas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existem limites de cidade neste local, pelo que a área começa com 1 km em redor do pin. Se locais do dia a dia nas proximidades aparecerem como viagens, utilize “Isto não foi uma viagem” numa delas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ingen stadsgräns här, så området börjar som 1 km runt nålen. Om vardagliga platser i närheten visas som resor använder du ”Det här var ingen resa” på en av dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada şehir sınırı yok; bu yüzden bölge, raptiyenin çevresinde 1 km olarak başlar. Yakındaki gündelik yerler seyahat olarak görünürse bunlardan birinde Bu Bir Seyahat Değildi seçeneğini kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có ranh giới thành phố tại đây, nên khu vực ban đầu là 1 km quanh ghim. Nếu các địa điểm thường ngày gần đó xuất hiện dưới dạng chuyến đi, hãy dùng “Đây không phải chuyến đi” cho một trong số đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里没有城市边界，因此区域从大头针周围 1 公里开始。如果附近的日常地点显示为旅程，请对其中之一使用“这不是旅程”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡沒有城市邊界，因此區域從大頭針周圍 1 公里開始。如果附近的日常地點顯示為旅程，請對其中之一使用「這不是旅程」。"
          }
        }
      }
    },
    "temporary-home.form.changes.retry" : {
      "comment" : "Button beside the row saying the temporary home form could not check what changes; reads the preview again.",
