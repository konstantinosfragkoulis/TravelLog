    "tip.merge.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på denne rejse, og vælg en tilstødende rejse for at flette dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese Reise gedrückt und wähle eine benachbarte Reise, um beide zusammenzuführen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα αυτό το ταξίδι και επίλεξε ένα διπλανό ταξίδι για να τα συγχωνεύσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold this trip, then choose a neighboring trip to merge them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga pulsado este viaje y elija uno adyacente para unirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur ce voyage, puis choisissez un voyage voisin pour les fusionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto questo viaggio, poi scegli un viaggio adiacente per unirli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行を長押しし、前後の旅行を選ぶと、1つにまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행을 길게 누른 다음 앞뒤 여행을 선택해 합치세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på denne reisen, og velg en tilstøtende reise for å slå dem sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd deze reis ingedrukt en kies een aangrenzende reis om ze samen te voegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure esta viagem e escolha uma viagem adjacente para uni-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque sem soltar nesta viagem e escolha uma viagem adjacente para as unir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på den här resan och välj en intilliggande resa för att slå ihop dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahate dokunup basılı tutun, ardından birleştirmek için bitişik bir seyahat seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ chuyến đi này, rồi chọn một chuyến đi liền kề để gộp chúng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按这次旅行，然后选择相邻的旅行，将它们合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按這次旅行，然後選擇相鄰的旅行，將它們合併。"
