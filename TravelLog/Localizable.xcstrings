    "app-intent.data-unavailable" : {
      "comment" : "Siri and Shortcuts response when the travel journal could not be read, so no answer is given.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kunne ikke læse dine rejsedata. Prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log konnte Ihre Reisedaten nicht lesen. Versuchen Sie es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log δεν μπόρεσε να διαβάσει τα ταξιδιωτικά σου δεδομένα. Δοκίμασε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log couldn't read your travel data. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log no pudo leer sus datos de viaje. Inténtelo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log n’a pas pu lire vos données de voyage. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
