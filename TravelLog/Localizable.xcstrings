    "No routine places. Add places you visit regularly that shouldn't count as trips." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen faste steder. Tilføj steder, du besøger regelmæssigt, og som ikke skal tælle som rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Alltagsorte. Fügen Sie regelmäßig besuchte Orte hinzu, die nicht als Reisen zählen sollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν συνηθισμένα μέρη. Πρόσθεσε μέρη που επισκέπτεσαι τακτικά και δεν πρέπει να υπολογίζονται ως ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No routine places. Add places you visit regularly that shouldn't count as trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay lugares habituales. Añada lugares que visite con frecuencia y que no deban contar como viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun lieu habituel. Ajoutez les lieux que vous fréquentez régulièrement et qui ne doivent pas être considérés comme des voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun luogo abituale. Aggiungi i luoghi che frequenti regolarmente e che non devono contare come viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常の場所はありません。旅行として扱わない、定期的に訪れる場所を追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일상 장소가 없어요. 정기적으로 방문하지만 여행으로 계산하면 안 되는 장소를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen faste steder. Legg til steder du besøker regelmessig, som ikke skal regnes som reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen vaste plekken. Voeg plekken toe die je regelmatig bezoekt en die niet als reizen moeten tellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum local habitual. Adicione locais que você visita regularmente e que não devem contar como viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há locais habituais. Adicione locais que visita regularmente e que não devem contar como viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga vardagsplatser. Lägg till platser du besöker regelbundet som inte ska räknas som resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutin yer yok. Düzenli ziyaret ettiğiniz ve seyahat sayılmaması gereken yerleri ekleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có địa điểm thường lui tới. Hãy thêm những nơi bạn thường đến nhưng không nên tính là chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无日常地点。请添加经常到访且不应计入旅程的地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無日常地點。請加入經常造訪且不應計入旅程的地點。"
          }
        }
      }
    },
    "No stays yet. As pings accumulate from your movements, they'll be grouped into stays here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ophold endnu. Når positionsmålinger fra dine bevægelser samles, bliver de grupperet i ophold her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Aufenthalte. Wenn durch Ihre Bewegungen Pings gesammelt werden, werden sie hier zu Aufenthalten gruppiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν παραμονές ακόμα. Καθώς συσσωρεύονται σήματα από τις μετακινήσεις σου, θα ομαδοποιούνται εδώ σε παραμονές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No stays yet. As pings accumulate from your movements, they'll be grouped into stays here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay estancias. A medida que se acumulen registros de sus desplazamientos, se agruparán aquí en estancias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun séjour pour le moment. À mesure que les relevés de vos déplacements s’accumulent, ils seront regroupés ici en séjours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun soggiorno. Man mano che si accumulano i rilevamenti degli spostamenti, verranno raggruppati qui in soggiorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滞在はまだありません。移動による位置情報が蓄積されると、ここで滞在としてまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 체류가 없어요. 이동 중 수집된 위치 신호가 여기에 체류로 묶여 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen opphold ennå. Etter hvert som posisjoner registreres når du beveger deg, grupperes de i opphold her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen verblijven. Wanneer pings van je verplaatsingen zich opstapelen, worden ze hier tot verblijven gegroepeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma estadia ainda. Conforme os sinais dos seus deslocamentos se acumularem, eles serão agrupados aqui em estadias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há estadias. À medida que os sinais dos seus movimentos se acumularem, serão aqui agrupados em estadias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga vistelser än. När platspunkter samlas från dina rörelser grupperas de här till vistelser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz konaklama yok. Hareketlerinizden konum sinyalleri biriktikçe burada konaklamalar hâlinde gruplanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có lần lưu trú. Khi các tín hiệu vị trí từ việc di chuyển tích lũy, chúng sẽ được nhóm thành các lần lưu trú tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚无停留。移动产生的位置点逐渐累积后，会在这里归组为停留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚無停留。移動產生的位置點逐漸累積後，會在這裡歸類為停留。"
          }
        }
      }
    },
