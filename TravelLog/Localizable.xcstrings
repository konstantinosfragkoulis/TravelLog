    "settings.delete-all.message" : {
      "comment" : "Delete All Data confirmation message: what is deleted and what is kept.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent alle positionsmålinger, ophold, rejser, besøg i sekskanter, årsminder, registrerede kommende rejser og din landeliste over tidligere rejser (på alle synkroniserede enheder). Dine hjem, midlertidige hjem og faste steder bevares. Handlingen kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Pings, Aufenthalte, Reisen, Hexfeldbesuche, Jahreserinnerungen, erkannten bevorstehenden Reisen und Ihre Länderliste unter „Frühere Reisen“ auf allen synchronisierten Geräten dauerhaft gelöscht. Ihre Zuhause, Zuhause auf Zeit und Alltagsorte bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα διαγράψει οριστικά όλα τα σήματα, τις παραμονές, τα ταξίδια, τις επισκέψεις εξαγώνων, τις αναμνήσεις ετών, τα επερχόμενα ταξίδια που εντοπίστηκαν και τη λίστα χωρών παλαιότερων ταξιδιών σου (σε κάθε συγχρονισμένη συσκευή). Οι κατοικίες, τα προσωρινά σπίτια και τα συνηθισμένα μέρη σου θα διατηρηθούν. Δεν είναι δυνατή η αναίρεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will permanently delete all pings, stays, trips, hex visits, year memories, detected upcoming trips, and your earlier-travels country checklist (on every synced device). Your homes, temporary homes and routine places will be kept. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará de forma permanente todos los registros, estancias, viajes, visitas a hexágonos, recuerdos anuales, próximos viajes detectados y la lista de países de Viajes anteriores en todos los dispositivos sincronizados. Se conservarán sus residencias, residencias temporales y lugares habituales. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération supprimera définitivement tous les relevés, séjours, voyages, visites d’hexagones, souvenirs annuels, voyages à venir détectés et votre liste de pays des voyages antérieurs (sur chaque appareil synchronisé). Vos domiciles, domiciles temporaires et lieux habituels seront conservés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà definitivamente tutti i rilevamenti, i soggiorni, i viaggi, le visite agli esagoni, i ricordi annuali, i prossimi viaggi rilevati e l’elenco dei paesi dei viaggi precedenti su ogni dispositivo sincronizzato. Le case, le case temporanee e i luoghi abituali verranno conservati. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての位置情報、滞在、旅行、六角形の訪問、一年の思い出、検出された今後の旅行、過去の旅行の国チェックリストが、同期中のすべてのデバイスから完全に削除されます。自宅、仮の自宅、日常の場所は保持されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 위치 신호, 체류, 여행, 육각형 방문, 연간 추억, 감지된 예정 여행, 이전 여행 국가 목록을 모든 동기화 기기에서 영구적으로 삭제해요. 집, 임시 거주지, 일상 장소는 유지돼요. 실행 취소할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sletter permanent alle posisjoner, opphold, reiser, sekskantbesøk, årsminner, registrerte kommende reiser og landlisten for tidligere reiser (på alle synkroniserte enheter). Hjem, midlertidige hjem og faste steder beholdes. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee verwijder je voorgoed alle pings, verblijven, reizen, zeshoekbezoeken, jaarherinneringen, gedetecteerde aankomende reizen en de landenlijst van je eerdere reizen (op elk gesynchroniseerd apparaat). Je thuislocaties, tijdelijke thuislocaties en vaste plekken blijven behouden. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apagará permanentemente todos os sinais, estadias, viagens, visitas a hexágonos, memórias anuais, próximas viagens detectadas e sua lista de países de viagens anteriores (em todos os dispositivos sincronizados). Suas casas, casas temporárias e locais habituais serão mantidos. Não é possível desfazer esta ação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação apaga permanentemente todos os sinais, estadias, viagens, visitas a hexágonos, memórias anuais, próximas viagens detetadas e a lista de países das viagens anteriores (em todos os dispositivos sincronizados). As residências, as casas temporárias e os locais habituais serão mantidos. Esta ação não pode ser desfeita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta raderar permanent alla platspunkter, vistelser, resor, hexagonbesök, årsminnen, identifierade kommande resor och din landslista för tidigare resor (på alla synkroniserade enheter). Dina hem, tillfälliga hem och vardagsplatser behålls. Det går inte att ångra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm konum sinyallerini, konaklamaları, seyahatleri, altıgen ziyaretlerini, yıl anılarını, algılanan yaklaşan seyahatleri ve önceki seyahatler ülke listenizi eşzamanlanan her aygıttan kalıcı olarak siler. Ev bölgeleriniz, geçici ev bölgeleriniz ve rutin yerleriniz korunur. İşlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này sẽ xóa vĩnh viễn mọi tín hiệu vị trí, lần lưu trú, chuyến đi, lượt ghé ô lục giác, kỷ niệm theo năm, chuyến đi sắp tới đã phát hiện và danh sách quốc gia trong Những chuyến đi trước đây (trên mọi thiết bị đồng bộ). Nhà, nhà tạm thời và địa điểm thường lui tới của bạn sẽ được giữ lại. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除所有位置点、停留、旅程、六边形到访、年度回忆、检测到的即将开始的旅程，以及过往足迹国家/地区清单（包括所有同步设备）。您的常住地、暂住地和日常地点会保留。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除所有位置點、停留、旅程、六邊形造訪、年度回憶、偵測到的即將開始的旅程，以及過往足跡國家或地區清單（包括所有同步裝置）。您的居住地、暫住地和日常地點會保留。此操作無法撤銷。"
          }
        }
      }
    },
