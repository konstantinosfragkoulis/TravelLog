    "View the tracking health dashboard and raw stay data for debugging." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se kontrolpanelet for sporingsstatus og rå opholdsdata til fejlfinding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt zur Fehlerdiagnose das Dashboard zum Aufzeichnungszustand und die Rohdaten der Aufenthalte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προβολή του πίνακα κατάστασης καταγραφής και των ανεπεξέργαστων δεδομένων παραμονών για εντοπισμό σφαλμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "View the tracking health dashboard and raw stay data for debugging."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulte el panel de estado del seguimiento y los datos sin procesar de las estancias para depurar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez le tableau de santé du suivi et les données brutes des séjours à des fins de diagnostic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza il pannello di stato del monitoraggio e i dati grezzi dei soggiorni per il debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグ用に記録状態のダッシュボードと滞在の生データを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디버깅을 위해 추적 상태 대시보드와 원시 체류 데이터를 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis instrumentpanelet for sporingsstatus og rådata om opphold for feilsøking."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk het dashboard voor de volgstatus en ruwe verblijfsgegevens voor foutopsporing."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o painel de integridade do rastreamento e os dados brutos das estadias para diagnóstico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o painel de estado do acompanhamento e os dados brutos das estadias para diagnóstico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa instrumentpanelen för spårningsstatus och rådata om vistelser för felsökning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hata ayıklamak için takip durumu panosunu ve ham konaklama verilerini görüntüleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem bảng tình trạng theo dõi và dữ liệu lưu trú thô để gỡ lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看记录运行状况面板和原始停留数据以进行调试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
