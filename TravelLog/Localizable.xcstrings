    "Enable calendar access in Settings to detect upcoming trips." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå kalenderadgang til i Indstillinger for at registrere kommende rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Kalenderzugriff in den Einstellungen, um bevorstehende Reisen zu erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησε την πρόσβαση στο ημερολόγιο στις Ρυθμίσεις για να εντοπίζονται επερχόμενα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enable calendar access in Settings to detect upcoming trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active el acceso al calendario en Ajustes para detectar próximos viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès au calendrier dans Réglages pour détecter les voyages à venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
