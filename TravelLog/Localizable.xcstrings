    "collections.flight-times.footer.on-confirm" : {
      "comment" : "Footer under the times set for a possible flight, which are kept only if the user confirms it.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiderne gemmes, når du bekræfter flyrejsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeiten werden gespeichert, wenn Sie den Flug bestätigen."
          }
        },
        "el" : {
          "stringUnit" : {
