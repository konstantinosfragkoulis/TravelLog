    "tracking.issue.reduced-accuracy.description" : {
      "comment" : "Instructions for enabling Precise Location for Travel Log.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Indstillinger → Travel Log → Lokalitet, og slå Præcis lokalitet til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Einstellungen → Travel Log → Standort und aktivieren Sie „Genauer Standort“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πήγαινε στις Ρυθμίσεις → Travel Log → Τοποθεσία και ενεργοποίησε την «Ακριβή τοποθεσία»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to Settings → Travel Log → Location and turn on Precise Location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaya a Ajustes → Travel Log → Ubicación y active Ubicación exacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à Réglages → Travel Log → Localisation et activez « Position exacte »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai in Impostazioni → Travel Log → Posizione e attiva Posizione esatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」→「Travel Log」→「位置情報」で「正確な位置情報」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → Travel Log → 위치에서 정확한 위치를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Innstillinger → Travel Log → Sted, og slå på Nøyaktig posisjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga naar Instellingen → Travel Log → Locatie en schakel Exacte locatie in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesse Ajustes → Travel Log → Localização e ative Localização Precisa."
