        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한동안 그곳에 사셨나요? 임시 거주지를 설정하면 그곳에서 떠난 여행이 따로 집계돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodde du der en stund? Opprett et midlertidig hjem, så teller reisene dine derfra for seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woonde je daar een tijdje? Stel een tijdelijk thuis in, zodat je reizen vanaf daar apart tellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morou lá por um tempo? Configure uma casa temporária para que suas viagens a partir de lá contem separadamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viveu lá durante algum tempo? Configure uma casa temporária para que as suas viagens a partir de lá contem à parte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodde du där ett tag? Skapa ett tillfälligt hem så att dina resor därifrån räknas för sig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süre orada mı yaşadınız? Oradan çıktığınız seyahatlerin ayrı sayılması için bir geçici ev bölgesi ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sống ở đó một thời gian? Hãy thiết lập nhà tạm thời để các chuyến đi từ đó được tính riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曾在那里住过一段时间吗？设置暂住地后，从那里出发的旅程会单独计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曾在那裡住過一段時間嗎？設定暫住地後，從那裡出發的旅程會單獨計算。"
          }
        }
      }
    },
