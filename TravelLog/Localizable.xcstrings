    "root.photo-import.resumable.detail" : {
      "comment" : "Recovery banner detail for a resumable photo import.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt for at fortsætte scanningen af dit fotobibliotek, eller kassér de delvise resultater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzen Sie den Scan Ihrer Fotomediathek fort oder verwerfen Sie die Teilergebnisse."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνέχισε τη σάρωση της βιβλιοθήκης φωτογραφιών σου ή απόρριψε τα μερικά αποτελέσματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Resume to continue scanning your photo library, or discard the partial results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanude para seguir analizando su fototeca o descarte los resultados parciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez pour continuer à analyser votre photothèque, ou abandonnez les résultats partiels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi per continuare la scansione della libreria foto oppure scarta i risultati parziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再開して写真ライブラリのスキャンを続けるか、途中結果を破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 보관함 스캔을 계속하거나 일부 결과를 버리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett for å skanne bildebiblioteket videre, eller forkast delresultatene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervat om je fotobibliotheek verder te scannen of verwerp de gedeeltelijke resultaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
