    "collections.flight-when.footer" : {
      "comment" : "Footer under When did you fly: the data's gap is too long to tell when the flight was, and the answer can be changed.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her mangler der mere end et døgns placeringsdata, så flyrejsen kan ligge i begge ender af hullet. Du kan ændre dit svar senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier fehlen Standortdaten für mehr als einen Tag, daher kann der Flug an beiden Enden der Lücke liegen. Sie können Ihre Antwort später ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εδώ λείπουν δεδομένα τοποθεσίας για πάνω από μία μέρα, οπότε η πτήση μπορεί να ήταν σε οποιοδήποτε άκρο του κενού. Μπορείς να αλλάξεις την απάντησή σου αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over a day of your location data is missing here, so the flight could be at either end of the gap. You can change your answer later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí falta más de un día de datos de ubicación, así que el vuelo pudo ser al principio o al final del hueco. Puedes cambiar tu respuesta más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque ici plus d’une journée de données de localisation : le vol peut se situer au début ou à la fin de ce trou. Vous pourrez modifier votre réponse plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui manca più di un giorno di dati sulla posizione, quindi il volo può essere all’inizio o alla fine del vuoto. Puoi cambiare la risposta in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは位置情報が1日以上欠けているため、フライトは空白の始まりにも終わりにもあり得ます。回答は後で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에는 위치 데이터가 하루 넘게 비어 있어 비행이 공백의 처음일 수도, 끝일 수도 있어요. 답은 나중에 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her mangler det mer enn et døgn med posisjonsdata, så flyreisen kan ligge i begge ender av hullet. Du kan endre svaret senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ontbreekt meer dan een dag aan locatiegegevens, dus de vlucht kan aan het begin of het einde van het gat liggen. Je kunt je antwoord later wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui falta mais de um dia de dados de localização, então o voo pode ter sido no início ou no fim da lacuna. Você pode mudar sua resposta depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui falta mais de um dia de dados de localização, por isso o voo pode ter sido no início ou no fim da falha. Pode alterar a sua resposta mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här saknas mer än ett dygn av platsdata, så flygningen kan ligga i båda ändar av glappet. Du kan ändra ditt svar senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada bir günden uzun süre konum verisi eksik, bu yüzden uçuş boşluğun başında da sonunda da olabilir. Yanıtınızı daha sonra değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở đây thiếu hơn một ngày dữ liệu vị trí, nên chuyến bay có thể ở đầu hoặc cuối khoảng trống. Bạn có thể đổi câu trả lời sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里缺少超过一天的位置数据，航班可能在空白的开头或结尾。你之后可以更改答案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡缺少超過一天的位置資料，航班可能在空白的開頭或結尾。你之後可以更改答案。"
          }
        }
      }
    },
    "collections.flight-when.question" : {
      "comment" : "Flight detail question when the data's gap is a day or more, so the flight could sit at either end of it.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvornår fløj du?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann sind Sie geflogen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πότε πέταξες;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When did you fly?"
          }
        },
        "es" : {
