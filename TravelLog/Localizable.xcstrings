          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reizen of woningen zijn gewijzigd terwijl dit openstond. Bekijk de bijgewerkte voorvertoning en deel opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas viagens ou casas mudaram enquanto isto estava aberto. Confira a prévia atualizada e compartilhe novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas viagens ou casas mudaram enquanto isto estava aberto. Verifique a pré-visualização atualizada e partilhe novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
