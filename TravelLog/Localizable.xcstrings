    "stats.this-year.footnote" : {
      "comment" : "Stats This Year card footnote explaining what each number counts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejsedage inkluderer en igangværende rejse. Rejser og lande tælles ud fra afsluttede rejser i det år, rejserne begyndte. Registreret første gang tæller lande, der er registreret for første gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisetage schließen eine laufende Reise ein. Reisen und Länder werden anhand abgeschlossener Reisen dem Jahr des Reisebeginns zugeordnet. Erstmals erfasst zählt Länder, die zum ersten Mal erfasst wurden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ημέρες ταξιδιού περιλαμβάνουν και ταξίδι σε εξέλιξη. Τα ταξίδια και οι χώρες υπολογίζονται από ολοκληρωμένα ταξίδια, στο έτος έναρξής τους. Η πρώτη καταγραφή μετρά χώρες που καταγράφηκαν για πρώτη φορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel days include a trip in progress. Trips and countries count finished trips in the year they started. First recorded counts countries recorded for the first time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días de viaje incluyen un viaje en curso. Los viajes y países se cuentan a partir de viajes finalizados y se asignan al año en que comenzaron. Primer registro cuenta los países registrados por primera vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours de voyage incluent un voyage en cours. Les voyages terminés et les pays visités lors de ces voyages sont comptés dans l’année de début du voyage. Premier enregistrement compte les pays enregistrés pour la première fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni di viaggio includono un viaggio in corso. I viaggi conclusi e i paesi visitati durante tali viaggi sono conteggiati nell’anno di inizio del viaggio. Prima registrazione conta i paesi registrati per la prima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行日数には進行中の旅行も含まれます。旅行数と国数は、終了した旅行を開始年に計上します。「初めて記録」は、初めて記録された国の数です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 일수에는 진행 중인 여행도 포함돼요. 여행과 국가 수는 완료된 여행을 기준으로 여행을 시작한 연도에 집계돼요. 처음 기록은 처음으로 기록된 국가 수예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisedager inkluderer en pågående reise. Reiser og land telles ut fra avsluttede reiser og føres på året reisen startet. Registrert for første gang teller land som er registrert for første gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisdagen tellen ook een lopende reis mee. Reizen en landen worden geteld op basis van voltooide reizen en toegerekend aan het jaar waarin de reis begon. Eerste registratie telt landen die voor het eerst zijn vastgelegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias de viagem incluem uma viagem em andamento. As viagens concluídas e os países visitados nelas são contabilizados no ano de início da viagem. Primeiro registro conta os países registrados pela primeira vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias de viagem incluem uma viagem em curso. As viagens concluídas e os países visitados nelas são contabilizados no ano de início da viagem. Primeiro registo conta os países registados pela primeira vez."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resdagar inkluderar en pågående resa. Resor och länder räknas utifrån avslutade resor och förs till året då resan började. Registrerat för första gången räknar länder som registrerats för första gången."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahat günlerine devam eden seyahat de dahildir. Seyahat ve ülke sayıları, tamamlanan seyahatler üzerinden seyahatin başladığı yıla yazılır. İlk Kez Kaydedilen, ilk kez kaydedilen ülkeleri sayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày du lịch bao gồm cả chuyến đi đang diễn ra. Số chuyến đi và quốc gia được tính từ các chuyến đi đã kết thúc, theo năm bắt đầu chuyến đi. Lần đầu ghi nhận tính các quốc gia được ghi nhận lần đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行日包含进行中的旅程。旅程数和国家/地区数仅统计已结束的旅程，并计入旅程开始的年份。首次记录统计首次被记录的国家/地区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行日包含進行中的旅程。旅程數和國家或地區數僅統計已結束的旅程，並計入旅程開始的年份。首次記錄統計首次被記錄的國家或地區。"
          }
        }
      }
    },
