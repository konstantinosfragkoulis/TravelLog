    "collections.flight-times.footer.air-time" : {
      "comment" : "Footer under a flight's route, inviting the user to set the real departure and arrival times instead of the air time estimated from the distance.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden i luften er anslået ud fra afstanden. Hvis du ved, hvornår du fløj, så angiv tiderne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flugzeit ist aus der Entfernung geschätzt. Wenn Sie wissen, wann Sie geflogen sind, legen Sie die Zeiten fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρόνος πτήσης εκτιμάται από την απόσταση. Αν ξέρεις πότε πέταξες, όρισε τις ώρες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air time is estimated from the distance. If you know when you flew, set the times."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo de vuelo se estima a partir de la distancia. Si sabes cuándo volaste, indica las horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La durée de vol est estimée d’après la distance. Si vous savez quand vous avez volé, indiquez les horaires."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di volo è stimato dalla distanza. Se sai quando hai volato, imposta gli orari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飛行時間は距離から推定しています。飛んだ時刻がわかる場合は、時刻を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비행 시간은 거리로 추정한 값이에요. 언제 비행했는지 알면 시간을 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden i luften er anslått ut fra avstanden. Hvis du vet når du fløy, angir du tidene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vliegtijd is geschat op basis van de afstand. Weet je wanneer je vloog, stel dan de tijden in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de voo é estimado pela distância. Se você sabe quando voou, defina os horários."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo de voo é estimado a partir da distância. Se sabe quando voou, defina as horas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flygtiden är uppskattad utifrån avståndet. Om du vet när du flög kan du ange tiderna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçuş süresi mesafeden tahmin edilir. Ne zaman uçtuğunuzu biliyorsanız saatleri ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian bay được ước tính từ khoảng cách. Nếu bạn biết mình bay lúc nào, hãy đặt giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飞行时长根据距离估算。如果你知道自己何时飞行，请设置时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飛行時長根據距離估算。如果你知道自己何時飛行，請設定時間。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}