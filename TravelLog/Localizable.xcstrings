    "settings.wrapped.generation-failure.insufficient-data" : {
      "comment" : "Failure message when the requested year has too little travel data for a Wrapped; the argument is the year.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er endnu ikke registreret nok rejser i %@ til at oprette Året der gik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Jahresrückblick %@ sind noch nicht genügend Reisen erfasst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχουν καταγραφεί ακόμα αρκετά ταξίδια το %@ για να δημιουργηθεί η χρονιά σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There isn't enough travel recorded in %@ yet to build a Wrapped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay suficientes viajes registrados en %@ para crear el resumen del año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas encore assez de voyages enregistrés en %@ pour créer une rétrospective."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono ancora stati registrati abbastanza viaggi nel %@ per creare il riepilogo dell’anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@年の旅の振り返りを作成するには、旅行の記録がまだ足りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@년 한 해 돌아보기를 만들기에는 아직 여행 기록이 부족해요."
          }
        },
        "nb" : {
          "stringUnit" : {
