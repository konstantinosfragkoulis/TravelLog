    "notification.country-welcome.body" : {
      "comment" : "Notification body shown after arriving in another country.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er ankommet til %@. God rejse!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind in %@ angekommen. Genießen Sie Ihre Reise!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έφτασες! Προορισμός: %@. Καλό ταξίδι!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've arrived in %@. Enjoy your trip!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha llegado a %@. ¡Disfrute del viaje!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes arrivé à %@. Profitez bien de votre voyage !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei arrivato in %@. Buon viaggio!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に到着しました。旅行をお楽しみください！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 도착했어요. 즐거운 여행 되세요!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ankommet %@. God tur!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent aangekomen in %@. Geniet van je reis!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você chegou a %@. Aproveite a viagem!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chegou a %@. Aproveite a viagem!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har anlänt till %@. Trevlig resa!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ülkesine vardınız. İyi seyahatler!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đến %@. Chúc bạn có chuyến đi vui vẻ!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已抵达 %@。祝旅途愉快！"
