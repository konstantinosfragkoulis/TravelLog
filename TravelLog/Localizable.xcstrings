        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、新しいタイトルを生成できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 새 제목을 생성할 수 없어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lage en ny tittel akkurat nå. Prøv igjen om litt."
