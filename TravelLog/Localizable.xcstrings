    "settings.homes.footer.trip-boundary" : {
      "comment" : "Footer of the Homes section in Settings: several homes are allowed, arriving at one ends a trip, and an occasional vacation house is better left out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan have flere hjem, og en rejse slutter, når du ankommer til et af dem. Undlad at registrere et feriehus, du kun besøger af og til, så besøgene stadig tæller som rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können mehrere Zuhause haben. Die Ankunft an einem davon beendet eine Reise. Tragen Sie ein nur gelegentlich besuchtes Ferienhaus nicht ein, damit diese Besuche weiterhin als Reisen zählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείς να έχεις περισσότερες από μία κατοικίες και η άφιξη σε οποιαδήποτε από αυτές τερματίζει ένα ταξίδι. Μην καταχωρίζεις ένα εξοχικό που επισκέπτεσαι μόνο περιστασιακά, ώστε αυτές οι επισκέψεις να παραμένουν ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can have more than one home, and arriving at any of them ends a trip. Leave a vacation house you visit only now and then unregistered, so those visits stay trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede tener varias residencias, y llegar a cualquiera de ellas finaliza un viaje. No registre una casa de vacaciones que solo visita de vez en cuando para que esas visitas sigan contando como viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez avoir plusieurs domiciles. L’arrivée à l’un d’eux termine un voyage. N’enregistrez pas une maison de vacances où vous ne séjournez qu’occasionnellement, afin que ces visites restent des voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi avere più case e arrivare in una qualsiasi di esse conclude un viaggio. Non registrare una casa vacanze che visiti solo ogni tanto, così quelle visite restano viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅は複数登録でき、いずれかに到着すると旅行が終了します。たまにしか訪れない別荘は登録しないでおくと、その訪問を旅行として記録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집을 여러 곳 등록할 수 있으며, 어느 집에 도착하든 여행이 끝나요. 가끔만 방문하는 별장은 등록하지 않아야 그곳 방문이 여행으로 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ha flere hjem, og en reise avsluttes når du ankommer et av dem. Ikke registrer en feriebolig du bare besøker av og til, slik at besøkene fortsatt regnes som reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt meerdere thuislocaties hebben. Aankomen bij een ervan beëindigt een reis. Registreer een vakantiehuis dat je maar af en toe bezoekt niet, zodat die bezoeken reizen blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode ter mais de uma casa, e chegar a qualquer uma delas encerra uma viagem. Não cadastre uma casa de férias que visita só de vez em quando, para que essas visitas continuem sendo viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ter várias residências, e chegar a qualquer uma delas termina uma viagem. Não registe uma casa de férias que visita apenas de vez em quando, para que essas visitas continuem a ser viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ha flera hem, och en resa avslutas när du kommer till något av dem. Registrera inte ett fritidshus som du bara besöker ibland, så att besöken fortsätter räknas som resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla ev bölgeniz olabilir ve bunlardan herhangi birine varmak seyahati bitirir. Yalnızca ara sıra gittiğiniz bir yazlığı kaydetmeyin; böylece bu ziyaretler seyahat olarak kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể có nhiều nhà; đến bất kỳ nhà nào cũng kết thúc chuyến đi. Đừng đăng ký nhà nghỉ dưỡng mà bạn chỉ thỉnh thoảng ghé để những lần ghé đó vẫn là chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以设置多个常住地，到达其中任意一个都会结束旅程。对于偶尔才去的度假屋，请不要登记为常住地，以便将这些到访保留为旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以設定多個居住地，抵達其中任何一個都會結束旅程。偶爾才去的度假屋請不要登記為居住地，讓這些造訪仍保留為旅程。"
          }
        }
      }
    },
    "settings.icloud.footer" : {
      "comment" : "Footer of the Settings Tracking & Sync section explaining iCloud Sync.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
