          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a las fotos. Concédalo en Ajustes de iOS → Privacidad → Fotos → TravelLog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
