    "photo-import.persisted-error.low-power-mode" : {
      "comment" : "Persisted photo-import status when Low Power Mode pauses an import.",
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat på pause: Energibesparende funktion er slået til. Slå den fra (Indstillinger → Batteri → Energibesparende funktion), eller slut din iPhone til strøm, og fortsæt derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angehalten: Der Stromsparmodus ist aktiviert. Deaktivieren Sie ihn unter Einstellungen → Batterie → Stromsparmodus oder schließen Sie Ihr iPhone an, und setzen Sie dann fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε παύση: Η Λειτουργία χαμηλής ισχύος είναι ενεργή. Απενεργοποίησέ την (Ρυθμίσεις → Μπαταρία → Λειτουργία χαμηλής ισχύος) ή σύνδεσε το iPhone σου στο ρεύμα και μετά συνέχισε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paused: Low Power Mode is enabled. Disable it (Settings → Battery → Low Power Mode) or plug in your iPhone, then resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: el modo de bajo consumo está activado. Desactívelo (Ajustes → Batería → Modo de bajo consumo) o conecte el iPhone y reanude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause : le mode économie d’énergie est activé. Désactivez-le (Réglages → Batterie → Mode économie d’énergie) ou branchez votre iPhone, puis reprenez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa: Risparmio energetico è attivo. Disattivalo in Impostazioni → Batteria → Risparmio energetico oppure collega l’iPhone all’alimentazione, quindi riprendi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中：低電力モードが有効です。無効にする（「設定」→「バッテリー」→「低電力モード」）かiPhoneを電源に接続してから再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지됨: 저전력 모드가 켜져 있어요. 끄거나(설정 → 배터리 → 저전력 모드) iPhone을 전원에 연결한 후 계속하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satt på pause: Strømsparingsmodus er på. Slå den av (Innstillinger → Batteri → Strømsparingsmodus), eller koble iPhone til strøm, og fortsett deretter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerd: energiebesparingsmodus is ingeschakeld. Schakel deze uit (Instellingen → Batterij → Energiebesparingsmodus) of sluit je iPhone aan en hervat daarna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado: o Modo Pouca Energia está ativado. Desative-o (Ajustes → Bateria → Modo Pouca Energia) ou conecte o iPhone à energia e retome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa: o Modo de baixo consumo está ativado. Desative-o (Definições → Bateria → Modo de baixo consumo), ligue o iPhone à corrente e retome."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausad: Strömsparläge är aktiverat. Avaktivera det (Inställningar → Batteri → Strömsparläge) eller anslut din iPhone till ström och fortsätt sedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatıldı: Düşük Güç Modu açık. Kapatın (Ayarlar → Pil → Düşük Güç Modu) veya iPhone'unuzu güç kaynağına bağlayıp sürdürün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tạm dừng: Chế độ nguồn điện thấp đang bật. Hãy tắt (Cài đặt → Pin → Chế độ nguồn điện thấp) hoặc cắm sạc iPhone, rồi tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停：低电量模式已开启。请将其关闭（“设置”→“电池”→“低电量模式”）或为 iPhone 接通电源，然后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暫停：低耗電模式已開啟。請將其關閉（「設定」→「電池」→「低耗電模式」）或為 iPhone 接通電源，然後繼續。"
          }
        }
      }
    },
    "photo-import.persisted-error.permission-revoked" : {
      "comment" : "Persisted photo-import error shown after photo permission is revoked.",
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til billeder blev trukket tilbage. Giv adgang igen under iOS-indstillinger → Anonymitet & sikkerhed → Fotos → TravelLog, og fortsæt derefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fotozugriff wurde widerrufen. Erteilen Sie ihn erneut unter iOS-Einstellungen → Datenschutz & Sicherheit → Fotos → TravelLog, und setzen Sie dann fort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στις φωτογραφίες ανακλήθηκε. Παραχώρησέ την ξανά στις Ρυθμίσεις iOS → Απόρρητο → Φωτογραφίες → TravelLog και μετά συνέχισε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photo access was revoked. Re-grant in iOS Settings → Privacy → Photos → TravelLog, then resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revocó el acceso a las fotos. Concédalo de nuevo en Ajustes de iOS → Privacidad → Fotos → TravelLog y reanude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos a été révoqué. Accordez-le à nouveau dans Réglages iOS → Confidentialité → Photos → TravelLog, puis reprenez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alle foto è stato revocato. Concedilo di nuovo in Impostazioni di iOS → Privacy → Foto → TravelLog, quindi riprendi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスが取り消されました。「iOS設定」→「プライバシー」→「写真」→「TravelLog」で再度許可してから再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 접근이 철회되었어요. iOS 설정 → 개인정보 보호 → 사진 → TravelLog에서 다시 허용한 후 계속하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildetilgangen ble trukket tilbake. Gi tilgang på nytt i iOS-innstillinger → Personvern og sikkerhet → Bilder → TravelLog, og fortsett deretter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fototoegang is ingetrokken. Geef opnieuw toegang via iOS-instellingen → Privacy en beveiliging → Foto’s → TravelLog en hervat daarna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotos foi revogado. Conceda-o novamente em Ajustes do iOS → Privacidade → Fotos → TravelLog e retome."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às fotografias foi revogado. Conceda-o novamente em Definições do iOS → Privacidade → Fotografias → TravelLog e retome."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildåtkomsten återkallades. Ge åtkomst igen i iOS Inställningar → Integritet → Bilder → TravelLog och fortsätt sedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf erişimi kaldırıldı. iOS Ayarlar → Gizlilik → Fotoğraflar → TravelLog yolundan yeniden izin verip sürdürün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập ảnh đã bị thu hồi. Cấp lại trong Cài đặt iOS → Quyền riêng tư → Ảnh → TravelLog, rồi tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片访问权限已被撤销。请在 iOS“设置”→“隐私与安全性”→“照片”→ TravelLog 中重新授予权限，然后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片取用權限已被撤銷。請在 iOS「設定」→「隱私權與安全性」→「照片」→ TravelLog 中重新授予權限，然後繼續。"
          }
        }
      }
    },
    "photo-import.persisted-error.thermal" : {
      "comment" : "Persisted photo-import status when critical device temperature pauses an import.",
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat på pause: Enheden er kritisk varm. Prøv igen, når den er kølet af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angehalten: Das Gerät befindet sich in einem kritischen Temperaturzustand. Versuchen Sie es nach dem Abkühlen erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε παύση: η συσκευή βρίσκεται σε κρίσιμη θερμική κατάσταση. Δοκίμασε ξανά όταν κρυώσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Paused: device is in a critical thermal state. Try again when it has cooled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: el dispositivo está en un estado térmico crítico. Inténtelo de nuevo cuando se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause : la température de l’appareil a atteint un niveau critique. Réessayez une fois l’appareil refroidi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa: il dispositivo ha raggiunto una temperatura critica. Riprova quando si sarà raffreddato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止中：デバイスが重大な高温状態です。温度が下がってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일시 정지됨: 기기가 위험한 고온 상태예요. 식은 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satt på pause: Enheten har kritisk høy temperatur. Prøv igjen når den er avkjølt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerd: het apparaat is kritiek warm. Probeer het opnieuw nadat het is afgekoeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausado: o dispositivo está em estado térmico crítico. Tente novamente quando ele esfriar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em pausa: o dispositivo atingiu um estado térmico crítico. Tente novamente quando arrefecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausad: enhetens temperatur är kritisk. Försök igen när den har svalnat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklatıldı: Aygıtın sıcaklığı kritik düzeyde. Soğuduğunda yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tạm dừng: thiết bị đang ở trạng thái nhiệt độ nghiêm trọng. Hãy thử lại khi thiết bị nguội."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停：设备温度达到临界状态。请待设备冷却后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暫停：裝置溫度達到臨界狀態。請待裝置冷卻後重試。"
          }
        }
      }
    },
