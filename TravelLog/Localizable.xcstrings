    "home.unmapped.confirmation" : {
      "comment" : "Confirmation shown before saving a home whose reverse geocode found neither a locality nor an administrative area.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne lokalitet ser ud til ikke at være kortlagt eller til at ligge på havet. Registrering af rejser genkender muligvis ikke, når du vender hjem. Gem alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Standort scheint nicht kartiert zu sein oder auf dem Meer zu liegen. Die Reiseerkennung erkennt möglicherweise nicht, wenn Sie nach Hause zurückkehren. Trotzdem sichern?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία αυτή φαίνεται να μην είναι χαρτογραφημένη ή να βρίσκεται στη θάλασσα. Ο εντοπισμός ταξιδιών μπορεί να μην αναγνωρίζει ότι επέστρεψες στην κατοικία σου. Θέλεις να την αποθηκεύσεις παρ’ όλα αυτά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This location looks unmapped or at sea. Trip detection may not recognize returns home. Save anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que esta ubicación no está cartografiada o está en el mar. Es posible que la detección de viajes no reconozca los regresos a casa. ¿Guardar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette position semble ne pas être cartographiée ou se trouver en mer. La détection des voyages risque de ne pas reconnaître vos retours chez vous. Enregistrer quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa posizione sembra non essere sulla mappa o trovarsi in mare. Il rilevamento dei viaggi potrebbe non riconoscere i rientri a casa. Salvare comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この位置情報は地図にないか、海上にあるようです。旅行の検出では帰宅を認識できない可能性があります。それでも保存しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 위치는 지도에 없거나 바다 위에 있는 것 같아요. 여행 감지에서 귀가를 인식하지 못할 수 있어요. 그래도 저장할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne posisjonen ser ut til å være utenfor kartet eller ute på havet. Reiseregistreringen gjenkjenner kanskje ikke at du kommer hjem. Lagre likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze locatie lijkt niet op de kaart te staan of op zee te liggen. Reisdetectie herkent mogelijk niet dat je thuiskomt. Toch bewaren?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este local parece não estar mapeado ou estar no mar. A detecção de viagens talvez não reconheça quando você volta para casa. Salvar mesmo assim?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta localização parece não estar mapeada ou encontrar-se no mar. A deteção de viagens poderá não reconhecer o regresso a casa. Guardar mesmo assim?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här platsen verkar saknas på kartan eller ligga ute till havs. Resedetekteringen kanske inte känner igen när du kommer hem. Spara ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konum haritada yer almıyor veya denizde gibi görünüyor. Seyahat algılama, eve dönüşleri tanımayabilir. Yine de kaydedilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí này có vẻ chưa được lập bản đồ hoặc nằm ngoài biển. Tính năng phát hiện chuyến đi có thể không nhận ra khi bạn trở về nhà. Vẫn lưu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位置似乎未标注在地图上或位于海上。旅程检测可能无法识别您返回常住地的情况。仍要保存吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位置似乎未標示在地圖上或位於海上。旅程偵測可能無法識別您返回居住地的情況。仍要儲存嗎？"
          }
        }
      }
    },
