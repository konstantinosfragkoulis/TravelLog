    "settings.calendar-match.none" : {
      "comment" : "Calendar matching result when no trip titles or flights were updated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen rejser skulle opdateres. Intet i din kalender matchede bedre end det, der allerede findes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Reise musste aktualisiert werden. Nichts in Ihrem Kalender passte besser als die bereits vorhandenen Angaben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα ταξίδι δεν χρειαζόταν ενημέρωση. Τίποτα στο ημερολόγιό σου δεν αντιστοιχούσε καλύτερα από τα υπάρχοντα στοιχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No trips needed updating. Nothing in your calendar matched better than what's already there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No era necesario actualizar ningún viaje. Nada del calendario coincidía mejor que los datos existentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun voyage n’avait besoin d’être mis à jour. Aucun élément de votre calendrier ne correspond mieux que les données existantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun viaggio richiedeva aggiornamenti. Gli elementi del calendario non offrivano corrispondenze migliori di quelle esistenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新が必要な旅行はありませんでした。カレンダーに、現在の情報より適切な一致はありませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트가 필요한 여행이 없어요. 캘린더에 기존 정보보다 더 잘 일치하는 항목이 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen reiser måtte oppdateres. Ingenting i kalenderen samsvarte bedre enn det som allerede finnes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen reizen hoefden te worden bijgewerkt. Niets in je agenda kwam beter overeen dan wat er al staat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma viagem precisava ser atualizada. Nada no seu calendário correspondeu melhor do que os dados existentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi necessário atualizar nenhuma viagem. Nada no seu calendário correspondeu melhor do que os dados existentes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga resor behövde uppdateras. Inget i kalendern matchade bättre än det som redan finns."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellenmesi gereken seyahat yok. Takviminizdeki hiçbir öğe mevcut bilgilerden daha iyi eşleşmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có chuyến đi nào cần cập nhật. Không có nội dung nào trong lịch khớp tốt hơn dữ liệu hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有旅程需要更新。日历中没有比现有信息更匹配的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有旅程需要更新。行事曆中沒有比現有資訊更比對的內容。"
          }
        }
      }
    },
    "settings.calendar-selection.unavailable-notice" : {
      "comment" : "Calendar selection notice when every calendar the user checked has disappeared from this device (account removed or calendar deleted).",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af de kalendere, du har markeret, er tilgængelige, så Travel Log læser ikke nogen kalender. Markér de kalendere, der skal bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keiner der ausgewählten Kalender ist verfügbar, daher liest Travel Log keinen Kalender. Wählen Sie die Kalender aus, die verwendet werden sollen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα από τα ημερολόγια που επέλεξες δεν είναι διαθέσιμο, οπότε το Travel Log δεν διαβάζει κανένα ημερολόγιο. Επίλεξε τα ημερολόγια που θα χρησιμοποιούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of the calendars you checked are available, so Travel Log isn't reading any calendar. Check the calendars to use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de los calendarios que marcó está disponible, así que Travel Log no lee ningún calendario. Marque los calendarios que desea usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun des calendriers cochés n’est disponible, Travel Log ne lit donc aucun calendrier. Cochez les calendriers à utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei calendari selezionati è disponibile, quindi Travel Log non legge alcun calendario. Seleziona i calendari da usare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックしたカレンダーはいずれも利用できないため、Travel Logはどのカレンダーも読み取っていません。使用するカレンダーをチェックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 캘린더를 모두 사용할 수 없어 Travel Log가 어떤 캘린더도 읽지 않고 있어요. 사용할 캘린더를 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av kalenderne du har merket av, er tilgjengelige, så Travel Log leser ingen kalender. Merk av kalenderne som skal brukes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen van de agenda’s die je hebt aangevinkt is beschikbaar, dus Travel Log leest geen enkele agenda. Vink de agenda’s aan die gebruikt moeten worden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dos calendários que você marcou está disponível, então o Travel Log não está lendo nenhum calendário. Marque os calendários que devem ser usados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dos calendários que selecionou está disponível, pelo que o Travel Log não está a ler nenhum calendário. Selecione os calendários a utilizar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av kalendrarna du har markerat är tillgänglig, så Travel Log läser ingen kalender. Markera de kalendrar som ska användas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretlediğiniz takvimlerin hiçbiri kullanılamıyor, bu nedenle Travel Log hiçbir takvimi okumuyor. Kullanılacak takvimleri işaretleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không lịch nào bạn đã chọn hiện có sẵn, vì vậy Travel Log không đọc lịch nào. Hãy chọn các lịch cần dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您勾选的日历均不可用，因此 Travel Log 不会读取任何日历。请勾选要使用的日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您勾選的行事曆均無法使用，因此 Travel Log 不會讀取任何行事曆。請勾選要使用的行事曆。"
          }
        }
      }
    },
    "settings.calendar.footer" : {
      "comment" : "Settings footer explaining Calendar access, storage, private iCloud sync, and data actions.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log læser din kalender for at finde kommende rejser og bekræfte flyrejser på tidligere rejser. Appen opretter, redigerer eller sletter aldrig begivenheder. iOS tilbyder ganske enkelt ikke en skrivebeskyttet tilladelse. Oplysninger om begivenheder, der bruges til at registrere rejser, gemmes på din enhed og synkroniseres via din private iCloud, når synkronisering er slået til. Noter gemmes aldrig. Kalenderbegivenheder vises aldrig i rejsetitler. “Match” forsøger igen at registrere flyrejser for ældre rejser. “Slet” fjerner registrerede kommende rejser og opretter AI-titler igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log liest Ihren Kalender, um bevorstehende Reisen zu erkennen und Flüge vergangener Reisen zu bestätigen. Ereignisse werden niemals erstellt, bearbeitet oder gelöscht. iOS bietet lediglich keine Nur-Lese-Berechtigung. Ereignisdetails, die zur Reiseerkennung verwendet werden, werden auf Ihrem Gerät gespeichert und über Ihre private iCloud synchronisiert, wenn die Synchronisierung aktiviert ist; Notizen werden nie gespeichert. Kalenderereignisse erscheinen nie in Reisetiteln. „Abgleichen“ versucht erneut, Flüge älterer Reisen zu erkennen. „Löschen“ entfernt erkannte bevorstehende Reisen und erstellt KI-Titel neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log διαβάζει το ημερολόγιό σου για να εντοπίζει επερχόμενα ταξίδια και να επιβεβαιώνει πτήσεις σε παλαιότερα. Δεν δημιουργεί, επεξεργάζεται ή διαγράφει ποτέ συμβάντα. Το iOS απλώς δεν προσφέρει άδεια αποκλειστικά για ανάγνωση. Οι λεπτομέρειες των συμβάντων που χρησιμοποιούνται για τον εντοπισμό ταξιδιών αποθηκεύονται στη συσκευή σου και συγχρονίζονται μέσω του ιδιωτικού σου iCloud όταν είναι ενεργός ο συγχρονισμός· οι σημειώσεις δεν αποθηκεύονται ποτέ. Τα συμβάντα του ημερολογίου δεν εμφανίζονται ποτέ στους τίτλους ταξιδιών. Η «Αντιστοίχιση» δοκιμάζει ξανά τον εντοπισμό πτήσεων για παλαιότερα ταξίδια· η «Διαγραφή» αφαιρεί τα επερχόμενα ταξίδια που εντοπίστηκαν και δημιουργεί ξανά τους τίτλους AI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log reads your calendar to spot upcoming trips and confirm flights on past ones. It never creates, edits, or deletes events. iOS just doesn't offer a read-only permission. Event details used for trip detection are stored on your device and sync through your private iCloud when sync is enabled; notes are never stored. Calendar events never appear in trip titles. “Match” retries flight detection for older trips; “Delete” removes detected upcoming trips and regenerates AI titles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log lee su calendario para detectar próximos viajes y confirmar vuelos de los anteriores. Nunca crea, edita ni elimina eventos. iOS no ofrece un permiso de solo lectura. Los detalles de los eventos que se usan para detectar viajes se almacenan en su dispositivo y se sincronizan mediante su iCloud privado cuando la sincronización está activada; las notas nunca se almacenan. Los eventos del calendario nunca aparecen en los títulos de los viajes. “Vincular” vuelve a intentar la detección de vuelos de viajes anteriores; “Eliminar” borra los próximos viajes detectados y regenera los títulos de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log lit votre calendrier pour repérer les voyages à venir et confirmer les vols des voyages passés. L’app ne crée, ne modifie et ne supprime jamais d’événements. iOS ne propose simplement pas d’autorisation en lecture seule. Les détails des événements utilisés pour détecter les voyages sont conservés sur votre appareil et synchronisés via votre espace iCloud privé lorsque la synchronisation est activée ; les notes ne sont jamais conservées. Les événements du calendrier n’apparaissent jamais dans les titres de voyage. « Associer » relance la détection des vols pour les anciens voyages ; « Supprimer » efface les voyages à venir détectés et régénère les titres de l’IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log legge il calendario per individuare i prossimi viaggi e confermare i voli di quelli passati. Non crea, modifica o elimina mai gli eventi. iOS non offre un’autorizzazione di sola lettura. I dettagli degli eventi usati per rilevare i viaggi vengono archiviati sul dispositivo e sincronizzati tramite il tuo iCloud privato quando la sincronizzazione è attiva; le note non vengono mai archiviate. Gli eventi del calendario non compaiono mai nei titoli dei viaggi. “Abbina” riprova a rilevare i voli dei viaggi meno recenti; “Elimina” rimuove i prossimi viaggi rilevati e rigenera i titoli IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logはカレンダーを読み取り、今後の旅行を見つけたり、過去の旅行のフライトを確認したりします。イベントを作成、編集、削除することはありません。iOSには読み取り専用の許可がないためです。旅行の検出に使用するイベントの詳細はデバイスに保存され、同期が有効な場合はプライベートなiCloudを通じて同期されます。メモが保存されることはありません。カレンダーのイベントが旅行タイトルに表示されることはありません。「照合」は古い旅行のフライト検出を再試行します。「削除」は検出された今後の旅行を削除し、AIタイトルを再生成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log는 캘린더를 읽어 예정 여행을 찾고 과거 여행의 항공편을 확인하는 데 활용해요. 이벤트를 생성, 편집 또는 삭제하지 않아요. iOS에서 읽기 전용 권한을 제공하지 않을 뿐이에요. 여행 감지에 사용되는 이벤트 세부 정보는 기기에 저장되며, 동기화가 켜져 있으면 비공개 iCloud를 통해 동기화돼요. 메모는 저장되지 않아요. 캘린더 이벤트는 여행 제목에 표시되지 않아요. “연결”은 이전 여행의 항공편 감지를 다시 시도하고, “삭제”는 감지된 예정 여행을 삭제하고 AI 제목을 재생성해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log leser kalenderen din for å finne kommende reiser og bekrefte flyreiser på tidligere reiser. Appen oppretter, redigerer eller sletter aldri hendelser. iOS tilbyr rett og slett ikke lesetilgang alene. Hendelsesdetaljer som brukes til å registrere reiser, lagres på enheten og synkroniseres via din private iCloud når synkronisering er slått på. Notater lagres aldri. Kalenderhendelser vises aldri i reisetitler. «Finn samsvar» prøver registrering av flyreiser på nytt for eldre reiser. «Slett» fjerner registrerte kommende reiser og lager AI-titler på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log leest je agenda om aankomende reizen te herkennen en vluchten van eerdere reizen te bevestigen. De app maakt, wijzigt of verwijdert nooit activiteiten. iOS biedt simpelweg geen alleen-lezenbevoegdheid. Details van activiteiten die voor reisdetectie worden gebruikt, worden op je apparaat bewaard en via je privé-iCloud gesynchroniseerd wanneer synchronisatie is ingeschakeld; notities worden nooit bewaard. Agenda-activiteiten verschijnen nooit in reistitels. ‘Koppelen’ probeert opnieuw vluchten te detecteren voor oudere reizen; ‘Verwijderen’ wist gedetecteerde aankomende reizen en genereert AI-titels opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log lê seu calendário para identificar próximas viagens e confirmar voos das anteriores. Ele nunca cria, edita nem apaga eventos. O iOS não oferece uma permissão somente de leitura. Os detalhes dos eventos usados para detectar viagens são armazenados no dispositivo e sincronizados pelo seu iCloud privado quando a sincronização está ativada; as notas nunca são armazenadas. Os eventos do calendário nunca aparecem nos títulos das viagens. “Associar” tenta novamente a detecção de voos de viagens antigas; “Apagar” remove as próximas viagens detectadas e gera novamente os títulos de IA."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log lê o seu calendário para identificar próximas viagens e confirmar voos das anteriores. Nunca cria, edita nem apaga eventos. O iOS não oferece uma permissão só de leitura. Os detalhes dos eventos utilizados para detetar viagens são guardados no dispositivo e sincronizados através do seu iCloud privado quando a sincronização está ativada; as notas nunca são guardadas. Os eventos do calendário nunca aparecem nos títulos das viagens. “Associar” volta a tentar a deteção de voos de viagens anteriores; “Apagar” remove as próximas viagens detetadas e volta a gerar os títulos com IA."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log läser din kalender för att upptäcka kommande resor och bekräfta flygningar på tidigare resor. Appen skapar, redigerar eller raderar aldrig händelser. iOS erbjuder helt enkelt ingen skrivskyddad behörighet. Händelseuppgifter som används för att identifiera resor lagras på din enhet och synkroniseras via ditt privata iCloud när synkronisering är aktiverad. Anteckningar lagras aldrig. Kalenderhändelser visas aldrig i resetitlar. ”Matcha” försöker identifiera flygningar för äldre resor igen. ”Radera” tar bort identifierade kommande resor och skapar om AI-titlar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log yaklaşan seyahatleri belirlemek ve geçmiş seyahatlerdeki uçuşları doğrulamak için takviminizi okur. Etkinlik oluşturmaz, düzenlemez veya silmez. iOS yalnızca okuma izni sunmaz. Seyahat algılamada kullanılan etkinlik ayrıntıları aygıtınızda saklanır ve eşzamanlama etkin olduğunda özel iCloud alanınız üzerinden eşzamanlanır; notlar hiçbir zaman saklanmaz. Takvim etkinlikleri seyahat başlıklarında hiçbir zaman görünmez. “Eşleştir”, eski seyahatler için uçuş algılamayı yeniden dener; “Sil”, algılanan yaklaşan seyahatleri kaldırır ve yapay zekâ başlıklarını yeniden oluşturur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log đọc lịch để phát hiện chuyến đi sắp tới và xác nhận chuyến bay của các chuyến đi trước đây. Ứng dụng không bao giờ tạo, sửa hoặc xóa sự kiện. iOS không cung cấp quyền chỉ đọc. Chi tiết sự kiện dùng để phát hiện chuyến đi được lưu trên thiết bị và đồng bộ qua iCloud riêng tư của bạn khi tính năng đồng bộ được bật; ghi chú không bao giờ được lưu. Sự kiện trên lịch không bao giờ xuất hiện trong tiêu đề chuyến đi. “Đối chiếu” sẽ thử lại việc phát hiện chuyến bay cho các chuyến đi cũ; “Xóa” sẽ xóa chuyến đi sắp tới đã phát hiện và tạo lại tiêu đề AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 会读取您的日历以发现即将开始的旅程，并确认过往旅程的航班。它绝不会创建、编辑或删除日程。iOS 不提供只读权限。用于旅程检测的日程详情会存储在您的设备上，并在同步开启时通过您的私人 iCloud 进行同步；绝不会存储备注。日历日程绝不会出现在旅程标题中。“匹配”会为较早的旅程重新尝试航班检测；“删除”会移除检测到的即将开始的旅程，并重新生成 AI 标题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 會讀取您的行事曆以發現即將開始的旅程，並確認過往旅程的航班。它絕不會建立、編輯或刪除行程。iOS 不提供只讀權限。用於旅程偵測的行程詳細資訊會儲存在您的裝置上，並在同步開啟時透過您的私人 iCloud 進行同步；絕不會儲存附註。行事曆行程絕不會出現在旅程標題中。「比對」會為較早的旅程重新嘗試航班偵測；「刪除」會移除偵測到的即將開始的旅程，並重新產生 AI 標題。"
          }
        }
      }
    },
    "settings.calendar.selection-unavailable" : {
      "comment" : "Secondary value on the Settings Calendars row when none of the calendars the user checked is available on this device.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tilgængelige"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine verfügbar"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα διαθέσιμο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None available"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun disponible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno disponibile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能なカレンダーなし"
          }
        },
        "ko" : {
