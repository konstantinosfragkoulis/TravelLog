    "settings.photo-import.error.incomplete-local-data" : {
      "comment" : "Photo import deletion error when required iCloud data is still syncing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle lokalitetsoplysninger synkroniseres stadig fra iCloud. Ingen importerede data blev slettet. Vent, til synkroniseringen er færdig, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Standortdaten werden noch aus iCloud synchronisiert. Es wurden keine importierten Daten gelöscht. Warten Sie auf den Abschluss der Synchronisierung und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορισμένες εγγραφές τοποθεσίας συγχρονίζονται ακόμη από το iCloud. Δεν διαγράφηκαν εισαγμένα δεδομένα. Περίμενε να ολοκληρωθεί ο συγχρονισμός και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some location records are still syncing from iCloud. No imported data was deleted. Wait for sync to finish, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos registros de ubicación aún se sincronizan desde iCloud. No se eliminó ningún dato importado. Espere a que termine e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données de localisation sont encore en cours de synchronisation depuis iCloud. Aucune donnée importée n’a été supprimée. Attendez la fin de la synchronisation, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni dati sulla posizione sono ancora in fase di sincronizzazione da iCloud. Nessun dato importato è stato eliminato. Attendi il termine della sincronizzazione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の位置情報をiCloudから同期中です。読み込んだデータは削除されていません。同期の完了を待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 위치 기록이 아직 iCloud에서 동기화 중이에요. 가져온 데이터는 삭제되지 않았어요. 동기화가 끝난 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen posisjonsoppføringer synkroniseres fortsatt fra iCloud. Ingen importerte data ble slettet. Vent til synkroniseringen er ferdig, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige locatiegegevens worden nog gesynchroniseerd vanuit iCloud. Er zijn geen geïmporteerde gegevens verwijderd. Wacht tot de synchronisatie klaar is en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns registros de localização ainda estão sendo sincronizados pelo iCloud. Nenhum dado importado foi apagado. Aguarde o fim da sincronização e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns registos de localização ainda estão a ser sincronizados pelo iCloud. Nenhum dado importado foi apagado. Aguarde que a sincronização termine e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa platsposter synkroniseras fortfarande från iCloud. Inga importerade data raderades. Vänta tills synkroniseringen är klar och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı konum kayıtları hâlâ iCloud'dan eşzamanlanıyor. İçe aktarılan hiçbir veri silinmedi. Eşzamanlamanın bitmesini bekleyip yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số bản ghi vị trí vẫn đang đồng bộ từ iCloud. Không có dữ liệu đã nhập nào bị xóa. Hãy đợi đồng bộ hoàn tất rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分位置记录仍在从 iCloud 同步。没有删除任何导入的数据。请等待同步完成后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分位置記錄仍在從 iCloud 同步。沒有刪除任何匯入的資料。請等待同步完成後再試。"
          }
        }
      }
    },
    "settings.photo-import.error.inconsistent-local-data" : {
      "comment" : "Photo import deletion error when local imported data is inconsistent.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De importerede data kunne ikke genskabes på en sikker måde, så intet blev slettet. Luk og åbn TravelLog igen, og prøv derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die importierten Daten konnten nicht sicher rekonstruiert werden, daher wurde nichts gelöscht. Schließen und öffnen Sie TravelLog und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ασφαλής ανακατασκευή των εισαγμένων δεδομένων, οπότε δεν διαγράφηκε τίποτα. Κλείσε και άνοιξε ξανά το TravelLog και μετά δοκίμασε πάλι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The imported data could not be safely reconstructed, so nothing was deleted. Close and reopen TravelLog, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos importados no se pudieron reconstruir de forma segura, por lo que no se eliminó nada. Cierre TravelLog, vuelva a abrirlo e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données importées n’ont pas pu être reconstituées de façon sûre ; rien n’a donc été supprimé. Fermez puis rouvrez TravelLog et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile ricostruire in sicurezza i dati importati, quindi non è stato eliminato nulla. Chiudi e riapri TravelLog, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだデータを安全に再構築できなかったため、何も削除されませんでした。TravelLogを閉じて開き直し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 데이터를 안전하게 복원할 수 없어 아무것도 삭제되지 않았어요. TravelLog를 닫았다가 다시 열고 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De importerte dataene kunne ikke gjenopprettes på en trygg måte, så ingenting ble slettet. Lukk og åpne TravelLog på nytt, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geïmporteerde gegevens konden niet veilig worden gereconstrueerd. Daarom is niets verwijderd. Sluit TravelLog, open de app opnieuw en probeer het nogmaals."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconstruir os dados importados com segurança, então nada foi apagado. Feche e reabra o TravelLog e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconstruir os dados importados em segurança, pelo que nada foi apagado. Feche e volte a abrir o TravelLog e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importerade data kunde inte återskapas på ett säkert sätt, så inget raderades. Stäng och öppna TravelLog igen och försök på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarılan veriler güvenle yeniden oluşturulamadığından hiçbir şey silinmedi. TravelLog'u kapatıp yeniden açın ve tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể dựng lại dữ liệu đã nhập một cách an toàn nên không có gì bị xóa. Đóng rồi mở lại TravelLog, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全地重建导入的数据，因此没有删除任何内容。请关闭并重新打开 TravelLog 后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法安全地重建匯入的資料，因此沒有刪除任何內容。請關閉並重新開啟 TravelLog 後再試。"
          }
        }
      }
    },
    "settings.photo-import.error.insufficient-storage" : {
      "comment" : "Photo import error showing available storage in megabytes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke nok ledig plads (%@ MB ledig). Frigør lagerplads, og prøv igen. Importen kræver mindst 100 MB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Speicher (%@ MB verfügbar). Geben Sie Speicherplatz frei und versuchen Sie es erneut. Für den Import sind mindestens 100 MB erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει αρκετός ελεύθερος χώρος (διαθέσιμα %@ MB). Ελευθέρωσε χώρο και δοκίμασε ξανά. Η εισαγωγή χρειάζεται τουλάχιστον 100 MB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not enough free space (%@ MB available). Free up some storage and try again. The import needs at least 100 MB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio libre (%@ MB disponibles). Libere espacio e inténtelo de nuevo. La importación requiere al menos 100 MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace libre insuffisant (%@ Mo disponibles). Libérez de l’espace et réessayez. L’import nécessite au moins 100 Mo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio libero insufficiente (%@ MB disponibili). Libera spazio e riprova. L’importazione richiede almeno 100 MB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量が不足しています（空き%@ MB）。空き容量を増やしてから、もう一度お試しください。読み込みには100 MB以上必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 공간이 부족해요(%@MB 사용 가능). 공간을 확보한 후 다시 시도하세요. 가져오기에 최소 100MB가 필요해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke nok ledig plass (%@ MB tilgjengelig). Frigjør lagringsplass og prøv igjen. Importen krever minst 100 MB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onvoldoende vrije ruimte (%@ MB beschikbaar). Maak opslagruimte vrij en probeer het opnieuw. Voor de import is minstens 100 MB nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço livre suficiente (%@ MB disponíveis). Libere espaço e tente novamente. A importação precisa de pelo menos 100 MB."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há espaço livre suficiente (%@ MB disponíveis). Liberte espaço e tente novamente. A importação precisa de pelo menos 100 MB."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För lite ledigt utrymme (%@ MB tillgängligt). Frigör lagringsutrymme och försök igen. Importen behöver minst 100 MB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeterli boş alan yok (%@ MB kullanılabilir). Yer açıp yeniden deneyin. İçe aktarma için en az 100 MB gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ dung lượng trống (%@ MB khả dụng). Hãy giải phóng dung lượng rồi thử lại. Quá trình nhập cần ít nhất 100 MB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间不足（剩余 %@ MB）。请释放一些存储空间后重试。导入至少需要 100 MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空間不足（剩餘 %@ MB）。請釋放一些儲存空間後重試。匯入至少需要 100 MB。"
          }
        }
      }
    },
    "settings.photo-import.error.low-power-mode" : {
      "comment" : "Photo import error when Low Power Mode prevents importing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energibesparende funktion er slået til. Slå den fra (Indstillinger → Batteri → Energibesparende funktion), eller slut din iPhone til strøm, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus ist aktiviert. Deaktivieren Sie ihn unter Einstellungen → Batterie → Stromsparmodus oder schließen Sie Ihr iPhone an, und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Λειτουργία χαμηλής ισχύος είναι ενεργή. Απενεργοποίησέ την (Ρυθμίσεις → Μπαταρία → Λειτουργία χαμηλής ισχύος) ή σύνδεσε το iPhone σου στο ρεύμα και μετά δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Low Power Mode is enabled. Disable it (Settings → Battery → Low Power Mode) or plug in your iPhone, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado. Desactívelo (Ajustes → Batería → Modo de bajo consumo) o conecte el iPhone e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode économie d’énergie est activé. Désactivez-le (Réglages → Batterie → Mode économie d’énergie) ou branchez votre iPhone, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmio energetico è attivo. Disattivalo in Impostazioni → Batteria → Risparmio energetico oppure collega l’iPhone all’alimentazione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードが有効です。無効にする（「設定」→「バッテリー」→「低電力モード」）かiPhoneを電源に接続してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 켜져 있어요. 끄거나(설정 → 배터리 → 저전력 모드) iPhone을 전원에 연결한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparingsmodus er på. Slå den av (Innstillinger → Batteri → Strømsparingsmodus), eller koble iPhone til strøm, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De energiebesparingsmodus is ingeschakeld. Schakel deze uit (Instellingen → Batterij → Energiebesparingsmodus) of sluit je iPhone aan en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo Pouca Energia está ativado. Desative-o (Ajustes → Bateria → Modo Pouca Energia) ou conecte o iPhone à energia e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de baixo consumo está ativado. Desative-o (Definições → Bateria → Modo de baixo consumo), ligue o iPhone à corrente e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömsparläge är aktiverat. Avaktivera det (Inställningar → Batteri → Strömsparläge) eller anslut din iPhone till ström och försök sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük Güç Modu açık. Kapatın (Ayarlar → Pil → Düşük Güç Modu) veya iPhone'unuzu güç kaynağına bağlayıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nguồn điện thấp đang bật. Hãy tắt (Cài đặt → Pin → Chế độ nguồn điện thấp) hoặc cắm sạc iPhone, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低电量模式已开启。请将其关闭（“设置”→“电池”→“低电量模式”）或为 iPhone 接通电源，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低耗電模式已開啟。請將其關閉（「設定」→「電池」→「低耗電模式」）或為 iPhone 接通電源，然後重試。"
          }
        }
      }
    },
    "settings.photo-import.error.no-permission" : {
      "comment" : "Photo import error when photo permission is missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til billeder er påkrævet. Giv adgang under iOS-indstillinger → Anonymitet & sikkerhed → Fotos → TravelLog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff ist erforderlich. Erteilen Sie ihn unter iOS-Einstellungen → Datenschutz & Sicherheit → Fotos → TravelLog."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται πρόσβαση στις φωτογραφίες. Παραχώρησέ την στις Ρυθμίσεις iOS → Απόρρητο → Φωτογραφίες → TravelLog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photo access is required. Grant access in iOS Settings → Privacy → Photos → TravelLog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere acceso a las fotos. Concédalo en Ajustes de iOS → Privacidad → Fotos → TravelLog."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès aux photos est requis. Accordez-le dans Réglages iOS → Confidentialité → Photos → TravelLog."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È richiesto l’accesso alle foto. Concedilo in Impostazioni di iOS → Privacy → Foto → TravelLog."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真へのアクセスが必要です。「iOS設定」→「プライバシー」→「写真」→「TravelLog」でアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
