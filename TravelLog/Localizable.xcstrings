    "Short outings near home aren't logged as trips. When Travel Log sets one aside, it appears here so you can decide." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte ture tæt på hjemmet registreres ikke som rejser. Når Travel Log lægger en til side, vises den her, så du kan beslutte dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Ausflüge nahe der Heimat werden nicht als Reisen protokolliert. Wenn Travel Log einen zurückstellt, erscheint er hier, damit Sie entscheiden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι σύντομες εξορμήσεις κοντά στην κατοικία δεν καταγράφονται ως ταξίδια. Όταν το Travel Log παραμερίζει μία, εμφανίζεται εδώ για να αποφασίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Short outings near home aren't logged as trips. When Travel Log sets one aside, it appears here so you can decide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las salidas cortas cerca de casa no se registran como viajes. Cuando Travel Log aparte una, aparecerá aquí para que decida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les courtes sorties près du domicile ne sont pas enregistrées comme voyages. Lorsqu’une sortie est écartée par Travel Log, elle apparaît ici pour que vous puissiez décider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le brevi uscite vicino a casa non vengono registrate come viaggi. Quando Travel Log ne mette da parte una, appare qui per consentirti di decidere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅付近の短い外出は旅行として記録されません。Travel Logが除外した外出がここに表示されるので、自分で判断できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집 근처의 짧은 외출은 여행으로 기록되지 않아요. Travel Log가 제외한 외출은 여기에 표시되어 직접 결정할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte turer nær hjemmet loggføres ikke som reiser. Når Travel Log legger en til side, vises den her, slik at du kan bestemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korte uitstapjes dicht bij huis worden niet als reis vastgelegd. Wanneer Travel Log er een apart houdt, verschijnt die hier zodat jij kunt beslissen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeios curtos perto de casa não são registrados como viagens. Quando o Travel Log separar um deles, ele aparecerá aqui para você decidir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As saídas curtas perto de casa não são registadas como viagens. Quando o Travel Log põe uma de parte, esta aparece aqui para que possa decidir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korta utflykter nära hemmet loggas inte som resor. När Travel Log lägger en åt sidan visas den här så att du kan bestämma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev yakınındaki kısa geziler seyahat olarak kaydedilmez. Travel Log bir geziyi ayırdığında karar verebilmeniz için burada gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những lần ra ngoài ngắn gần nhà không được ghi là chuyến đi. Khi Travel Log để riêng một lần như vậy, nó sẽ xuất hiện tại đây để bạn quyết định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常住区域附近的短途外出不会记录为旅程。Travel Log 暂不计入的外出会显示在这里，由您决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居住區域附近的短途外出不會記錄為旅程。Travel Log 暫不計入的外出會顯示在這裡，由您決定。"
          }
        }
      }
    },
