    "settings.photo-import.footer.sync-warning" : {
      "comment" : "Settings photo-import footer warning, shown when iCloud Sync is on, to import on one device at a time.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når iCloud-synkronisering er slået til, skal du importere på én enhed ad gangen. Import på to enheder samtidig kan skabe dobbelte rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie bei aktivierter iCloud-Synchronisierung jeweils nur auf einem Gerät. Gleichzeitige Importe auf zwei Geräten können doppelte Reisen erzeugen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με ενεργό τον Συγχρονισμό iCloud, κάνε εισαγωγή σε μία συσκευή κάθε φορά. Η ταυτόχρονη εισαγωγή σε δύο συσκευές μπορεί να δημιουργήσει διπλά ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "With iCloud Sync on, import on one device at a time. Importing on two at once can create duplicate trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronización con iCloud activada, importe en un solo dispositivo a la vez. Importar en dos a la vez puede crear viajes duplicados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque la synchronisation iCloud est activée, importez sur un seul appareil à la fois. Importer sur deux appareils en même temps peut créer des voyages en double."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la sincronizzazione con iCloud attiva, importa su un dispositivo alla volta. Importare su due dispositivi contemporaneamente può creare viaggi duplicati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期がオンの場合は、1台ずつ読み込んでください。2台で同時に読み込むと、旅行が重複することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화가 켜져 있으면 한 번에 한 기기에서만 가져오세요. 두 기기에서 동시에 가져오면 여행이 중복될 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når iCloud-synkronisering er på, importer på én enhet om gangen. Import på to enheter samtidig kan opprette dupliserte reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeer met iCloud-synchronisatie aan op één apparaat tegelijk. Tegelijk importeren op twee apparaten kan dubbele reizen maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a sincronização do iCloud ativada, importe em um dispositivo por vez. Importar em dois ao mesmo tempo pode criar viagens duplicadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a sincronização do iCloud ativa, importe num dispositivo de cada vez. Importar em dois ao mesmo tempo pode criar viagens duplicadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När iCloud-synkronisering är på ska du importera på en enhet i taget. Import på två enheter samtidigt kan skapa dubbla resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Eşzamanlama açıkken aynı anda yalnızca bir aygıtta içe aktarın. İki aygıtta aynı anda içe aktarmak yinelenen seyahatler oluşturabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật Đồng bộ iCloud, chỉ nhập trên một thiết bị mỗi lần. Nhập đồng thời trên hai thiết bị có thể tạo chuyến đi trùng lặp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启 iCloud 同步时，请每次只在一台设备上导入。同时在两台设备上导入可能会产生重复旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 iCloud 同步時，請一次只在一部裝置上匯入。同時在兩部裝置上匯入可能會產生重複旅程。"
          }
        }
      }
    },
