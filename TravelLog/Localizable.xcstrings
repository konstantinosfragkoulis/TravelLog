    "data-import.error.older-format" : {
      "comment" : "Error shown when an imported backup was written in a format older than the one this app version reads.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sikkerhedskopi er lavet med en ældre version af Travel Log og kan ikke importeres. Opdater Travel Log på den enhed, der har dine rejser, og eksportér derefter en ny sikkerhedskopi der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup wurde mit einer älteren Version von Travel Log erstellt und kann nicht importiert werden. Aktualisieren Sie Travel Log auf dem Gerät mit Ihren Reisen und exportieren Sie dort ein neues Backup."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αντίγραφο ασφαλείας δημιουργήθηκε από παλαιότερη έκδοση του Travel Log και δεν μπορεί να εισαχθεί. Ενημέρωσε το Travel Log στη συσκευή που έχει τα ταξίδια σου και μετά εξήγαγε εκεί ένα νέο αντίγραφο ασφαλείας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was made by an earlier version of Travel Log and can't be imported. Update Travel Log on the device that has your trips, then export a new backup there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia se creó con una versión anterior de Travel Log y no se puede importar. Actualice Travel Log en el dispositivo que tiene sus viajes y exporte allí una copia nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde a été créée par une version antérieure de Travel Log et ne peut pas être importée. Mettez à jour Travel Log sur l’appareil qui contient vos voyages, puis exportez-y une nouvelle sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup è stato creato da una versione precedente di Travel Log e non può essere importato. Aggiorna Travel Log sul dispositivo con i tuoi viaggi, poi esporta lì un nuovo backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは以前のバージョンのTravel Logで作成されたため、読み込めません。旅行が保存されているデバイスでTravel Logをアップデートしてから、そのデバイスで新しいバックアップを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업은 이전 버전의 Travel Log에서 만들어져 가져올 수 없어요. 여행이 있는 기기에서 Travel Log를 업데이트한 다음 그 기기에서 새 백업을 내보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sikkerhetskopien ble laget med en eldre versjon av Travel Log og kan ikke importeres. Oppdater Travel Log på enheten som har reisene dine, og eksporter deretter en ny sikkerhetskopi der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reservekopie is gemaakt met een oudere versie van Travel Log en kan niet worden geïmporteerd. Werk Travel Log bij op het apparaat met je reizen en exporteer daar een nieuwe reservekopie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup foi criado por uma versão anterior do Travel Log e não pode ser importado. Atualize o Travel Log no dispositivo que tem suas viagens e exporte um novo backup nele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia de segurança foi criada por uma versão anterior do Travel Log e não pode ser importada. Atualize o Travel Log no dispositivo que tem as suas viagens e exporte lá uma nova cópia de segurança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopian skapades med en äldre version av Travel Log och kan inte importeras. Uppdatera Travel Log på enheten som har dina resor och exportera sedan en ny säkerhetskopia där."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedek, Travel Log'un daha eski bir sürümüyle oluşturulduğu için içe aktarılamıyor. Seyahatlerinizin bulunduğu cihazda Travel Log'u güncelleyin, ardından orada yeni bir yedek dışa aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu này được tạo bởi phiên bản Travel Log cũ hơn nên không thể nhập. Hãy cập nhật Travel Log trên thiết bị có các chuyến đi của bạn, rồi xuất bản sao lưu mới trên thiết bị đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份由较早版本的 Travel Log 创建，无法导入。请在存有你旅程的设备上更新 Travel Log，然后在该设备上导出新的备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此備份由較早版本的 Travel Log 建立，無法匯入。請在存有你旅程的裝置上更新 Travel Log，然後在該裝置上匯出新的備份。"
          }
        }
      }
    },
