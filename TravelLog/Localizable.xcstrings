    "onboarding.location.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalitetsadgangen “Altid” lader Travel Log opdage rejser i baggrunden med minimalt batteriforbrug. Din rejsehistorik bliver på din enhed og i din private iCloud. Vejr og nogle stednavne kommer fra Apple-tjenester."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Standortzugriff „Immer“ erkennt Travel Log Reisen im Hintergrund bei minimalem Batterieverbrauch. Ihr Reiseverlauf bleibt auf Ihrem Gerät und in Ihrer privaten iCloud. Wetter und manche Ortsnamen stammen von Apple-Diensten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με πρόσβαση τοποθεσίας «Πάντα», το Travel Log εντοπίζει ταξίδια στο παρασκήνιο με ελάχιστη κατανάλωση μπαταρίας. Το ιστορικό ταξιδιών σου μένει στη συσκευή σου και στο ιδιωτικό σου iCloud. Ο καιρός και ορισμένα ονόματα τοποθεσιών προέρχονται από υπηρεσίες της Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always” location access lets Travel Log notice trips in the background with minimal battery use. Your travel history stays on your device and in your private iCloud. Weather and some place names come from Apple services."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación “Siempre” permite a Travel Log detectar viajes en segundo plano con un consumo mínimo de batería. Su historial de viajes queda en su dispositivo y en su iCloud privado. El tiempo y algunos nombres de lugares proceden de servicios de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position « Toujours » permet à Travel Log de détecter les voyages en arrière-plan en consommant très peu de batterie. Votre historique de voyages reste sur votre appareil et dans votre espace iCloud privé. La météo et certains noms de lieux proviennent de services Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione “Sempre” permette a Travel Log di rilevare viaggi in background consumando pochissima batteria. La cronologia dei viaggi resta sul tuo dispositivo e nel tuo iCloud privato. Il meteo e alcuni nomi di luoghi provengono dai servizi Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスを「常に」にすると、Travel Logがバッテリー消費を最小限に抑えてバックグラウンドで旅行を検出します。旅行履歴はデバイスとプライベートなiCloudに保存されます。天気と一部の地名はAppleのサービスから取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근을 “항상”으로 설정하면 Travel Log가 배터리를 최소한으로 쓰며 백그라운드에서 여행을 감지해요. 여행 기록은 기기와 비공개 iCloud에 보관돼요. 날씨와 일부 장소 이름은 Apple 서비스에서 가져와요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang «Alltid» lar Travel Log oppdage reiser i bakgrunnen med minimalt batteriforbruk. Reisehistorikken din blir på enheten og i din private iCloud. Vær og noen stedsnavn kommer fra Apple-tjenester."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met locatietoegang op ‘Altijd’ herkent Travel Log reizen op de achtergrond met minimaal batterijgebruik. Je reisgeschiedenis blijft op je apparaat en in je privé-iCloud. Het weer en sommige plaatsnamen komen van Apple-diensten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização “Sempre” permite ao Travel Log detectar viagens em segundo plano com consumo mínimo de bateria. Seu histórico de viagens fica no dispositivo e no seu iCloud privado. O clima e alguns nomes de lugares vêm de serviços da Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização “Sempre” permite ao Travel Log detetar viagens em segundo plano com consumo mínimo de bateria. O seu histórico de viagens fica no dispositivo e no seu iCloud privado. A meteorologia e alguns nomes de locais vêm de serviços da Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med platsåtkomsten ”Alltid” upptäcker Travel Log resor i bakgrunden med minimal batteriförbrukning. Din resehistorik stannar på enheten och i ditt privata iCloud. Väder och vissa platsnamn kommer från Apples tjänster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Her Zaman” konum erişimi, Travel Log’un arka planda çok az pil kullanarak seyahatleri fark etmesini sağlar. Seyahat geçmişiniz aygıtınızda ve özel iCloud alanınızda kalır. Hava durumu ve bazı yer adları Apple hizmetlerinden gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền vị trí “Luôn luôn” giúp Travel Log nhận biết chuyến đi trong nền với mức dùng pin tối thiểu. Lịch sử chuyến đi ở trên thiết bị và trong iCloud riêng tư của bạn. Thời tiết và một số tên địa điểm lấy từ dịch vụ của Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“始终”允许访问位置，让 Travel Log 以极低耗电量在后台发现旅程。您的旅行记录保存在设备和您的私人 iCloud 中。天气和部分地名来自 Apple 服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「永遠」允許取用位置，讓 Travel Log 以極低耗電量在背景發現旅程。您的旅行記錄儲存在裝置和您的私人 iCloud 中。天氣和部分地名來自 Apple 服務。"
          }
        }
      }
    },
    "onboarding.location.status.denied.detail" : {
