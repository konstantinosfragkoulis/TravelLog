    "wrapped.notification.preparation-failed" : {
      "comment" : "Terminal state when notification-triggered Wrapped generation fails to read, build or save the recap; the argument is the year.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
