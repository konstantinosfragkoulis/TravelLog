    },
    "settings.photo-import.error.low-power-mode" : {
      "comment" : "Photo import error when Low Power Mode prevents importing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energibesparende funktion er slået til. Slå den fra (Indstillinger → Batteri → Energibesparende funktion), eller slut din iPhone til strøm, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus ist aktiviert. Deaktivieren Sie ihn unter Einstellungen → Batterie → Stromsparmodus oder schließen Sie Ihr iPhone an, und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Λειτουργία χαμηλής ισχύος είναι ενεργή. Απενεργοποίησέ την (Ρυθμίσεις → Μπαταρία → Λειτουργία χαμηλής ισχύος) ή σύνδεσε το iPhone σου στο ρεύμα και μετά δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Low Power Mode is enabled. Disable it (Settings → Battery → Low Power Mode) or plug in your iPhone, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo está activado. Desactívelo (Ajustes → Batería → Modo de bajo consumo) o conecte el iPhone e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode économie d’énergie est activé. Désactivez-le (Réglages → Batterie → Mode économie d’énergie) ou branchez votre iPhone, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmio energetico è attivo. Disattivalo in Impostazioni → Batteria → Risparmio energetico oppure collega l’iPhone all’alimentazione, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低電力モードが有効です。無効にする（「設定」→「バッテリー」→「低電力モード」）かiPhoneを電源に接続してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드가 켜져 있어요. 끄거나(설정 → 배터리 → 저전력 모드) iPhone을 전원에 연결한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strømsparingsmodus er på. Slå den av (Innstillinger → Batteri → Strømsparingsmodus), eller koble iPhone til strøm, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De energiebesparingsmodus is ingeschakeld. Schakel deze uit (Instellingen → Batterij → Energiebesparingsmodus) of sluit je iPhone aan en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo Pouca Energia está ativado. Desative-o (Ajustes → Bateria → Modo Pouca Energia) ou conecte o iPhone à energia e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de baixo consumo está ativado. Desative-o (Definições → Bateria → Modo de baixo consumo), ligue o iPhone à corrente e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strömsparläge är aktiverat. Avaktivera det (Inställningar → Batteri → Strömsparläge) eller anslut din iPhone till ström och försök sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük Güç Modu açık. Kapatın (Ayarlar → Pil → Düşük Güç Modu) veya iPhone'unuzu güç kaynağına bağlayıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nguồn điện thấp đang bật. Hãy tắt (Cài đặt → Pin → Chế độ nguồn điện thấp) hoặc cắm sạc iPhone, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低电量模式已开启。请将其关闭（“设置”→“电池”→“低电量模式”）或为 iPhone 接通电源，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低耗電模式已開啟。請將其關閉（「設定」→「電池」→「低耗電模式」）或為 iPhone 接通電源，然後重試。"
          }
        }
      }
    },
    "settings.photo-import.error.no-permission" : {
      "comment" : "Photo import error when photo permission is missing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
