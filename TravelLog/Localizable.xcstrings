          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経路と所要時間は位置情報データから推定されます。所要時間は概算です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로와 기간은 위치 데이터에서 추정하며 기간은 예상치예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruter og varigheter utledes fra posisjonsdata. Varighetene er anslag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes en duur worden afgeleid uit locatiegegevens. De duur is een schatting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas e durações são inferidas dos dados de localização. As durações são estimativas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas e durações são inferidas dos dados de localização. As durações são estimativas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutter och längder härleds från platsdata. Längderna är uppskattningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
