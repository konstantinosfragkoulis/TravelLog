    "collections.flight-times.footer.set" : {
      "comment" : "Footer under the times the user set for a flight: they replace the distance estimate in the totals and are stored on this device and in backups.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine tider erstatter skønnet i dine flytotaler. De bliver på denne enhed og i dine sikkerhedskopier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Zeiten ersetzen die Schätzung in Ihren Flugsummen. Sie bleiben auf diesem Gerät und in Ihren Backups."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ώρες σου αντικαθιστούν την εκτίμηση στα σύνολα πτήσεων. Μένουν σε αυτήν τη συσκευή και στα αντίγραφα ασφαλείας σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your times replace the estimate in your flight totals. They stay on this device and in your backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus horas sustituyen a la estimación en los totales de vuelos. Se guardan en este dispositivo y en tus copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos horaires remplacent l’estimation dans vos totaux de vol. Ils restent sur cet appareil et dans vos sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi orari sostituiscono la stima nei totali dei voli. Restano su questo dispositivo e nei tuoi backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定した時刻がフライト合計の推定値に代わって使われます。時刻はこのデバイスとバックアップに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정한 시간이 항공편 합계의 추정값을 대신해요. 이 기기와 백업에 보관돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidene dine erstatter anslaget i flytotalene. De blir værende på denne enheten og i sikkerhetskopiene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw tijden vervangen de schatting in je vluchttotalen. Ze blijven op dit apparaat en in je back-ups."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus horários substituem a estimativa nos totais de voos. Eles ficam neste dispositivo e nos seus backups."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas horas substituem a estimativa nos totais de voos. Ficam neste dispositivo e nas suas cópias de segurança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina tider ersätter uppskattningen i dina flygsummor. De finns kvar på den här enheten och i dina säkerhetskopior."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatleriniz uçuş toplamlarınızdaki tahminin yerini alır. Bu cihazda ve yedeklerinizde kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ của bạn thay cho ước tính trong tổng số chuyến bay. Chúng được giữ trên thiết bị này và trong bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你设置的时间会取代航班总计中的估算值。这些时间保存在这台设备和你的备份中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你設定的時間會取代航班總計中的估算值。這些時間儲存在這台裝置和你的備份中。"
          }
        }
      }
    },
    "collections.flight-times.footer.zones" : {
      "comment" : "Footer under the flight-time pickers: each time reads in the local time of its own end.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afgang er i lokal tid, hvor du rejste fra, ankomst hvor du landede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Abflug gilt in der Ortszeit des Abflugorts, die Ankunft in der des Landeorts."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναχώρηση είναι σε τοπική ώρα του σημείου που έφυγες, η άφιξη του σημείου που προσγειώθηκες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Departure is in local time where you left, arrival where you landed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salida va en la hora local del lugar de partida y la llegada en la del lugar donde aterrizaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le départ est à l’heure locale du lieu de départ, l’arrivée à celle du lieu d’atterrissage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partenza è nell’ora locale del luogo da cui sei partito, l’arrivo in quella del luogo in cui sei atterrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出発は出発地の現地時刻、到着は着陸地の現地時刻です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출발은 떠난 곳의 현지 시간, 도착은 착륙한 곳의 현지 시간이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgang er i lokal tid der du dro fra, ankomst der du landet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertrek is in de lokale tijd waar je vertrok, aankomst waar je landde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partida fica no horário local de onde você saiu, e a chegada no de onde você pousou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partida está na hora local de onde partiu, e a chegada na de onde aterrou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avgång anges i lokal tid där du reste från, ankomst där du landade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalkış ayrıldığınız yerin, varış indiğiniz yerin yerel saatindedir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giờ khởi hành theo giờ địa phương nơi bạn rời đi, giờ đến theo nơi bạn hạ cánh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出发时间为出发地当地时间，到达时间为降落地当地时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出發時間為出發地當地時間，抵達時間為降落地當地時間。"
          }
        }
      }
    },
    "collections.flight-times.problem.long" : {
      "comment" : "Flight times validation message when the flight is longer than the maximum, such as 48 hours.",
