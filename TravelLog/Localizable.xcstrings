    "settings.photo-import.footer" : {
      "comment" : "Settings photo-import footer explaining what the import reads.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser kun tidsstempler og lokaliteter fra dine billeder for at genskabe rejser, du foretog, før du installerede TravelLog. TravelLog uploader eller ændrer aldrig dine billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest nur Zeitstempel und Standorte Ihrer Fotos, um Reisen vor der Installation von TravelLog zu rekonstruieren. TravelLog lädt Ihre Fotos nie hoch und ändert sie nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει μόνο τις χρονικές σημάνσεις και τις τοποθεσίες των φωτογραφιών σου, για να ανακατασκευάσει ταξίδια που έκανες πριν εγκαταστήσεις το TravelLog. Το TravelLog δεν ανεβάζει ούτε αλλάζει ποτέ τις φωτογραφίες σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reads only timestamps and locations from your photos to rebuild trips you took before installing TravelLog. TravelLog never uploads or changes your photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lee las fechas, horas y ubicaciones de sus fotos para reconstruir viajes anteriores a la instalación de TravelLog. TravelLog nunca sube ni modifica sus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit uniquement les horodatages et les lieux de vos photos afin de reconstituer les voyages effectués avant l’installation de TravelLog. TravelLog n’envoie ni ne modifie jamais vos photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge solo data, ora e posizione delle foto per ricostruire i viaggi effettuati prima di installare TravelLog. TravelLog non carica né modifica mai le tue foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogをインストールする前の旅行を再構築するため、写真のタイムスタンプと位置情報だけを読み取ります。TravelLogが写真をアップロードしたり変更したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진의 타임스탬프와 위치만 읽어 TravelLog 설치 전에 다녀온 여행을 복원해요. TravelLog는 사진을 업로드하거나 변경하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leser bare tidsstempler og posisjoner fra bildene dine for å gjenopprette reiser du tok før du installerte TravelLog. TravelLog laster aldri opp eller endrer bildene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest alleen tijdstippen en locaties van je foto’s om reizen te reconstrueren die je vóór de installatie van TravelLog maakte. TravelLog uploadt of wijzigt je foto’s nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê somente os horários e as localizações das suas fotos para reconstruir viagens feitas antes da instalação do TravelLog. O TravelLog nunca envia nem altera suas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê apenas as datas, horas e localizações das suas fotografias para reconstruir viagens feitas antes de instalar o TravelLog. O TravelLog nunca envia nem altera as suas fotografias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser endast tidsstämplar och platser från dina bilder för att återskapa resor du gjorde innan du installerade TravelLog. TravelLog laddar aldrig upp eller ändrar dina bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog'u yüklemeden önce yaptığınız seyahatleri yeniden oluşturmak için fotoğraflarınızdan yalnızca zaman damgalarını ve konumları okur. TravelLog fotoğraflarınızı asla yüklemez veya değiştirmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đọc dấu thời gian và vị trí trong ảnh để dựng lại các chuyến đi bạn đã thực hiện trước khi cài TravelLog. TravelLog không bao giờ tải lên hay thay đổi ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读取照片的时间戳和位置，用于重建安装 TravelLog 前的旅程。TravelLog 绝不会上传或更改您的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只讀取照片的時間戳記和位置，用於重建安裝 TravelLog 前的旅程。TravelLog 絕不會上傳或更改您的照片。"
          }
        }
      }
    },
    "settings.photo-import.footer.failed" : {
      "comment" : "Settings photo-import footer after an import failed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et nyt forsøg fortsætter, hvor importen slap. Importerede data bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Versuch setzt an derselben Stelle fort. Importierte Daten bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η νέα προσπάθεια συνεχίζει από εκεί που σταμάτησε. Τα δεδομένα που εισήχθησαν διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Retrying continues where it left off. Imported data is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al reintentar, continúa donde se quedó. Los datos importados se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouvel essai reprend là où l’import s’est arrêté. Les données importées sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuovo tentativo riprende da dove si era fermata. I dati importati vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行すると、停止したところから続行します。読み込み済みのデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재시도하면 멈춘 곳부터 이어서 진행해요. 가져온 데이터는 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et nytt forsøk fortsetter der importen slapp. Importerte data beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw proberen gaat verder waar de import stopte. Geïmporteerde gegevens blijven bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova tentativa continua de onde parou. Os dados importados são mantidos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova tentativa continua de onde parou. Os dados importados são mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett nytt försök fortsätter där importen slutade. Importerade data behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden deneme, kaldığı yerden devam eder. İçe aktarılan veriler korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử lại sẽ tiếp tục từ chỗ đã dừng. Dữ liệu đã nhập được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试会从中断处继续。已导入的数据会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重試會從中斷處接續。已匯入的資料會保留。"
          }
        }
      }
    },
    "settings.photo-import.footer.interrupted" : {
      "comment" : "Settings photo-import footer after an import was interrupted (app closed or background time ran out).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den sidste import stoppede før tid. Genoptag for at fortsætte, hvor den slap, eller slet de importerede data for at kassere dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der letzte Import wurde vorzeitig beendet. Setzen Sie ihn an derselben Stelle fort oder löschen Sie die importierten Daten, um sie zu verwerfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τελευταία εισαγωγή σταμάτησε πρόωρα. Συνέχισέ τη από εκεί που σταμάτησε ή διάγραψε τα δεδομένα που εισήχθησαν για να τα απορρίψεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The last import stopped early. Resume to continue where it left off, or delete the imported data to discard it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última importación se detuvo antes de terminar. Reanúdela para continuar donde se quedó o elimine los datos importados para descartarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dernier import s’est arrêté avant la fin. Reprenez là où il s’est arrêté ou supprimez les données importées pour les abandonner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima importazione si è interrotta prima del termine. Riprendi da dove si era fermata oppure elimina i dati importati per scartarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回の読み込みは途中で停止しました。再開すると続きから読み込めます。取り消すには、読み込んだデータを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 가져오기가 중간에 멈췄어요. 재개하면 멈춘 곳부터 이어서 진행하며, 가져온 데이터를 삭제하면 폐기할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den siste importen stoppet før den var ferdig. Gjenoppta for å fortsette der den slapp, eller slett de importerte dataene for å forkaste dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatste import is voortijdig gestopt. Hervat om verder te gaan waar deze stopte, of verwijder de geïmporteerde gegevens om ze te verwerpen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A última importação parou antes de terminar. Retome para continuar de onde parou ou apague os dados importados para descartá-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A última importação parou antes de terminar. Retome para continuar de onde parou ou apague os dados importados para os descartar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den senaste importen avbröts innan den var klar. Återuppta där den slutade eller radera importerade data för att kasta dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son içe aktarma tamamlanmadan durdu. Kaldığı yerden sürdürün veya vazgeçmek için içe aktarılan verileri silin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần nhập trước dừng sớm. Tiếp tục từ chỗ đã dừng hoặc xóa dữ liệu đã nhập để loại bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次导入提前停止。恢复即可从中断处继续，或删除已导入的数据以将其丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次匯入提前停止。繼續即可從中斷處接續，或刪除已匯入的資料以捨棄它們。"
          }
        }
      }
    },
