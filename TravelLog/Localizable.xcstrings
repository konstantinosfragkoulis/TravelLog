    "tracking.issue.location-services-disabled.description" : {
      "comment" : "Instructions for fixing disabled Location Services.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalitetstjenester er slået fra på hele enheden. Gå til Indstillinger → Anonymitet & sikkerhed → Lokalitetstjenester, og slå dem til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortdienste sind für das gesamte Gerät ausgeschaltet. Öffnen Sie Einstellungen → Datenschutz & Sicherheit → Ortungsdienste und schalten Sie sie ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Υπηρεσίες τοποθεσίας είναι απενεργοποιημένες για ολόκληρη τη συσκευή. Πήγαινε στις Ρυθμίσεις → Απόρρητο και ασφάλεια → Υπηρεσίες τοποθεσίας και ενεργοποίησέ τες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location Services are turned off for the entire device. Go to Settings → Privacy & Security → Location Services and turn them on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios de ubicación están desactivados en todo el dispositivo. Vaya a Ajustes → Privacidad y seguridad → Localización y actívelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de localisation est désactivé sur tout l’appareil. Accédez à Réglages → Confidentialité et sécurité → Service de localisation et activez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La localizzazione è disattivata per l’intero dispositivo. Vai in Impostazioni → Privacy e sicurezza → Localizzazione e attivala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス全体の位置情報サービスがオフです。「設定」→「プライバシーとセキュリティ」→「位置情報サービス」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 전체의 위치 서비스가 꺼져 있어요. 설정 → 개인정보 보호 및 보안 → 위치 서비스로 이동하여 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstjenester er slått av for hele enheten. Gå til Innstillinger → Personvern og sikkerhet → Stedstjenester, og slå dem på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatievoorzieningen zijn voor het hele apparaat uitgeschakeld. Ga naar Instellingen → Privacy en beveiliging → Locatievoorzieningen en schakel ze in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Serviços de Localização estão desativados em todo o dispositivo. Acesse Ajustes → Privacidade e Segurança → Serviços de Localização e ative-os."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Serviços de localização estão desativados em todo o dispositivo. Aceda a Definições → Privacidade e segurança → Serviços de localização e ative-os."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platstjänster är avstängda för hela enheten. Gå till Inställningar → Integritet och säkerhet → Platstjänster och aktivera dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum Servisleri tüm aygıt için kapalı. Ayarlar → Gizlilik ve Güvenlik → Konum Servisleri yoluna gidip açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dịch vụ định vị đang tắt trên toàn thiết bị. Vào Cài đặt → Quyền riêng tư & Bảo mật → Dịch vụ định vị và bật lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整台设备的定位服务已关闭。请前往“设置”→“隐私与安全性”→“定位服务”并将其打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整台裝置的定位服務已關閉。請前往「設定」→「隱私權與安全性」→「定位服務」並將其開啟。"
          }
        }
      }
    },
