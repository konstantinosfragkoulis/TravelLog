    "temporary-home.card.end-hint" : {
      "comment" : "Hint on the card of an open-ended temporary home the user seems to have left: the day they got back home, then the day of their last stay at the temporary home, offered as its end date.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden %1$@ har du været hjemme igen. Afslut den %2$@?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit dem %1$@ wieder zu Hause. Am %2$@ beenden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πίσω στην κατοικία σου από %1$@. Λήξη στις %2$@;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Back home since %1$@. End it on %2$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vuelta en casa desde el %1$@. ¿Finalizarla el %2$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De retour au domicile depuis le %1$@. Terminer le %2$@ ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di nuovo a casa dal %1$@. Terminarla il %2$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@から自宅に戻っています。%2$@で終了しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@부터 집에 돌아와 있어요. %2$@에 종료할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden %1$@ har du vært hjemme igjen. Avslutt den %2$@?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinds %1$@ weer thuis. Beëindigen op %2$@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volta em casa desde %1$@. Encerrar em %2$@?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De regresso a casa desde %1$@. Terminar em %2$@?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedan %1$@ är du hemma igen. Avsluta den %2$@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarihinden beri evdesiniz. %2$@ günü bitirilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã về nhà từ %1$@. Kết thúc vào %2$@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %1$@ 起已回家。要在 %2$@ 结束吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %1$@ 起已回家。要在 %2$@ 結束嗎？"
          }
        }
      }
    },
