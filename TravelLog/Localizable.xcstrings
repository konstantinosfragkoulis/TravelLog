        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@件の旅行が、ここで過ごした時間とここから出かけた旅行に分割されます：%2$@。コピーはこのデバイスの「削除された旅行」に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 %1$@개가 이곳에서 보낸 시간과 다른 곳으로 떠난 여행으로 나뉘어요: %2$@. 사본은 이 기기의 삭제된 여행에 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reiser blir delt i tid her og reiser herfra: %2$@. Kopier blir liggende i Fjernede reiser på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ reizen worden gesplitst in tijd hier en reizen weg van hier: %2$@. Er blijven kopieën in Verwijderde reizen op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ viagens serão divididas em tempo aqui e viagens fora: %2$@. As cópias ficam em Viagens removidas neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ viagens serão divididas em tempo aqui e viagens fora: %2$@. As cópias ficam em Viagens removidas neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ resor delas upp i tid här och resor härifrån: %2$@. Kopior finns kvar i Borttagna resor på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ seyahat, buradaki süre ve buradan çıkılan seyahatler olarak bölünecek: %2$@. Kopyaları bu aygıtta Kaldırılan Seyahatler’de kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ chuyến đi sẽ được tách thành thời gian ở đây và các chuyến đi khỏi đây: %2$@. Các bản sao vẫn được giữ trong Chuyến đi đã xóa trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 段旅程将被拆分为在此的时间和离开这里的旅程：%2$@。副本会保留在此设备的“已移除的旅程”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 段旅程將被拆分為在此的時間和離開這裡的旅程：%2$@。副本會保留在此裝置的「已移除的旅程」中。"
          }
        }
      }
    },
    "temporary-home.form.dates.footer" : {
      "comment" : "Footer of the dates section in the temporary home form: the picked first and last days are both included.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både første og sidste dag tæller med. Lad slutdatoen stå åben, hvis du ikke er sikker endnu. Du kan afslutte det senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste und der letzte Tag zählen beide mit. Lassen Sie das Ende offen, wenn Sie noch nicht sicher sind. Sie können es später beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετράνε και η πρώτη και η τελευταία μέρα. Αν δεν ξέρεις ακόμα, άφησε τη λήξη ανοιχτή. Μπορείς να την ορίσεις αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The first and last days both count. Leave the end open if you're not sure yet. You can end it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentan tanto el primer día como el último. Deje el final abierto si aún no lo sabe. Podrá finalizarla más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier et le dernier jour comptent tous les deux. Laissez la fin ouverte si vous hésitez encore. Vous pourrez y mettre fin plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contano sia il primo sia l’ultimo giorno. Non impostare una data di fine se non sai ancora quando terminerà il soggiorno. Potrai aggiungerla in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初日と最終日はどちらも含まれます。まだ決まっていない場合は、終了日を未設定のままにしてください。あとから終了できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫날과 마지막 날 모두 포함돼요. 아직 확실하지 않다면 종료 날짜를 비워 두세요. 나중에 종료할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både første og siste dag teller med. La slutten stå åpen hvis du ikke er sikker ennå. Du kan avslutte det senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De eerste en de laatste dag tellen allebei mee. Laat het einde open als je het nog niet zeker weet. Je kunt het later beëindigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro e o último dia contam. Deixe o término em aberto se ainda não tiver certeza. Você pode encerrá-la depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro e o último dia contam ambos. Deixe o fim em aberto se ainda não tiver a certeza. Pode terminá-la mais tarde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Både första och sista dagen räknas. Lämna slutet öppet om du inte är säker än. Du kan avsluta det senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk ve son gün de dahildir. Henüz emin değilseniz bitişi açık bırakın. Daha sonra sonlandırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả ngày đầu và ngày cuối đều được tính. Hãy để trống ngày kết thúc nếu bạn chưa chắc chắn. Bạn có thể kết thúc sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一天和最后一天都计算在内。如果还不确定，可以先不设置结束日期，之后再结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一天和最後一天都計算在內。如果還不確定，可以先不設定結束日期，之後再結束。"
          }
        }
      }
    },
