    "Enabling iCloud sync requires closing and reopening the app. Your data will begin syncing after you relaunch." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis iCloud-synkronisering slås til, skal appen lukkes og åbnes igen. Dine data begynder at blive synkroniseret, når du åbner appen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die iCloud-Synchronisierung aktivieren, muss die App geschlossen und erneut geöffnet werden. Nach dem Neustart beginnt die Synchronisierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενεργοποίηση του συγχρονισμού iCloud απαιτεί να κλείσεις και να ανοίξεις ξανά την εφαρμογή. Τα δεδομένα σου θα αρχίσουν να συγχρονίζονται μετά την επανεκκίνηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling iCloud sync requires closing and reopening the app. Your data will begin syncing after you relaunch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para activar la sincronización con iCloud hay que cerrar y volver a abrir la app. Sus datos empezarán a sincronizarse al abrirla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activation de la synchronisation iCloud nécessite de fermer puis de rouvrir l’app. La synchronisation commencera après la relance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per attivare la sincronizzazione con iCloud è necessario chiudere e riaprire l’app. I dati inizieranno a sincronizzarsi dopo il riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期を有効にするには、Appを閉じて開き直す必要があります。再起動後に同期が始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화를 켜려면 앱을 닫았다가 다시 열어야 해요. 앱을 다시 실행하면 데이터 동기화가 시작돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår på iCloud-synkronisering, må appen lukkes og åpnes igjen. Dataene begynner å synkroniseres etter omstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je iCloud-synchronisatie inschakelt, moet je de app sluiten en opnieuw openen. Na het opnieuw starten begint de synchronisatie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar a sincronização com o iCloud exige fechar e reabrir o app. Seus dados começarão a ser sincronizados após a reabertura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ativar a sincronização com iCloud, é necessário fechar e voltar a abrir a app. Os dados começarão a ser sincronizados quando voltar a abri-la."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du aktiverar iCloud-synkronisering måste appen stängas och öppnas igen. Dina data börjar synkroniseras efter omstarten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud eşzamanlamasını açmak için uygulamayı kapatıp yeniden açmanız gerekir. Yeniden açtığınızda verileriniz eşzamanlanmaya başlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật đồng bộ iCloud yêu cầu đóng rồi mở lại ứng dụng. Dữ liệu sẽ bắt đầu đồng bộ sau khi bạn mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 iCloud 同步需要退出并重新打开 App。重新启动后，数据将开始同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用 iCloud 同步需要退出並重新開啟 App。重新啟動後，資料將開始同步。"
          }
        }
      }
    },
