          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não existem viagens suficientes registadas em %@ para criar o resumo do ano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns ännu inte tillräckligt många registrerade resor i %@ för att skapa en årssammanfattning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
