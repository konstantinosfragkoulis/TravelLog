        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα ταξίδι δεν αντιστοιχεί σε όλο το «%1$@». Πλησιέστερα: %2$@."
          }
        },
        "en" : {
