    "settings.data.export-password.warning" : {
      "comment" : "Footer warning in Settings Import & Export that a forgotten backup password cannot be recovered.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal bruge adgangskoden for at importere sikkerhedskopien. Travel Log gemmer den ikke, så hvis du glemmer den, kan sikkerhedskopien ikke gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie benötigen dieses Passwort, um das Backup zu importieren. Travel Log speichert es nicht. Wenn Sie es vergessen, kann das Backup nicht wiederhergestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα χρειαστείς αυτόν τον κωδικό για να εισαγάγεις το αντίγραφο ασφαλείας. Το Travel Log δεν τον κρατά, οπότε αν τον ξεχάσεις, το αντίγραφο δεν μπορεί να ανακτηθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You'll need this password to import the backup. Travel Log doesn't keep a copy, so if you forget it, the backup can't be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitará esta contraseña para importar la copia. Travel Log no guarda una copia de ella, así que si la olvida, la copia no se podrá recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe sera nécessaire pour importer la sauvegarde. Travel Log n’en garde aucune copie : si vous l’oubliez, la sauvegarde ne pourra pas être récupérée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti servirà questa password per importare il backup. Travel Log non ne conserva una copia, quindi se la dimentichi il backup non potrà essere recuperato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを読み込むにはこのパスワードが必要です。Travel Logはパスワードを保存しないため、忘れるとバックアップを復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 가져오려면 이 암호가 필요해요. Travel Log는 암호를 보관하지 않으므로 잊어버리면 백업을 복구할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger dette passordet for å importere sikkerhetskopien. Travel Log lagrer det ikke, så hvis du glemmer det, kan sikkerhetskopien ikke gjenopprettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt dit wachtwoord nodig om de reservekopie te importeren. Travel Log bewaart het niet, dus als je het vergeet, kan de reservekopie niet worden hersteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisará desta senha para importar o backup. O Travel Log não guarda uma cópia dela, então, se você esquecê-la, o backup não poderá ser recuperado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai precisar desta palavra-passe para importar a cópia de segurança. O Travel Log não guarda uma cópia, por isso, se a esquecer, a cópia de segurança não poderá ser recuperada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver lösenordet för att importera säkerhetskopian. Travel Log sparar det inte, så om du glömmer det kan säkerhetskopian inte återställas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeği içe aktarmak için bu parola gerekecek. Travel Log parolayı saklamaz; parolayı unutursanız yedek kurtarılamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ cần mật khẩu này để nhập bản sao lưu. Travel Log không lưu mật khẩu, nên nếu bạn quên, bản sao lưu sẽ không thể khôi phục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入此备份时需要此密码。Travel Log 不会保存密码，如果忘记密码，备份将无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯入此備份時需要此密碼。Travel Log 不會保存密碼，如果忘記密碼，備份將無法復原。"
          }
        }
      }
    },
    "settings.gpx-import.error.too-large" : {
      "comment" : "GPX import error when the file is larger than the import can read.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-filen er for stor til at blive importeret på denne enhed. Eksporter en kortere periode, og prøv derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese GPX-Datei ist zu groß, um sie auf diesem Gerät zu importieren. Exportieren Sie einen kürzeren Zeitraum und versuchen Sie es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αρχείο GPX είναι πολύ μεγάλο για εισαγωγή σε αυτή τη συσκευή. Εξήγαγε μικρότερη περίοδο και μετά δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This GPX file is too large to import on this device. Export a shorter period, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo GPX es demasiado grande para importarlo en este dispositivo. Exporte un periodo más corto e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier GPX est trop volumineux pour être importé sur cet appareil. Exportez une période plus courte, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo file GPX è troppo grande per essere importato su questo dispositivo. Esporta un periodo più breve, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このGPXファイルは大きすぎるため、このデバイスでは読み込めません。期間を短くして書き出してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 GPX 파일은 너무 커서 이 기기에서 가져올 수 없어요. 더 짧은 기간을 내보낸 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne GPX-filen er for stor til å importeres på denne enheten. Eksporter en kortere periode, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit GPX-bestand is te groot om op dit apparaat te importeren. Exporteer een kortere periode en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo GPX é grande demais para ser importado neste dispositivo. Exporte um período mais curto e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ficheiro GPX é demasiado grande para ser importado neste dispositivo. Exporte um período mais curto e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-filen är för stor för att importeras på den här enheten. Exportera en kortare period och försök sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu GPX dosyası bu aygıtta içe aktarılamayacak kadar büyük. Daha kısa bir dönemi dışa aktarıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp GPX này quá lớn để nhập trên thiết bị này. Hãy xuất một khoảng thời gian ngắn hơn rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 GPX 文件太大，无法在此设备上导入。请导出较短的时间段后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 GPX 檔案太大，無法在此裝置上匯入。請匯出較短的時間段後再試。"
          }
        }
      }
    },
