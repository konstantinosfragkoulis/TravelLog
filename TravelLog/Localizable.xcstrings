    "Every city, town, and island you stay in shows up here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle byer og øer, du opholder dig i, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Stadt, Ortschaft und Insel, in der Sie sich aufhalten, erscheint hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε πόλη, κωμόπολη και νησί όπου μένεις εμφανίζεται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every city, town, and island you stay in shows up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen todas las ciudades, localidades e islas en las que se aloje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ville, commune et île où vous séjournez apparaît ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni città, località e isola in cui soggiorni appare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滞在したすべての都市、町、島がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
