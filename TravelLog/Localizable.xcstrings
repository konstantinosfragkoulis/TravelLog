    "root.tracking-warning.detail.not-determined" : {
      "comment" : "Tracking warning detail before the user has chosen a location permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er ikke konfigureret, så Travel Log kan ikke registrere dine rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff wurde noch nicht eingerichtet, daher kann Travel Log Ihre Reisen nicht aufzeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει ρυθμιστεί η πρόσβαση στην τοποθεσία, οπότε το Travel Log δεν μπορεί να καταγράφει τα ταξίδια σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location access hasn't been set up, so Travel Log can't record your trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se configuró el acceso a la ubicación, por lo que Travel Log no puede registrar sus viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la localisation n’a pas été configuré ; Travel Log ne peut donc pas enregistrer vos voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione non è stato configurato, quindi Travel Log non può registrare i viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスが設定されていないため、Travel Logは旅行を記録できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 설정되지 않아 Travel Log가 여행을 기록할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang er ikke konfigurert, så Travel Log kan ikke registrere reisene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang is niet ingesteld, dus Travel Log kan je reizen niet vastleggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização não foi configurado, então o Travel Log não pode registrar suas viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização não foi configurado, pelo que o Travel Log não consegue registar as suas viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsåtkomst har inte ställts in, så Travel Log kan inte registrera dina resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi ayarlanmadığından Travel Log seyahatlerinizi kaydedemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vị trí chưa được thiết lập nên Travel Log không thể ghi chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未设置位置访问权限，因此 Travel Log 无法记录您的旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
