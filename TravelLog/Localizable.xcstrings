    "settings.data-import.error.nothing-imported" : {
      "comment" : "Trip-data import error when the operation imports nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet blev importeret. Filen er muligvis en dublet af eksisterende data eller indeholder ingen gyldige rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wurde importiert. Die Datei enthält möglicherweise nur bereits vorhandene Daten oder keine gültigen Reisen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν εισήχθη τίποτα. Το αρχείο μπορεί να περιέχει διπλότυπα υπαρχόντων δεδομένων ή κανένα έγκυρο ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing was imported. The file may duplicate existing data or contain no valid trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se importó nada. Es posible que el archivo duplique datos existentes o no contenga viajes válidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun élément n’a été importé. Le fichier peut contenir des données déjà présentes ou aucun voyage valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato importato nulla. Il file potrebbe duplicare dati esistenti o non contenere viaggi validi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も読み込まれませんでした。既存データと重複しているか、有効な旅行が含まれていない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 항목이 없어요. 파일의 데이터가 기존 데이터와 중복되거나 유효한 여행이 없을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting ble importert. Filen kan inneholde data som allerede finnes, eller ingen gyldige reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is niets geïmporteerd. Het bestand bevat mogelijk alleen bestaande gegevens of geen geldige reizen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi importado. O arquivo pode duplicar dados existentes ou não conter viagens válidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi importado. O ficheiro pode duplicar dados existentes ou não conter viagens válidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget importerades. Filen kan innehålla dubbletter av befintliga data eller sakna giltiga resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey içe aktarılmadı. Dosya mevcut verileri yineliyor veya geçerli seyahat içermiyor olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì được nhập. Tệp có thể trùng với dữ liệu hiện có hoặc không chứa chuyến đi hợp lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未导入任何内容。该文件可能与现有数据重复，或不包含有效旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未匯入任何內容。該檔案可能與現有資料重複，或不包含有效旅程。"
          }
        }
      }
    },
    "settings.data-import.error.partial-save" : {
      "comment" : "Trip-data import error when only part of the imported data could be saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen kunne ikke gemmes helt. Nogle rejser mangler muligvis. Det er sikkert at importere den samme fil igen, så hullerne udfyldes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Import konnte nicht vollständig gespeichert werden. Einige Reisen fehlen möglicherweise. Sie können dieselbe Datei gefahrlos erneut importieren, um die Lücken zu füllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η πλήρης αποθήκευση της εισαγωγής. Ορισμένα ταξίδια μπορεί να λείπουν. Είναι ασφαλές να εισαγάγεις ξανά το ίδιο αρχείο και θα συμπληρωθούν τα κενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The import could not be fully saved. Some trips may be missing. Importing the same file again is safe and will fill the gaps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar toda la importación. Es posible que falten viajes. Puede importar el mismo archivo otra vez para completar lo que falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’import n’a pas pu être entièrement enregistré. Certains voyages peuvent manquer. Vous pouvez réimporter le même fichier sans risque pour compléter les données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare completamente l’importazione. Alcuni viaggi potrebbero mancare. È sicuro importare di nuovo lo stesso file per colmare le lacune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだデータを完全には保存できませんでした。一部の旅行が欠けている可能性があります。同じファイルを再度読み込むと、安全に不足分を補えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 내용을 모두 저장할 수 없어요. 일부 여행이 누락되었을 수 있어요. 같은 파일을 다시 가져오면 안전하게 누락된 항목을 채울 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen kunne ikke lagres fullstendig. Noen reiser kan mangle. Det er trygt å importere samme fil igjen for å fylle hullene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De import kon niet volledig worden bewaard. Sommige reizen ontbreken mogelijk. Je kunt hetzelfde bestand veilig opnieuw importeren om de ontbrekende gegevens aan te vullen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar toda a importação. Algumas viagens podem estar ausentes. É seguro importar o mesmo arquivo novamente para preencher as lacunas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível guardar toda a importação. Algumas viagens podem estar ausentes. É seguro importar o mesmo ficheiro novamente para preencher as lacunas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importen kunde inte sparas helt. Några resor kan saknas. Det är säkert att importera samma fil igen för att fylla luckorna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarma tamamen kaydedilemedi. Bazı seyahatler eksik olabilir. Aynı dosyayı yeniden içe aktarmak güvenlidir ve boşlukları doldurur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể lưu đầy đủ dữ liệu nhập. Có thể thiếu một số chuyến đi. Bạn có thể nhập lại cùng tệp một cách an toàn để bổ sung phần còn thiếu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法完整保存导入内容，部分旅程可能缺失。再次导入同一文件是安全的，并会补全缺失内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法完整儲存匯入內容，部分旅程可能缺失。再次匯入同一檔案是安全的，並會補齊缺失內容。"
          }
        }
      }
    },
    "settings.data-import.error.processing-incomplete" : {
      "comment" : "Timeline or GPX import error when the location fixes were saved but rebuilding trips from them did not finish.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
