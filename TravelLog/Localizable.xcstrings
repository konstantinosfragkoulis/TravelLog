            "value" : "Status do rastreamento"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estado do acompanhamento"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spårningsstatus"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takip Durumu"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trạng thái theo dõi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录状态"
          }
        },
