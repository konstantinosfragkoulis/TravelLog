    "collections.flights.candidates.footer" : {
      "comment" : "Flight Log footer under possible flights; dismissals are stored on this device only.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bekræfter, føjes en flyrejse til din log. Når du afviser, skjules forslaget på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch Bestätigen wird ein Flug zu Ihrem Protokoll hinzugefügt. Durch Verwerfen wird der Vorschlag auf diesem Gerät ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την επιβεβαίωση προστίθεται μια πτήση στο αρχείο σου. Με την απόρριψη η πρόταση αποκρύπτεται σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Confirming adds a flight to your log. Dismissing hides the suggestion on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmar añade un vuelo al registro. Descartar oculta la sugerencia en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmer ajoute un vol à votre journal. Ignorer masque la suggestion sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se confermi, il volo viene aggiunto al registro. Se ignori, il suggerimento viene nascosto su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定するとフライトが記録に追加されます。閉じると、このデバイスでは候補が表示されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인하면 항공편이 기록에 추가돼요. 닫으면 이 기기에서 제안이 숨겨져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreftelse legger en flyreise til i loggen. Avvisning skjuler forslaget på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigen voegt een vlucht toe aan je logboek. Afwijzen verbergt de suggestie op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmar adiciona um voo ao registro. Dispensar oculta a sugestão neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmar adiciona um voo ao registo. Descartar oculta a sugestão neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du bekräftar läggs en flygning till i loggen. Om du avfärdar döljs förslaget på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onaylamak günlüğünüze bir uçuş ekler. Kapatmak öneriyi bu cihazda gizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác nhận sẽ thêm chuyến bay vào nhật ký. Bỏ qua sẽ ẩn gợi ý trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认后会将航班添加到航班记录。忽略后，此建议将在这台设备上隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後會將航班加入到航班記錄。忽略後，此建議將在這台裝置上隱藏。"
          }
        }
      }
    },
    "collections.flights.empty.description" : {
      "comment" : "Flight Log empty-state description; Detect Flights is the Settings button of that name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyrejser vises her, når Travel Log finder flyrejser i dine registrerede placeringer. For ældre rejser kan du prøve Registrer flyrejser i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüge erscheinen hier, wenn Travel Log in Ihren aufgezeichneten Standorten Flugreisen erkennt. Für ältere Reisen können Sie in den Einstellungen „Flüge erkennen“ verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πτήσεις εμφανίζονται εδώ όταν το Travel Log εντοπίζει αεροπορικά ταξίδια στις καταγεγραμμένες τοποθεσίες σου. Για παλαιότερα ταξίδια, δοκίμασε τον Εντοπισμό πτήσεων στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Flights appear here when Travel Log detects air travel in your recorded locations. For older journeys, try Detect Flights in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vuelos aparecen aquí cuando Travel Log detecta viajes en avión en sus ubicaciones registradas. Para viajes anteriores, pruebe Detectar vuelos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vols apparaissent ici lorsque Travel Log détecte des trajets en avion dans vos positions enregistrées. Pour les voyages plus anciens, essayez Détecter les vols dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I voli compaiono qui quando Travel Log rileva viaggi in aereo nelle posizioni registrate. Per i viaggi meno recenti, prova Rileva voli in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logが記録された位置情報から空の移動を検出すると、ここにフライトが表示されます。以前の旅行については、設定の「フライトを検出」をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log가 기록된 위치에서 항공 이동을 감지하면 항공편이 여기에 표시돼요. 이전 여행은 설정에서 항공편 감지를 사용해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyreiser vises her når Travel Log oppdager flyreiser i de registrerte posisjonene dine. For eldre reiser kan du prøve Finn flyreiser i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vluchten verschijnen hier wanneer Travel Log luchtreizen herkent in je vastgelegde locaties. Probeer voor oudere reizen Detecteer vluchten in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os voos aparecem aqui quando o Travel Log detecta viagens aéreas nas suas localizações registradas. Para viagens mais antigas, experimente Detectar voos em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os voos aparecem aqui quando o Travel Log deteta viagens aéreas nas suas localizações registadas. Para viagens mais antigas, experimente Detetar voos nas Definições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flygningar visas här när Travel Log identifierar flygresor i dina registrerade platser. För äldre resor kan du prova Identifiera flygningar i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kaydedilen konumlarınızda hava yolculuğu algıladığında uçuşlar burada görünür. Eski yolculuklar için Ayarlar'da Uçuşları Algıla'yı deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chuyến bay sẽ xuất hiện tại đây khi Travel Log phát hiện việc di chuyển bằng máy bay trong các vị trí đã ghi lại. Với các chuyến đi cũ hơn, hãy thử Phát hiện chuyến bay trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Travel Log 在您记录的位置中检测到空中旅行时，航班会显示在这里。对于较早的旅程，请尝试“设置”中的“检测航班”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 Travel Log 在您記錄的位置中偵測到空中旅行時，航班會顯示在這裡。對於較早的旅程，請試試「設定」中的「偵測航班」。"
          }
        }
      }
    },
