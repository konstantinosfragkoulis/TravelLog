          }
        }
      }
    },
    "root.tracking-warning.detail.restricted" : {
      "comment" : "Tracking warning detail when location access is restricted by the device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er begrænset på denne enhed, muligvis på grund af børnesikring eller en administrationsprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist auf diesem Gerät eingeschränkt, möglicherweise durch Kindersicherungen oder ein Verwaltungsprofil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην τοποθεσία είναι περιορισμένη σε αυτήν τη συσκευή, πιθανώς λόγω γονικού ελέγχου ή προφίλ διαχείρισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location access is restricted on this device, possibly by parental controls or a management profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está restringido en este dispositivo, posiblemente por controles parentales o un perfil de gestión."
