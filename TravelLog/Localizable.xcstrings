    "data-export.error.trip-name-too-long" : {
      "comment" : "Export error when a trip's custom name is longer than a backup can restore. The placeholder is the trip's start date.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejsen, der starter %@, har et navn, der er for langt til at kunne gendannes fra en sikkerhedskopi. Gør navnet kortere, og eksportér derefter igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reise, die am %@ beginnt, hat einen Namen, der zu lang ist, um aus einem Backup wiederhergestellt zu werden. Kürzen Sie den Namen und exportieren Sie dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το ταξίδι που ξεκινά στις %@ έχει όνομα πολύ μεγάλο για να επαναφερθεί από αντίγραφο ασφαλείας. Σύντμησε το όνομα και μετά κάνε ξανά εξαγωγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The trip that starts on %@ has a name too long to restore from a backup. Shorten its name, then export again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El viaje que empieza el %@ tiene un nombre demasiado largo para restaurarlo desde una copia. Acorte el nombre y vuelva a exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voyage qui commence le %@ porte un nom trop long pour être restauré depuis une sauvegarde. Raccourcissez son nom, puis exportez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il viaggio che inizia il %@ ha un nome troppo lungo per essere ripristinato da un backup. Accorcia il nome, poi esporta di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に始まる旅行の名前が長すぎるため、バックアップから復元できません。名前を短くしてから、もう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 시작하는 여행의 이름이 너무 길어 백업에서 복원할 수 없어요. 이름을 줄인 다음 다시 내보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen som starter %@, har et navn som er for langt til å gjenopprettes fra en sikkerhetskopi. Gjør navnet kortere, og eksporter deretter på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De reis die op %@ begint, heeft een naam die te lang is om uit een reservekopie te herstellen. Maak de naam korter en exporteer daarna opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A viagem que começa em %@ tem um nome longo demais para ser restaurado de um backup. Encurte o nome e exporte novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A viagem que começa a %@ tem um nome demasiado longo para ser restaurado a partir de uma cópia de segurança. Encurte o nome e exporte novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resan som börjar %@ har ett namn som är för långt för att kunna återställas från en säkerhetskopia. Korta namnet och exportera sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarihinde başlayan seyahatin adı, bir yedekten geri yüklenemeyecek kadar uzun. Adı kısaltın, ardından yeniden dışa aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyến đi bắt đầu vào %@ có tên quá dài để khôi phục từ bản sao lưu. Hãy rút ngắn tên, rồi xuất lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始于 %@ 的旅程名称过长，无法从备份中恢复。请缩短名称，然后重新导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始於 %@ 的旅程名稱過長，無法從備份中恢復。請縮短名稱，然後重新匯出。"
          }
        }
      }
    },
