    "shared-trip.result.added" : {
      "comment" : "Shared trip result after a successful add, naming where to undo it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føjet til din historik. Du kan fjerne den igen under Indstillinger › Import og eksport › Delte rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu Ihrem Verlauf hinzugefügt. Sie können sie unter Einstellungen › Import & Export › Geteilte Reisen wieder entfernen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστέθηκε στο ιστορικό σας. Μπορείτε να το αφαιρέσετε ξανά στις Ρυθμίσεις › Εισαγωγή και εξαγωγή › Κοινόχρηστα ταξίδια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Added to your history. You can remove it again under Settings › Import & Export › Shared Trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadido a tu historial. Puedes eliminarlo de nuevo en Ajustes › Importar y exportar › Viajes compartidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté à votre historique. Vous pouvez le supprimer dans Réglages › Import et export › Voyages partagés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunto alla tua cronologia. Puoi rimuoverlo in Impostazioni › Importazione ed esportazione › Viaggi condivisi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴に追加しました。設定 › 読み込みと書き出し › 共有された旅行 からいつでも削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에 추가되었습니다. 설정 › 가져오기 및 내보내기 › 공유된 여행에서 다시 삭제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagt til i historikken din. Du kan fjerne den igjen under Innstillinger › Import og eksport › Delte reiser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegevoegd aan je geschiedenis. Je kunt het weer verwijderen via Instellingen › Importeren en exporteren › Gedeelde reizen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionada ao seu histórico. Você pode removê-la em Ajustes › Importação e exportação › Viagens compartilhadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionada ao seu histórico. Pode removê-la em Definições › Importação e exportação › Viagens partilhadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillagd i din historik. Du kan ta bort den igen under Inställningar › Import och export › Delade resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmişinize eklendi. Ayarlar › İçe ve Dışa Aktarma › Paylaşılan Seyahatler bölümünden yeniden kaldırabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã thêm vào lịch sử của bạn. Bạn có thể xóa lại trong Cài đặt › Nhập và xuất › Chuyến đi được chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加到你的历史记录。你可以在“设置 › 导入与导出 › 共享的旅程”中再次移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已加入你的歷史記錄。你可以在「設定 › 匯入與匯出 › 分享的旅程」中再次移除。"
          }
        }
      }
    },
    "shared-trip.error.busy" : {
      "comment" : "Shared trip error when an add or removal is already running.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden delt rejse er ved at blive tilføjet. Prøv igen, når den er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere geteilte Reise wird gerade hinzugefügt. Versuche es erneut, wenn sie fertig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προστίθεται ήδη ένα άλλο κοινόχρηστο ταξίδι. Δοκιμάστε ξανά όταν ολοκληρωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another shared trip is being added. Try again when it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está añadiendo otro viaje compartido. Inténtalo de nuevo cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre voyage partagé est en cours d’ajout. Réessayez lorsqu’il sera terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso l’aggiunta di un altro viaggio condiviso. Riprova quando è terminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の共有された旅行を追加中です。完了してからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 공유된 여행을 추가하는 중입니다. 완료된 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen delt reise legges til. Prøv igjen når den er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt al een andere gedeelde reis toegevoegd. Probeer het opnieuw als die klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra viagem compartilhada está sendo adicionada. Tente novamente quando terminar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a ser adicionada outra viagem partilhada. Tente novamente quando terminar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan delad resa läggs till. Försök igen när den är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir paylaşılan seyahat ekleniyor. Bittiğinde yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một chuyến đi được chia sẻ khác đang được thêm. Hãy thử lại khi hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
