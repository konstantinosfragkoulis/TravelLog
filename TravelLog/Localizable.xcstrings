    "app-intent.travel-stats.description" : {
      "comment" : "Siri travel statistics description. Days away includes domestic and international trip dates.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsummerer dine rejser (lande, rejser, dage hjemmefra og flyrejser) for hele perioden eller et enkelt år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst Ihre Reisen für den gesamten Zeitraum oder ein einzelnes Jahr zusammen: Länder, Reisen, Tage unterwegs und Flüge."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνοψίζει τα ταξίδια σου (χώρες, ταξίδια, ημέρες μακριά από το σπίτι και πτήσεις) για όλα τα έτη ή για ένα συγκεκριμένο έτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Summarizes your travel (countries, trips, days away, and flights) for your lifetime or a single year."
