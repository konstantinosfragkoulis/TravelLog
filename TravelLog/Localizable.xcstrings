    "temporary-home.form.stale-review" : {
      "comment" : "Notice in the temporary home form after Save was tapped while trips changed underneath the review: nothing was saved, and the What Changes section shows the fresh review.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejserne ændrede sig, mens du gennemgik dem. Tjek Hvad der ændres, og gem igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reisen haben sich während Ihrer Prüfung geändert. Prüfen Sie „Was sich ändert“ und speichern Sie erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια άλλαξαν ενώ τα έλεγχες. Έλεγξε το Τι αλλάζει και αποθήκευσε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trips changed while you were reviewing. Check What Changes and save again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes cambiaron mientras los revisaba. Compruebe Qué cambia y vuelva a guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voyages ont changé pendant votre vérification. Consultez Ce qui change et enregistrez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi sono cambiati mentre li controllavi. Controlla Cosa cambia e salva di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認中に旅行が変更されました。「変更点」を確認して、もう一度保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토하는 동안 여행이 바뀌었어요. 변경 사항을 확인하고 다시 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisene endret seg mens du gikk gjennom dem. Sjekk Hva som endres, og lagre på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De reizen zijn veranderd terwijl je ze bekeek. Bekijk Wat er verandert en bewaar opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens mudaram enquanto você revisava. Confira O que muda e salve novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens mudaram enquanto revia. Verifique O que muda e guarde novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resorna ändrades medan du granskade. Kontrollera Vad som ändras och spara igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siz incelerken seyahatler değişti. Neler Değişecek bölümünü kontrol edip yeniden kaydedin."
