    "settings.data-import.opened-backup.busy" : {
      "comment" : "Import error when a backup is opened from Files or AirDrop while an import, export or other data task is running.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden opgave er i gang. Åbn sikkerhedskopien igen, når den er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade läuft ein anderer Vorgang. Öffnen Sie das Backup erneut, wenn er abgeschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελείται ήδη άλλη εργασία. Ανοίξτε ξανά το αντίγραφο ασφαλείας όταν ολοκληρωθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Another task is running. Open the backup again when it finishes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay otra tarea en curso. Vuelva a abrir la copia cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre tâche est en cours. Rouvrez la sauvegarde lorsqu’elle sera terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un’altra operazione. Apri di nuovo il backup quando è terminata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の処理を実行中です。完了してから、もう一度バックアップを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 작업이 진행 중이에요. 완료되면 백업을 다시 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen oppgave pågår. Åpne sikkerhetskopien igjen når den er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er loopt al een andere taak. Open de reservekopie opnieuw als die klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra tarefa está em andamento. Abra o backup novamente quando ela terminar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a decorrer outra tarefa. Abra novamente a cópia de segurança quando terminar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan åtgärd pågår. Öppna säkerhetskopian igen när den är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir işlem sürüyor. Bittiğinde yedeği yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tác vụ khác đang chạy. Hãy mở lại bản sao lưu khi tác vụ đó hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一项任务正在进行。完成后请再次打开此备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一項作業正在進行。完成後請再次打開此備份。"
          }
        }
      }
    },
