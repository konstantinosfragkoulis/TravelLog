    "Removes all detected upcoming trips and clears AI trip titles so they regenerate. Your trips, stays, and location data are untouched." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle registrerede kommende rejser og rydder AI-rejsetitler, så de oprettes igen. Dine rejser, ophold og lokalitetsdata ændres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle erkannten bevorstehenden Reisen und löscht KI-Reisetitel, damit sie neu erstellt werden. Ihre Reisen, Aufenthalte und Standortdaten bleiben unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί όλα τα επερχόμενα ταξίδια που εντοπίστηκαν και διαγράφει τους τίτλους ταξιδιών AI ώστε να δημιουργηθούν ξανά. Τα ταξίδια, οι παραμονές και τα δεδομένα τοποθεσίας σου δεν επηρεάζονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes all detected upcoming trips and clears AI trip titles so they regenerate. Your trips, stays, and location data are untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los próximos viajes detectados y borra los títulos de IA para que se vuelvan a generar. Sus viajes, estancias y datos de ubicación no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les voyages à venir détectés et efface les titres de voyage générés par l’IA afin qu’ils soient regénérés. Vos voyages, séjours et données de localisation ne sont pas modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove tutti i prossimi viaggi rilevati e cancella i titoli IA affinché vengano rigenerati. Viaggi, soggiorni e dati sulla posizione non vengono modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出された今後の旅行をすべて削除し、AIの旅行タイトルを消去して再生成します。旅行、滞在、位置情報データには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감지된 모든 예정 여행을 삭제하고 AI 여행 제목을 지워 다시 생성되도록 해요. 여행, 체류, 위치 데이터에는 영향을 주지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle registrerte kommende reiser og tømmer AI-reisetitler, slik at de lages på nytt. Reiser, opphold og posisjonsdata berøres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alle gedetecteerde aankomende reizen en wist AI-reistitels zodat ze opnieuw worden gegenereerd. Je reizen, verblijven en locatiegegevens blijven ongewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todas as próximas viagens detectadas e limpa os títulos de viagem da IA para que sejam gerados novamente. Suas viagens, estadias e dados de localização não são alterados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todas as próximas viagens detetadas e limpa os títulos de viagem da IA para que sejam gerados novamente. As suas viagens, estadias e dados de localização não são alterados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla identifierade kommande resor och rensar AI-resetitlar så att de skapas på nytt. Dina resor, vistelser och platsdata påverkas inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algılanan tüm yaklaşan seyahatleri kaldırır ve yapay zekâ seyahat başlıklarını yeniden oluşturulmaları için temizler. Seyahatlerinize, konaklamalarınıza ve konum verilerinize dokunulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi chuyến đi sắp tới đã phát hiện và xóa tiêu đề chuyến đi do AI tạo để chúng được tạo lại. Chuyến đi, lần lưu trú và dữ liệu vị trí không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除所有检测到的即将开始的旅程，并清除 AI 旅程标题以便重新生成。您的旅程、停留和位置数据不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除所有偵測到的即將開始的旅程，並清除 AI 旅程標題以便重新產生。您的旅程、停留和位置資料不受影響。"
          }
        }
      }
    },
