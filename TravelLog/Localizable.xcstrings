    "trip-share.error.unreadable" : {
      "comment" : "Share error when the trips or home areas could not be read.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine rejser kunne ikke læses lige nu. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Reisen konnten gerade nicht gelesen werden. Versuchen Sie es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των ταξιδιών σας αυτή τη στιγμή. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your trips couldn't be read just now. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer tus viajes en este momento. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos voyages n’ont pas pu être lus pour le moment. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è stato possibile leggere i tuoi viaggi. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在旅行を読み込めません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 여행을 읽을 수 없습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisene dine kunne ikke leses akkurat nå. Prøv igjen om litt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reizen konden nu niet worden gelezen. Probeer het zo opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler suas viagens agora. Tente novamente em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as suas viagens neste momento. Tente novamente daqui a pouco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina resor kunde inte läsas just nu. Försök igen om en stund."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahatleriniz şu anda okunamadı. Biraz sonra yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc các chuyến đi của bạn lúc này. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
