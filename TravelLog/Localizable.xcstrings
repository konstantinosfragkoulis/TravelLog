    "Weather data is fetched for each stay after it ends. Stays before August 2021 have no weather data available." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejrdata hentes for hvert ophold, når det slutter. Der findes ingen vejrdata for ophold før august 2021."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wetterdaten werden nach Ende jedes Aufenthalts abgerufen. Für Aufenthalte vor August 2021 sind keine Wetterdaten verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα καιρού ανακτώνται για κάθε παραμονή αφού τελειώσει. Δεν υπάρχουν διαθέσιμα δεδομένα καιρού για παραμονές πριν από τον Αύγουστο του 2021."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Weather data is fetched for each stay after it ends. Stays before August 2021 have no weather data available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos meteorológicos se obtienen para cada estancia cuando termina. No hay datos disponibles para estancias anteriores a agosto de 2021."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données météo sont récupérées à la fin de chaque séjour. Aucune donnée météo n’est disponible pour les séjours antérieurs à août 2021."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati meteo vengono recuperati al termine di ogni soggiorno. Non sono disponibili per i soggiorni precedenti ad agosto 2021."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天気データは各滞在の終了後に取得されます。2021年8月より前の滞在では天気データを利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 체류가 끝나면 날씨 데이터를 가져와요. 2021년 8월 이전 체류에는 사용할 수 있는 날씨 데이터가 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdata hentes for hvert opphold etter at det er avsluttet. Værdata er ikke tilgjengelig for opphold før august 2021."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weergegevens worden voor elk verblijf opgehaald nadat het eindigt. Voor verblijven van vóór augustus 2021 zijn geen weergegevens beschikbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados de clima são obtidos para cada estadia depois que ela termina. Não há dados disponíveis para estadias anteriores a agosto de 2021."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados meteorológicos são obtidos para cada estadia depois de esta terminar. Não existem dados meteorológicos para estadias anteriores a agosto de 2021."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väderdata hämtas för varje vistelse efter att den avslutats. Det finns inga väderdata för vistelser före augusti 2021."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava durumu verileri her konaklama bittikten sonra alınır. Ağustos 2021 öncesindeki konaklamalar için hava durumu verisi yoktur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu thời tiết được tải cho mỗi lần lưu trú sau khi kết thúc. Không có dữ liệu thời tiết cho các lần lưu trú trước tháng 8 năm 2021."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次停留结束后会获取相应天气数据。2021 年 8 月之前的停留没有可用的天气数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次停留結束後會取得相應天氣資料。2021 年 8 月之前的停留沒有可用的天氣資料。"
          }
        }
      }
    },
