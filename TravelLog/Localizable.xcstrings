    "Stays from \"%@\" will be merged into \"%@\"." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ophold fra \"%1$@\" bliver flettet ind i \"%2$@\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufenthalte aus „%1$@“ werden mit „%2$@“ zusammengeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραμονές από το «%1$@» θα συγχωνευτούν στο «%2$@»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stays from \"%1$@\" will be merged into \"%2$@\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estancias de \"%1$@\" se fusionarán con \"%2$@\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séjours de « %1$@ » seront fusionnés avec « %2$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I soggiorni di “%1$@” verranno uniti a “%2$@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」の滞在を「%2$@」に結合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”의 체류가 “%2$@”에 병합돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opphold fra «%1$@» slås sammen med «%2$@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verblijven van \"%1$@\" worden samengevoegd met \"%2$@\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estadias de \"%1$@\" serão combinadas com \"%2$@\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estadias de \"%1$@\" serão combinadas com \"%2$@\"."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistelser från ”%1$@” slås ihop med ”%2$@”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” konaklamaları “%2$@” ile birleştirilecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lần lưu trú từ \"%1$@\" sẽ được gộp vào \"%2$@\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”中的停留将合并到“%2$@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」中的停留將合併到「%2$@」。"
          }
        }
      }
    },
    "Stays from one trip will be merged into the other." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ophold fra den ene rejse bliver flettet ind i den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufenthalte aus einer Reise werden mit der anderen zusammengeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραμονές από το ένα ταξίδι θα συγχωνευτούν στο άλλο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stays from one trip will be merged into the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estancias de un viaje se fusionarán con el otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séjours d’un voyage seront fusionnés avec ceux de l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I soggiorni di un viaggio verranno uniti all’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方の旅行の滞在をもう一方に結合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 여행의 체류가 다른 여행에 병합돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opphold fra den ene reisen slås sammen med den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verblijven van de ene reis worden samengevoegd met de andere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estadias de uma viagem serão combinadas com as da outra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estadias de uma viagem serão combinadas com as da outra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistelser från den ena resan slås ihop med den andra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir seyahatteki konaklamalar diğeriyle birleştirilecek."
