          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está restrito neste dispositivo, possivelmente por controles parentais ou um perfil de gerenciamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
