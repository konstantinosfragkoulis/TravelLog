    "Permanently removes this trip and its underlying location data." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne rejse og de underliggende lokalitetsdata permanent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt diese Reise und die zugrunde liegenden Standortdaten dauerhaft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί οριστικά αυτό το ταξίδι και τα υποκείμενα δεδομένα τοποθεσίας του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Permanently removes this trip and its underlying location data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de forma permanente este viaje y sus datos de ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement ce voyage et ses données de localisation sous-jacentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente questo viaggio e i suoi dati sulla posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行と、その基となる位置情報データを完全に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행과 관련 위치 데이터를 영구적으로 삭제해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner denne reisen og tilhørende posisjonsdata permanent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert deze reis en de onderliggende locatiegegevens voorgoed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
