    "TravelLog's offline geocoder, country shapes, and airport data are built from the open datasets credited here." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogs offlinegeokodning, landekonturer og lufthavnsdata er baseret på de åbne datasæt, der krediteres her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Offline-Geocoder, die Länderformen und die Flughafendaten von TravelLog beruhen auf den hier genannten offenen Datensätzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο γεωκωδικοποιητής εκτός σύνδεσης, τα σχήματα χωρών και τα δεδομένα αεροδρομίων του TravelLog βασίζονται στα ανοικτά σύνολα δεδομένων που αναφέρονται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TravelLog's offline geocoder, country shapes, and airport data are built from the open datasets credited here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El geocodificador sin conexión, los contornos de países y los datos de aeropuertos de TravelLog se crean con los conjuntos de datos abiertos acreditados aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le géocodeur hors ligne, les contours de pays et les données d’aéroports de TravelLog sont issus des jeux de données ouverts crédités ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il geocodificatore offline, i confini dei paesi e i dati degli aeroporti di TravelLog derivano dai set di dati aperti indicati qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogのオフラインジオコーダー、国の形状、空港データは、ここに記載されたオープンデータセットから構築されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog의 오프라인 지오코더, 국가 형태, 공항 데이터는 여기에 출처가 표시된 공개 데이터 세트를 기반으로 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogs frakoblede geokoder, landegrenser og flyplassdata er basert på de åpne datasettene som krediteres her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De offline geocoder, landvormen en luchthavengegevens van TravelLog zijn opgebouwd uit de open gegevenssets die hier worden vermeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O geocodificador offline, os contornos de países e os dados de aeroportos do TravelLog são criados a partir dos conjuntos de dados abertos creditados aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O geocodificador offline, os contornos dos países e os dados dos aeroportos do TravelLog baseiam-se nos conjuntos de dados abertos aqui creditados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogs offlinegeokodare, landskonturer och flygplatsdata bygger på de öppna datamängder som anges här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog'un çevrimdışı coğrafi kodlayıcısı, ülke şekilleri ve havalimanı verileri burada belirtilen açık veri kümelerinden oluşturulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ mã hóa địa lý ngoại tuyến, hình dạng quốc gia và dữ liệu sân bay của TravelLog được xây dựng từ các bộ dữ liệu mở được ghi nhận tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog 的离线地理编码器、国家/地区边界和机场数据均基于此处列出的开放数据集构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog 的離線地理編碼器、國家或地區邊界和機場資料均基於此處列出的開放資料集構建。"
          }
        }
      }
    },
