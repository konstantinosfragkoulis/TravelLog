    "Everything from \"%@\" onwards will become a separate trip." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt fra \"%@\" og frem bliver til en separat rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles ab „%@“ wird zu einer eigenen Reise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα από το «%@» και μετά θα γίνουν ξεχωριστό ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything from \"%@\" onwards will become a separate trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo a partir de \"%@\" se convertirá en otro viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments à partir de « %@ » formeront un voyage distinct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che segue “%@” diventerà un viaggio separato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」以降のすべてが別の旅行になります。"
