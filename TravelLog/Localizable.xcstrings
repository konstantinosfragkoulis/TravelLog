    "onboarding.background-refresh.restricted.detail" : {
      "comment" : "Guidance when Background App Refresh is restricted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhedspolitik blokerer det, så sporingen kan stoppe, når iOS lukker appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Geräterichtlinie blockiert sie. Die Aufzeichnung kann stoppen, wenn iOS die App schließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πολιτική συσκευής την αποκλείει, οπότε η καταγραφή ίσως σταματήσει όταν το iOS κλείσει την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A device policy blocks it, so tracking may stop when iOS closes the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una política del dispositivo la bloquea. El seguimiento puede detenerse si iOS cierra la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle de l’appareil la bloque. Le suivi peut s’arrêter quand iOS ferme l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un criterio del dispositivo lo blocca. Il monitoraggio può fermarsi quando iOS chiude l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのポリシーで制限されているため、iOSがAppを閉じると記録が止まる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 정책으로 차단되어 있어 iOS가 앱을 닫으면 추적이 멈출 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhetspolicy blokkerer det, så sporingen kan stoppe når iOS lukker appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een apparaatbeleid blokkeert dit. Het volgen kan stoppen als iOS de app sluit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma política do dispositivo bloqueia a função. O rastreamento pode parar quando o iOS fechar o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma política do dispositivo bloqueia a função. O acompanhamento pode parar quando o iOS fechar a app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhetspolicy blockerar det, så spårningen kan stanna när iOS stänger appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıt politikası bunu engelliyor. iOS uygulamayı kapattığında takip durabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chính sách thiết bị chặn tính năng này nên việc theo dõi có thể dừng khi iOS đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
