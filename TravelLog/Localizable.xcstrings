        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang er begrenset på denne enheten, muligens av foreldrekontroll eller en administrasjonsprofil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
