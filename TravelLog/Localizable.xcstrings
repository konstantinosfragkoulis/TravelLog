    "tip.split.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk og hold på et stop, og vælg “Opdel rejsen her” for at starte en separat rejse ved det stop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Aufenthalt gedrückt und wähle „Reise hier teilen“, um dort eine separate Reise zu beginnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άγγιξε παρατεταμένα μια στάση και επίλεξε «Διαχωρισμός ταξιδιού εδώ» για να ξεκινήσεις ένα ξεχωριστό ταξίδι από εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold a stop, then choose “Split Trip Here” to start a separate trip at that stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenga pulsada una parada y elija «Dividir el viaje aquí» para iniciar un viaje separado en esa parada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une étape, puis choisissez « Scinder le voyage ici » pour commencer un voyage distinct à cet endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una tappa, poi scegli “Dividi il viaggio qui” per iniziare un viaggio separato da quella tappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち寄り先を長押しし、「ここで旅行を分割」を選ぶと、その場所から別の旅行を始められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머문 곳을 길게 누른 다음 ‘여기서 여행 분할’을 선택해 그곳에서 별도의 여행을 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på et stopp, og velg «Del reisen her» for å starte en egen reise ved det stoppet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een stop ingedrukt en kies ‘Splits reis hier’ om bij die stop een aparte reis te beginnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e segure uma parada e escolha “Dividir viagem aqui” para iniciar uma viagem separada nessa parada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque sem soltar numa paragem e escolha «Dividir viagem aqui» para iniciar uma viagem separada nessa paragem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck och håll på ett stopp och välj ”Dela resan här” för att börja en separat resa vid det stoppet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir durağa dokunup basılı tutun, ardından o duraktan ayrı bir seyahat başlatmak için “Seyahati Buradan Böl” seçeneğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ một điểm dừng, rồi chọn “Tách chuyến đi tại đây” để bắt đầu một chuyến đi riêng tại đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按一个停留点，然后选择“在此处拆分旅程”，从该停留点开始一段独立的旅行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按一個停留點，然後選擇「在此處分割旅程」，從該停留點開始一段獨立的旅行。"
          }
        }
      }
    },
