    "onboarding.photo-scan.error.awaiting-cloud-history" : {
      "comment" : "Onboarding photo-scan error when another device's history may still be syncing from iCloud.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine rejser er måske stadig på vej fra iCloud. En scanning nu kan give dubletter, så start scanningen fra Indstillinger, når de er kommet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Reisen werden möglicherweise noch aus iCloud geladen. Ein Scan jetzt könnte sie doppelt anlegen. Starten Sie den Scan daher in den Einstellungen, sobald sie da sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια σου ίσως φτάνουν ακόμη από το iCloud. Μια σάρωση τώρα μπορεί να δημιουργήσει διπλότυπα, οπότε ξεκίνα τη σάρωση από τις Ρυθμίσεις όταν φτάσουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your trips may still be arriving from iCloud. Scanning now could duplicate them, so start the scan from Settings once they have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que sus viajes aún estén llegando desde iCloud. Analizar ahora podría duplicarlos, así que inicie el análisis desde Ajustes cuando hayan llegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos voyages arrivent peut-être encore depuis iCloud. Lancer l’analyse maintenant pourrait les dupliquer : lancez-la depuis Réglages une fois qu’ils sont arrivés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi viaggi potrebbero essere ancora in arrivo da iCloud. Eseguire la scansione ora potrebbe duplicarli, quindi avviala da Impostazioni quando saranno arrivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行がまだiCloudから届いている途中かもしれません。今スキャンすると重複するおそれがあるため、届いてから「設定」でスキャンを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행이 아직 iCloud에서 도착하는 중일 수 있어요. 지금 스캔하면 중복될 수 있으니 도착한 후 설정에서 스캔을 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisene dine er kanskje fortsatt på vei fra iCloud. En skanning nå kan gi duplikater, så start skanningen fra Innstillinger når de har kommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je reizen komen mogelijk nog binnen vanuit iCloud. Nu scannen kan ze dubbel maken, dus start de scan via Instellingen zodra ze er zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas viagens ainda podem estar chegando do iCloud. Fazer a análise agora pode duplicá-las, então inicie a análise em Ajustes quando elas chegarem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas viagens podem ainda estar a chegar do iCloud. Efetuar a análise agora pode duplicá-las, por isso inicie a análise em Definições quando tiverem chegado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina resor kanske fortfarande hämtas från iCloud. En skanning nu kan ge dubbletter, så starta skanningen från Inställningar när de har kommit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahatleriniz hâlâ iCloud'dan geliyor olabilir. Şimdi taramak bunları çoğaltabilir; bu nedenle geldiklerinde taramayı Ayarlar'dan başlatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chuyến đi của bạn có thể vẫn đang được tải từ iCloud. Quét bây giờ có thể tạo bản trùng, vì vậy hãy bắt đầu quét từ Cài đặt khi chúng đã về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的旅行可能仍在从 iCloud 同步。现在扫描可能会产生重复，请在同步完成后从“设置”开始扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的旅行可能仍在從 iCloud 同步。現在掃描可能會產生重複，請在同步完成後從「設定」開始掃描。"
          }
        }
      }
    },
