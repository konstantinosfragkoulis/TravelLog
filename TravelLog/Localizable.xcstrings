    "settings.temporary-homes.footer" : {
      "comment" : "Footer of the Settings section listing temporary homes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sted, hvor du bor i en periode, f.eks. under et semester i udlandet. Rejser derfra slutter, når du vender tilbage dertil, og dit hjem fungerer som sædvanligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ort, an dem Sie eine Zeit lang leben, etwa während eines Auslandssemesters. Reisen von dort enden, wenn Sie dorthin zurückkehren, und Ihr Zuhause funktioniert weiter wie gewohnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα μέρος όπου μένεις για ένα διάστημα, όπως ένα εξάμηνο στο εξωτερικό. Τα ταξίδια από εκεί τερματίζονται όταν επιστρέφεις σε αυτό και η κατοικία σου συνεχίζει να λειτουργεί όπως πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A place you're living in for a while, like a semester abroad. Trips away from it end when you come back to it, and your home keeps working as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lugar donde vive durante un tiempo, como un semestre en el extranjero. Los viajes desde allí finalizan cuando regresa, y su residencia sigue funcionando como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu où vous vivez pendant un certain temps, comme un semestre à l’étranger. Les voyages au départ de ce lieu se terminent quand vous y revenez, et votre domicile continue de fonctionner comme d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un luogo in cui vivi per un periodo, ad esempio un semestre all’estero. I viaggi da lì si concludono quando ci ritorni e la tua casa continua a funzionare come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1学期間の留学など、しばらく暮らす場所です。そこからの旅行はそこに戻ると終了し、自宅はこれまでどおり機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해외에서 보내는 한 학기처럼 한동안 지내는 곳이에요. 이곳에서 떠난 여행은 이곳으로 돌아오면 끝나고, 집은 평소처럼 작동해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et sted der du bor en periode, for eksempel under et semester i utlandet. Reiser derfra avsluttes når du kommer tilbake dit, og hjemmet ditt fungerer som vanlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een plek waar je een tijdje woont, zoals tijdens een semester in het buitenland. Reizen vanaf die plek eindigen wanneer je er terugkomt, en je thuislocatie blijft werken zoals altijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um local onde você mora por um tempo, como um semestre no exterior. As viagens a partir dele se encerram quando você volta para lá, e sua casa continua funcionando normalmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um local onde vive durante algum tempo, como um semestre no estrangeiro. As viagens a partir dele terminam quando regressa a esse local, e a sua casa continua a funcionar normalmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En plats där du bor en tid, till exempel under en termin utomlands. Resor därifrån avslutas när du kommer tillbaka dit, och ditt hem fungerar som vanligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yurt dışında bir dönem gibi, bir süreliğine yaşadığınız bir yer. Buradan çıktığınız seyahatler buraya döndüğünüzde sona erer; ev bölgeniz her zamanki gibi çalışmaya devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nơi bạn sống trong một thời gian, chẳng hạn một học kỳ ở nước ngoài. Các chuyến đi từ nơi đó sẽ kết thúc khi bạn quay lại đó, còn nhà của bạn vẫn hoạt động như thường lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您会暂住一段时间的地方，例如出国留学一学期时的住处。从那里出发的旅程会在您返回那里时结束，您的常住地照常运作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您會暫住一段時間的地方，例如出國留學一學期時的住處。從那裡出發的旅程會在您返回那裡時結束，您的居住地照常運作。"
          }
        }
      }
    },
