    "app-intent.travel-stats.lifetime.country-one.trip-one.flight.one" : {
      "comment" : "Lifetime Siri travel summary with one country, one trip, and one flight.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har besøgt %1$@ land på %2$@ rejse med %3$@ dage hjemmefra og %4$@ flyrejse."
          }
        },
        "de" : {
