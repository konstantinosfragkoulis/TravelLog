          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eliminazioni per la privacy possono aggiornare i riepiloghi dell’anno salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー保護のためにデータを削除すると、保存済みの年間の旅の振り返りが更新されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호를 위해 데이터를 삭제하면 저장된 한 해 돌아보기가 업데이트될 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletting av personvernhensyn kan oppdatere lagrede årsoppsummeringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderingen voor je privacy kunnen opgeslagen jaaroverzichten bijwerken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclusões por privacidade podem atualizar as retrospectivas salvas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As eliminações por motivos de privacidade podem atualizar os resumos do ano guardados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderingar av integritetsskäl kan uppdatera sparade versioner av Året i korthet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik amacıyla yapılan silmeler, kaydedilmiş Yıl Özetlerini güncelleyebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc xóa dữ liệu vì quyền riêng tư có thể cập nhật các bản Nhìn lại một năm đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保护隐私而删除数据可能会更新已保存的年度回顾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為保護隱私而刪除資料，可能會更新已儲存的年度回顧。"
          }
        }
      }
    },
    "settings.wrapped.generation-failure.insufficient-data" : {
      "comment" : "Failure message when the requested year has too little travel data for a Wrapped; the argument is the year.",
