    "trip-photos.all-hidden.description" : {
      "comment" : "Trip gallery empty state when every photo of the trip on this device is hidden.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle billeder fra denne rejse er skjult. Du kan gendanne dem fra Skjulte billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Fotos dieser Reise sind ausgeblendet. Sie können sie unter „Ausgeblendete Fotos“ wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι φωτογραφίες αυτού του ταξιδιού είναι κρυφές. Μπορείς να τις επαναφέρεις από τις Κρυφές φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All of this trip's photos are hidden. You can restore them from Hidden Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las fotos de este viaje están ocultas. Puede restaurarlas desde Fotos ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les photos de ce voyage sont masquées. Vous pouvez les restaurer depuis Photos masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le foto di questo viaggio sono nascoste. Puoi ripristinarle da Foto nascoste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅行の写真はすべて非表示です。「非表示の写真」から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여행의 사진이 모두 숨겨져 있어요. 숨긴 사진에서 복원할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle bildene fra denne reisen er skjult. Du kan gjenopprette dem fra Skjulte bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle foto’s van deze reis zijn verborgen. Je kunt ze herstellen vanuit Verborgen foto’s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as fotos desta viagem estão ocultas. Você pode restaurá-las em Fotos ocultas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as fotografias desta viagem estão ocultas. Pode restaurá-las em Fotografias ocultas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla bilder från den här resan är dolda. Du kan återställa dem från Dolda bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seyahatin tüm fotoğrafları gizli. Gizli Fotoğraflar'dan geri yükleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả ảnh của chuyến đi này đã bị ẩn. Bạn có thể khôi phục chúng từ Ảnh đã ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这段旅程的所有照片均已隐藏。您可以从“已隐藏的照片”中恢复。"
          }
