    "root.storage-error.detail" : {
      "comment" : "Full-screen explanation when Travel Log could not open its persistent storage. Must not claim saved data exists: a first launch has none.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kunne ikke åbne sin datalagring. Genstart appen, eller frigør plads, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log konnte seinen Datenspeicher nicht öffnen. Starten Sie die App neu oder geben Sie Speicherplatz frei und versuchen Sie es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log δεν μπόρεσε να ανοίξει τον χώρο αποθήκευσής του. Κλείσε και άνοιξε ξανά την εφαρμογή ή ελευθέρωσε λίγο χώρο και δοκίμασε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log couldn't open its storage. Restart the app or free up some space, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log no pudo abrir su almacenamiento. Reinicie la app o libere algo de espacio e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log n’a pas pu ouvrir son espace de stockage. Redémarrez l’app ou libérez de l’espace, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log non è riuscito ad aprire il proprio archivio dati. Riavvia l’app o libera un po’ di spazio, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Logのデータ保存領域を開けませんでした。アプリを再起動するか、空き容量を増やしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log에서 데이터 저장소를 열 수 없었어요. 앱을 다시 시작하거나 저장 공간을 확보한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kunne ikke åpne datalagringen sin. Start appen på nytt eller frigjør litt plass, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kon zijn opslag niet openen. Start de app opnieuw of maak wat ruimte vrij en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não conseguiu abrir seu armazenamento. Reinicie o app ou libere espaço e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não conseguiu abrir o seu armazenamento. Reinicie a app ou liberte espaço e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kunde inte öppna sin datalagring. Starta om appen eller frigör lite utrymme och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log veri deposunu açamadı. Uygulamayı yeniden başlatın veya biraz yer açın, ardından yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log không thể mở bộ nhớ lưu trữ của mình. Hãy khởi động lại ứng dụng hoặc giải phóng bớt dung lượng, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 无法打开其数据存储。请重新启动 App 或释放一些空间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 無法開啟其資料儲存空間。請重新啟動 App 或釋放一些空間，然後再試一次。"
          }
        }
      }
    },
