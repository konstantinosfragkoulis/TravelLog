    "Disabling iCloud sync requires closing and reopening the app. Your data will remain on this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis iCloud-synkronisering slås fra, skal appen lukkes og åbnes igen. Dine data forbliver på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie die iCloud-Synchronisierung deaktivieren, muss die App geschlossen und erneut geöffnet werden. Ihre Daten bleiben auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απενεργοποίηση του συγχρονισμού iCloud απαιτεί να κλείσεις και να ανοίξεις ξανά την εφαρμογή. Τα δεδομένα σου θα παραμείνουν σε αυτήν τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Disabling iCloud sync requires closing and reopening the app. Your data will remain on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desactivar la sincronización con iCloud hay que cerrar y volver a abrir la app. Sus datos permanecerán en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La désactivation de la synchronisation iCloud nécessite de fermer puis de rouvrir l’app. Vos données resteront sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per disattivare la sincronizzazione con iCloud è necessario chiudere e riaprire l’app. I dati resteranno su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud同期を無効にするには、Appを閉じて開き直す必要があります。データはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화를 끄려면 앱을 닫았다가 다시 열어야 해요. 데이터는 이 기기에 남아 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår av iCloud-synkronisering, må appen lukkes og åpnes igjen. Dataene dine blir værende på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je iCloud-synchronisatie uitschakelt, moet je de app sluiten en opnieuw openen. Je gegevens blijven op dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a sincronização com o iCloud exige fechar e reabrir o app. Seus dados permanecerão neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desativar a sincronização com iCloud, é necessário fechar e voltar a abrir a app. Os seus dados permanecerão neste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du stänger av iCloud-synkronisering måste appen stängas och öppnas igen. Dina data finns kvar på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud eşzamanlamasını kapatmak için uygulamayı kapatıp yeniden açmanız gerekir. Verileriniz bu aygıtta kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt đồng bộ iCloud yêu cầu đóng rồi mở lại ứng dụng. Dữ liệu của bạn sẽ vẫn còn trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭 iCloud 同步需要退出并重新打开 App。您的数据会保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉 iCloud 同步需要退出並重新開啟 App。您的資料會保留在此裝置上。"
          }
        }
      }
    },
