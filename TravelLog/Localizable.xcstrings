    "Pull to refresh and cluster new pings. Stays are grouped from consecutive location pings within 3km and 4 hours of each other." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at opdatere og gruppere nye positionsmålinger. Ophold grupperes ud fra fortløbende positionsmålinger, der ligger inden for 3 km og 4 timer af hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Aktualisieren nach unten ziehen und neue Pings gruppieren. Aufenthalte werden aus aufeinanderfolgenden Standort-Pings gebildet, die höchstens 3 km und 4 Stunden auseinanderliegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τράβηξε για ανανέωση και ομαδοποίηση νέων σημάτων. Οι παραμονές ομαδοποιούνται από διαδοχικά σήματα τοποθεσίας που απέχουν έως 3 χλμ. και 4 ώρες μεταξύ τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pull to refresh and cluster new pings. Stays are grouped from consecutive location pings within 3km and 4 hours of each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslice hacia abajo para actualizar y agrupar nuevos registros. Las estancias se forman con registros consecutivos separados por menos de 3 km y 4 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez vers le bas pour actualiser et regrouper les nouveaux relevés. Les relevés de localisation consécutifs espacés de moins de 3 km et 4 heures sont regroupés en séjours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per aggiornare e raggruppare i nuovi rilevamenti. I soggiorni vengono formati da rilevamenti consecutivi entro 3 km e 4 ore l’uno dall’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルして更新し、新しい位置情報を滞在にまとめます。3 km以内かつ4時間以内に連続して記録された位置情報が、1回の滞在としてまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 당겨 새 위치 신호를 새로 고치고 묶으세요. 서로 3km 및 4시간 이내인 연속 위치 신호가 체류로 묶여요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å oppdatere og gruppere nye posisjoner. Opphold grupperes fra påfølgende posisjoner innenfor 3 km og 4 timer fra hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek om te vernieuwen en nieuwe pings te groeperen. Verblijven worden gevormd uit opeenvolgende locatiepings die binnen 3 km en 4 uur van elkaar liggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos separados por até 3 km e 4 horas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos a menos de 3 km e 4 horas entre si."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att uppdatera och gruppera nya platspunkter. Vistelser skapas av efterföljande platspunkter inom 3 km och 4 timmar från varandra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilemek ve yeni konum sinyallerini gruplamak için aşağı çekin. Birbirine 3 km ve 4 saat içinde olan ardışık konum sinyalleri konaklama olarak gruplanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để làm mới và nhóm tín hiệu vị trí mới. Các lần lưu trú được nhóm từ những tín hiệu vị trí liên tiếp cách nhau trong phạm vi 3km và 4 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下拉刷新并聚类新的位置点。相距不超过 3 公里且时间间隔不超过 4 小时的连续位置点会归组为停留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下拉重新整理並分群新的位置點。相距不超過 3 公里且時間間隔不超過 4 小時的連續位置點會歸類為停留。"
          }
        }
      }
    },
    "Pull to refresh. Swipe to delete. Trips are assembled from stays outside your home and routine places." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at opdatere. Skub for at slette. Rejser sammensættes af ophold uden for dit hjem og dine faste steder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Aktualisieren nach unten ziehen. Zum Löschen streichen. Reisen werden aus Aufenthalten außerhalb Ihrer Heimat und Ihrer Alltagsorte zusammengestellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τράβηξε για ανανέωση. Σύρε για διαγραφή. Τα ταξίδια συντίθενται από παραμονές έξω από την κατοικία και τα συνηθισμένα μέρη σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pull to refresh. Swipe to delete. Trips are assembled from stays outside your home and routine places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslice hacia abajo para actualizar y hacia un lado para eliminar. Los viajes se crean a partir de estancias fuera de su residencia y lugares habituales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez vers le bas pour actualiser. Balayez pour supprimer. Les voyages sont créés à partir des séjours en dehors de votre domicile et de vos lieux habituels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per aggiornare e scorri per eliminare. I viaggi vengono creati dai soggiorni al di fuori di casa e dei luoghi abituali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プルして更新します。スワイプして削除します。自宅と日常の場所以外での滞在から旅行が作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 당겨 새로 고치고 쓸어넘겨 삭제하세요. 집과 일상 장소 밖의 체류로 여행이 구성돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å oppdatere. Sveip for å slette. Reiser settes sammen av opphold utenfor hjemmet og faste steder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek om te vernieuwen. Veeg om te verwijderen. Reizen worden samengesteld uit verblijven buiten je thuisgebied en vaste plekken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe para atualizar. Deslize para apagar. As viagens são montadas a partir de estadias fora de casa e dos locais habituais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxe para atualizar. Passe o dedo para apagar. As viagens são criadas a partir de estadias fora de casa e dos locais habituais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att uppdatera. Svep för att radera. Resor sätts samman av vistelser utanför hemområdet och vardagsplatser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilemek için aşağı çekin. Silmek için kaydırın. Seyahatler, ev bölgenizin ve rutin yerlerinizin dışındaki konaklamalardan oluşturulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để làm mới. Vuốt để xóa. Chuyến đi được ghép từ các lần lưu trú ngoài nhà và địa điểm thường lui tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下拉刷新。轻扫删除。旅程由常住地和日常地点以外的停留组合而成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下拉重新整理。滑動刪除。旅程由居住地和日常地點以外的停留組合而成。"
          }
        }
      }
    },
