        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 이후의 모든 항목이 별도의 여행이 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
