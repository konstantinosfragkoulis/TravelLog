{
  "sourceLanguage" : "en",
  "strings" : {
    "settings.calendar.older-history.possible.title" : {
      "comment" : "Settings Calendar notice title when a calendar account's events on this device are all recent, which suggests a sync limit.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ældre begivenheder synkroniseres måske ikke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Ereignisse werden eventuell nicht synchronisiert"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα παλαιότερα συμβάντα ίσως δεν συγχρονίζονται"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Older events may not be synced"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que los eventos antiguos no estén sincronizados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements plus anciens ne sont peut-être pas synchronisés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi meno recenti potrebbero non essere sincronizzati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いイベントが同期されていない可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 이벤트가 동기화되지 않았을 수 있음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eldre hendelser synkroniseres kanskje ikke"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oudere activiteiten worden mogelijk niet gesynchroniseerd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos mais antigos podem não estar sincronizados"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos mais antigos podem não estar sincronizados"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äldre händelser kanske inte synkroniseras"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eski etkinlikler eşzamanlanmıyor olabilir"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các sự kiện cũ hơn có thể chưa được đồng bộ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较早的日程可能尚未同步"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較早的行程可能尚未同步"
          }
        }
      }
    },
    "settings.calendar.older-history.possible.message" : {
      "comment" : "Settings Calendar notice when a calendar account's events on this device are all recent, which suggests it syncs only recent events. The placeholder is the account name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gemmer måske kun nyere begivenheder på denne enhed. For at bekræfte flyrejser på tidligere rejser skal du kontrollere, at Synkroniser er sat til Alle begivenheder i Indstillinger → Apps → Kalender → Konti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ speichert auf diesem Gerät eventuell nur neuere Ereignisse. Um Flüge auf älteren Reisen zu bestätigen, prüfen Sie, ob für diesen Account unter Einstellungen → Apps → Kalender → Accounts bei „Synchronisieren“ die Option „Alle Ereignisse“ gewählt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός «%@» ίσως διατηρεί μόνο πρόσφατα γεγονότα σε αυτήν τη συσκευή. Για να επιβεβαιώσεις πτήσεις σε παλαιότερα ταξίδια, έλεγξε ότι ο Συγχρονισμός του είναι Όλα τα γεγονότα στις Ρυθμίσεις → Εφαρμογές → Ημερολόγιο → Λογαριασμοί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” may only keep recent events on this device. To confirm flights on older trips, check that its Sync option is All Events in Settings → Apps → Calendar → Accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que «%@» solo conserve eventos recientes en este dispositivo. Para confirmar vuelos en viajes anteriores, compruebe que su opción Sincronizar sea Todos los eventos en Ajustes → Apps → Calendario → Cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne conserve peut-être que les événements récents sur cet appareil. Pour confirmer les vols des anciens voyages, vérifiez que son option Synchroniser est réglée sur Tous les événements dans Réglages → Apps → Calendrier → Comptes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” potrebbe conservare solo gli eventi recenti su questo dispositivo. Per confermare i voli dei viaggi precedenti, verifica che la sua opzione Sincronizza sia impostata su Tutti gli eventi in Impostazioni → App → Calendario → Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」では、このデバイスに最近のイベントしか保存されていない可能性があります。以前の旅行のフライトを確認するには、「設定」→「アプリ」→「カレンダー」→「アカウント」で、このアカウントの「同期」が「すべてのイベント」になっているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 계정은 이 기기에 최근 이벤트만 보관하고 있을 수 있어요. 이전 여행의 항공편을 확인하려면 설정 → 앱 → 캘린더 → 계정에서 해당 계정의 동기화 옵션이 모든 이벤트인지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» beholder kanskje bare nyere hendelser på denne enheten. For å bekrefte flyreiser på eldre reiser kontrollerer du at kontoens Synkroniser-valg er Alle hendelser under Innstillinger → Apper → Kalender → Kontoer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ bewaart mogelijk alleen recente activiteiten op dit apparaat. Om vluchten van oudere reizen te bevestigen, controleer je of de optie Synchroniseer op Alle activiteiten staat via Instellingen → Apps → Agenda → Accounts."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” pode manter apenas eventos recentes neste dispositivo. Para confirmar voos em viagens antigas, verifique se a opção Sincronizar dessa conta está como Todos os Eventos em Ajustes → Apps → Calendário → Contas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» pode guardar apenas eventos recentes neste dispositivo. Para confirmar voos em viagens antigas, verifique se a opção Sincronizar dessa conta está como Todos os eventos em Definições → Aplicações → Calendário → Contas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” sparar kanske bara nyare händelser på den här enheten. För att bekräfta flygningar på äldre resor kontrollerar du att kontots alternativ Synkronisera är Alla händelser under Inställningar → Appar → Kalender → Konton."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bu aygıtta yalnızca son etkinlikleri tutuyor olabilir. Eski seyahatlerdeki uçuşları doğrulamak için Ayarlar → Uygulamalar → Takvim → Hesaplar bölümünde bu hesabın Eşzamanla seçeneğinin Tüm Etkinlikler olduğunu denetleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” có thể chỉ giữ các sự kiện gần đây trên thiết bị này. Để xác nhận chuyến bay trong các chuyến đi cũ, hãy kiểm tra tùy chọn Đồng bộ hóa của tài khoản là Tất cả sự kiện trong Cài đặt → Ứng dụng → Lịch → Tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在此设备上可能只保留近期日程。要确认较早旅程中的航班，请前往“设置”→“App”→“日历”→“账户”，检查其“同步”选项是否为“所有日程”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在此裝置上可能只保留近期行程。若要確認較早旅程中的航班，請前往「設定」→「App」→「行事曆」→「帳號」，檢查其「同步」選項是否為「所有行程」。"
          }
        }
      }
    },
    "app-intent.search-trips.result.partial" : {
      "comment" : "Siri response when no trip matches the whole search but some match part of it (a place, not the year). The first placeholder is the search, the second up to three trip names.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen rejse matchede hele “%1$@”. Nærmeste: %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Reise entspricht ganz „%1$@“. Am nächsten: %2$@."
