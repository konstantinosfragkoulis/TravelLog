          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildåtkomst krävs. Ge åtkomst i iOS Inställningar → Integritet och säkerhet → Bilder → TravelLog."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraf erişimi gereklidir. iOS Ayarlar → Gizlilik → Fotoğraflar → TravelLog yolundan izin verin."
          }
        },
        "vi" : {
          "stringUnit" : {
