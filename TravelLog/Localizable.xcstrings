          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅允許「使用 App 期間」取用位置"
          }
        }
      }
    },
    "Only selected photos will be matched to trips. Grant full access in Settings for best results." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun valgte billeder bliver matchet med rejser. Giv fuld adgang i Indstillinger for at få de bedste resultater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ausgewählte Fotos werden Reisen zugeordnet. Erteilen Sie für optimale Ergebnisse in den Einstellungen Vollzugriff."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο οι επιλεγμένες φωτογραφίες θα αντιστοιχιστούν με ταξίδια. Για καλύτερα αποτελέσματα, παραχώρησε πλήρη πρόσβαση στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only selected photos will be matched to trips. Grant full access in Settings for best results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se vincularán las fotos seleccionadas con viajes. Conceda acceso total en Ajustes para obtener mejores resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les photos sélectionnées seront associées aux voyages. Accordez l’accès complet dans Réglages pour de meilleurs résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo le foto selezionate verranno abbinate ai viaggi. Concedi l’accesso completo in Impostazioni per ottenere i risultati migliori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した写真だけが旅行と照合されます。最適な結果を得るには、「設定」でフルアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 사진만 여행과 연결돼요. 최상의 결과를 위해 설정에서 전체 접근을 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare valgte bilder kobles til reiser. Gi full tilgang i Innstillinger for best resultat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen geselecteerde foto’s worden aan reizen gekoppeld. Geef volledige toegang in Instellingen voor het beste resultaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente as fotos selecionadas serão associadas às viagens. Conceda acesso total em Ajustes para obter os melhores resultados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas as fotografias selecionadas serão associadas às viagens. Conceda acesso total em Definições para obter os melhores resultados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast valda bilder matchas med resor. Ge full åtkomst i Inställningar för bästa resultat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca seçilen fotoğraflar seyahatlerle eşleştirilir. En iyi sonuçlar için Ayarlar'dan tam erişim verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ ảnh đã chọn được đối chiếu với chuyến đi. Cấp quyền truy cập đầy đủ trong Cài đặt để có kết quả tốt nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会将所选照片与旅程匹配。请在“设置”中授予完全访问权限以获得最佳效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會將所選照片與旅程比對。請在「設定」中授予完整取用權限以獲得最佳效果。"
          }
        }
      }
    },
