    "tracking.issue.monitoring-unavailable.description" : {
      "comment" : "Explanation when the device cannot monitor significant location changes, so trips are not recorded in the background.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed kan ikke holde øje med væsentlige lokalitetsændringer, så Travel Log kan ikke registrere dine rejser i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann keine wesentlichen Standortänderungen erkennen, daher kann Travel Log Ihre Reisen nicht im Hintergrund aufzeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή δεν μπορεί να παρακολουθεί σημαντικές αλλαγές τοποθεσίας, οπότε το Travel Log δεν μπορεί να καταγράφει τα ταξίδια σου στο παρασκήνιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This device can't watch for significant location changes, so Travel Log can't record your trips in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no puede detectar cambios importantes de ubicación, por lo que Travel Log no puede registrar sus viajes en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut pas détecter les changements de position importants : Travel Log ne peut donc pas enregistrer vos voyages en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può rilevare i cambiamenti di posizione significativi, quindi Travel Log non può registrare i tuoi viaggi in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでは大幅な位置情報の変更を検出できないため、Travel Logはバックグラウンドで旅行を記録できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기는 중요한 위치 변경을 감지할 수 없어서 Travel Log가 백그라운드에서 여행을 기록할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enheten kan ikke følge med på betydelige stedsendringer, så Travel Log kan ikke registrere reisene dine i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat kan geen belangrijke locatiewijzigingen volgen, dus Travel Log kan je reizen niet op de achtergrond vastleggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue detectar mudanças significativas de localização, então o Travel Log não pode registrar suas viagens em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não consegue detetar alterações significativas de localização, pelo que o Travel Log não pode registar as suas viagens em segundo plano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte upptäcka betydande platsändringar, så Travel Log kan inte registrera dina resor i bakgrunden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz önemli konum değişikliklerini algılayamıyor, bu nedenle Travel Log seyahatlerinizi arka planda kaydedemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này không thể theo dõi các thay đổi vị trí đáng kể, nên Travel Log không thể ghi lại chuyến đi của bạn trong nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法检测重大位置变化，因此 Travel Log 无法在后台记录您的旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置無法偵測重大位置變更，因此 Travel Log 無法在背景記錄您的旅程。"
          }
        }
      }
    },
