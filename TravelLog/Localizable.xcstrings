    "settings.photo-import.footer" : {
      "comment" : "Settings photo-import footer explaining what the import reads.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser kun tidsstempler og lokaliteter fra dine billeder for at genskabe rejser, du foretog, før du installerede TravelLog. TravelLog uploader eller ændrer aldrig dine billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest nur Zeitstempel und Standorte Ihrer Fotos, um Reisen vor der Installation von TravelLog zu rekonstruieren. TravelLog lädt Ihre Fotos nie hoch und ändert sie nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει μόνο τις χρονικές σημάνσεις και τις τοποθεσίες των φωτογραφιών σου, για να ανακατασκευάσει ταξίδια που έκανες πριν εγκαταστήσεις το TravelLog. Το TravelLog δεν ανεβάζει ούτε αλλάζει ποτέ τις φωτογραφίες σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reads only timestamps and locations from your photos to rebuild trips you took before installing TravelLog. TravelLog never uploads or changes your photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lee las fechas, horas y ubicaciones de sus fotos para reconstruir viajes anteriores a la instalación de TravelLog. TravelLog nunca sube ni modifica sus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit uniquement les horodatages et les lieux de vos photos afin de reconstituer les voyages effectués avant l’installation de TravelLog. TravelLog n’envoie ni ne modifie jamais vos photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge solo data, ora e posizione delle foto per ricostruire i viaggi effettuati prima di installare TravelLog. TravelLog non carica né modifica mai le tue foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogをインストールする前の旅行を再構築するため、写真のタイムスタンプと位置情報だけを読み取ります。TravelLogが写真をアップロードしたり変更したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진의 타임스탬프와 위치만 읽어 TravelLog 설치 전에 다녀온 여행을 복원해요. TravelLog는 사진을 업로드하거나 변경하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leser bare tidsstempler og posisjoner fra bildene dine for å gjenopprette reiser du tok før du installerte TravelLog. TravelLog laster aldri opp eller endrer bildene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest alleen tijdstippen en locaties van je foto’s om reizen te reconstrueren die je vóór de installatie van TravelLog maakte. TravelLog uploadt of wijzigt je foto’s nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê somente os horários e as localizações das suas fotos para reconstruir viagens feitas antes da instalação do TravelLog. O TravelLog nunca envia nem altera suas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê apenas as datas, horas e localizações das suas fotografias para reconstruir viagens feitas antes de instalar o TravelLog. O TravelLog nunca envia nem altera as suas fotografias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser endast tidsstämplar och platser från dina bilder för att återskapa resor du gjorde innan du installerade TravelLog. TravelLog laddar aldrig upp eller ändrar dina bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog'u yüklemeden önce yaptığınız seyahatleri yeniden oluşturmak için fotoğraflarınızdan yalnızca zaman damgalarını ve konumları okur. TravelLog fotoğraflarınızı asla yüklemez veya değiştirmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đọc dấu thời gian và vị trí trong ảnh để dựng lại các chuyến đi bạn đã thực hiện trước khi cài TravelLog. TravelLog không bao giờ tải lên hay thay đổi ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读取照片的时间戳和位置，用于重建安装 TravelLog 前的旅程。TravelLog 绝不会上传或更改您的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只讀取照片的時間戳記和位置，用於重建安裝 TravelLog 前的旅程。TravelLog 絕不會上傳或更改您的照片。"
          }
        }
      }
    },
    "settings.photo-import.footer.icloud-sync" : {
      "comment" : "Settings photo-import footer when iCloud Sync is on: what the import reads, plus a warning to import on one device at a time.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læser kun tidsstempler og lokaliteter fra dine billeder for at genskabe rejser, du foretog, før du installerede TravelLog. TravelLog uploader eller ændrer aldrig dine billeder.\n\nNår iCloud-synkronisering er slået til: Kør kun import på ÉN enhed ad gangen. Samtidig kørsel på to enheder kan oprette dubletter, som skal ryddes op manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest nur Zeitstempel und Standorte Ihrer Fotos, um Reisen vor der Installation von TravelLog zu rekonstruieren. TravelLog lädt Ihre Fotos nie hoch und ändert sie nicht.\n\nBei aktivierter iCloud-Synchronisierung: Führen Sie den Import jeweils nur auf EINEM Gerät aus. Ein gleichzeitiger Import auf zwei Geräten kann doppelte Reisen erzeugen, die manuell bereinigt werden müssen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάζει μόνο τις χρονικές σημάνσεις και τις τοποθεσίες των φωτογραφιών σου, για να ανακατασκευάσει ταξίδια που έκανες πριν εγκαταστήσεις το TravelLog. Το TravelLog δεν ανεβάζει ούτε αλλάζει ποτέ τις φωτογραφίες σου.\n\nΜε ενεργό τον Συγχρονισμό iCloud: εκτέλεσε την εισαγωγή σε ΜΙΑ συσκευή κάθε φορά. Η ταυτόχρονη εκτέλεση σε δύο συσκευές μπορεί να δημιουργήσει διπλότυπα ταξίδια που απαιτούν μη αυτόματη εκκαθάριση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reads only timestamps and locations from your photos to rebuild trips you took before installing TravelLog. TravelLog never uploads or changes your photos.\n\nWith iCloud Sync on: run import on ONE device at a time. Running on two devices simultaneously can create duplicate trips that require manual cleanup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lee las fechas, horas y ubicaciones de sus fotos para reconstruir viajes anteriores a la instalación de TravelLog. TravelLog nunca sube ni modifica sus fotos.\n\nCon la sincronización con iCloud activada: ejecute la importación en UN solo dispositivo a la vez. Ejecutarla simultáneamente en dos dispositivos puede crear viajes duplicados que deban corregirse manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit uniquement les horodatages et les lieux de vos photos afin de reconstituer les voyages effectués avant l’installation de TravelLog. TravelLog n’envoie ni ne modifie jamais vos photos.\n\nLorsque la synchronisation iCloud est activée, lancez l’import sur UN SEUL appareil à la fois. Une exécution simultanée sur deux appareils peut créer des voyages en double qu’il faudra supprimer manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge solo data, ora e posizione delle foto per ricostruire i viaggi effettuati prima di installare TravelLog. TravelLog non carica né modifica mai le tue foto.\n\nCon la sincronizzazione iCloud attiva, esegui l’importazione su UN solo dispositivo alla volta. L’esecuzione contemporanea su due dispositivi può creare viaggi duplicati da correggere manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLogをインストールする前の旅行を再構築するため、写真のタイムスタンプと位置情報だけを読み取ります。TravelLogが写真をアップロードしたり変更したりすることはありません。\n\niCloud同期がオンの場合：読み込みは一度に1台のデバイスだけで実行してください。2台で同時に実行すると、手動で整理が必要な重複旅行が作成される場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진의 타임스탬프와 위치만 읽어 TravelLog 설치 전에 다녀온 여행을 복원해요. TravelLog는 사진을 업로드하거나 변경하지 않아요.\n\niCloud 동기화 사용 시 한 번에 기기 한 대에서만 가져오기를 실행하세요. 두 기기에서 동시에 실행하면 중복 여행이 생겨 수동 정리가 필요할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leser bare tidsstempler og posisjoner fra bildene dine for å gjenopprette reiser du tok før du installerte TravelLog. TravelLog laster aldri opp eller endrer bildene dine.\n\nNår iCloud-synkronisering er på: Kjør import på ÉN enhet om gangen. Hvis den kjøres på to enheter samtidig, kan det oppstå dupliserte reiser som må ryddes opp manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest alleen tijdstippen en locaties van je foto’s om reizen te reconstrueren die je vóór de installatie van TravelLog maakte. TravelLog uploadt of wijzigt je foto’s nooit.\n\nMet iCloud-synchronisatie ingeschakeld: voer de import op ÉÉN apparaat tegelijk uit. Gelijktijdig importeren op twee apparaten kan dubbele reizen opleveren die je handmatig moet opruimen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê somente os horários e as localizações das suas fotos para reconstruir viagens feitas antes da instalação do TravelLog. O TravelLog nunca envia nem altera suas fotos.\n\nCom a sincronização do iCloud ativada: importe em UM dispositivo por vez. Executar em dois dispositivos ao mesmo tempo pode criar viagens duplicadas que exigirão limpeza manual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê apenas as datas, horas e localizações das suas fotografias para reconstruir viagens feitas antes de instalar o TravelLog. O TravelLog nunca envia nem altera as suas fotografias.\n\nCom a sincronização do iCloud ativada: execute a importação num ÚNICO dispositivo de cada vez. A execução simultânea em dois dispositivos pode criar viagens duplicadas que exigem limpeza manual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser endast tidsstämplar och platser från dina bilder för att återskapa resor du gjorde innan du installerade TravelLog. TravelLog laddar aldrig upp eller ändrar dina bilder.\n\nMed iCloud-synkronisering på: kör importen på EN enhet åt gången. Om den körs samtidigt på två enheter kan dubbletter skapas som måste rensas manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TravelLog'u yüklemeden önce yaptığınız seyahatleri yeniden oluşturmak için fotoğraflarınızdan yalnızca zaman damgalarını ve konumları okur. TravelLog fotoğraflarınızı asla yüklemez veya değiştirmez.\n\niCloud Eşzamanlama açıkken içe aktarmayı aynı anda yalnızca BİR aygıtta çalıştırın. İki aygıtta aynı anda çalıştırmak, elle temizlenmesi gereken yinelenen seyahatler oluşturabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đọc dấu thời gian và vị trí trong ảnh để dựng lại các chuyến đi bạn đã thực hiện trước khi cài TravelLog. TravelLog không bao giờ tải lên hay thay đổi ảnh của bạn.\n\nKhi bật Đồng bộ iCloud: mỗi lần chỉ nhập trên MỘT thiết bị. Chạy đồng thời trên hai thiết bị có thể tạo chuyến đi trùng lặp và cần dọn dẹp thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只读取照片的时间戳和位置，用于重建安装 TravelLog 前的旅程。TravelLog 绝不会上传或更改您的照片。\n\n启用 iCloud 同步时：请一次只在一台设备上导入。同时在两台设备上运行可能会创建重复旅程，需要手动清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只讀取照片的時間戳記和位置，用於重建安裝 TravelLog 前的旅程。TravelLog 絕不會上傳或更改您的照片。\n\n啟用 iCloud 同步時：請一次只在一台裝置上匯入。同時在兩台裝置上執行可能會建立重複旅程，需要手動清理。"
          }
        }
      }
    },
