          }
        }
      }
    },
    "tracking.issue.background-refresh-disabled.description" : {
      "comment" : "Instructions for enabling Background App Refresh for Travel Log.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater apps i baggrunden er slået fra. Uden den kan Travel Log ikke startes igen, efter iOS har lukket appen. Gå til Indstillinger → Generelt → Opdater apps i baggrunden, og slå funktionen til for Travel Log."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaktualisierung ist deaktiviert. Ohne sie kann Travel Log nach dem Beenden durch iOS nicht neu gestartet werden. Öffnen Sie Einstellungen → Allgemein → Hintergrundaktualisierung und aktivieren Sie sie für Travel Log."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η Ανανέωση εφαρμογών στο παρασκήνιο είναι απενεργοποιημένη. Χωρίς αυτήν, το Travel Log δεν μπορεί να επανεκκινηθεί αφού τερματιστεί από το iOS. Πήγαινε στις Ρυθμίσεις → Γενικά → Ανανέωση εφαρμογών στο παρασκήνιο και ενεργοποίησέ την για το Travel Log."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Background App Refresh is disabled. Without this, Travel Log cannot be relaunched after iOS terminates it. Go to Settings → General → Background App Refresh and enable it for Travel Log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización en segundo plano está desactivada. Sin ella, Travel Log no puede volver a abrirse después de que iOS la cierre. Vaya a Ajustes → General → Actualización en segundo plano y actívela para Travel Log."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actualisation en arrière-plan est désactivée. Sans elle, Travel Log ne peut pas être relancé après sa fermeture par iOS. Accédez à Réglages → Général → Actualisation en arrière-plan et activez-la pour Travel Log."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aggiornamento app in background è disattivato. Senza questa funzione, Travel Log non può riaprirsi dopo la chiusura da parte di iOS. Vai in Impostazioni → Generali → Aggiornamento app in background e attivalo per Travel Log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appのバックグラウンド更新が無効です。これが無効だと、iOSによる終了後にTravel Logを再起動できません。「設定」→「一般」→「Appのバックグラウンド更新」でTravel Logを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 앱 새로 고침이 비활성화되어 있어요. 이 기능이 없으면 iOS가 Travel Log를 종료한 후 앱을 다시 실행할 수 없어요. 설정 → 일반 → 백그라운드 앱 새로 고침에서 Travel Log를 활성화하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnsoppdatering er slått av. Uten dette kan ikke Travel Log startes på nytt etter at iOS avslutter appen. Gå til Innstillinger → Generelt → Bakgrunnsoppdatering, og slå det på for Travel Log."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ververs op achtergrond is uitgeschakeld. Zonder deze functie kan Travel Log niet opnieuw worden gestart nadat iOS de app beëindigt. Ga naar Instellingen → Algemeen → Ververs op achtergrond en schakel dit in voor Travel Log."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Atualização em 2º Plano está desativada. Sem ela, o Travel Log não pode ser reaberto depois que o iOS o encerrar. Acesse Ajustes → Geral → Atualização em 2º Plano e ative-a para o Travel Log."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização em segundo plano está desativada. Sem esta opção, o Travel Log não pode ser reaberto depois de o iOS o fechar. Aceda a Definições → Geral → Atualização em segundo plano e ative-a para o Travel Log."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundsuppdatering är avstängd. Utan den kan Travel Log inte startas om efter att iOS avslutar appen. Gå till Inställningar → Allmänt → Bakgrundsuppdatering och aktivera den för Travel Log."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka Planda Uygulama Yenileme kapalı. Bu ayar olmadan iOS sonlandırdıktan sonra Travel Log yeniden başlatılamaz. Ayarlar → Genel → Arka Planda Uygulama Yenileme yoluna gidip Travel Log için etkinleştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mới ứng dụng trong nền đang tắt. Nếu không bật, Travel Log không thể khởi chạy lại sau khi iOS chấm dứt ứng dụng. Vào Cài đặt → Cài đặt chung → Làm mới ứng dụng trong nền và bật cho Travel Log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后台 App 刷新已关闭。若不启用，iOS 终止 Travel Log 后将无法再次在后台启动它。请前往“设置”→“通用”→“后台 App 刷新”，为 Travel Log 启用此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景 App 重新整理已關閉。若不啟用，iOS 終止 Travel Log 後將無法再次在背景啟動它。請前往「設定」→「一般」→「背景 App 重新整理」，為 Travel Log 啟用此功能。"
          }
        }
      }
    },
