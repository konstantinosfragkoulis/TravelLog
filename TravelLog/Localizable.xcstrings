          "stringUnit" : {
            "state" : "translated",
            "value" : "이 타임라인 파일은 너무 커서 이 기기에서 가져올 수 없어요. 더 짧은 기간을 내보낸 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Tidslinje-filen er for stor til å importeres på denne enheten. Eksporter en kortere periode, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit Tijdlijn-bestand is te groot om op dit apparaat te importeren. Exporteer een kortere periode en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo da Linha do Tempo é grande demais para ser importado neste dispositivo. Exporte um período mais curto e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ficheiro da Cronologia é demasiado grande para ser importado neste dispositivo. Exporte um período mais curto e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidslinje-filen är för stor för att importeras på den här enheten. Exportera en kortare period och försök sedan igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Zaman Çizelgesi dosyası bu aygıtta içe aktarılamayacak kadar büyük. Daha kısa bir dönemi dışa aktarıp yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp Dòng thời gian này quá lớn để nhập trên thiết bị này. Hãy xuất một khoảng thời gian ngắn hơn rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此时间轴文件太大，无法在此设备上导入。请导出较短的时间段后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此時間軸檔案太大，無法在此裝置上匯入。請匯出較短的時間段後再試。"
          }
        }
      }
    },
