    "collections.flight-candidate.details.hint" : {
      "comment" : "VoiceOver hint on a possible flight row that opens its detail sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser, hvor du var før og efter, og hvorfor det kan være en flyrejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, wo Sie davor und danach waren und warum es ein Flug sein könnte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει πού ήσουν πριν και μετά, και γιατί μπορεί να ήταν πτήση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows where you were before and after, and why this might be a flight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra dónde estabas antes y después, y por qué podría ser un vuelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique où vous étiez avant et après, et pourquoi il pourrait s’agir d’un vol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra dove eri prima e dopo, e perché potrebbe essere un volo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後にいた場所と、フライトと考えられる理由を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전후에 있었던 곳과 항공편일 수 있는 이유를 보여 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser hvor du var før og etter, og hvorfor dette kan være en flyreise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont waar je ervoor en erna was, en waarom dit een vlucht kan zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra onde você estava antes e depois, e por que isto pode ser um voo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra onde estava antes e depois, e porque isto pode ser um voo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar var du var före och efter, och varför det kan vara en flygning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce ve sonra nerede olduğunuzu ve bunun neden uçuş olabileceğini gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho biết bạn ở đâu trước và sau, và vì sao đây có thể là chuyến bay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示你之前和之后所在的地方，以及这可能是航班的原因。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示你之前和之後所在的地方，以及這可能是航班的原因。"
          }
        }
      }
    },
