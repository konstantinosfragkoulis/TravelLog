          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une année précise, par exemple 2025. Laissez ce champ vide pour les statistiques globales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anno specifico, come 2025. Lascialo vuoto per vedere le statistiche di sempre."
