    "onboarding.routine.title" : {
      "comment" : "Onboarding routine places headline.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring hverdagens steder over."
