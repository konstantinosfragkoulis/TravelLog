    "collections.flight-times.problem.order" : {
      "comment" : "Flight times validation message when the arrival is not after the departure.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ankomst skal være efter afgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ankunft muss nach dem Abflug liegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άφιξη πρέπει να είναι μετά την αναχώρηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrival must be after departure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llegada debe ser posterior a la salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’arrivée doit être postérieure au départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’arrivo deve essere successivo alla partenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到着は出発より後にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도착은 출발 이후여야 해요."
