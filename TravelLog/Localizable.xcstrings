    "“%@” is no longer a trip. Future visits there will count as home. Manage this under Settings › Home Area Places." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” er ikke længere en rejse. Fremtidige besøg dér tæller som hjem. Administrer dette under Indstillinger › Steder i hjemmeområdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine Reise mehr. Künftige Besuche dort zählen als Heimat. Verwalten Sie dies unter Einstellungen › Orte der Heimatregion."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%@» δεν είναι πλέον ταξίδι. Οι μελλοντικές επισκέψεις εκεί θα υπολογίζονται ως χρόνος στην περιοχή κατοικίας. Μπορείς να το διαχειριστείς στις Ρυθμίσεις › Μέρη περιοχής κατοικίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” is no longer a trip. Future visits there will count as home. Manage this under Settings › Home Area Places."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ya no es un viaje. Las próximas visitas allí contarán como estancia en casa. Gestione este lugar en Ajustes › Lugares de la zona de residencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est plus un voyage. Vos prochaines visites à cet endroit seront considérées comme du temps au domicile. Gérez ce réglage dans Réglages › Lieux de la zone de domicile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è più un viaggio. Le visite future conteranno come permanenza a casa. Gestisci il luogo in Impostazioni › Luoghi della zona di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は旅行ではなくなりました。今後ここを訪れた場合は自宅として扱われます。設定 › 自宅エリアの場所で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 여행이 아니에요: “%@”. 앞으로 이곳 방문은 집으로 계산돼요. 설정 › 생활권 장소에서 관리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» er ikke lenger en reise. Fremtidige besøk der regnes som hjemme. Administrer dette under Innstillinger › Steder i hjemmeområdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is geen reis meer. Toekomstige bezoeken daar tellen als thuis. Beheer dit via Instellingen › Plekken in thuisgebied."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é mais uma viagem. Visitas futuras ao local contarão como casa. Gerencie isso em Ajustes › Locais da área de residência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” já não é uma viagem. As visitas futuras a esse local contarão como casa. Faça a gestão deste local em Definições › Locais da área de residência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” är inte längre en resa. Framtida besök där räknas som hemma. Hantera detta under Inställningar › Platser i hemområdet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” artık seyahat değil. Gelecekteki ziyaretler ev bölgesi sayılacak. Ayarlar › Ev Bölgesi Yerleri bölümünden yönetin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” không còn là chuyến đi. Các lần ghé sau này sẽ được tính là ở nhà. Quản lý trong Cài đặt › Địa điểm thuộc khu vực sinh sống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不再属于旅程。今后到访该地点将视为回家。可在“设置”›“常住区域地点”中管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不再屬於旅程。今後造訪該地點將視為回家。可在「設定」›「居住區域地點」中管理。"
          }
        }
      }
    },
