    "No homes configured. Add one so Travel Log can distinguish trips from daily life." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke konfigureret nogen hjem. Tilføj et, så Travel Log kan skelne rejser fra hverdagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
