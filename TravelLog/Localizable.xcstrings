    "trip-gap.question.answers-note" : {
      "comment" : "Note above the did-you-go-home answers in the questions sheet. The placeholder is the place after the gap, which starts the new trip on Yes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja gør %@ til en rejse for sig. Nej beholder én rejse og spørger aldrig om dette igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja macht %@ zu einer eigenen Reise. Nein behält eine Reise bei und fragt nie wieder danach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Ναι κάνει το %@ ξεχωριστό ταξίδι. Το Όχι κρατά ένα ταξίδι και δεν ξαναρωτά γι’ αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Yes makes %@ its own trip. No keeps one trip and never asks about this again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí convierte %@ en un viaje aparte. No mantiene un solo viaje y no volverá a preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui fait de %@ un voyage à part. Non garde un seul voyage et ne vous le demandera plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì rende %@ un viaggio a sé. No mantiene un solo viaggio e non lo chiederà più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「はい」で%@が別の旅行になります。「いいえ」で1つの旅行のままになり、今後この質問はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네를 선택하면 %@ 일정이 별도 여행이 돼요. 아니요를 선택하면 하나의 여행으로 유지하고 다시 묻지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja gjør %@ til en egen reise. Nei beholder én reise og spør aldri om dette igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja maakt van %@ een eigen reis. Nee houdt één reis en vraagt hier nooit meer naar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim torna %@ uma viagem própria. Não mantém uma só viagem e nunca mais pergunta sobre isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim torna %@ uma viagem própria. Não mantém uma só viagem e nunca mais pergunta sobre isto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja gör %@ till en egen resa. Nej behåller en resa och frågar aldrig om detta igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evet, %@ yerini ayrı bir seyahat yapar. Hayır, tek seyahat olarak tutar ve bunu bir daha sormaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có sẽ tách %@ thành chuyến đi riêng. Không sẽ giữ một chuyến và không hỏi lại điều này nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选“是”会让%@成为单独的旅程。选“否”会保留为一段旅程，且不再询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選「是」會讓%@成為獨立的旅程。選「否」會保留為一段旅程，且不再詢問。"
          }
        }
      }
    },
    "trip-gap.question.detail.between" : {
      "comment" : "Secondary line under the did-you-go-home question. The placeholders are the place before the gap, the day it was left (e.g. Sat 3 Aug), the place after the gap and the day it was reached (e.g. Mon 5 Aug 2024).",
