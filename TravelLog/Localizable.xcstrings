    "settings.temporary-homes.footer.trip-boundary" : {
      "comment" : "Footer of the Settings section listing temporary homes: what a temporary home is for and how it ends trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til et sted, du bor i en periode, f.eks. et semester i udlandet. En rejse slutter, når du vender tilbage dertil, og dit hjem fungerer som normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Ort, an dem Sie vorübergehend leben, etwa während eines Auslandssemesters. Die Rückkehr dorthin beendet eine Reise. Ihr Zuhause funktioniert weiter wie gewohnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για ένα μέρος όπου μένεις για κάποιο διάστημα, όπως ένα εξάμηνο στο εξωτερικό. Η επιστροφή εκεί τερματίζει ένα ταξίδι και η κατοικία σου συνεχίζει να λειτουργεί όπως πριν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For a place you live for a while, like a semester abroad. Coming back to it ends a trip, and your home keeps working as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un lugar donde vive durante un tiempo, como un semestre en el extranjero. Volver allí finaliza un viaje y su residencia sigue funcionando como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un lieu où vous vivez quelque temps, comme un semestre à l’étranger. Y revenir termine un voyage, et votre domicile continue de fonctionner comme d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un luogo in cui vivi per un periodo, come un semestre all’estero. Tornarci conclude un viaggio e la tua casa continua a funzionare come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留学など、一定期間住む場所に使います。その場所に戻ると旅行が終了し、通常の自宅もこれまでどおり機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 학기 해외 유학처럼 일정 기간 사는 곳에 사용해요. 그곳으로 돌아오면 여행이 끝나며, 원래 집도 평소처럼 작동해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For et sted du bor en stund, som et semester i utlandet. Når du kommer tilbake dit, avsluttes en reise, og hjemmet ditt fungerer som før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een plek waar je een tijdje woont, zoals een semester in het buitenland. Terugkomen op die plek beëindigt een reis, en je thuislocatie blijft werken zoals altijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um lugar onde você mora por um tempo, como um semestre no exterior. Voltar a ele encerra uma viagem, e sua casa continua funcionando normalmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um local onde vive durante algum tempo, como um semestre no estrangeiro. Regressar a esse local termina uma viagem, e a sua residência continua a funcionar como habitualmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en plats där du bor en tid, till exempel en termin utomlands. När du återvänder dit avslutas en resa, och ditt hem fortsätter fungera som vanligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yurt dışında bir dönem geçirmek gibi, bir süre yaşadığınız yerler içindir. Oraya dönmek seyahati bitirir ve ev bölgeniz her zamanki gibi çalışmaya devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dành cho nơi bạn sống một thời gian, như một học kỳ ở nước ngoài. Trở lại đó sẽ kết thúc chuyến đi và nhà của bạn vẫn hoạt động như thường lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于住一段时间的地方，例如在国外读一个学期。返回此处会结束旅程，原有常住地仍照常生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於住一段時間的地方，例如在國外讀一個學期。返回此處會結束旅程，原有居住地仍照常運作。"
          }
        }
      }
    },
