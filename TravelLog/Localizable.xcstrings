    "onboarding.notifications.caption" : {
      "comment" : "Onboarding notifications caption.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hilsen, når du ankommer til udlandet, en velkomst, når du er hjemme igen. Valgfrit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hallo bei der Ankunft im Ausland, ein Willkommen zurück zu Hause. Optional."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα γεια όταν φτάνεις στο εξωτερικό, ένα καλωσόρισμα όταν γυρνάς σπίτι. Προαιρετικό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A hello when you arrive abroad, a welcome when you're back home. Optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un saludo al llegar al extranjero y una bienvenida al volver a casa. Opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bonjour à l’arrivée à l’étranger, un accueil au retour chez vous. Facultatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un saluto all’arrivo all’estero, un bentornato quando sei a casa. Facoltativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海外に着いたらご挨拶、帰国したらおかえりの通知。任意で利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해외에 도착하면 인사를, 집에 돌아오면 환영을 전해요. 선택 사항이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hilsen når du ankommer utlandet, en velkomst når du er hjemme igjen. Valgfritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groet bij aankomst in het buitenland, een welkom als je weer thuis bent. Optioneel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um olá ao chegar ao exterior, boas-vindas ao voltar para casa. Opcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um olá ao chegar ao estrangeiro, boas-vindas no regresso a casa. Opcional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hälsning när du kommer utomlands, ett välkommen när du är hemma igen. Valfritt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yurt dışına varınca bir merhaba, eve dönünce hoş geldiniz. İsteğe bağlı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời chào khi đến nước ngoài, lời mừng khi bạn về nhà. Tùy chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抵达国外时一声问候，回到家时一句欢迎。可选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
