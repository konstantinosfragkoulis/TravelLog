    "All trips and stays reconstructed from photos will be removed. Live-tracked data is preserved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle rejser og ophold, der er genskabt ud fra billeder, bliver fjernet. Livedata fra sporing bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle aus Fotos rekonstruierten Reisen und Aufenthalte werden entfernt. Live erfasste Daten bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα αφαιρεθούν όλα τα ταξίδια και οι παραμονές που ανακατασκευάστηκαν από φωτογραφίες. Τα δεδομένα ζωντανής καταγραφής διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All trips and stays reconstructed from photos will be removed. Live-tracked data is preserved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los viajes y estancias reconstruidos a partir de fotos. Se conservarán los datos registrados en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les voyages et séjours reconstitués à partir des photos seront supprimés. Les données suivies en direct seront conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi tutti i viaggi e i soggiorni ricostruiti dalle foto. I dati registrati in tempo reale verranno conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真から再構築した旅行と滞在がすべて削除されます。リアルタイムで記録したデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진에서 복원한 모든 여행과 체류가 삭제돼요. 실시간으로 추적한 데이터는 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle reiser og opphold som er gjenopprettet fra bilder, blir fjernet. Direkte sporede data beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle reizen en verblijven die op basis van foto’s zijn gereconstrueerd, worden verwijderd. Live gevolgde gegevens blijven behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as viagens e estadias reconstruídas a partir de fotos serão removidas. Os dados rastreados ao vivo serão preservados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as viagens e estadias reconstruídas a partir de fotografias serão removidas. Os dados registados em tempo real serão mantidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla resor och vistelser som återskapats från bilder tas bort. Direktspårade data behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflardan yeniden oluşturulan tüm seyahat ve konaklamalar kaldırılır. Canlı takip edilen veriler korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả chuyến đi và lần lưu trú được dựng lại từ ảnh sẽ bị xóa. Dữ liệu theo dõi trực tiếp vẫn được giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除所有通过照片重建的旅程和停留，实时记录的数据会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除所有透過照片重建的旅程和停留，即時記錄的資料會保留。"
          }
        }
      }
    },
