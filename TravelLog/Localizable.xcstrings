    "temporary-home.suggestion.completed.place" : {
      "comment" : "Suggestion on a long completed trip that mostly stayed in one city; the placeholder is the city. A temporary home makes trips from there separate trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boede du i %@ en tid? Opret et midlertidigt hjem, så dine rejser derfra tæller for sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben Sie eine Zeit lang in %@ gewohnt? Richten Sie ein Zuhause auf Zeit ein, damit Ihre Reisen von dort als eigene Reisen zählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: έμενες εκεί για ένα διάστημα; Όρισε ένα προσωρινό σπίτι, ώστε τα ταξίδια σου από εκεί να μετρούν ξεχωριστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lived in %@ for a while? Set up a temporary home so your trips from there count on their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Vivió en %@ un tiempo? Configure una residencia temporal para que sus viajes desde allí cuenten por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez vécu à %@ quelque temps ? Configurez un domicile temporaire pour que vos voyages au départ de là-bas comptent à part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai vissuto a %@ per un po’? Configura una casa temporanea così i viaggi da lì contano a parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらく%@に住んでいましたか？仮の自宅を設定すると、そこから出かけた旅行が別々に数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한동안 %@에 사셨나요? 임시 거주지를 설정하면 그곳에서 떠난 여행이 따로 집계돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodde du i %@ en stund? Opprett et midlertidig hjem, så teller reisene dine derfra for seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woonde je een tijdje in %@? Stel een tijdelijk thuis in, zodat je reizen vanaf daar apart tellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morou em %@ por um tempo? Configure uma casa temporária para que suas viagens a partir de lá contem separadamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viveu em %@ durante algum tempo? Configure uma casa temporária para que as suas viagens a partir de lá contem à parte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodde du i %@ ett tag? Skapa ett tillfälligt hem så att dina resor därifrån räknas för sig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süre %@ konumunda mı yaşadınız? Oradan çıktığınız seyahatlerin ayrı sayılması için bir geçici ev bölgesi ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sống ở %@ một thời gian? Hãy thiết lập nhà tạm thời để các chuyến đi từ đó được tính riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曾在 %@ 住过一段时间吗？设置暂住地后，从那里出发的旅程会单独计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曾在 %@ 住過一段時間嗎？設定暫住地後，從那裡出發的旅程會單獨計算。"
          }
        }
      }
    },
