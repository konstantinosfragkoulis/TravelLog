    "temporary-home.unmapped.confirmation" : {
      "comment" : "Confirmation shown before saving a temporary home whose reverse geocode found neither a locality nor an administrative area.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne lokalitet ser ud til ikke at være kortlagt eller til at ligge på havet. Registrering af rejser genkender muligvis ikke, når du vender tilbage hertil. Gem alligevel?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Standort scheint nicht kartiert zu sein oder auf dem Meer zu liegen. Die Reiseerkennung erkennt möglicherweise nicht, wenn Sie hierher zurückkehren. Trotzdem sichern?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τοποθεσία αυτή φαίνεται να μην είναι χαρτογραφημένη ή να βρίσκεται στη θάλασσα. Ο εντοπισμός ταξιδιών μπορεί να μην αναγνωρίζει ότι επέστρεψες εδώ. Θέλεις να την αποθηκεύσεις παρ’ όλα αυτά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This location looks unmapped or at sea. Trip detection may not recognize when you come back here. Save anyway?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que esta ubicación no está cartografiada o está en el mar. Es posible que la detección de viajes no reconozca cuando regrese aquí. ¿Guardar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette position semble ne pas être cartographiée ou se trouver en mer. La détection des voyages risque de ne pas reconnaître vos retours ici. Enregistrer quand même ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa posizione sembra non essere sulla mappa o trovarsi in mare. Il rilevamento dei viaggi potrebbe non riconoscere i rientri qui. Salvare comunque?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この位置情報は地図にないか、海上にあるようです。旅行の検出では、ここに戻ったことを認識できない可能性があります。それでも保存しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 위치는 지도에 없거나 바다 위에 있는 것 같아요. 여행 감지에서 이곳으로 돌아온 것을 인식하지 못할 수 있어요. 그래도 저장할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne posisjonen ser ut til å være utenfor kartet eller ute på havet. Reiseregistreringen gjenkjenner kanskje ikke at du kommer tilbake hit. Lagre likevel?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze locatie lijkt niet op de kaart te staan of op zee te liggen. Reisdetectie herkent mogelijk niet dat je hier terugkomt. Toch bewaren?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este local parece não estar mapeado ou estar no mar. A detecção de viagens talvez não reconheça quando você volta para cá. Salvar mesmo assim?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta localização parece não estar mapeada ou encontrar-se no mar. A deteção de viagens poderá não reconhecer o regresso a este local. Guardar mesmo assim?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här platsen verkar saknas på kartan eller ligga ute till havs. Resedetekteringen kanske inte känner igen när du kommer tillbaka hit. Spara ändå?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konum haritada yer almıyor veya denizde gibi görünüyor. Seyahat algılama, buraya dönüşlerinizi tanımayabilir. Yine de kaydedilsin mi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí này có vẻ chưa được lập bản đồ hoặc nằm ngoài biển. Tính năng phát hiện chuyến đi có thể không nhận ra khi bạn quay lại đây. Vẫn lưu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位置似乎未标注在地图上或位于海上。旅程检测可能无法识别您返回这里的情况。仍要保存吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位置似乎未標示在地圖上或位於海上。旅程偵測可能無法識別您返回這裡的情況。仍要儲存嗎？"
          }
        }
      }
    },
    "temporary-home.updating-trips" : {
      "comment" : "Shown on a temporary home's card and detail page after a change to it is saved, while the app is still updating the trips the change affects.",
