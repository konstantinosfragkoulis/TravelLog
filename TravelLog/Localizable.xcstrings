      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En flyrejse kan ikke vare længere end %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Flug kann nicht länger als %@ dauern."
