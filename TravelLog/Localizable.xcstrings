        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen werden dem Jahr ihres Beginns zugeordnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια αντιστοιχίζονται με το έτος που ξεκίνησαν."
          }
        },
        "en" : {
