    "onboarding.photo-scan.error.inconsistent-local-data" : {
      "comment" : "Onboarding photo-scan error when local imported data is inconsistent.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanningen kunne ikke genskabe dine rejser på en sikker måde. Åbn Travel Log igen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scan konnte Ihre Reisen nicht sicher rekonstruieren. Öffnen Sie Travel Log erneut und versuchen Sie es noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σάρωση δεν μπόρεσε να ανακατασκευάσει με ασφάλεια τα ταξίδια σου. Άνοιξε ξανά το Travel Log και δοκίμασε πάλι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The scan couldn't safely rebuild your trips. Reopen Travel Log and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis no pudo reconstruir sus viajes de forma segura. Vuelva a abrir Travel Log e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’analyse n’a pas pu reconstituer vos voyages de façon sûre. Rouvrez Travel Log et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scansione non ha potuto ricostruire i viaggi in sicurezza. Riapri Travel Log e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行を安全に再構築できませんでした。Travel Logを開き直して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔이 여행을 안전하게 복원할 수 없어요. Travel Log를 다시 열고 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanningen kunne ikke gjenopprette reisene dine på en trygg måte. Åpne Travel Log på nytt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De scan kon je reizen niet veilig reconstrueren. Open Travel Log opnieuw en probeer het nogmaals."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A análise não pôde reconstruir suas viagens com segurança. Reabra o Travel Log e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A análise não conseguiu reconstruir as suas viagens em segurança. Volte a abrir o Travel Log e tente novamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanningen kunde inte återskapa dina resor på ett säkert sätt. Öppna Travel Log igen och försök på nytt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama seyahatlerinizi güvenle yeniden oluşturamadı. Travel Log'u yeniden açıp deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình quét không thể dựng lại chuyến đi một cách an toàn. Mở lại Travel Log và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描无法安全地重建您的旅程。请重新打开 Travel Log 后再试。"
          }
