    "trip-share.privacy.footer" : {
      "comment" : "Privacy note on the trip share sheet: what is always left out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delte elementer indeholder aldrig dine hjem, din tid i nærheden af dem eller dine fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Inhalte enthalten nie Ihre Wohnorte, Ihre Zeit in deren Nähe oder Ihre Fotos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κοινόχρηστα στοιχεία δεν περιλαμβάνουν ποτέ τα σπίτια σας, τον χρόνο σας κοντά τους ή τις φωτογραφίες σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shared items never include your homes, your time near them or your photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos compartidos nunca incluyen tus casas, el tiempo que pasas cerca de ellas ni tus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments partagés n’incluent jamais vos domiciles, votre temps passé à proximité ni vos photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi condivisi non includono mai le tue case, il tempo trascorso vicino a esse o le tue foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有する項目には、自宅、自宅付近で過ごした時間、写真は一切含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 항목에는 집, 집 근처에서 보낸 시간, 사진이 절대 포함되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delte elementer inneholder aldri hjemmene dine, tiden din i nærheten av dem eller bildene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeelde onderdelen bevatten nooit je woningen, je tijd in de buurt ervan of je foto’s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens compartilhados nunca incluem suas casas, seu tempo perto delas nem suas fotos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens partilhados nunca incluem as suas casas, o seu tempo perto delas nem as suas fotografias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delade objekt innehåller aldrig dina hem, din tid nära dem eller dina bilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaşılan öğeler hiçbir zaman evlerinizi, onların yakınında geçirdiğiniz zamanı veya fotoğraflarınızı içermez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục được chia sẻ không bao giờ bao gồm nhà của bạn, thời gian bạn ở gần nhà hoặc ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享的项目绝不包含你的住所、你在住所附近的时间或你的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分享的項目絕不包含你的住所、你在住所附近的時間或你的照片。"
          }
        }
      }
    },
    "settings.shared-trips.remove.confirm.message" : {
      "comment" : "Confirmation message before removing what a shared trip added.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De steder og tidspunkter, denne delte rejse tilføjede, slettes, og dine rejser genopbygges. Dine egne placeringer berøres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Orte und Zeiten, die diese geteilte Reise hinzugefügt hat, werden gelöscht und Ihre Reisen neu aufgebaut. Ihre eigenen Standorte bleiben unberührt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα μέρη και οι χρόνοι που πρόσθεσε αυτό το κοινόχρηστο ταξίδι διαγράφονται και τα ταξίδια σας αναδημιουργούνται. Οι δικές σας τοποθεσίες δεν αλλάζουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The places and times this shared trip added are deleted and your trips are rebuilt. Your own locations are not touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan los lugares y horas que añadió este viaje compartido y se reconstruyen tus viajes. Tus propias ubicaciones no se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux et horaires ajoutés par ce voyage partagé sont supprimés et vos voyages sont reconstruits. Vos propres positions ne sont pas modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I luoghi e gli orari aggiunti da questo viaggio condiviso vengono eliminati e i tuoi viaggi vengono ricostruiti. Le tue posizioni non vengono toccate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この共有された旅行で追加された場所と時刻が削除され、旅行が再構築されます。自分の位置情報は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유된 여행이 추가한 장소와 시간이 삭제되고 여행이 다시 구성됩니다. 내 위치는 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedene og tidspunktene denne delte reisen la til, slettes, og reisene dine bygges opp på nytt. Dine egne posisjoner berøres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De plaatsen en tijden die deze gedeelde reis heeft toegevoegd, worden verwijderd en je reizen worden opnieuw opgebouwd. Je eigen locaties blijven onaangeroerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lugares e horários que esta viagem compartilhada adicionou são apagados e suas viagens são reconstruídas. Suas próprias localizações não são alteradas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os locais e horários que esta viagem partilhada adicionou são apagados e as suas viagens são reconstruídas. As suas próprias localizações não são alteradas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platserna och tiderna som den här delade resan lade till raderas och dina resor byggs om. Dina egna platser påverkas inte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu paylaşılan seyahatin eklediği yerler ve zamanlar silinir ve seyahatleriniz yeniden oluşturulur. Kendi konumlarınıza dokunulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các địa điểm và thời gian mà chuyến đi được chia sẻ này đã thêm sẽ bị xóa và các chuyến đi của bạn được dựng lại. Vị trí của riêng bạn không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此共享旅程添加的地点和时间将被删除，你的旅程会重新生成。你自己的位置不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分享旅程加入的地點和時間將被刪除，你的旅程會重新產生。你自己的位置不受影響。"
          }
        }
      }
    },
    "trip-share.stop-count.one" : {
      "comment" : "Count of a shared trip's stops (destinations and transit), for one.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stop"
          }
        },
        "de" : {
