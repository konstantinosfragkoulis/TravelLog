    "settings.flight-detection.none-found" : {
      "comment" : "Flight detection result when no new flights were confirmed; the Flight Log lists possible flights to review.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen nye flyrejser fundet. Mulige flyrejser, som du kan bekræfte, vises i Flylog."
          }
        },
        "de" : {
          "stringUnit" : {
