        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bestemt år, for eksempel 2025. La feltet stå tomt for statistikk for hele perioden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een specifiek jaar, zoals 2025. Laat leeg voor statistieken over de hele periode."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ano específico, como 2025. Deixe em branco para ver as estatísticas de toda a vida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
