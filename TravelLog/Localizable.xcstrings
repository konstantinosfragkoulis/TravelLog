    "root.tracking-warning.detail.not-determined" : {
      "comment" : "Tracking warning detail before the user has chosen a location permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er ikke konfigureret, så Travel Log kan ikke registrere dine rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff wurde noch nicht eingerichtet, daher kann Travel Log Ihre Reisen nicht aufzeichnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχει ρυθμιστεί η πρόσβαση στην τοποθεσία, οπότε το Travel Log δεν μπορεί να καταγράφει τα ταξίδια σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location access hasn't been set up, so Travel Log can't record your trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se configuró el acceso a la ubicación, por lo que Travel Log no puede registrar sus viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la localisation n’a pas été configuré ; Travel Log ne peut donc pas enregistrer vos voyages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione non è stato configurato, quindi Travel Log non può registrare i viaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスが設定されていないため、Travel Logは旅行を記録できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 설정되지 않아 Travel Log가 여행을 기록할 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang er ikke konfigurert, så Travel Log kan ikke registrere reisene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang is niet ingesteld, dus Travel Log kan je reizen niet vastleggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização não foi configurado, então o Travel Log não pode registrar suas viagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização não foi configurado, pelo que o Travel Log não consegue registar as suas viagens."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsåtkomst har inte ställts in, så Travel Log kan inte registrera dina resor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi ayarlanmadığından Travel Log seyahatlerinizi kaydedemiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vị trí chưa được thiết lập nên Travel Log không thể ghi chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未设置位置访问权限，因此 Travel Log 无法记录您的旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未設定位置取用權限，因此 Travel Log 無法記錄您的旅程。"
          }
        }
      }
    },
    "root.tracking-warning.detail.off" : {
      "comment" : "Tracking warning instructions when location access is off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er slået fra. Tjek Indstillinger → Travel Log → Lokalitet, og sørg for, at den er indstillet til “Altid”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist deaktiviert. Prüfen Sie Einstellungen → Travel Log → Standort und stellen Sie sicher, dass „Immer“ ausgewählt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην τοποθεσία είναι απενεργοποιημένη. Έλεγξε Ρυθμίσεις → Travel Log → Τοποθεσία και βεβαιώσου ότι έχει οριστεί σε «Πάντα»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location access is off. Check Settings → Travel Log → Location and make sure it's set to “Always”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Compruebe Ajustes → Travel Log → Ubicación y asegúrese de que esté en “Siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la localisation est désactivé. Vérifiez dans Réglages → Travel Log → Localisation qu’il est réglé sur « Toujours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è disattivato. Controlla in Impostazioni → Travel Log → Posizione che sia impostato su “Sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスがオフです。「設定」→「Travel Log」→「位置情報」で「常に」になっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 꺼져 있어요. 설정 → Travel Log → 위치에서 “항상”으로 설정되어 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang er av. Sjekk Innstillinger → Travel Log → Sted, og sørg for at «Alltid» er valgt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang staat uit. Controleer Instellingen → Travel Log → Locatie en zorg dat ‘Altijd’ is gekozen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está desativado. Confira Ajustes → Travel Log → Localização e escolha “Sempre”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está desativado. Consulte Definições → Travel Log → Localização e selecione “Sempre”."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsåtkomst är avstängd. Kontrollera Inställningar → Travel Log → Plats och se till att den är inställd på ”Alltid”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi kapalı. Ayarlar → Travel Log → Konum yolundan “Her Zaman” seçili olduğundan emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vị trí đang tắt. Kiểm tra Cài đặt → Travel Log → Vị trí và bảo đảm đã chọn “Luôn luôn”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问已关闭。请检查“设置”→ Travel Log →“位置”，并确保设为“始终”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置取用已關閉。請檢查「設定」→ Travel Log →「位置」，並確保設為「永遠」。"
          }
        }
      }
    },
    "root.tracking-warning.detail.restricted" : {
      "comment" : "Tracking warning detail when location access is restricted by the device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er begrænset på denne enhed, muligvis på grund af børnesikring eller en administrationsprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist auf diesem Gerät eingeschränkt, möglicherweise durch Kindersicherungen oder ein Verwaltungsprofil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην τοποθεσία είναι περιορισμένη σε αυτήν τη συσκευή, πιθανώς λόγω γονικού ελέγχου ή προφίλ διαχείρισης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location access is restricted on this device, possibly by parental controls or a management profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está restringido en este dispositivo, posiblemente por controles parentales o un perfil de gestión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la localisation est restreint sur cet appareil, peut-être par le contrôle parental ou un profil de gestion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è limitato su questo dispositivo, forse dai controlli parentali o da un profilo di gestione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアレンタルコントロールまたは管理プロファイルにより、このデバイスでは位置情報へのアクセスが制限されている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 위치 접근이 제한되어 있어요. 유해 콘텐츠 차단 또는 관리 프로파일 때문일 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stedstilgang er begrenset på denne enheten, muligens av foreldrekontroll eller en administrasjonsprofil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang is beperkt op dit apparaat, mogelijk door ouderlijk toezicht of een beheerprofiel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está restrito neste dispositivo, possivelmente por controles parentais ou um perfil de gerenciamento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está restrito neste dispositivo, possivelmente por controlo parental ou um perfil de gestão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsåtkomsten är begränsad på den här enheten, möjligen på grund av föräldrakontroller eller en hanteringsprofil."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi bu aygıtta kısıtlı; bunun nedeni ebeveyn denetimleri veya bir yönetim profili olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vị trí bị hạn chế trên thiết bị này, có thể do kiểm soát của phụ huynh hoặc hồ sơ quản lý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的位置访问受限，可能是家长控制或管理描述文件所致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的位置取用受限，可能是家長控制或管理描述檔所致。"
          }
        }
      }
    },
