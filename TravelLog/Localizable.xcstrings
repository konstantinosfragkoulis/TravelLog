    "onboarding.home.caption" : {
      "comment" : "Onboarding home step caption.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid derhjemme tæller aldrig som en rejse."
          }
