    "temporary-home.form.changes.footer" : {
      "comment" : "Footer of the temporary home form section that previews the effect on existing stays and trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejser herfra slutter, når du vender tilbage. Dit hjem fungerer som sædvanligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisen von hier aus enden, wenn Sie zurückkehren. Ihr Zuhause funktioniert weiter wie gewohnt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα ταξίδια από εδώ θα τερματίζονται όταν επιστρέφεις. Η κατοικία σου συνεχίζει να λειτουργεί όπως πάντα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trips away from here will end when you come back. Your home keeps working as usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los viajes desde aquí finalizarán cuando regrese. Su residencia sigue funcionando como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les voyages au départ d’ici se termineront à votre retour. Votre domicile continue de fonctionner comme d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I viaggi da qui si concluderanno al tuo ritorno. La tua casa continua a funzionare come sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここからの旅行は、ここに戻ると終了します。自宅はこれまでどおり機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 떠난 여행은 돌아오면 끝나요. 집은 평소처럼 작동해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiser herfra avsluttes når du kommer tilbake. Hjemmet ditt fungerer som vanlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reizen vanaf hier eindigen wanneer je terugkomt. Je thuislocatie blijft werken zoals altijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens a partir daqui se encerram quando você volta. Sua casa continua funcionando normalmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As viagens a partir daqui terminam quando regressa. A sua casa continua a funcionar normalmente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resor härifrån avslutas när du kommer tillbaka. Ditt hem fungerar som vanligt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradan çıktığınız seyahatler geri döndüğünüzde sona erer. Ev bölgeniz her zamanki gibi çalışmaya devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chuyến đi từ đây sẽ kết thúc khi bạn quay lại. Nhà của bạn vẫn hoạt động như thường lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从这里出发的旅程会在您返回时结束。您的常住地照常运作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這裡出發的旅程會在您返回時結束。您的居住地照常運作。"
          }
        }
      }
    },
