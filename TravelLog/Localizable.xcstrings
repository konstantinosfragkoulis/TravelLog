    "root.tracking-warning.when-in-use.detail" : {
      "comment" : "Tracking warning instructions for enabling background tracking from while-using location access.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg “Altid” under Indstillinger → Travel Log → Lokalitet for at slå sporing i baggrunden til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie unter Einstellungen → Travel Log → Standort die Option „Immer“, um die Hintergrundaufzeichnung zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για καταγραφή στο παρασκήνιο, επίλεξε «Πάντα» στις Ρυθμίσεις → Travel Log → Τοποθεσία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose “Always” in Settings → Travel Log → Location to enable background tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija “Siempre” en Ajustes → Travel Log → Ubicación para activar el seguimiento en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Toujours » dans Réglages → Travel Log → Localisation pour activer le suivi en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli “Sempre” in Impostazioni → Travel Log → Posizione per attivare il monitoraggio in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドでの記録を有効にするには、「設定」→「Travel Log」→「位置情報」で「常に」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 추적을 사용하려면 설정 → Travel Log → 위치에서 “항상”을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg «Alltid» i Innstillinger → Travel Log → Sted for å slå på sporing i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies ‘Altijd’ via Instellingen → Travel Log → Locatie om volgen op de achtergrond in te schakelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha “Sempre” em Ajustes → Travel Log → Localização para ativar o rastreamento em segundo plano."
          }
        },
        "pt-PT" : {
