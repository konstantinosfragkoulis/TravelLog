    "shared-trip.result.processing" : {
      "comment" : "Shared trip result when the locations were saved but trips were not rebuilt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejsens placeringer blev tilføjet, men dine rejser kunne ikke genopbygges endnu. Det sker, næste gang Travel Log opdaterer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standorte der Reise wurden hinzugefügt, aber Ihre Reisen konnten noch nicht neu aufgebaut werden. Das passiert bei der nächsten Aktualisierung von Travel Log."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τοποθεσίες του ταξιδιού προστέθηκαν, αλλά τα ταξίδια σας δεν αναδημιουργήθηκαν ακόμα. Θα αναδημιουργηθούν στην επόμενη ενημέρωση του Travel Log."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The trip's locations were added, but your trips couldn't be rebuilt yet. They will be the next time Travel Log updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadieron las ubicaciones del viaje, pero tus viajes aún no se han podido reconstruir. Se reconstruirán la próxima vez que Travel Log se actualice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les positions du voyage ont été ajoutées, mais vos voyages n’ont pas encore pu être reconstruits. Ils le seront à la prochaine mise à jour de Travel Log."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le posizioni del viaggio sono state aggiunte, ma i tuoi viaggi non sono ancora stati ricostruiti. Lo saranno al prossimo aggiornamento di Travel Log."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行の位置情報は追加されましたが、旅行をまだ再構築できませんでした。次回Travel Logが更新するときに再構築されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행의 위치는 추가되었지만 아직 여행을 다시 구성하지 못했습니다. 다음에 Travel Log가 업데이트될 때 구성됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reisens posisjoner ble lagt til, men reisene dine kunne ikke bygges opp på nytt ennå. Det skjer neste gang Travel Log oppdateres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De locaties van de reis zijn toegevoegd, maar je reizen konden nog niet opnieuw worden opgebouwd. Dat gebeurt de volgende keer dat Travel Log bijwerkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As localizações da viagem foram adicionadas, mas suas viagens ainda não puderam ser reconstruídas. Isso acontecerá na próxima vez que o Travel Log atualizar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As localizações da viagem foram adicionadas, mas as suas viagens ainda não puderam ser reconstruídas. Isso acontecerá na próxima vez que o Travel Log atualizar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resans platser lades till, men dina resor kunde inte byggas om ännu. Det sker nästa gång Travel Log uppdateras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahatin konumları eklendi, ancak seyahatleriniz henüz yeniden oluşturulamadı. Travel Log bir sonraki güncellemede bunu yapacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí của chuyến đi đã được thêm, nhưng chưa thể dựng lại các chuyến đi của bạn. Việc này sẽ diễn ra vào lần cập nhật tiếp theo của Travel Log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅程的位置已添加，但暂时无法重新生成你的旅程。Travel Log 下次更新时会完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅程的位置已加入，但暫時無法重新產生你的旅程。Travel Log 下次更新時會完成。"
          }
        }
      }
    },
