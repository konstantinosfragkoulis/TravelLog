        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún viaje coincide con todo “%1$@”. Lo más parecido: %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun voyage ne correspond à tout « %1$@ ». Les plus proches : %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun viaggio corrisponde a tutto “%1$@”. I più vicini: %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」のすべてに一致する旅行はありませんでした。近い旅行：%2$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”에 모두 일치하는 여행이 없어요. 가장 가까운 여행: %2$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen reise samsvarte med hele «%1$@». Nærmest: %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen reis past bij alles van ‘%1$@’. Het dichtst in de buurt: %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma viagem correspondeu a tudo em “%1$@”. Mais próximas: %2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma viagem corresponde a tudo em “%1$@”. Mais próximas: %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen resa matchade hela ”%1$@”. Närmast: %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ile tamamen eşleşen seyahat yok. En yakın: %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có chuyến đi nào khớp với toàn bộ “%1$@”. Gần nhất: %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有与“%1$@”完全匹配的旅程。最接近的：%2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有完全符合「%1$@」的旅程。最接近的：%2$@。"
          }
        }
      }
    },
