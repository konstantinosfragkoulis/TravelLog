    "collections.flight-route.footer.on-confirm" : {
      "comment" : "Footer under the stops (and any times) set for a possible flight, which are kept only if the user confirms it.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine mellemlandinger og tider gemmes, når du bekræfter flyrejsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Zwischenstopps und Zeiten werden gespeichert, wenn Sie den Flug bestätigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι στάσεις και οι ώρες σου αποθηκεύονται όταν επιβεβαιώσεις την πτήση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your stops and times are saved when you confirm the flight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus escalas y horas se guardan cuando confirmas el vuelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos escales et horaires sont enregistrés lorsque vous confirmez le vol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scali e orari vengono salvati quando confermi il volo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乗り継ぎ地と時刻はフライトを確定すると保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항공편을 확인하면 경유지와 시간이 저장돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellomlandingene og tidene lagres når du bekrefter flyreisen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tussenstops en tijden worden bewaard wanneer je de vlucht bevestigt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas escalas e horários são salvos quando você confirma o voo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas escalas e horas são guardadas quando confirmar o voo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina mellanlandningar och tider sparas när du bekräftar flygningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarmalarınız ve saatleriniz uçuşu onayladığınızda kaydedilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điểm dừng và giờ của bạn được lưu khi bạn xác nhận chuyến bay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
