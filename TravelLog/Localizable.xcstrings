    "collections.flights.totals.footer.tap" : {
      "comment" : "Flight Log footer under the totals: routes are inferred, durations estimated unless the user set the times, which tapping a flight offers.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruter udledes af placeringsdata. Varigheder er skøn, medmindre du angiver en flyrejses tider: tryk på en flyrejse for at angive dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routen werden aus Standortdaten abgeleitet. Dauern sind Schätzungen, außer Sie legen die Zeiten eines Flugs fest: Tippen Sie auf einen Flug, um sie festzulegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διαδρομές προκύπτουν από δεδομένα τοποθεσίας. Οι διάρκειες είναι εκτιμήσεις, εκτός αν ορίσεις τις ώρες μιας πτήσης: πάτησε μια πτήση για να τις ορίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes are inferred from location data. Durations are estimates unless you set a flight's times: tap a flight to set them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas se deducen de los datos de ubicación. Las duraciones son estimaciones salvo que indiques las horas de un vuelo: toca un vuelo para indicarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les itinéraires sont déduits des données de localisation. Les durées sont estimées, sauf si vous indiquez les horaires d’un vol : touchez un vol pour les indiquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi sono dedotti dai dati di posizione. Le durate sono stime, a meno che tu non imposti gli orari di un volo: tocca un volo per impostarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートは位置情報から推定しています。フライトの時刻を設定しない限り、所要時間は推定値です。フライトをタップすると設定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로는 위치 데이터로 추정해요. 항공편 시간을 설정하지 않으면 소요 시간은 추정값이에요. 항공편을 탭해 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruter utledes fra posisjonsdata. Varigheter er anslag med mindre du angir tidene for en flyreise: trykk på en flyreise for å angi dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes worden afgeleid uit locatiegegevens. Duur is een schatting, tenzij je de tijden van een vlucht instelt: tik op een vlucht om ze in te stellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas são deduzidas dos dados de localização. As durações são estimativas, a menos que você defina os horários de um voo: toque em um voo para defini-los."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As rotas são deduzidas dos dados de localização. As durações são estimativas, a menos que defina as horas de um voo: toque num voo para as definir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutter härleds från platsdata. Tider är uppskattningar om du inte anger en flygnings tider: tryck på en flygning för att ange dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rotalar konum verilerinden çıkarılır. Bir uçuşun saatlerini ayarlamadığınız sürece süreler tahminidir: ayarlamak için bir uçuşa dokunun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuyến bay được suy ra từ dữ liệu vị trí. Thời lượng là ước tính trừ khi bạn đặt giờ cho chuyến bay: chạm vào một chuyến bay để đặt."
          }
        },
        "zh-Hans" : {
