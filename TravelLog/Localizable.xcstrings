    "wrapped.notification.ready.body" : {
      "comment" : "Notification body announcing that the year's Wrapped is ready.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dit rejseår: lande, byer, afstande og meget mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erleben Sie Ihr Reisejahr: Länder, Städte, Entfernungen und mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες τη χρονιά των ταξιδιών σου: χώρες, πόλεις, αποστάσεις και άλλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your year of travel: countries, cities, distances, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea su año de viajes: países, ciudades, distancias y mucho más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez votre année de voyages : pays, villes, distances et plus encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivivi il tuo anno di viaggi: paesi, città, distanze e molto altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れた国、都市、移動距離など、一年の旅を振り返ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "국가, 도시, 거리 등으로 여행한 한 해를 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reiseåret ditt: land, byer, avstander og mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je reisjaar: landen, steden, afstanden en meer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja seu ano de viagens: países, cidades, distâncias e muito mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o seu ano de viagens: países, cidades, distâncias e muito mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ditt reseår: länder, städer, sträckor och mer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyahat yılınızı görün: ülkeler, şehirler, mesafeler ve daha fazlası."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem một năm du lịch của bạn: quốc gia, thành phố, quãng đường và nhiều hơn nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
