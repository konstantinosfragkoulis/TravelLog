    "trip-share.options.footer" : {
      "comment" : "Footer under the share format toggles, explaining each format.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Billedet er til alle. En Travel Log-fil lader en, der var med, føje rejsen til sin egen historik. En GPX-rute kan åbnes i kort- og træningsapps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild ist für alle. Mit einer Travel Log-Datei kann jemand, der dabei war, die Reise in den eigenen Verlauf übernehmen. Eine GPX-Route lässt sich in Karten- und Fitness-Apps öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εικόνα είναι για όλους. Ένα αρχείο Travel Log επιτρέπει σε κάποιον που ήταν εκεί να προσθέσει το ταξίδι στο δικό του ιστορικό. Μια διαδρομή GPX ανοίγει σε εφαρμογές χαρτών και γυμναστικής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The image is for anyone. A Travel Log file lets someone who was there add the trip to their own history. A GPX route opens in maps and fitness apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen es para cualquiera. Un archivo de Travel Log permite que alguien que estuvo allí añada el viaje a su propio historial. Una ruta GPX se abre en apps de mapas y de ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image est pour tout le monde. Un fichier Travel Log permet à quelqu’un qui était présent d’ajouter le voyage à son propre historique. Un itinéraire GPX s’ouvre dans les apps de cartes et de sport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine è per tutti. Un file di Travel Log permette a chi era presente di aggiungere il viaggio alla propria cronologia. Un percorso GPX si apre nelle app di mappe e fitness."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は誰でも見られます。Travel Logファイルを使うと、一緒にいた人が自分の履歴に旅行を追加できます。GPXルートはマップやフィットネスAppで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지는 누구나 볼 수 있습니다. Travel Log 파일을 사용하면 함께 있었던 사람이 자신의 기록에 여행을 추가할 수 있습니다. GPX 경로는 지도 및 피트니스 앱에서 열립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildet er for alle. Med en Travel Log-fil kan noen som var med, legge reisen til i sin egen historikk. En GPX-rute kan åpnes i kart- og treningsapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De afbeelding is voor iedereen. Met een Travel Log-bestand kan iemand die erbij was de reis aan de eigen geschiedenis toevoegen. Een GPX-route opent in kaart- en fitnessapps."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem é para qualquer pessoa. Um arquivo do Travel Log permite que alguém que esteve lá adicione a viagem ao próprio histórico. Uma rota GPX abre em apps de mapas e de exercícios."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem é para qualquer pessoa. Um ficheiro do Travel Log permite que alguém que esteve lá adicione a viagem ao seu próprio histórico. Um percurso GPX abre em apps de mapas e de exercício."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilden är för alla. Med en Travel Log-fil kan någon som var med lägga till resan i sin egen historik. En GPX-rutt öppnas i kart- och träningsappar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görsel herkes içindir. Travel Log dosyası, orada bulunan birinin seyahati kendi geçmişine eklemesini sağlar. GPX rotası harita ve fitness uygulamalarında açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình ảnh dành cho bất kỳ ai. Tệp Travel Log cho phép người đã có mặt thêm chuyến đi vào lịch sử của họ. Lộ trình GPX mở được trong các ứng dụng bản đồ và thể dục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片适合任何人查看。Travel Log 文件可让同行者将此旅程添加到自己的历史记录。GPX 路线可在地图和健身 App 中打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片適合任何人查看。Travel Log 檔案可讓同行者將此旅程加入自己的歷史記錄。GPX 路線可在地圖和健身 App 中打開。"
          }
        }
      }
    },
