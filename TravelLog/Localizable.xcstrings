        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze reizen of plaatsen zijn sinds het splitsen gewijzigd, dus de reis kan niet weer worden samengevoegd: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens ou lugares mudaram depois da divisão, então a viagem não pode ser juntada de novo: %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas viagens ou locais mudaram depois da divisão, por isso a viagem não pode voltar a ser juntada: %@."
          }
