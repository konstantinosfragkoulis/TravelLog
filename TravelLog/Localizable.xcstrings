    "onboarding.background-refresh.off.detail" : {
      "comment" : "Guidance when Background App Refresh is off.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå det til i Indstillinger, så sporingen fortsætter, når iOS lukker appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie sie in Einstellungen, damit die Aufzeichnung weiterläuft, wenn iOS die App schließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησέ την στις Ρυθμίσεις ώστε η καταγραφή να συνεχίζεται όταν το iOS κλείνει την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn it on in Settings so tracking keeps running when iOS closes the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívela en Ajustes para que el seguimiento continúe cuando iOS cierre la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez-la dans Réglages pour que le suivi continue quand iOS ferme l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivalo in Impostazioni per continuare il monitoraggio quando iOS chiude l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSがAppを閉じても記録が続くよう、「設定」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS가 앱을 닫아도 추적이 계속되도록 설정에서 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå det på i Innstillinger, så sporingen fortsetter når iOS lukker appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet dit aan in Instellingen zodat het volgen doorgaat als iOS de app sluit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative em Ajustes para que o rastreamento continue quando o iOS fechar o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative em Definições para que o acompanhamento continue quando o iOS fechar a app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på det i Inställningar så att spårningen fortsätter när iOS stänger appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uygulamayı kapattığında takibin sürmesi için Ayarlar’da açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật trong Cài đặt để tiếp tục theo dõi khi iOS đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中开启此功能，让 iOS 关闭 App 后仍能继续跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中開啟此功能，讓 iOS 關閉 App 後仍能繼續追蹤。"
          }
        }
      }
    },
    "onboarding.background-refresh.restricted.detail" : {
      "comment" : "Guidance when Background App Refresh is restricted.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhedspolitik blokerer det, så sporingen kan stoppe, når iOS lukker appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Geräterichtlinie blockiert sie. Die Aufzeichnung kann stoppen, wenn iOS die App schließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια πολιτική συσκευής την αποκλείει, οπότε η καταγραφή ίσως σταματήσει όταν το iOS κλείσει την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A device policy blocks it, so tracking may stop when iOS closes the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una política del dispositivo la bloquea. El seguimiento puede detenerse si iOS cierra la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle de l’appareil la bloque. Le suivi peut s’arrêter quand iOS ferme l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un criterio del dispositivo lo blocca. Il monitoraggio può fermarsi quando iOS chiude l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスのポリシーで制限されているため、iOSがAppを閉じると記録が止まる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 정책으로 차단되어 있어 iOS가 앱을 닫으면 추적이 멈출 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhetspolicy blokkerer det, så sporingen kan stoppe når iOS lukker appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een apparaatbeleid blokkeert dit. Het volgen kan stoppen als iOS de app sluit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma política do dispositivo bloqueia a função. O rastreamento pode parar quando o iOS fechar o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma política do dispositivo bloqueia a função. O acompanhamento pode parar quando o iOS fechar a app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En enhetspolicy blockerar det, så spårningen kan stanna när iOS stänger appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıt politikası bunu engelliyor. iOS uygulamayı kapattığında takip durabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chính sách thiết bị chặn tính năng này nên việc theo dõi có thể dừng khi iOS đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备策略阻止了此功能，iOS 关闭 App 后，跟踪可能停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置政策阻擋了此功能，iOS 關閉 App 後，追蹤可能停止。"
          }
        }
      }
    },
    "onboarding.feature.automatic-trips.description.with-ai" : {
      "comment" : "Onboarding automatic-trip description on devices that can use Apple Intelligence.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI på enheden gør dine ophold til rejser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI auf dem Gerät macht aus Aufenthalten Reisen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AI στη συσκευή κάνει τις παραμονές σου ταξίδια"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On-device AI turns your stays into trips"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA del dispositivo convierte estancias en viajes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA sur l’appareil transforme vos séjours en voyages"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA sul dispositivo trasforma i soggiorni in viaggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のAIが滞在を旅行にまとめます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기 내 AI가 머문 곳을 여행으로 엮어요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI på enheten gjør oppholdene dine til reiser"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI op je apparaat maakt van je verblijven reizen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA no dispositivo transforma estadias em viagens"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA no dispositivo transforma estadias em viagens"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI på enheten gör dina vistelser till resor"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıttaki yapay zekâ konaklamaları seyahate dönüştürür"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI trên thiết bị biến các lần lưu trú thành chuyến đi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备端 AI 将您的停留汇成旅程"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裝置端 AI 將您的停留匯成旅程"
          }
        }
      }
