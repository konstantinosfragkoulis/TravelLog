    "temporary-home.suggestion.ongoing.here" : {
      "comment" : "Suggestion on an ongoing trip that mostly stays in one place whose city is unknown. A temporary home makes trips from there separate trips.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bor du her for tiden? Opret et midlertidigt hjem, så dine rejser herfra tæller for sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wohnen Sie gerade hier? Richten Sie ein Zuhause auf Zeit ein, damit Ihre Reisen von hier als eigene Reisen zählen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μένεις εδώ προς το παρόν; Όρισε ένα προσωρινό σπίτι, ώστε τα ταξίδια σου από εδώ να μετρούν ξεχωριστά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Living here for now? Set up a temporary home so your trips from here count on their own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Vive aquí por ahora? Configure una residencia temporal para que sus viajes desde aquí cuenten por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vivez ici pour le moment ? Configurez un domicile temporaire pour que vos voyages au départ d’ici comptent à part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivi qui per ora? Configura una casa temporanea così i viaggi da qui contano a parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらくここに住んでいますか？仮の自宅を設定すると、ここから出かけた旅行が別々に数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당분간 이곳에 살고 계신가요? 임시 거주지를 설정하면 이곳에서 떠난 여행이 따로 집계돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bor du her for tiden? Opprett et midlertidig hjem, så teller reisene dine herfra for seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woon je hier voorlopig? Stel een tijdelijk thuis in, zodat je reizen vanaf hier apart tellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morando aqui por enquanto? Configure uma casa temporária para que suas viagens a partir daqui contem separadamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está a viver aqui por agora? Configure uma casa temporária para que as suas viagens a partir daqui contem à parte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bor du här just nu? Skapa ett tillfälligt hem så att dina resor härifrån räknas för sig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdilik burada mı yaşıyorsunuz? Buradan çıktığınız seyahatlerin ayrı sayılması için bir geçici ev bölgesi ayarlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện đang sống ở đây? Hãy thiết lập nhà tạm thời để các chuyến đi từ đây được tính riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前住在这里吗？设置暂住地后，从这里出发的旅程会单独计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前住在這裡嗎？設定暫住地後，從這裡出發的旅程會單獨計算。"
          }
        }
      }
    },
