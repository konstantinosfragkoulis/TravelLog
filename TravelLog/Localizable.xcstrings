    "settings.data-import.result.records.one" : {
      "comment" : "Trip-data import result for one restored location history entry, map cell, recap, planned trip, removed trip or preference.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannede %@ element af placeringshistorik eller gemte appdata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Eintrag aus dem Standortverlauf oder gespeicherten App-Daten wiederhergestellt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαναφέρθηκε %@ στοιχείο ιστορικού τοποθεσίας ή αποθηκευμένων δεδομένων της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored %@ item of location history or saved app data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restauró %@ elemento del historial de ubicaciones o de los datos guardados de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ élément de l’historique des positions ou des données de l’app restauré."
          }
        },
        "it" : {
          "stringUnit" : {
