    "Stays from one trip will be merged into the other." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ophold fra den ene rejse bliver flettet ind i den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufenthalte aus einer Reise werden mit der anderen zusammengeführt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι παραμονές από το ένα ταξίδι θα συγχωνευτούν στο άλλο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stays from one trip will be merged into the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estancias de un viaje se fusionarán con el otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les séjours d’un voyage seront fusionnés avec ceux de l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I soggiorni di un viaggio verranno uniti all’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一方の旅行の滞在をもう一方に結合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 여행의 체류가 다른 여행에 병합돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opphold fra den ene reisen slås sammen med den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verblijven van de ene reis worden samengevoegd met de andere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estadias de uma viagem serão combinadas com as da outra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
