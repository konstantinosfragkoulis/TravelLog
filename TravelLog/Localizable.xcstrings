    "These come from your tracked and imported trips." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stammer fra dine sporede og importerede rejser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese stammen aus Ihren aufgezeichneten und importierten Reisen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προέρχονται από τα καταγεγραμμένα και εισαγμένα ταξίδια σου."
          }
        },
        "en" : {
          "stringUnit" : {
