        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@件の滞在のうち最近の%1$@件を表示しています。プルして更新し、新しい位置情報を滞在にまとめます。3 km以内かつ4時間以内に連続して記録された位置情報が、1回の滞在としてまとめられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체류 %2$@개 중 최근 %1$@개를 표시해요. 아래로 당겨 새 위치 신호를 새로 고치고 묶으세요. 서로 3km 및 4시간 이내인 연속 위치 신호가 체류로 묶여요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser de %1$@ nyeste av %2$@ opphold. Dra for å oppdatere og gruppere nye posisjoner. Opphold grupperes fra påfølgende posisjoner innenfor 3 km og 4 timer fra hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De %1$@ meest recente van %2$@ verblijven worden getoond. Trek om te vernieuwen en nieuwe pings te groeperen. Verblijven worden gevormd uit opeenvolgende locatiepings die binnen 3 km en 4 uur van elkaar liggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrando as %1$@ estadias mais recentes de %2$@. Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos separados por até 3 km e 4 horas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mostrar as %1$@ estadias mais recentes de %2$@. Puxe para atualizar e agrupar novos sinais. As estadias são formadas por sinais de localização consecutivos a menos de 3 km e 4 horas entre si."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar de %1$@ senaste av %2$@ vistelser. Dra för att uppdatera och gruppera nya platspunkter. Vistelser skapas av efterföljande platspunkter inom 3 km och 4 timmar från varandra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ konaklamanın en son %1$@ tanesi gösteriliyor. Yenilemek ve yeni konum sinyallerini gruplamak için aşağı çekin. Birbirine 3 km ve 4 saat içinde olan ardışık konum sinyalleri konaklama olarak gruplanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang hiển thị %1$@ lần lưu trú gần đây nhất trong tổng số %2$@. Kéo để làm mới và nhóm tín hiệu vị trí mới. Các lần lưu trú được nhóm từ những tín hiệu vị trí liên tiếp cách nhau trong phạm vi 3km và 4 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %2$@ 个停留，正在显示最近的 %1$@ 个。下拉刷新并聚类新的位置点。相距不超过 3 公里且时间间隔不超过 4 小时的连续位置点会归组为停留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %2$@ 個停留，正在顯示最近的 %1$@ 個。下拉重新整理並分群新的位置點。相距不超過 3 公里且時間間隔不超過 4 小時的連續位置點會歸類為停留。"
          }
        }
      }
    },
