          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke stad, plaats en elk eiland waar je verblijft, verschijnt hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda cidade, vila e ilha em que você fica aparece aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as cidades, localidades e ilhas onde fica aparecem aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje stad, ort och ö du vistas på visas här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konakladığınız her şehir, kasaba ve ada burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thành phố, thị trấn và hòn đảo nơi bạn lưu trú đều xuất hiện tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
