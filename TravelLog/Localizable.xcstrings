    "home-area.nearby-activity.empty.description" : {
      "comment" : "Empty-state description in Settings > Near-Home Activity, which lists outings Travel Log did not log as trips because they stayed near home or had only brief stops.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ture tæt på hjemmet eller med kun korte stop registreres ikke som rejser. Når Travel Log lægger en til side, vises den her, så du kan beslutte dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausflüge nahe der Heimat oder nur mit kurzen Stopps werden nicht als Reisen protokolliert. Wenn Travel Log einen zurückstellt, erscheint er hier, damit Sie entscheiden können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εξορμήσεις κοντά στην κατοικία ή μόνο με σύντομες στάσεις δεν καταγράφονται ως ταξίδια. Όταν το Travel Log παραμερίζει μία, εμφανίζεται εδώ για να αποφασίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Outings near home or with only brief stops aren't logged as trips. When Travel Log sets one aside, it appears here so you can decide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las salidas cerca de casa o con solo paradas breves no se registran como viajes. Cuando Travel Log aparte una, aparecerá aquí para que decida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sorties près du domicile ou avec seulement de brefs arrêts ne sont pas enregistrées comme voyages. Lorsqu’une sortie est écartée par Travel Log, elle apparaît ici pour que vous puissiez décider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le uscite vicino a casa o con solo brevi soste non vengono registrate come viaggi. Quando Travel Log ne mette da parte una, appare qui per consentirti di decidere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自宅付近の外出や短い立ち寄りだけの外出は旅行として記録されません。Travel Logが除外した外出がここに表示されるので、自分で判断できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집 근처의 외출이나 잠깐 들른 곳만 있는 외출은 여행으로 기록되지 않아요. Travel Log가 제외한 외출은 여기에 표시되어 직접 결정할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turer nær hjemmet eller med bare korte stopp loggføres ikke som reiser. Når Travel Log legger en til side, vises den her, slik at du kan bestemme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitstapjes dicht bij huis of met alleen korte stops worden niet als reis vastgelegd. Wanneer Travel Log er een apart houdt, verschijnt die hier zodat jij kunt beslissen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passeios perto de casa ou só com paradas rápidas não são registrados como viagens. Quando o Travel Log separar um deles, ele aparecerá aqui para você decidir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As saídas perto de casa ou apenas com paragens breves não são registadas como viagens. Quando o Travel Log põe uma de parte, esta aparece aqui para que possa decidir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utflykter nära hemmet eller med bara korta stopp loggas inte som resor. När Travel Log lägger en åt sidan visas den här så att du kan bestämma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ev yakınındaki ya da yalnızca kısa duraklı geziler seyahat olarak kaydedilmez. Travel Log bir geziyi ayırdığında karar verebilmeniz için burada gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những lần ra ngoài gần nhà hoặc chỉ dừng chân chốc lát không được ghi là chuyến đi. Khi Travel Log để riêng một lần như vậy, nó sẽ xuất hiện tại đây để bạn quyết định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常住区域附近的外出或只有短暂停留的外出不会记录为旅程。Travel Log 暂不计入的外出会显示在这里，由您决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "居住區域附近的外出或只有短暫停留的外出不會記錄為旅程。Travel Log 暫不計入的外出會顯示在這裡，由您決定。"
          }
        }
      }
    },
    "home-area.nearby-activity.footer" : {
      "comment" : "Footer of the outings list in Settings > Near-Home Activity. Each row has a Log as a Trip button; logging one keeps it as a trip for good.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse ture forblev tæt på hjemmet eller havde kun korte stop, så Travel Log registrerede dem ikke som rejser. Hvis du registrerer en, markeres den permanent som en rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ausflüge blieben nahe der Heimat oder hatten nur kurze Stopps, daher hat Travel Log sie nicht als Reisen protokolliert. Wenn Sie einen protokollieren, wird er dauerhaft als Reise markiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι εξορμήσεις έμειναν κοντά στην κατοικία ή είχαν μόνο σύντομες στάσεις, οπότε το Travel Log δεν τις κατέγραψε ως ταξίδια. Η καταγραφή μίας την επισημαίνει οριστικά ως ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These outings stayed near home or had only brief stops, so Travel Log didn't log them as trips. Logging one marks it as a trip permanently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas salidas fueron cerca de casa o solo tuvieron paradas breves, por lo que Travel Log no las registró como viajes. Registrar una la marca como viaje de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces sorties sont restées près du domicile ou n’ont compté que de brefs arrêts ; Travel Log ne les a donc pas enregistrées comme voyages. En enregistrer une comme voyage rend ce choix définitif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste uscite sono rimaste vicino a casa o hanno avuto solo brevi soste, quindi Travel Log non le ha registrate come viaggi. Registrandone una, verrà contrassegnata definitivamente come viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの外出は自宅付近だったか短い立ち寄りだけだったため、Travel Logは旅行として記録しませんでした。記録すると、その外出は常に旅行として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 외출은 집 근처에 머물렀거나 잠깐 들른 곳만 있어 Travel Log가 여행으로 기록하지 않았어요. 기록하면 영구적으로 여행으로 표시돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse turene holdt seg nær hjemmet eller hadde bare korte stopp, så Travel Log loggførte dem ikke som reiser. Hvis du loggfører en, merkes den permanent som en reise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze uitstapjes bleven dicht bij huis of hadden alleen korte stops en zijn daarom niet als reizen vastgelegd door Travel Log. Als je er een vastlegt, wordt die blijvend als reis gemarkeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses passeios ficaram perto de casa ou só tiveram paradas rápidas, então o Travel Log não os registrou como viagens. Registrar um deles o marca permanentemente como viagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas saídas permaneceram perto de casa ou tiveram apenas paragens breves, pelo que o Travel Log não as registou como viagens. Registar uma marca-a permanentemente como viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här utflykterna höll sig nära hemmet eller hade bara korta stopp, så Travel Log loggade dem inte som resor. Om du loggar en markeras den permanent som en resa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu geziler ev yakınında kaldığından ya da yalnızca kısa duraklar içerdiğinden Travel Log onları seyahat olarak kaydetmedi. Kaydettiğiniz gezi kalıcı olarak seyahat sayılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những lần ra ngoài này ở gần nhà hoặc chỉ dừng chân chốc lát nên Travel Log không ghi chúng thành chuyến đi. Ghi lại một lần sẽ đánh dấu vĩnh viễn đó là chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些外出活动始终在常住区域附近，或只有短暂停留，因此 Travel Log 没有将其记录为旅程。将某次外出记录为旅程后，它会永久保留为旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些外出活動一直在居住區域附近，或只有短暫停留，因此 Travel Log 沒有將其記錄為旅程。將某次外出記錄為旅程後，它會永久保留為旅程。"
          }
        }
      }
    },
    "home-area.places-added.footer" : {
      "comment" : "Footer of the Places You Added section in Home Area Places. Each row is a place the user taught as part of their home area; removing one also lets Travel Log classify the user's past visits there again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremtidige besøg på disse steder tæller som hjem og ikke som rejser. Hvis du fjerner et sted, bliver dine tidligere besøg der også vurderet igen, så tidligere rejser kan komme tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künftige Besuche an diesen Orten zählen als Heimat und nicht als Reise. Wenn Sie einen Ort entfernen, werden auch Ihre bisherigen Besuche dort neu bewertet, sodass frühere Reisen zurückkehren können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μελλοντικές επισκέψεις σε αυτά τα μέρη μετρούν ως χρόνος στην περιοχή κατοικίας, όχι ως ταξίδια. Αν αφαιρέσεις ένα, επανεξετάζονται και οι παλιές σου επισκέψεις εκεί και παλαιότερα ταξίδια μπορεί να επιστρέψουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Future visits to these places count as home, not travel. Removing one also reconsiders your past visits there, so earlier trips can come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las próximas visitas a estos lugares contarán como estancia en casa, no como viaje. Si elimina uno, también se revisan sus visitas anteriores allí, por lo que pueden volver a aparecer viajes pasados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futures visites dans ces lieux comptent comme du temps au domicile, et non comme des voyages. Supprimer un lieu réexamine aussi vos visites passées, et d’anciens voyages peuvent revenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le visite future in questi luoghi conteranno come permanenza a casa, non come viaggi. Se rimuovi un luogo, vengono riesaminate anche le tue visite passate lì, quindi alcuni viaggi precedenti potrebbero ricomparire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後これらの場所を訪れた場合は、旅行ではなく自宅として扱われます。削除すると、その場所への過去の訪問も見直されるため、以前の旅行が再び表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 이 장소를 방문하면 여행이 아닌 집으로 간주돼요. 장소를 삭제하면 그곳의 지난 방문도 다시 판단하므로 이전 여행이 다시 나타날 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremtidige besøk på disse stedene regnes som hjemme, ikke som reiser. Fjerner du et sted, blir også de tidligere besøkene dine der vurdert på nytt, så tidligere reiser kan komme tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toekomstige bezoeken aan deze plekken tellen als thuis, niet als reis. Als je een plek verwijdert, worden ook je eerdere bezoeken daar opnieuw beoordeeld, zodat eerdere reizen kunnen terugkomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitas futuras a esses locais contam como casa, não como viagem. Ao remover um deles, suas visitas anteriores ali também são reavaliadas, e viagens passadas podem voltar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As visitas futuras a estes locais contam como casa, não como viagens. Ao remover um local, as suas visitas anteriores também são reavaliadas, pelo que viagens passadas podem voltar a aparecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framtida besök på dessa platser räknas som hemma, inte som resor. Tar du bort en plats bedöms även dina tidigare besök där på nytt, så tidigare resor kan komma tillbaka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yerlere gelecekteki ziyaretler seyahat değil, ev bölgesi olarak sayılır. Birini kaldırdığınızda oradaki geçmiş ziyaretleriniz de yeniden değerlendirilir ve önceki seyahatler geri gelebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lần ghé thăm sau này đến những nơi này sẽ được tính là ở nhà, không phải du lịch. Khi xóa một nơi, các lần ghé trước đây của bạn ở đó cũng được xem xét lại, nên các chuyến đi cũ có thể xuất hiện trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今后到访这些地点将视为回家，而非旅行。移除地点后，您过去在那里的到访也会重新判断，之前的旅程可能会重新出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後造訪這些地點將視為回家，而非旅行。移除地點後，您過去在那裡的造訪也會重新判斷，先前的旅程可能會重新出現。"
          }
        }
      }
    },
    "home-area.removed-trip.restore-error.stays-claimed" : {
      "comment" : "Error when a removed trip cannot be restored because its stays belong to another trip.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kan ikke gendannes. Opholdene hører nu til en anden rejse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht wiederhergestellt werden. Seine Aufenthalte gehören jetzt zu einer anderen Reise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η επαναφορά του «%@». Οι παραμονές του ανήκουν πλέον σε άλλο ταξίδι."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” can't be restored. Its stays now belong to another trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede restaurar “%@”. Sus estancias pertenecen ahora a otro viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de restaurer « %@ ». Ses séjours appartiennent désormais à un autre voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ripristinare “%@”. I suoi soggiorni ora appartengono a un altro viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は復元できません。その滞在は現在、別の旅行に含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원할 수 없는 여행이에요: “%@”. 해당 체류가 이제 다른 여행에 속해 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» kan ikke gjenopprettes. Oppholdene tilhører nå en annen reise."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan niet worden hersteld. De verblijven horen nu bij een andere reis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível restaurar “%@”. As estadias agora pertencem a outra viagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível restaurar “%@”. As estadias agora pertencem a outra viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” kan inte återställas. Dess vistelser tillhör nu en annan resa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” geri yüklenemiyor. Konaklamaları artık başka bir seyahate ait."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể khôi phục “%@”. Các lần lưu trú của chuyến đi này giờ thuộc về chuyến khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法恢复“%@”。其中的停留现已属于另一段旅程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法恢復「%@」。其中的停留現已屬於另一段旅程。"
          }
        }
      }
    },
    "home-area.removed-trip.restore-error.stays-missing" : {
      "comment" : "Error when a removed trip cannot be restored because its location history is unavailable locally.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kan ikke gendannes lige nu. Lokalitetshistorikken findes ikke på denne enhed. Hvis iCloud stadig synkroniserer, kan du prøve igen senere eller skubbe for at glemme den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann derzeit nicht wiederhergestellt werden. Der Standortverlauf befindet sich nicht auf diesem Gerät. Falls iCloud noch synchronisiert, versuchen Sie es später erneut, oder streichen Sie, um die Reise zu vergessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η επαναφορά του «%@» τώρα. Το ιστορικό τοποθεσίας του δεν βρίσκεται σε αυτήν τη συσκευή. Αν το iCloud συγχρονίζεται ακόμη, δοκίμασε ξανά αργότερα ή σύρε για να το ξεχάσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%@” can't be restored right now. Its location history isn't on this device. If iCloud is still syncing, try again later, or swipe to forget it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede restaurar “%@” ahora. Su historial de ubicaciones no está en este dispositivo. Si iCloud aún se está sincronizando, inténtelo más tarde o deslice para olvidarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de restaurer « %@ » pour le moment. Son historique de localisation n’est pas présent sur cet appareil. Si iCloud est encore en cours de synchronisation, réessayez plus tard ou balayez pour l’oublier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non è possibile ripristinare “%@”. La relativa cronologia delle posizioni non è presente su questo dispositivo. Se iCloud sta ancora sincronizzando, riprova più tardi oppure scorri per dimenticarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在「%@」を復元できません。位置情報履歴がこのデバイスにありません。iCloudが同期中の場合は後でもう一度試すか、スワイプして記録から削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 복원할 수 없는 여행이에요: “%@”. 이 기기에 해당 위치 기록이 없어요. iCloud가 아직 동기화 중이라면 나중에 다시 시도하거나 쓸어넘겨 잊으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» kan ikke gjenopprettes akkurat nå. Posisjonsloggen finnes ikke på denne enheten. Hvis iCloud fortsatt synkroniserer, prøver du igjen senere eller sveiper for å glemme reisen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ kan nu niet worden hersteld. De locatiegeschiedenis staat niet op dit apparaat. Als iCloud nog synchroniseert, probeer je het later opnieuw of veeg je om de reis te vergeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível restaurar “%@” agora. O histórico de localização não está neste dispositivo. Se o iCloud ainda estiver sincronizando, tente novamente mais tarde ou deslize para esquecer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível restaurar “%@” neste momento. O histórico de localização não está neste dispositivo. Se o iCloud ainda estiver a sincronizar, tente novamente mais tarde ou passe o dedo para esquecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” kan inte återställas just nu. Dess platshistorik finns inte på den här enheten. Om iCloud fortfarande synkroniserar kan du försöka igen senare eller svepa för att glömma den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” şu anda geri yüklenemiyor. Konum geçmişi bu aygıtta değil. iCloud hâlâ eşzamanlanıyorsa daha sonra yeniden deneyin veya unutmak için kaydırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện không thể khôi phục “%@”. Lịch sử vị trí của chuyến đi không có trên thiết bị này. Nếu iCloud vẫn đang đồng bộ, hãy thử lại sau hoặc vuốt để quên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法恢复“%@”。此设备上没有相关位置历史。如果 iCloud 仍在同步，请稍后再试，或轻扫以忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法恢復「%@」。此裝置上沒有相關位置歷史。如果 iCloud 仍在同步，請稍後再試，或滑動以忽略。"
          }
        }
      }
    },
    "home-area.removed-trips.footer" : {
      "comment" : "Footer of the Removed Trips section in Near-Home Activity. The rows are device-local copies of trips Travel Log removed when their places became part of the user's home area, or split when a temporary home covered them. Restore and Keep as One Trip are the names of the rows' buttons; a trip kept as one trip is not split by that temporary home again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse kopier blev gemt, da rejser blev en del af et hjemmeområde eller blev delt af et midlertidigt hjem. Gendan eller Behold som én rejse henter en tilbage, og Behold som én rejse forhindrer også, at det midlertidige hjem deler den igen. Skub for at glemme en kopi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopien wurden gespeichert, als Reisen Teil einer Heimatregion wurden oder durch ein Zuhause auf Zeit aufgeteilt wurden. „Wiederherstellen“ oder „Als eine Reise behalten“ holt eine zurück, und „Als eine Reise behalten“ verhindert außerdem, dass dieses Zuhause auf Zeit sie erneut aufteilt. Streichen Sie über eine Kopie, um sie zu vergessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα αντίγραφα αποθηκεύτηκαν όταν ταξίδια έγιναν μέρος μιας περιοχής κατοικίας ή χωρίστηκαν από ένα προσωρινό σπίτι. Η Επαναφορά ή η Διατήρηση ως ένα ταξίδι φέρνει πίσω ένα, και η Διατήρηση ως ένα ταξίδι εμποδίζει επίσης εκείνο το προσωρινό σπίτι να το χωρίσει ξανά. Σύρε για να ξεχάσεις ένα αντίγραφο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These copies were saved when trips became part of a home area or were split by a temporary home. Restore or Keep as One Trip brings one back, and Keep as One Trip also stops that temporary home from splitting it again. Swipe to forget a copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas copias se guardaron cuando unos viajes pasaron a formar parte de una zona de residencia o se dividieron por una residencia temporal. Restaurar o Mantener como un solo viaje recupera uno, y Mantener como un solo viaje también evita que esa residencia temporal lo divida de nuevo. Deslice para olvidar una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces copies ont été enregistrées lorsque des voyages sont devenus partie d’une zone de domicile ou ont été séparés par un domicile temporaire. Restaurer ou Garder en un seul voyage en rétablit un, et Garder en un seul voyage empêche aussi ce domicile temporaire de le séparer à nouveau. Balayez pour oublier une copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste copie sono state salvate quando dei viaggi sono entrati in una zona di casa o sono stati divisi da una casa temporanea. Ripristina o Mantieni come un unico viaggio ne riporta indietro uno, e Mantieni come un unico viaggio impedisce anche a quella casa temporanea di dividerlo di nuovo. Scorri per dimenticare una copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのコピーは、旅行が自宅エリアの一部になったときや仮の自宅によって分割されたときに保存されました。「復元」または「1つの旅行として残す」で元に戻せます。「1つの旅行として残す」を使うと、その仮の自宅によって再び分割されることもなくなります。スワイプするとコピーを削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사본은 여행이 생활권에 포함되거나 임시 거주지로 인해 나뉠 때 저장되었어요. ‘복원’ 또는 ‘하나의 여행으로 유지’를 선택하면 여행을 되돌릴 수 있으며, ‘하나의 여행으로 유지’를 사용하면 그 임시 거주지가 여행을 다시 나누지 않아요. 사본을 삭제하려면 쓸어넘기세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse kopiene ble lagret da reiser ble en del av et hjemmeområde eller ble delt av et midlertidig hjem. Gjenopprett eller Behold som én reise henter en tilbake, og Behold som én reise hindrer også at det midlertidige hjemmet deler den på nytt. Sveip for å glemme en kopi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kopieën zijn bewaard toen reizen deel van een thuisgebied werden of door een tijdelijk thuis werden gesplitst. Herstel of Bewaar als één reis haalt er een terug, en Bewaar als één reis voorkomt ook dat dat tijdelijke thuis hem opnieuw splitst. Veeg om een kopie te vergeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas cópias foram salvas quando viagens passaram a fazer parte de uma área de residência ou foram divididas por uma casa temporária. Restaurar ou Manter como uma única viagem traz uma de volta, e Manter como uma única viagem também impede que essa casa temporária a divida outra vez. Deslize para esquecer uma cópia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas cópias foram guardadas quando viagens passaram a fazer parte de uma área de residência ou foram divididas por uma casa temporária. Restaurar ou Manter como uma única viagem repõe uma, e Manter como uma única viagem também impede que essa casa temporária a divida outra vez. Passe o dedo para esquecer uma cópia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här kopiorna sparades när resor blev en del av ett hemområde eller delades av ett tillfälligt hem. Återställ eller Behåll som en resa tar tillbaka en, och Behåll som en resa hindrar också det tillfälliga hemmet från att dela den igen. Svep för att glömma en kopia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kopyalar, seyahatler bir ev bölgesinin parçası olduğunda veya bir geçici ev bölgesi tarafından bölündüğünde kaydedildi. Geri Yükle veya Tek Seyahat Olarak Koru birini geri getirir; Tek Seyahat Olarak Koru ayrıca o geçici ev bölgesinin seyahati tekrar bölmesini önler. Bir kopyayı unutmak için kaydırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản sao này được lưu khi chuyến đi trở thành một phần khu vực sinh sống hoặc bị tách bởi một nhà tạm thời. Khôi phục hoặc Giữ thành một chuyến đi sẽ đưa một chuyến trở lại, và Giữ thành một chuyến đi cũng ngăn nhà tạm thời đó tách chuyến đi lần nữa. Vuốt để quên một bản sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些副本是在旅程成为常住区域的一部分，或被暂住地拆分时保存的。“恢复”或“保留为一段旅程”可将其找回，“保留为一段旅程”还会让该暂住地不再拆分它。轻扫可忽略副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些副本是在旅程成為居住區域的一部分，或被暫住地拆分時儲存的。「恢復」或「保留為一段旅程」可將其找回，「保留為一段旅程」還會讓該暫住地不再拆分它。滑動可忽略副本。"
          }
        }
      }
    },
