          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log não conseguiu ler seus dados de viagem. Tente novamente em instantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
