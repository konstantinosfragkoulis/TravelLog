    "trips.search-empty.ai-empty-hint" : {
      "comment" : "Trip search empty-state hint when the AI fallback search also found nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet matchede, heller ikke med AI. Tjek stavningen, eller prøv et sted, et land eller et år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit KI wurde nichts gefunden. Prüfen Sie die Schreibweise, oder versuchen Sie einen Ort, ein Land oder ein Jahr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε τίποτα, ούτε με AI. Έλεγξε την ορθογραφία ή δοκίμασε ένα μέρος, μια χώρα ή ένα έτος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing matched, even with AI. Check the spelling, or try a place, country, or year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró nada, ni siquiera con IA. Compruebe la ortografía o pruebe con un lugar, un país o un año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun résultat, même avec l’IA. Vérifiez l’orthographe, ou essayez un lieu, un pays ou une année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun risultato, nemmeno con l’IA. Controlla l’ortografia oppure prova un luogo, un paese o un anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIを使っても一致するものはありませんでした。つづりを確認するか、場所、国、年で検索してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI로도 일치하는 결과를 찾지 못했어요. 철자를 확인하거나 장소, 국가 또는 연도로 검색해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen treff, heller ikke med AI. Sjekk stavemåten, eller prøv et sted, et land eller et år."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets gevonden, ook niet met AI. Controleer de spelling, of probeer een plaats, land of jaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada encontrado, nem mesmo com IA. Confira a ortografia ou tente um lugar, país ou ano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada encontrado, nem mesmo com IA. Verifique a ortografia ou experimente um local, país ou ano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga träffar, inte ens med AI. Kontrollera stavningen eller prova en plats, ett land eller ett år."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâyla da eşleşen bir şey bulunamadı. Yazımı kontrol edin ya da bir yer, ülke veya yıl deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tìm thấy kết quả nào, kể cả khi dùng AI. Hãy kiểm tra chính tả, hoặc thử tìm một địa điểm, quốc gia hay năm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用 AI 也未找到结果。请检查拼写，或尝试搜索地点、国家/地区或年份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用 AI 也找不到結果。請檢查拼寫，或嘗試搜尋地點、國家或地區、年份。"
          }
        }
      }
    },
