    "settings.photos.footer" : {
      "comment" : "Settings Photos section footer explaining how photos are used.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log matcher dine billeder med rejser ved hjælp af tidsstempler og GPS-lokaliteter. Appen læser dem kun på denne enhed og uploader eller ændrer dem aldrig. iCloud-fotos kan hente billeder fra Apple for at vise dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log ordnet Ihre Fotos anhand von Zeitstempeln und GPS-Standorten Reisen zu. Die App liest sie nur auf diesem Gerät und lädt sie nie hoch oder ändert sie. iCloud-Fotos kann Fotos von Apple laden, um sie anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Travel Log αντιστοιχίζει τις φωτογραφίες σου με ταξίδια χρησιμοποιώντας χρονικές σημάνσεις και τοποθεσίες GPS. Τις διαβάζει μόνο σε αυτήν τη συσκευή και δεν τις ανεβάζει ούτε τις αλλάζει ποτέ. Οι Φωτογραφίες iCloud μπορεί να κατεβάσουν φωτογραφίες από την Apple για να εμφανιστούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Travel Log matches your photos to trips using timestamps and GPS locations. It only reads them on this device and never uploads or changes them. iCloud Photos may download photos from Apple to show them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log vincula sus fotos con viajes mediante fechas, horas y ubicaciones GPS. Solo las lee en este dispositivo y nunca las sube ni las modifica. Fotos de iCloud puede descargar fotos de Apple para mostrarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log associe vos photos aux voyages grâce aux horodatages et aux coordonnées GPS. L’app les lit uniquement sur cet appareil et ne les envoie ni ne les modifie jamais. Photos iCloud peut télécharger des photos depuis Apple pour les afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log abbina le foto ai viaggi usando data, ora e posizione GPS. Le legge solo su questo dispositivo e non le carica né le modifica mai. Foto di iCloud può scaricare le foto da Apple per mostrarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel LogはタイムスタンプとGPS位置情報を使って写真を旅行と照合します。写真はこのデバイス上で読み取るだけで、アップロードや変更は一切しません。iCloud写真では、表示のためにAppleから写真がダウンロードされることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log는 타임스탬프와 GPS 위치를 사용해 사진을 여행과 연결해요. 사진은 이 기기에서 읽기만 하고 업로드하거나 변경하지 않아요. iCloud 사진은 사진을 표시하기 위해 Apple에서 다운로드할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log kobler bildene dine til reiser ved hjelp av tidsstempler og GPS-posisjoner. Appen leser dem bare på denne enheten og laster dem aldri opp eller endrer dem. iCloud-bilder kan laste ned bilder fra Apple for å vise dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log koppelt je foto’s aan reizen met tijdstippen en gps-locaties. De app leest ze alleen op dit apparaat en uploadt of wijzigt ze nooit. iCloud-foto’s kan foto’s van Apple downloaden om ze te tonen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log associa suas fotos às viagens usando horários e localizações GPS. Ele só as lê neste dispositivo e nunca as envia nem as altera. As Fotos do iCloud podem baixar fotos da Apple para exibi-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Travel Log associa as suas fotografias às viagens através das respetivas datas, horas e localizações GPS. Apenas as lê neste dispositivo e nunca as envia nem as altera. As Fotografias em iCloud podem descarregar fotografias da Apple para as mostrar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log matchar dina bilder med resor med hjälp av tidsstämplar och GPS-platser. Appen läser dem bara på den här enheten och laddar aldrig upp eller ändrar dem. iCloud-bilder kan hämta bilder från Apple för att visa dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log, zaman damgalarını ve GPS konumlarını kullanarak fotoğraflarınızı seyahatlerle eşleştirir. Fotoğrafları yalnızca bu aygıtta okur; asla yüklemez veya değiştirmez. iCloud Fotoğrafları, fotoğrafları göstermek için Apple’dan indirebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log đối chiếu ảnh với chuyến đi bằng dấu thời gian và vị trí GPS. Ứng dụng chỉ đọc ảnh trên thiết bị này và không bao giờ tải lên hay thay đổi ảnh. Ảnh iCloud có thể tải ảnh xuống từ Apple để hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 会使用照片的时间戳和 GPS 位置将其与旅程匹配。它只在此设备上读取照片，绝不会上传或更改照片。iCloud 照片可能会从 Apple 下载照片以供显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel Log 會使用照片的時間戳記和 GPS 位置將其與旅程比對。它只在此裝置上讀取照片，絕不會上傳或更改照片。iCloud 照片可能會從 Apple 下載照片以供顯示。"
          }
        }
      }
    },
