          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu này đến từ các chuyến đi được theo dõi và đã nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
