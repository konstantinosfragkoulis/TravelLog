    "settings.data-import.preview.cross-device-warning" : {
      "comment" : "Import preview warning when the same backup was imported on another device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Denne sikkerhedskopi er allerede importeret på en anden enhed. Hvis dataene fra den enhed stadig synkroniseres med iCloud, kan en import her oprette dubletter. Det er sikrere at vente, til synkroniseringen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Dieses Backup wurde bereits auf einem anderen Gerät importiert. Wenn dessen Daten noch mit iCloud synchronisiert werden, kann der Import hier doppelte Reisen erzeugen. Es ist sicherer, zuerst den Abschluss der Synchronisierung abzuwarten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προειδοποίηση: αυτό το αντίγραφο ασφαλείας έχει ήδη εισαχθεί σε άλλη συσκευή. Αν τα δεδομένα εκείνης της συσκευής συγχρονίζονται ακόμη με το iCloud, η εισαγωγή εδώ μπορεί να δημιουργήσει διπλότυπα ταξίδια. Είναι ασφαλέστερο να περιμένεις πρώτα να ολοκληρωθεί ο συγχρονισμός."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: this backup was already imported on another device. If that device's data is still syncing to iCloud, importing here can create duplicate trips. Waiting for sync to finish first is safer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advertencia: esta copia ya se importó en otro dispositivo. Si sus datos aún se sincronizan con iCloud, importar aquí puede crear viajes duplicados. Es más seguro esperar a que termine la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avertissement : cette sauvegarde a déjà été importée sur un autre appareil. Si les données de cet appareil sont encore en cours de synchronisation avec iCloud, l’import ici peut créer des voyages en double. Il est plus sûr d’attendre la fin de la synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avviso: questo backup è già stato importato su un altro dispositivo. Se i dati dell’altro dispositivo sono ancora in fase di sincronizzazione con iCloud, l’importazione qui può creare viaggi duplicati. È più sicuro attendere il termine della sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：このバックアップは別のデバイスですでに読み込まれています。そのデバイスのデータがまだiCloudに同期中の場合、ここで読み込むと旅行が重複する可能性があります。先に同期の完了を待つ方が安全です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경고: 이 백업은 다른 기기에서 이미 가져왔어요. 해당 기기의 데이터가 아직 iCloud와 동기화 중이면 여기서 가져올 때 여행이 중복될 수 있어요. 먼저 동기화가 끝날 때까지 기다리는 것이 더 안전해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Denne sikkerhetskopien er allerede importert på en annen enhet. Hvis dataene fra den enheten fortsatt synkroniseres med iCloud, kan import her opprette dupliserte reiser. Det er tryggere å vente til synkroniseringen er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: deze reservekopie is al op een ander apparaat geïmporteerd. Als de gegevens van dat apparaat nog met iCloud worden gesynchroniseerd, kan importeren hier dubbele reizen maken. Het is veiliger eerst te wachten tot de synchronisatie klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: este backup já foi importado em outro dispositivo. Se os dados desse dispositivo ainda estiverem sendo sincronizados com o iCloud, importar aqui poderá criar viagens duplicadas. É mais seguro aguardar o fim da sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: esta cópia de segurança já foi importada noutro dispositivo. Se os dados desse dispositivo ainda estiverem a ser sincronizados com o iCloud, a importação neste dispositivo poderá criar viagens duplicadas. É mais seguro aguardar que a sincronização termine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: säkerhetskopian har redan importerats på en annan enhet. Om data från den enheten fortfarande synkroniseras till iCloud kan en import här skapa dubbletter. Det är säkrare att vänta tills synkroniseringen är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyarı: Bu yedek başka bir aygıtta zaten içe aktarılmış. O aygıtın verileri hâlâ iCloud ile eşzamanlanıyorsa burada içe aktarmak yinelenen seyahatler oluşturabilir. Önce eşzamanlamanın bitmesini beklemek daha güvenlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo: bản sao lưu này đã được nhập trên một thiết bị khác. Nếu dữ liệu của thiết bị đó vẫn đang đồng bộ với iCloud, việc nhập tại đây có thể tạo chuyến đi trùng lặp. An toàn hơn nếu đợi đồng bộ hoàn tất trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：此备份已在另一台设备上导入。如果该设备的数据仍在同步到 iCloud，在此导入可能会创建重复旅程。建议先等待同步完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：此備份已在另一台裝置上匯入。如果該裝置的資料仍在同步到 iCloud，在此匯入可能會建立重複旅程。建議先等待同步完成。"
          }
        }
      }
    },
