    "Photo access is required. Grant access in iOS Settings → Privacy → Photos → TravelLog." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til billeder er påkrævet. Giv adgang under iOS-indstillinger → Anonymitet & sikkerhed → Fotos → TravelLog."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff ist erforderlich. Erteilen Sie ihn unter iOS-Einstellungen → Datenschutz & Sicherheit → Fotos → TravelLog."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται πρόσβαση στις φωτογραφίες. Παραχώρησέ την στις Ρυθμίσεις iOS → Απόρρητο → Φωτογραφίες → TravelLog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
